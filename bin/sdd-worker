#!/usr/bin/env bash
# sdd-worker — the verbs of the campaign worker (ADR 0022).
#
# The worker is a SESSION that orchestrates a campaign: it plans, approves, runs `sdd run`, opens
# the pull request, reviews it and merges, inside a level of autonomy the owner signed. The
# questions that decide those acts used to be the model's reading, and the reading was wrong four
# times on record (a Codex receipt matched by the hour instead of the sha, a watcher whose `pgrep -f`
# matched itself, a bot with no quota read as "reviewed", a checker that read 20 of 21 units). This
# program answers them from artifacts instead:
#
#   delegate   show a campaign's delegation, ask, and sign it
#   level      the effective level of autonomy, with the reason
#   allows     whether one act fits that level
#   budget     what the campaign spent against its two ceilings
#   next       the next act of the campaign
#   pr-ready   whether a pull request meets the owner's five-item bar on its head sha
#
# Every verb but `delegate` only reads. None of them acts: launching `sdd run`, opening the pull
# request and merging stay with the session, through the commands that already exist.
# The runner (`bin/sdd`) owns ONE mission; this program owns the campaign and never writes what the
# runner owns. The sensor is tests/check-worker.sh.
set -euo pipefail

# The ladder of autonomy, lowest first, ONE definition: a name outside it is not a level.
LADDER=(assisted pr plan merge full)
# The six keys of a delegation, in the order the digest reads them. `signed:` is not among them: it
# is where the digest is written.
DELEGATION_KEYS=(campaign level lots expires budget_mission_usd budget_campaign_usd)
# The table of acts, ONE definition and positive: each act is written with the lowest level that
# grants it, and an act is allowed because the table names a level at or below the effective one —
# never because nothing refused it. A word the table does not name is no act at all.
ACTS=(run:pr pr:pr review:pr plan:plan merge:merge postmerge:merge approve:full)
# The one author whose receipt counts for pr-ready: anybody can comment on a pull request of a
# public repo, and a receipt somebody pasted is not a review.
CODEX_LOGIN='chatgpt-codex-connector[bot]'

usage() {
  cat >&2 <<'USAGE'
usage: sdd-worker <verb> <args>
  delegate <campaign-dir>                      show the delegation, ask, and sign it
  level    <campaign-dir> [--lot L<n>]         the effective level of autonomy, with the reason
  allows   <campaign-dir> <act> --lot L<n>     whether the act fits the effective level of its lot
  budget   <campaign-dir>                      the campaign's spend against its ceilings
  next     <campaign-dir>                      the next act of the campaign
  pr-ready <mission-dir> <pr>                  whether the pull request is ready on its head sha
USAGE
}

# now — the local instant, to the minute. ONE clock for every verb. SDD_WORKER_NOW replaces the
# real clock only when it is LATER than it: the seam lets the sensor move time forward and watch a
# delegation expire, and never brings an expired one back. The two instants are compared by their
# digits, never as text under the locale's collation; a value with no digits fails the test and
# leaves the real clock.
now() {
  local real seam="${SDD_WORKER_NOW:-}"
  real="$(date '+%Y-%m-%d %H:%M')"
  if [ "${seam//[!0-9]/}" -gt "${real//[!0-9]/}" ] 2>/dev/null; then
    printf '%s\n' "$seam"
  else
    printf '%s\n' "$real"
  fi
}

# fm_value <file> <key> — the value of <key> in the frontmatter of <file>: the text after the `: `
# that follows the key on the first line starting with `<key>:`, trailing blanks removed. Prints
# nothing when the file opens with no `---`, when the frontmatter is never closed, or when the key
# is absent; a key whose colon is not followed by a space reads empty. ONE reader for every verb:
# two readers of one fact would let a sabotaged one hide behind the other.
fm_value() {
  awk -v key="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { if (found) print val; exit }
    !found && index($0, key ":") == 1 {
      found = 1; val = ""
      if (index($0, ": ") == length(key) + 1) val = substr($0, length(key) + 3)
      sub(/[ \t\r]+$/, "", val)
    }' "$1"
}

# ladder_rank <name> — the position of <name> on the ladder, 0 for assisted; prints nothing and
# returns 1 when <name> is not exactly one of the five levels. Positive: a level is a level because
# the ladder names it, never because nothing refused it.
ladder_rank() {
  local i
  for i in "${!LADDER[@]}"; do
    [ "${LADDER[$i]}" = "$1" ] && { printf '%s\n' "$i"; return 0; }
  done
  return 1
}

# on_ladder <name> — 0 when <name> is a level. It is ladder_rank and nothing else, so the two can
# never disagree about what a level is.
on_ladder() { ladder_rank "$1" > /dev/null; }

# campaign_name <campaign-dir> — the name of the directory a campaign lives in, resolved: `.`, a
# trailing slash and a symlink all name the directory itself. Empty when it does not resolve.
campaign_name() {
  local p
  p="$(readlink -f -- "$1")" || true
  printf '%s\n' "${p##*/}"
}

# id_is_dir <campaign-dir> <file> — 0 when <file> exists and its campaign: is the name of
# <campaign-dir> (campaign_name); otherwise 1, with both values PUBLISHED in ID_WHY. The contract
# writes the id three times (the directory, campaign.md and delegation.md), and a reader of one of
# them alone lets two campaigns cross: budget summing the missions of one id while next walks the
# queue of another, or the template's placeholder read as an id. ONE rule, for the two files of
# the delegation and for next. Called, never substituted: under `$( )` the reason would die with
# the subshell.
id_is_dir() {
  local name v
  name="$(campaign_name "$1")"
  if [ ! -f "$2" ]; then ID_WHY="$2 does not exist"; return 1; fi
  v="$(fm_value "$2" campaign)"
  if [ "$v" != "$name" ]; then ID_WHY="campaign: '$v' in $2 is not the directory's name '$name'"; return 1; fi
}

# delegation_legible <campaign-dir> — 0 when the six keys of its delegation.md are present and not
# empty, the campaign: of that file and of the campaign.md beside it is the directory's name
# (id_is_dir), the level is on the ladder, expires is a local instant to the minute that the clock
# has — it comes back from `date -d` as it went, so 2026-11-31 and 99:99 are not instants — and
# both ceilings are numbers; otherwise 1, with the first rule that failed PUBLISHED in
# ILLEGIBLE_WHY. Called, never substituted: under `$( )` the reason would die with the subshell. A
# `<…>` placeholder of the template fails one of these rules.
# Declared limit: the comparison of what `date` gives back has no world on GNU date 9, which refuses
# every instant of this shape it does not have (minute 60, hour 24, a gap of summer time, measured)
# and gives the others back as written; it stays for a `date` that rolls 24:00 over to the next day.
delegation_legible() {
  local dir="${1%/}" f k v rt
  f="$dir/delegation.md"
  ILLEGIBLE_WHY=""
  for k in "${DELEGATION_KEYS[@]}"; do
    v="$(fm_value "$f" "$k")"
    if [ -z "$v" ]; then ILLEGIBLE_WHY="$k is missing or empty"; return 1; fi
  done
  for k in delegation.md campaign.md; do
    if ! id_is_dir "$dir" "$dir/$k"; then ILLEGIBLE_WHY="$ID_WHY"; return 1; fi
  done
  v="$(fm_value "$f" level)"
  if ! on_ladder "$v"; then
    ILLEGIBLE_WHY="level '$v' is not on the ladder (${LADDER[*]})"; return 1
  fi
  v="$(fm_value "$f" expires)"
  if ! [[ "$v" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]]; then
    ILLEGIBLE_WHY="expires '$v' is not YYYY-MM-DD HH:MM"; return 1
  fi
  if ! rt="$(date -d "$v" '+%Y-%m-%d %H:%M' 2> /dev/null)" || [ "$rt" != "$v" ]; then
    ILLEGIBLE_WHY="expires '$v' is no instant on the clock"; return 1
  fi
  for k in budget_mission_usd budget_campaign_usd; do
    v="$(fm_value "$f" "$k")"
    if ! [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      ILLEGIBLE_WHY="$k '$v' is not a number"; return 1
    fi
  done
}

# expired <instant> — 0 when <instant> is not after now. Both sides go to their twelve digits and
# are compared as numbers, never as text under the locale's collation.
expired() {
  local n
  n="$(now)"
  [ "${1//[!0-9]/}" -le "${n//[!0-9]/}" ]
}

# delegation_terms <campaign-dir> — what a signature grants, one line each: the six keys of the
# delegation, `key: value` in the order of DELEGATION_KEYS, then one `ceiling <lot>: <ceiling>` per
# row of the lots table of the campaign.md beside it, in the order of the queue (lots_table, the one
# reader of the queue). A lot's ceiling is what keeps its approval from being delegated, and it lives
# in a file the owner does not sign: outside the seal, an edit of the table would lift a capped lot
# to the signed level, or bring in a lot the owner never saw, under a signature that still holds.
# The titles, the counts and the items are not in it, since the campaign strikes them as it goes.
# ONE definition for the three readers: the delegate that shows it and signs its digest, and the
# level that checks it.
delegation_terms() {
  local dir="${1%/}" k l c
  for k in "${DELEGATION_KEYS[@]}"; do printf '%s: %s\n' "$k" "$(fm_value "$dir/delegation.md" "$k")"; done
  while read -r l c; do printf 'ceiling %s: %s\n' "$l" "$c"; done < <(lots_table "$dir/campaign.md")
}

# terms_digest <terms> — the first 12 hex of the sha256 of <terms>, one newline after each line:
# the ONE spelling of the hash, for the terms read now and for the terms the delegate showed.
terms_digest() { printf '%s\n' "$1" | sha256sum | cut -c1-12; }

# delegation_digest <campaign-dir> — the digest of delegation_terms, read now.
delegation_digest() { terms_digest "$(delegation_terms "$1")"; }

# delegation_write_signed <file> <line> — the frontmatter's `signed:` line replaced by <line>, or
# <line> added before the closing `---` when the key is absent. The body is never touched, and the
# file keeps its mode: the new content is written beside it and moved over it.
delegation_write_signed() {
  local f="$1" tmp
  tmp="$(mktemp "${f%/*}/.delegation.XXXXXX")"
  if ! awk -v line="$2" '
         NR == 1 { fm = 1; print; next }
         fm && !done && index($0, "signed:") == 1 { print line; done = 1; next }
         fm && $0 == "---" { if (!done) print line; fm = 0; done = 1 }
         { print }' "$f" > "$tmp" \
     || ! chmod --reference="$f" "$tmp" || ! mv -f "$tmp" "$f"; then
    rm -f "$tmp"
    return 1
  fi
}

# delegate <campaign-dir> — show what a signature grants (the six keys of the delegation and the
# ceiling of each lot, delegation_terms), ask on stderr, read ONE line of stdin, and sign only on a
# yes. It refuses before asking what it could never sign (rc 1): no
# delegation, an illegible one, or one whose instant already passed. The stdin contract is the one
# of `sdd approve`: a pipe is an answer, no TTY is required, and no character at all is not a no —
# nobody was asked — so it is rc 66 and nothing is written. It does not read .sdd/config.sh and it
# does not commit: the commit is the owner's trail, and the line it prints says how.
# It signs what it showed: the terms are kept as they were printed, read again after the yes, and a
# change in between (the owner's editor, a `git pull` in the checkout) signs nothing (rc 1); the
# digest written is the one of the terms shown, so an edit after that re-read leaves a signature the
# file no longer matches, which level reads as edited after signing.
cmd_delegate() {
  [ "$#" -eq 1 ] && [ -d "$1" ] || { usage; return 2; }
  local f="${1%/}/delegation.md" ans="" got=0 id shown
  if [ ! -f "$f" ]; then
    printf 'not signed — no delegation at %s\n' "$f"
    return 1
  fi
  shown="$(delegation_terms "$1")"
  printf '%s\n' "$shown"
  if ! delegation_legible "$1"; then
    printf 'not signed — illegible: %s\n' "$ILLEGIBLE_WHY"
    return 1
  fi
  if expired "$(fm_value "$f" expires)"; then
    printf 'not signed — expired: %s is not after %s\n' "$(fm_value "$f" expires)" "$(now)"
    return 1
  fi
  printf 'Sign this delegation? [y/N] ' >&2
  # `|| got=$?`: with stdin closed `read` returns non-zero, and `set -e` would end the verb here.
  read -r ans || got=$?
  # The prompt ends with no newline; a terminal supplies one on Enter, a pipe does not.
  printf '\n' >&2
  if [ "$got" -ne 0 ] && [ -z "$ans" ]; then
    printf 'not signed — no answer reached the prompt: stdin closed before a character was read\n'
    return 66
  fi
  # A partial line with no newline is an answer that arrived, and it is not a yes.
  [ "$got" -eq 0 ] || ans=""
  case "$ans" in
    y | Y | yes | Yes | YES) : ;;
    *) printf 'not signed — the answer was not y, and nothing was written\n'; return 0 ;;
  esac
  if [ "$(delegation_terms "$1")" != "$shown" ]; then
    printf 'not signed — the delegation changed after it was shown, and nothing was written: run delegate again\n'
    return 1
  fi
  delegation_write_signed "$f" "signed: $(now) $(terms_digest "$shown")"
  id="$(fm_value "$f" campaign)"
  printf 'signed %s — commit it: git add %s && git commit -m "chore(campaign): sign the delegation of %s"\n' \
    "$f" "$f" "$id"
}

# repo_root <dir> — the top of the git checkout that holds <dir>; empty outside one.
repo_root() { git -C "$1" rev-parse --show-toplevel 2>/dev/null || true; }

# config_key <root> <key> [<env>] — the value of <key> in <root>/.sdd/config.sh, read by sourcing the
# file in a subshell, the way the runner loads it: nothing the file sets leaks into this program.
# Empty when there is no root, no file, or no such key. With <env>, the answer is what the runner
# reads when it is launched with <key>=<env> in its environment: the file sources over that value,
# so a line that assigns the key wins and one that does not leaves <env> — and so does no file. The
# caller's own value of <key> never reaches that reading. ONE reader for every key a verb needs.
config_key() {
  local cfg="$1/.sdd/config.sh" key="$2"
  if [ -z "$1" ] || [ ! -f "$cfg" ]; then [ "$#" -lt 3 ] || printf '%s' "$3"; return 0; fi
  # shellcheck disable=SC1090
  ( set +eu; [ "$#" -lt 3 ] || printf -v "$key" '%s' "$3"
    . "$cfg" > /dev/null 2>&1 < /dev/null; printf '%s' "${!key-}" ) || true
}

# lots_table <campaign.md> — one line `<lot> <ceiling>` per row of the table under the `## Lotes`
# heading, in the order of the queue. The two columns are found by their header names (`Lot`,
# `Ceiling`), the separator row is skipped, and the table ends at its first line that is not a
# row. Prints nothing when the file or the table is absent. ONE reader of the queue.
lots_table() {
  [ -f "$1" ] || return 0
  awk '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
    $0 == "## Lotes" { sec = 1; next }
    !sec { next }
    /^## / { exit }
    substr($0, 1, 1) != "|" { if (hdr) exit; next }
    {
      n = split($0, c, "|")
      if (!hdr) {
        for (i = 2; i < n; i++) { h = trim(c[i]); if (h == "Lot") lc = i; if (h == "Ceiling") cc = i }
        hdr = 1; next
      }
      if (trim(c[2]) ~ /^:?-+:?$/) next
      if (lc && cc) print trim(c[lc]), trim(c[cc])
    }' "$1"
}

# effective_level <campaign-dir> [<lot>] — the level the worker may act at, PUBLISHED in LEVEL,
# with the reason in LEVEL_WHY. The first rule that matches decides, in this order, and every rule
# that refuses answers assisted: a delegation that does not hold means "do nothing alone", never
# "do what it says". Called, never substituted: under `$( )` both globals would die with the
# subshell. The lot's ceiling only ever lowers the level.
effective_level() {
  local dir="${1%/}" lot="${2:-}" f signed want exp lv root lots w found="" l c cr sr
  local -a words=()
  f="$dir/delegation.md"
  LEVEL=assisted
  if [ ! -f "$f" ]; then LEVEL_WHY="no delegation: $f does not exist"; return 0; fi
  if ! delegation_legible "$dir"; then LEVEL_WHY="illegible: $ILLEGIBLE_WHY"; return 0; fi
  signed="$(fm_value "$f" signed)"
  if [ -z "$signed" ]; then LEVEL_WHY="unsigned: the signed: line is empty"; return 0; fi
  want="$(delegation_digest "$dir")"
  if [ "${signed##* }" != "$want" ]; then
    LEVEL_WHY="edited after signing: signed ${signed##* }, the six keys and the lot ceilings now give $want"
    return 0
  fi
  exp="$(fm_value "$f" expires)"
  if expired "$exp"; then LEVEL_WHY="expired: $exp is not after $(now)"; return 0; fi
  lv="$(fm_value "$f" level)"
  root="$(repo_root "$dir")"
  if [ "$lv" != assisted ] && [ -z "$(config_key "$root" ON_ESCALATION_CMD)" ]; then
    LEVEL_WHY="no pager: ON_ESCALATION_CMD is empty in ${root:-(no repo)}/.sdd/config.sh"; return 0
  fi
  if [ -n "$lot" ]; then
    lots="$(fm_value "$f" lots)"
    if [ "$lots" != all ]; then
      read -ra words <<< "$lots"
      for w in "${words[@]}"; do [ "$w" = "$lot" ] && found=1; done
      if [ -z "$found" ]; then LEVEL_WHY="lot not covered: $lot is not in lots: $lots"; return 0; fi
    fi
    found=""
    while read -r l c; do
      if [ "$l" = "$lot" ]; then found=1; break; fi
    done < <(lots_table "$dir/campaign.md")
    if [ -z "$found" ]; then
      LEVEL_WHY="lot not covered: $dir/campaign.md has no row for $lot"; return 0
    fi
    if [ "$c" != - ]; then
      if ! cr="$(ladder_rank "$c")"; then
        LEVEL_WHY="capped by the lot: the ceiling '$c' of $lot is not a level"; return 0
      fi
      sr="$(ladder_rank "$lv")"
      if [ "$cr" -lt "$sr" ]; then
        LEVEL="$c"; LEVEL_WHY="capped by the lot: the ceiling of $lot is $c"; return 0
      fi
    fi
  fi
  LEVEL="$lv"
  LEVEL_WHY="signed until $exp"
}

# level <campaign-dir> [--lot L<n>] — the effective level, and why, on one line; rc 0 whatever the
# answer, since assisted is an answer and not an error. A --lot with no lot is a usage error: read
# as no lot, it would answer the uncapped level to a caller that asked about one lot.
cmd_level() {
  local lot=""
  case "$#" in
    1) : ;;
    3) [ "$2" = --lot ] && [ -n "$3" ] || { usage; return 2; }; lot="$3" ;;
    *) usage; return 2 ;;
  esac
  [ -d "$1" ] || { usage; return 2; }
  effective_level "$1" "$lot"
  printf 'level %s — %s\n' "$LEVEL" "$LEVEL_WHY"
}

# act_floor <act> — the lowest level that grants <act>, read from ACTS; prints nothing and returns
# 1 when the table does not name <act> exactly.
act_floor() {
  local e
  for e in "${ACTS[@]}"; do
    [ "${e%%:*}" = "$1" ] && { printf '%s\n' "${e#*:}"; return 0; }
  done
  return 1
}

# allows <campaign-dir> <act> --lot L<n> — whether <act> fits the effective level of the lot: rc 0
# and `allowed`, or rc 1 and `ask`, naming the level the act needs and the reason of the effective
# one, so the owner reads why it came back. A word the table does not name is a usage error (rc 2,
# nothing on stdout): read as any level, it would be allowed at the top. The --lot is required, and
# its absence is a usage error too: every act of a campaign is an act of one lot, the lot's ceiling
# is the act's, and an act asked with no lot would answer the signed level over every ceiling of the
# queue — the argument the session would have to remember is the reading this program takes from it.
# A rank that does not compare asks, never allows: that world is a floor off the ladder, which only
# an edit of ACTS could write, so no probe reaches it from outside.
cmd_allows() {
  local lot="" need
  case "$#" in
    2) printf 'sdd-worker: allows needs --lot L<n>: every act is of one lot, and its ceiling caps the act\n' >&2; usage; return 2 ;;
    4) [ "$3" = --lot ] && [ -n "$4" ] || { usage; return 2; }; lot="$4" ;;
    *) usage; return 2 ;;
  esac
  [ -d "$1" ] || { usage; return 2; }
  if ! need="$(act_floor "$2")"; then
    printf "sdd-worker: '%s' is not an act (%s)\n" "$2" "${ACTS[*]%%:*}" >&2
    usage; return 2
  fi
  effective_level "$1" "$lot"
  if [ "$(ladder_rank "$LEVEL")" -ge "$(ladder_rank "$need")" ] 2>/dev/null; then
    printf 'allowed %s at %s\n' "$2" "$LEVEL"
    return 0
  fi
  printf 'ask %s needs %s, effective %s — %s\n' "$2" "$need" "$LEVEL" "$LEVEL_WHY"
  return 1
}

# ledger_path — the autonomy ledger the runner writes, one JSON line per event, machine-wide: the
# spelling of autonomy_log_path in bin/sdd, so the two never name two files.
ledger_path() { printf '%s/autonomy-log.jsonl' "${SDD_STATE_DIR:-$HOME/.sdd}"; }

# checkouts_of <root> — <root>, then every worktree of its repository, one per line, each once. A
# mission of a campaign runs in a worktree of its own, and its folder reaches the checkout that
# holds the campaign only with the merge: a reader of <root> alone would not see it in flight.
checkouts_of() {
  { printf '%s\n' "$1"; git -C "$1" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p' || true; } \
    | awk '!seen[$0]++'
}

# campaign_mission_dirs <root> <id> — the folder of every copy of every mission of campaign <id>,
# one per line: the folders under HANDOFF_DIR (the root's; docs/handoffs when unset) of every
# checkout of the root's repository whose 00-missao.md declares exactly `campaign: <id>`. ONE
# definition of which missions are a campaign's, for both readers: budget counts their ids, next
# reads their copies. An empty <id> prints nothing, since it would match every mission that belongs
# to no campaign; neither verb reaches that branch (a legible delegation and the campaign.md next
# walks both name their directory, id_is_dir), and it is kept because it decides what an empty id
# answers: no mission, never all.
campaign_mission_dirs() {
  local root="$1" id="$2" hd wt m
  [ -n "$root" ] && [ -n "$id" ] || return 0
  hd="$(config_key "$root" HANDOFF_DIR)"
  hd="${hd:-docs/handoffs}"
  while IFS= read -r wt; do
    for m in "$wt/$hd"/*/00-missao.md; do
      if [ -f "$m" ] && [ "$(fm_value "$m" campaign)" = "$id" ]; then printf '%s\n' "${m%/00-missao.md}"; fi
    done
  done < <(checkouts_of "$root")
}

# campaign_missions <root> <id> — the id of every mission of campaign <id>, one per line, each once:
# the folder names of campaign_mission_dirs, a mission copied in two checkouts counted once.
campaign_missions() {
  local p
  campaign_mission_dirs "$1" "$2" | while IFS= read -r p; do printf '%s\n' "${p##*/}"; done \
    | awk '!seen[$0]++'
}

# budget <campaign-dir> — what the campaign spent against its ceiling: the cost_usd of every ledger
# line whose mission is one of the campaign's (the delegation's campaign:), summed by jq — never by
# awk, whose mawk reads 1.99 as 1 under pt-BR — against budget_campaign_usd, and the mission cap the
# worker passes to `sdd run` as BUDGET_MISSION_USD. Money is printed under LC_ALL=C, two decimals.
# rc 0 below the ceiling; rc 1 at it or above it, and rc 1 for every answer it cannot have — no
# delegation or an illegible one (no ceiling), a directory outside a git checkout or a ledger that
# does not read (no spend): a spend that could not be read is never zero. A missing ledger is the
# one zero, since nothing ran yet. rc 1 too, and no mission cap, when the signed cap is zero, which
# the runner reads as no ceiling: the stop names the delegation, the one place that sets it, before
# any config is read. And when the runner would not apply the signed one: it sources the
# .sdd/config.sh of the checkout it runs in over its environment, so a file that assigns
# BUDGET_MISSION_USD above the signed cap, or to a zero (no ceiling), or to anything that is not a
# number, beats the value the session passes; a value at or below the signed cap is the stricter
# one, and holds. The session launches `sdd run` in the mission's worktree, not
# in the campaign's checkout, and a worktree cut from a commit that still sets the key keeps the
# line the owner deleted here: so the file of every checkout of the repo is read (checkouts_of, the
# set campaign_mission_dirs walks), the campaign's first and every linked worktree after it, whether
# or not it holds a mission of the campaign — the wider set is the fail-safe one — and the first
# that would beat the signed cap is the one the stop names.
# Declared limits: a line is matched by its mission id alone, so a mission of the same id in another
# repo is counted too (the fail-safe side: more spend, an earlier stop); a malformed line is skipped
# (`fromjson?`, as the runner reads the ledger), and its cost with it; the ceiling is read whether or
# not the delegation is signed — whether the worker may act on it is the level's question; an empty
# BUDGET_MISSION_USD in the file stops, though the runner fills it with its default, which may be
# below the signed cap (the fail-safe side: the owner deletes the line); a worktree made after this
# call is not read, and the loop of commands/sdd-worker.md calls budget on every turn, so the turn
# that runs a mission reads the worktree its plan made; a worktree unrelated to the campaign whose
# file beats the cap stops it too (the fail-safe side again: the owner fixes that file, or prunes
# the worktree).
cmd_budget() {
  [ "$#" -eq 1 ] && [ -d "$1" ] || { usage; return 2; }
  local dir="${1%/}" f root cap mcap run wt ledger out
  local -a ms=()
  f="$dir/delegation.md"
  if [ ! -f "$f" ]; then printf 'no ceiling — no delegation: %s does not exist\n' "$f"; return 1; fi
  if ! delegation_legible "$dir"; then printf 'no ceiling — illegible: %s\n' "$ILLEGIBLE_WHY"; return 1; fi
  mcap="$(fm_value "$f" budget_mission_usd)"
  # A legible cap is digits with an optional fraction, so it is above zero when a digit is.
  if ! [[ "$mcap" =~ [1-9] ]]; then
    printf 'no mission cap — %s signs budget_mission_usd: %s, which sdd run reads as no ceiling;' "$f" "$mcap"
    printf ' sign a cap above 0\n'
    return 1
  fi
  root="$(repo_root "$dir")"
  if [ -z "$root" ]; then printf 'no spend — %s is not inside a git checkout\n' "$dir"; return 1; fi
  while IFS= read -r wt; do
    run="$(config_key "$wt" BUDGET_MISSION_USD "$mcap")"
    if ! jq -en --arg r "$run" --arg s "$mcap" '($r | tonumber) as $r | $r > 0 and $r <= ($s | tonumber)' \
         > /dev/null 2>&1; then
      printf 'no mission cap — %s sets BUDGET_MISSION_USD=%s, which sdd run applies over the signed' \
        "$wt/.sdd/config.sh" "$run"
      printf ' budget_mission_usd: %s; delete the line, or set it above 0 and at most that\n' "$mcap"
      return 1
    fi
  done < <(checkouts_of "$root")
  mapfile -t ms < <(campaign_missions "$root" "$(fm_value "$f" campaign)")
  cap="$(fm_value "$f" budget_campaign_usd)"
  ledger="$(ledger_path)"
  [ -e "$ledger" ] || ledger=/dev/null
  if ! out="$(jq -nrR --arg cap "$cap" --args '
         [inputs | fromjson? | select(type == "object" and (.mission | IN($ARGS.positional[])))
          | .cost_usd | numbers] | add // 0
         | "\(.) \(. >= ($cap | tonumber))"' ${ms[@]+"${ms[@]}"} < "$ledger")"; then
    printf 'no spend — the ledger %s does not read\n' "$ledger"; return 1
  fi
  LC_ALL=C printf 'campaign US$ %.2f of %.2f — %d mission(s); mission cap US$ %.2f\n' \
    "${out% *}" "$cap" "${#ms[@]}" "$mcap"
  if [ "${out##* }" = true ]; then return 1; fi
}

# approved <00-missao.md> — 0 when its aprovacao: is one the runner's gate_PLAN admits: auto, or
# humano-<date>. Positive, and the runner's own grammar: an empty value, or the template's
# placeholder, is a plan nobody approved.
approved() {
  case "$(fm_value "$1" aprovacao)" in auto | humano-*) return 0 ;; *) return 1 ;; esac
}

# lot_of <lot> <mission-dir...> — PUBLISHES LOT_DIRS, every copy among <mission-dir...> whose
# 00-missao.md declares exactly `lot: <lot>`, and LOT_IDS, their distinct mission ids. Called, never
# substituted: under `$( )` both arrays would die with the subshell.
lot_of() {
  local lot="$1" p i seen
  shift
  LOT_DIRS=(); LOT_IDS=()
  for p in "$@"; do
    [ "$(fm_value "$p/00-missao.md" lot)" = "$lot" ] || continue
    LOT_DIRS+=("$p")
    seen=""
    for i in ${LOT_IDS[@]+"${LOT_IDS[@]}"}; do [ "$i" != "${p##*/}" ] || seen=1; done
    [ -n "$seen" ] || LOT_IDS+=("${p##*/}")
  done
}

# pr_states <root> <branch> — the pull requests whose head is <branch>, PUBLISHED in PR_STATES as one
# `<number> <state>` per line, from `gh pr list --head <branch> --state all --json number,state` run
# at <root>, the checkout gh infers the repository from. Returns 1, with the reason in GH_WHY, when
# gh failed or answered anything but one array whose every element has a state of OPEN, CLOSED or
# MERGED — an empty answer included: an answer that was not read is never "no pull request", which
# would send a lot to run again. An element that is not an object makes jq itself fail on `.state`,
# so no rule of its own says so; the number is only printed.
pr_states() {
  local out rc=0
  out="$(CDPATH='' cd -- "$1" && gh pr list --head "$2" --state all --json number,state)" || rc=$?
  if [ "$rc" -ne 0 ]; then GH_WHY="gh pr list --head $2 failed (rc $rc)"; return 1; fi
  if ! PR_STATES="$(jq -rn 'input
         | if type == "array" and all(.[]; .state | IN("OPEN", "CLOSED", "MERGED"))
           then .[] | "\(.number) \(.state)" else error("off the contract") end' 2> /dev/null <<< "$out")"; then
    GH_WHY="gh pr list --head $2 answered no array of pull requests in a known state: '${out:0:80}'"
    return 1
  fi
}

# next <campaign-dir> — the next act of the campaign, from the queue, the missions on disk and gh.
# It walks the lots of campaign.md in the order of the table and stops at the first one not merged:
# no mission → plan; a mission not approved → approve; approved with no pull request → run; a pull
# request open → review; only closed ones → stop. A merged pull request makes the lot done, and a
# queue whose every lot is merged is done. When the act is run or review and the lot after it has no
# mission, a second line says the session may plan that one ahead. rc 0; rc 1 when the line is
# stop; rc 3, and no act at all, when gh did not answer. What next cannot decide stops it, naming
# why: no campaign.md, a campaign: that is not the directory's name (id_is_dir: an empty one and the
# template's placeholder among them), a directory outside a git checkout, an empty queue, two
# missions on one lot, and an approved mission with no branch — `gh pr list --head ''` lists every
# pull request of the repo, and one merged anywhere would read as this lot's.
# A mission is found as budget finds them, in the campaign's checkout and in every linked worktree,
# so a lot in flight is never planned again. Copies of one mission are one mission, approved only
# when every copy is: approve is the act the ladder grants last, run is not. Declared limit: the
# branch read is the first copy's that names one.
cmd_next() {
  [ "$#" -eq 1 ] && [ -d "$1" ] || { usage; return 2; }
  local dir="${1%/}" cf id root l i m p branch act="" ahead="" n s merged open closed
  local -a lots=() dirs=()
  cf="$dir/campaign.md"
  if [ ! -f "$cf" ]; then printf 'stop - - — no campaign: %s does not exist\n' "$cf"; return 1; fi
  if ! id_is_dir "$dir" "$cf"; then printf 'stop - - — illegible: %s\n' "$ID_WHY"; return 1; fi
  id="$(fm_value "$cf" campaign)"
  root="$(repo_root "$dir")"
  if [ -z "$root" ]; then printf 'stop - - — %s is not inside a git checkout\n' "$dir"; return 1; fi
  while read -r l _; do lots+=("$l"); done < <(lots_table "$cf")
  if [ "${#lots[@]}" -eq 0 ]; then
    printf 'stop - - — the queue is empty: no row under ## Lotes in %s\n' "$cf"; return 1
  fi
  mapfile -t dirs < <(campaign_mission_dirs "$root" "$id")
  for i in "${!lots[@]}"; do
    l="${lots[$i]}"
    lot_of "$l" ${dirs[@]+"${dirs[@]}"}
    if [ "${#LOT_IDS[@]}" -eq 0 ]; then act="plan $l - — no mission of campaign $id declares lot: $l"; break; fi
    if [ "${#LOT_IDS[@]}" -gt 1 ]; then
      act="stop $l - — more than one mission declares lot: $l (${LOT_IDS[*]})"; break
    fi
    m="${LOT_IDS[0]}"
    for p in "${LOT_DIRS[@]}"; do
      if ! approved "$p/00-missao.md"; then
        act="approve $l $m — not approved: $p/00-missao.md has aprovacao: '$(fm_value "$p/00-missao.md" aprovacao)'"
        break
      fi
    done
    [ -z "$act" ] || break
    branch=""
    for p in "${LOT_DIRS[@]}"; do
      branch="$(fm_value "$p/00-missao.md" branch)"
      [ -z "$branch" ] || break
    done
    if [ -z "$branch" ]; then act="stop $l $m — the mission names no branch: ${LOT_DIRS[0]}/00-missao.md"; break; fi
    if ! pr_states "$root" "$branch"; then
      printf 'sdd-worker: %s — no act is named: an answer that was not read is never "no pull request"\n' \
        "$GH_WHY" >&2
      return 3
    fi
    merged=""; open=""; closed=""
    while read -r n s; do
      case "$s" in MERGED) merged="$merged #$n" ;; OPEN) open="$open #$n" ;; CLOSED) closed="$closed #$n" ;; esac
    done <<< "$PR_STATES"
    if [ -n "$merged" ]; then continue; fi
    if [ -n "$open" ]; then act="review $l $m — pull request$open is open on $branch"
    elif [ -n "$closed" ]; then act="stop $l $m — pull request closed without merge:$closed"
    else act="run $l $m — approved, and no pull request has the head $branch"
    fi
    break
  done
  [ -n "$act" ] || act="done - - — every lot of the queue is merged (${#lots[@]} lot(s))"
  case "$act" in
    run\ * | review\ *)
      if [ "$((i + 1))" -lt "${#lots[@]}" ]; then
        lot_of "${lots[$((i + 1))]}" ${dirs[@]+"${dirs[@]}"}
        [ "${#LOT_IDS[@]}" -gt 0 ] || ahead="ahead plan ${lots[$((i + 1))]}"
      fi ;;
  esac
  printf '%s\n' "$act"
  [ -z "$ahead" ] || printf '%s\n' "$ahead"
  case "$act" in stop\ *) return 1 ;; esac
}

# newest_round <mission-dir> — the 40-review-r<N>.md of highest N, compared as a number: r10 is newer
# than r9, which a glob sorts the other way. Prints nothing when there is none.
newest_round() {
  local f n best=-1 out=""
  for f in "$1"/40-review-r*.md; do
    n="${f##*/40-review-r}"; n="${n%.md}"
    [[ "$n" =~ ^[0-9]+$ ]] || continue
    if [ "$n" -gt "$best" ]; then best="$n"; out="$f"; fi
  done
  [ -z "$out" ] || printf '%s\n' "$out"
}

# GRADE_ROW_AWK — cells(<row>, <array>): the cells of a row of the grade table, split as the runner's
# gate_REVIEW splits it (the escaped_pipe and the rejoin of bin/sdd, copied): GFM writes a pipe
# inside a cell as `\|`, so a piece whose run of trailing backslashes is ODD is joined to the next,
# its last backslash given back as the pipe; an EVEN run (`\\`, a literal backslash) sits against a
# real delimiter. The array is emptied first, since it is the caller's: a row with fewer cells
# would read the cells the row before it left.
# Cut at every `|`, a criterion holding `\|` moved a B out of the Grade column and left an A there,
# and the fill-in `<why \| in one sentence>` was judged by `<why \`, which reads as a sentence:
# both pass a round gate_REVIEW refuses. tests/check-worker.sh reads the runner's split out of
# bin/sdd and holds the two equal on the same rows (its `pipe:` family).
GRADE_ROW_AWK='
function escaped_pipe(s,   t) { t = s; sub(/\\+$/, "", t); return (length(s) - length(t)) % 2 }
function cells(row, f,   raw, rawn, i, n) {
  split("", f)
  rawn = split(row, raw, "|")
  n = 0
  for (i = 1; i <= rawn; i++) {
    if (n > 0 && escaped_pipe(f[n])) { sub(/\\$/, "|", f[n]); f[n] = f[n] raw[i] }
    else { f[++n] = raw[i] }
  }
}
'

# round_grades <round> — the Grade cell of every row of the table under `### Overall Grade`, one per
# line, read as the runner's gate_REVIEW reads it: the third column of the row as cells() splits it,
# a row indented or not, its bold and code-span marks removed; the header row and the separator are
# skipped, and the read ends at the next heading. An empty cell prints <empty>. Prints nothing when
# the section has no row.
round_grades() {
  awk "$GRADE_ROW_AWK"'
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
    /^###[ \t]+Overall Grade/ { sec = 1; next }
    !sec { next }
    /^#+[ \t]/ { exit }
    $0 !~ /^[ \t]*\|/ { next }
    {
      cells($0, c)
      g = c[3]; gsub(/[*`]/, "", g); g = trim(g)
      if (g == "Grade" || g ~ /^:?-+:?$/) next
      print (g == "" ? "<empty>" : g)
    }' "$1"
}

# PLACEHOLDER_AWK — a COPY of the runner's (PLACEHOLDER_AWK in bin/sdd, the rule gate_REVIEW applies
# to every Rationale cell and to the gate: of a round): the refused set of fill-ins, written by a
# model in place of a sentence. The rule lives in two programs, so tests/check-worker.sh reads the
# runner's out of bin/sdd and holds the two equal on the same cells (its `rationale:` family): a
# change to one that the other does not follow turns the sensor red. The function is the runner's,
# line for line; its comments are shortened.
PLACEHOLDER_AWK='
# Refused: an EMPTY cell; the whole cell wrapped in angle brackets, which is how the `### Overall
# Grade` table of templates/review.md ships its fill-ins; a bare ellipsis; and the bare fill-in
# words below. It targets the WHOLE cell, never the presence of a character — a real sentence
# containing <A> is a real sentence. NOT refused: `clean`, `n/a` and `—`, the terse rationales of
# the codereview skill, which mean measured-with-nothing-to-say.
function placeholder(s,   u, w) {
  if (s == "") return 1
  if (s ~ /^<.*>$/) return 1
  u = toupper(s)
  # `—` is E2 80 94 and mawk is byte-oriented, so the rule below sees three bytes with no letter.
  if (s == "—") return 0
  # A cell with no letter and no digit says nothing: `-`, `?`, `.`, `--`, `...` and `…`.
  if (u !~ /[[:alnum:]]/) return 1
  # The WORD, not the spelling: `TODO:` and `TBD.` are the bare words with punctuation.
  w = u; gsub(/[^[:alnum:]]/, "", w)
  if (w == "PREENCHER" || w == "TODO" || w == "TBD" || w == "FIXME" || w == "XXX" ||
      w == "WIP" || w == "FILLME") return 1
  return 0
}
'
# placeholder <text> — rc 0 when <text> is a fill-in that says nothing, by the copy above. Through
# ENVIRON and never `awk -v`, which runs escape sequences.
placeholder() { SDD_PLACEHOLDER_TEXT="$1" awk "$PLACEHOLDER_AWK"' BEGIN { exit placeholder(ENVIRON["SDD_PLACEHOLDER_TEXT"]) ? 0 : 1 }'; }

# round_unjustified <round> — the first row under `### Overall Grade` whose Rationale is a fill-in
# (placeholder), as `<criterion><TAB><rationale>`, the rationale read as gate_REVIEW reads it: the
# fourth column of the row as cells() splits it, a `\|` inside it given back as the pipe, its `*`
# and backticks removed, its blanks trimmed, `<empty>` for an empty one. The separator row is
# skipped and the read ends at the next heading, like round_grades. Prints nothing when every row
# is justified.
round_unjustified() {
  awk "$PLACEHOLDER_AWK$GRADE_ROW_AWK"'
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
    /^###[ \t]+Overall Grade/ { sec = 1; next }
    !sec { next }
    /^#+[ \t]/ { exit }
    /^[ \t]*\|/ {
      cells($0, c)
      if (trim(c[2]) ~ /^:?-+:?$/) next
      r = c[4]; gsub(/[*`]/, "", r); r = trim(r)
      if (placeholder(r)) { print trim(c[2]) "\t" (r == "" ? "<empty>" : r); exit }
    }' "$1"
}

# gh_at <root> <args...> — gh run at <root>, the checkout gh infers the repository from; its stdout
# PUBLISHED in GH_OUT and its rc in GH_RC. Returns 1 when gh failed. Called, never substituted.
gh_at() {
  local root="$1"
  shift
  GH_RC=0
  GH_OUT="$(CDPATH='' cd -- "$root" && gh "$@")" || GH_RC=$?
  [ "$GH_RC" -eq 0 ]
}

# gh_unread <what> — the stderr line for an answer gh did not give. The caller leaves rc 3 and
# nothing on stdout: an answer that was not read is never ready, nor a not-ready to set out to fix.
gh_unread() {
  printf 'sdd-worker: %s — no item is named: an answer that was not read is never ready\n' "$1" >&2
}

# pr-ready <mission-dir> <pr> — whether pull request <pr> meets the owner's bar on its head sha:
# `ready <sha>` and rc 0 when the five items hold, else `not-ready <item>: <reason>` and rc 1 for the
# first that fails, in this order:
#   review     the newest 40-review-r<N>.md of the mission folder (by number) grades A in every row
#              of `### Overall Grade`, with no Rationale and no gate: that is a fill-in by the rule
#              of gate_REVIEW (placeholder), and names `reviewed_head: <sha>`, and between that sha
#              and the head only the mission folder changed — renames not followed, so a move into
#              the folder is a change outside it;
#   codex      the newest receipt (`codex-review-state:v1`) the Codex bot left on the pull request,
#              read from every page, is for the head, completed, with no unresolved finding;
#   threads    every review thread is resolved, and every one was read;
#   mergeable  the pull request is OPEN and MERGEABLE;
#   head       the local HEAD of the mission's checkout is the head.
# rc 3, and nothing on stdout, when gh failed or answered off its contract. The `ready` line carries
# the sha the caller passes to `gh pr merge --merge --match-head-commit`; the method (a merge commit,
# never a squash) is the merging command's, not this verb's. No bot's review is read but the Codex
# state, so a bot with no quota neither blocks nor counts as a review. The `reviewed_head:` key is the
# worker's own round's: a round the runner's REVIEW phase wrote names no head, and is not ready.
# Declared limits: the round is read from the disk of the checkout as it stands — the head item
# proves the checkout is at the head, not that its tree is clean; a path git still quotes under
# core.quotePath=false (a control byte, a quote or a backslash in its name) never matches the mission
# folder, the fail-safe side; and only the first hundred threads are read, which is why a pull request
# with more is not ready.
cmd_pr_ready() {
  [ "$#" -eq 2 ] && [ -d "$1" ] && [[ "$2" =~ ^[1-9][0-9]*$ ]] || { usage; return 2; }
  local dir="${1%/}" pr="$2" root view head state mergeable round rh g unjust gv prefix changed p repo verdict
  local threads open total seen unseen here
  local -a grades=()
  root="$(repo_root "$dir")"
  if [ -z "$root" ]; then printf 'not-ready review: %s is not inside a git checkout\n' "$dir"; return 1; fi
  if ! gh_at "$root" pr view "$pr" --json headRefOid,mergeable,state; then
    gh_unread "gh pr view $pr failed (rc $GH_RC)"; return 3
  fi
  # A head that is not a full sha, or no object at all, makes jq fail; a state or a mergeability
  # that is absent reads null, which the mergeable item refuses.
  if ! view="$(jq -rn 'input | if (.headRefOid | test("^[0-9a-f]{40}$"))
           then "\(.headRefOid) \(.state) \(.mergeable)" else error("off the contract") end' 2> /dev/null <<< "$GH_OUT")"; then
    gh_unread "gh pr view $pr answered no pull request with a full head sha: '${GH_OUT:0:80}'"; return 3
  fi
  read -r head state mergeable <<< "$view"

  round="$(newest_round "$dir")"
  if [ -z "$round" ]; then printf 'not-ready review: no 40-review-r<N>.md in %s\n' "$dir"; return 1; fi
  rh="$(fm_value "$round" reviewed_head)"
  if [ -z "$rh" ]; then
    printf 'not-ready review: the newest round names no head — %s has no reviewed_head:\n' "$round"; return 1
  fi
  if ! [[ "$rh" =~ ^[0-9a-f]{7,40}$ ]] || ! git -C "$root" rev-parse -q --verify "$rh^{commit}" > /dev/null; then
    printf "not-ready review: the reviewed head '%s' of %s is no commit of this checkout\n" "$rh" "$round"; return 1
  fi
  mapfile -t grades < <(round_grades "$round")
  if [ "${#grades[@]}" -eq 0 ]; then
    printf 'not-ready review: %s has no grade under ### Overall Grade\n' "$round"; return 1
  fi
  for g in "${grades[@]}"; do
    if [ "$g" != A ]; then printf 'not-ready review: %s grades %s, and every row must read A\n' "$round" "$g"; return 1; fi
  done
  unjust="$(round_unjustified "$round")"
  if [ -n "$unjust" ]; then
    printf 'not-ready review: %s: %s grades A with a placeholder rationale (%s) — a grade no sentence supports is a label\n' \
      "$round" "${unjust%%$'\t'*}" "${unjust#*$'\t'}"
    return 1
  fi
  # The gate: by the same rule, its surrounding quotes stripped as the runner's frontmatter reader
  # does. Absent reads empty, and fails: gate_REVIEW leaves an absent gate: alone for the rounds that
  # predate the key, and a round that names reviewed_head: is the worker's own, made from the template.
  gv="$(fm_value "$round" gate)"; gv="${gv#[\"\']}"; gv="${gv%[\"\']}"
  if placeholder "$gv"; then
    printf "not-ready review: the gate: of %s is a placeholder or absent ('%s') — it carries the evidence the round closed\n" \
      "$round" "$gv"
    return 1
  fi
  prefix="$(git -C "$dir" rev-parse --show-prefix)"
  if [ -z "$prefix" ]; then
    printf 'not-ready review: the mission folder %s is the root of its checkout\n' "$dir"; return 1
  fi
  if ! changed="$(git -C "$root" -c core.quotePath=false diff --no-renames --name-only "$rh" "$head" 2> /dev/null)"; then
    printf 'not-ready review: git diff %s %s does not run here — is the pull request head fetched?\n' "$rh" "$head"
    return 1
  fi
  while IFS= read -r p; do
    if [ -n "$p" ] && [[ "$p" != "$prefix"* ]]; then
      printf 'not-ready review: %s changed after the reviewed head %s, outside %s\n' "$p" "$rh" "$prefix"; return 1
    fi
  done <<< "$changed"

  if ! gh_at "$root" repo view --json nameWithOwner -q .nameWithOwner; then
    gh_unread "gh repo view failed (rc $GH_RC)"; return 3
  fi
  repo="$GH_OUT"
  if ! [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    gh_unread "gh repo view answered '${repo:0:80}', not <owner>/<name>"; return 3
  fi
  if ! gh_at "$root" api --paginate "repos/$repo/issues/$pr/comments"; then
    gh_unread "gh api --paginate repos/$repo/issues/$pr/comments failed (rc $GH_RC)"; return 3
  fi
  # The pages are arrays, one after the other, as --paginate prints them; a comment of another shape
  # makes jq fail. A receipt whose state does not parse is a receipt that says nothing — never one to
  # skip, which would let an older receipt decide.
  if ! verdict="$(jq -rn --arg head "$head" --arg login "$CODEX_LOGIN" '
         [inputs] | if length > 0 and all(.[]; type == "array") then [.[][]] else error("off the contract") end
         | [.[] | select(.user.login == $login) | .body
            | capture("codex-review-state:v1 (?<s>\\{.*\\}) -->").s | (fromjson? // {}) | .code_review]
         | last
         | if . == null then "no receipt of \($login) on the pull request"
           elif .commit_sha != $head then "the newest receipt of \($login) is for \(.commit_sha), not the head \($head)"
           elif .status != "completed" then "the newest receipt of \($login) is \(.status), not completed"
           elif .has_unresolved_findings != false then "the newest receipt of \($login) has unresolved findings (\(.has_unresolved_findings))"
           else "ok" end' 2> /dev/null <<< "$GH_OUT")"; then
    gh_unread "gh api --paginate repos/$repo/issues/$pr/comments answered no pages of comments: '${GH_OUT:0:80}'"
    return 3
  fi
  if [ "$verdict" != ok ]; then printf 'not-ready codex: %s\n' "$verdict"; return 1; fi

  if ! gh_at "$root" api graphql -f \
       "query=query{repository(owner:\"${repo%%/*}\",name:\"${repo#*/}\"){pullRequest(number:$pr){reviewThreads(first:100){totalCount nodes{isResolved}}}}}"; then
    gh_unread "gh api graphql (the review threads of #$pr) failed (rc $GH_RC)"; return 3
  fi
  if ! threads="$(jq -rn 'input | .data.repository.pullRequest.reviewThreads
         | if (.totalCount | type) == "number" and (.nodes | type) == "array"
              and all(.nodes[]; (.isResolved | type) == "boolean")
           then "\([.nodes[] | select(.isResolved == false)] | length) \(.totalCount) \(.nodes | length) \((.nodes | length) < .totalCount)"
           else error("off the contract") end' 2> /dev/null <<< "$GH_OUT")"; then
    gh_unread "gh api graphql answered no review threads of #$pr: '${GH_OUT:0:80}'"; return 3
  fi
  read -r open total seen unseen <<< "$threads"
  if [ "$open" -ne 0 ]; then
    printf 'not-ready threads: %s of %s review thread(s) not resolved\n' "$open" "$total"; return 1
  fi
  if [ "$unseen" != false ]; then
    printf 'not-ready threads: %s of %s review threads read, the rest unseen\n' "$seen" "$total"; return 1
  fi

  if [ "$state" != OPEN ] || [ "$mergeable" != MERGEABLE ]; then
    printf 'not-ready mergeable: the pull request is %s and %s, not OPEN and MERGEABLE\n' "$state" "$mergeable"
    return 1
  fi

  here="$(git -C "$root" rev-parse -q --verify HEAD || true)"
  if [ "$here" != "$head" ]; then
    printf 'not-ready head: the local HEAD %s is not the pull request head %s\n' "${here:-(none)}" "$head"; return 1
  fi
  printf 'ready %s\n' "$head"
}

main() {
  case "${1:-}" in
    delegate) shift; cmd_delegate "$@" ;;
    level) shift; cmd_level "$@" ;;
    allows) shift; cmd_allows "$@" ;;
    budget) shift; cmd_budget "$@" ;;
    next) shift; cmd_next "$@" ;;
    pr-ready) shift; cmd_pr_ready "$@" ;;
    *) usage; return 2 ;;
  esac
}

{ main "$@"; exit $?; }
