#!/usr/bin/env bash
# sdd-worker — the verbs of the campaign worker (ADR 0022).
#
# The worker is a SESSION that orchestrates a campaign: it plans, approves, runs `sdd run`, opens
# the pull request, reviews it and merges, inside a level of autonomy the owner signed. The
# questions that decide those acts used to be the model's reading, and the reading was wrong four
# times on record (a Codex receipt matched by the hour instead of the sha, a watcher whose `pgrep -f`
# matched itself, a bot with no quota read as "reviewed", a checker that read 20 of 21 units). This
# program answers them from artifacts instead:
#
#   delegate   show a campaign's delegation, ask, and sign it
#   level      the effective level of autonomy, with the reason
#   allows     whether one act fits that level
#   budget     what the campaign spent against its two ceilings
#   next       the next act of the campaign
#   pr-ready   whether a pull request meets the owner's five-item bar on its head sha
#
# Every verb but `delegate` only reads. None of them acts: launching `sdd run`, opening the pull
# request and merging stay with the session, through the commands that already exist.
# The runner (`bin/sdd`) owns ONE mission; this program owns the campaign and never writes what the
# runner owns. The sensor is tests/check-worker.sh.
set -euo pipefail

# The ladder of autonomy, lowest first, ONE definition: a name outside it is not a level.
LADDER=(assisted pr plan merge full)
# The six keys of a delegation, in the order the digest reads them. `signed:` is not among them: it
# is where the digest is written.
DELEGATION_KEYS=(campaign level lots expires budget_mission_usd budget_campaign_usd)

usage() {
  cat >&2 <<'USAGE'
usage: sdd-worker <verb> <args>
  delegate <campaign-dir>                      show the delegation, ask, and sign it
  level    <campaign-dir> [--lot L<n>]         the effective level of autonomy, with the reason
  allows   <campaign-dir> <act> [--lot L<n>]   whether the act fits the effective level
  budget   <campaign-dir>                      the campaign's spend against its ceilings
  next     <campaign-dir>                      the next act of the campaign
  pr-ready <mission-dir> <pr>                  whether the pull request is ready on its head sha
USAGE
}

# now — the local instant, to the minute. ONE clock for every verb.
now() { date '+%Y-%m-%d %H:%M'; }

# fm_value <file> <key> — the value of <key> in the frontmatter of <file>: the text after the `: `
# that follows the key on the first line starting with `<key>:`, trailing blanks removed. Prints
# nothing when the file opens with no `---`, when the frontmatter is never closed, or when the key
# is absent; a key whose colon is not followed by a space reads empty. ONE reader for every verb:
# two readers of one fact would let a sabotaged one hide behind the other.
fm_value() {
  awk -v key="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { if (found) print val; exit }
    !found && index($0, key ":") == 1 {
      found = 1; val = ""
      if (index($0, ": ") == length(key) + 1) val = substr($0, length(key) + 3)
      sub(/[ \t\r]+$/, "", val)
    }' "$1"
}

# on_ladder <name> — 0 when <name> is exactly one of the five levels. Positive: a level is a level
# because the ladder names it, never because nothing refused it.
on_ladder() {
  local l
  for l in "${LADDER[@]}"; do [ "$l" = "$1" ] && return 0; done
  return 1
}

# delegation_legible <file> — 0 when the six keys are present and not empty, the level is on the
# ladder, expires is a local instant to the minute and both ceilings are numbers; otherwise 1, with
# the first rule that failed PUBLISHED in ILLEGIBLE_WHY. Called, never substituted: under `$( )` the
# reason would die with the subshell. A `<…>` placeholder of the template fails one of these rules.
delegation_legible() {
  local f="$1" k v
  ILLEGIBLE_WHY=""
  for k in "${DELEGATION_KEYS[@]}"; do
    v="$(fm_value "$f" "$k")"
    if [ -z "$v" ]; then ILLEGIBLE_WHY="$k is missing or empty"; return 1; fi
  done
  v="$(fm_value "$f" level)"
  if ! on_ladder "$v"; then
    ILLEGIBLE_WHY="level '$v' is not on the ladder (${LADDER[*]})"; return 1
  fi
  v="$(fm_value "$f" expires)"
  if ! [[ "$v" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}$ ]]; then
    ILLEGIBLE_WHY="expires '$v' is not YYYY-MM-DD HH:MM"; return 1
  fi
  for k in budget_mission_usd budget_campaign_usd; do
    v="$(fm_value "$f" "$k")"
    if ! [[ "$v" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      ILLEGIBLE_WHY="$k '$v' is not a number"; return 1
    fi
  done
}

# expired <instant> — 0 when <instant> is not after now. Both sides go to their twelve digits and
# are compared as numbers, never as text under the locale's collation.
expired() {
  local n
  n="$(now)"
  [ "${1//[!0-9]/}" -le "${n//[!0-9]/}" ]
}

# delegation_digest <file> — the first 12 hex of the sha256 of the six keys, each written
# `key: value` and a newline, in the order of DELEGATION_KEYS. ONE definition for both readers: the
# `delegate` that writes it and the `level` that checks it.
delegation_digest() {
  local k
  for k in "${DELEGATION_KEYS[@]}"; do printf '%s: %s\n' "$k" "$(fm_value "$1" "$k")"; done \
    | sha256sum | cut -c1-12
}

# delegation_write_signed <file> <line> — the frontmatter's `signed:` line replaced by <line>, or
# <line> added before the closing `---` when the key is absent. The body is never touched, and the
# file keeps its mode: the new content is written beside it and moved over it.
delegation_write_signed() {
  local f="$1" tmp
  tmp="$(mktemp "${f%/*}/.delegation.XXXXXX")"
  if ! awk -v line="$2" '
         NR == 1 { fm = 1; print; next }
         fm && !done && index($0, "signed:") == 1 { print line; done = 1; next }
         fm && $0 == "---" { if (!done) print line; fm = 0; done = 1 }
         { print }' "$f" > "$tmp" \
     || ! chmod --reference="$f" "$tmp" || ! mv -f "$tmp" "$f"; then
    rm -f "$tmp"
    return 1
  fi
}

# delegate <campaign-dir> — show the six keys of the delegation, ask on stderr, read ONE line of
# stdin, and sign only on a yes. It refuses before asking what it could never sign (rc 1): no
# delegation, an illegible one, or one whose instant already passed. The stdin contract is the one
# of `sdd approve`: a pipe is an answer, no TTY is required, and no character at all is not a no —
# nobody was asked — so it is rc 66 and nothing is written. It does not read .sdd/config.sh and it
# does not commit: the commit is the owner's trail, and the line it prints says how.
cmd_delegate() {
  [ "$#" -eq 1 ] && [ -d "$1" ] || { usage; return 2; }
  local f="${1%/}/delegation.md" k ans="" got=0 id
  if [ ! -f "$f" ]; then
    printf 'not signed — no delegation at %s\n' "$f"
    return 1
  fi
  for k in "${DELEGATION_KEYS[@]}"; do printf '%s: %s\n' "$k" "$(fm_value "$f" "$k")"; done
  if ! delegation_legible "$f"; then
    printf 'not signed — illegible: %s\n' "$ILLEGIBLE_WHY"
    return 1
  fi
  if expired "$(fm_value "$f" expires)"; then
    printf 'not signed — expired: %s is not after %s\n' "$(fm_value "$f" expires)" "$(now)"
    return 1
  fi
  printf 'Sign this delegation? [y/N] ' >&2
  # `|| got=$?`: with stdin closed `read` returns non-zero, and `set -e` would end the verb here.
  read -r ans || got=$?
  # The prompt ends with no newline; a terminal supplies one on Enter, a pipe does not.
  printf '\n' >&2
  if [ "$got" -ne 0 ] && [ -z "$ans" ]; then
    printf 'not signed — no answer reached the prompt: stdin closed before a character was read\n'
    return 66
  fi
  # A partial line with no newline is an answer that arrived, and it is not a yes.
  [ "$got" -eq 0 ] || ans=""
  case "$ans" in
    y | Y | yes | Yes | YES) : ;;
    *) printf 'not signed — the answer was not y, and nothing was written\n'; return 0 ;;
  esac
  delegation_write_signed "$f" "signed: $(now) $(delegation_digest "$f")"
  id="$(fm_value "$f" campaign)"
  printf 'signed %s — commit it: git add %s && git commit -m "chore(campaign): sign the delegation of %s"\n' \
    "$f" "$f" "$id"
}

main() {
  case "${1:-}" in
    delegate) shift; cmd_delegate "$@" ;;
    level | allows | budget | next | pr-ready)
      printf 'sdd-worker: %s is not implemented yet\n' "$1" >&2
      return 2 ;;
    *) usage; return 2 ;;
  esac
}

{ main "$@"; exit $?; }
