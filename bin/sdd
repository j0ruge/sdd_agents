#!/usr/bin/env bash
#
# sdd — runner do pipeline de agentes autônomos de desenvolvimento.
#
# Princípio central: NÃO existe arquivo de estado. A fase corrente é DERIVADA dos artefatos
# em disco. Isso dá resume de graça depois de qualquer morte de sessão e elimina a classe de
# bug "o estado mente sobre o disco".
#
# Princípio nº 2: sucesso nunca é a resposta do modelo. Todo gate é reavaliado aqui — rodando
# os testes, fazendo grep no checkpoint, consultando o git log, chamando o gh.
#
# Uso: sdd <comando> [missão] [opções]   ·   `sdd help` para a lista.

set -euo pipefail

readonly SDD_VERSION="0.1.0"

# Arrays associativos (cache de sensores) exigem bash 4. macOS entrega bash 3.2 como /bin/bash;
# falhar aqui é melhor do que falhar com "bad substitution" no meio de uma fase.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  printf 'erro: sdd exige bash 4+ (encontrado: %s). No macOS: brew install bash\n' \
    "${BASH_VERSION:-desconhecido}" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# Resolução do SDD_HOME (aguenta ser chamado por symlink em ~/.local/bin)
# ---------------------------------------------------------------------------
_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    if [[ $src != /* ]]; then src="$dir/$src"; fi
  done
  cd -P "$(dirname "$src")/.." && pwd
}
SDD_HOME="$(_resolve_self)"
readonly SDD_HOME

# ---------------------------------------------------------------------------
# Saída
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=''; C_DIM=''; C_BOLD=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''
fi

info() { printf '%s\n' "$*"; }
step() { printf '%s▸%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()   { printf '%s  ok%s   %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s  aviso%s %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
bad()  { printf '%s  falha%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
die()  { printf '%serro:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Repo-alvo e configuração
# ---------------------------------------------------------------------------
REPO_ROOT=""
CONFIG_FILE=""

resolve_repo_root() {
  REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "não estou dentro de um repositório git (cwd: $PWD)"
  CONFIG_FILE="$REPO_ROOT/.sdd/config.sh"
}

# Defaults + validação. Chave obrigatória vazia falha AQUI, antes de gastar sessão.
load_config() {
  resolve_repo_root
  [ -f "$CONFIG_FILE" ] \
    || die "$CONFIG_FILE não existe. Rode 'sdd install' na raiz do repo-alvo."
  bash -n "$CONFIG_FILE" || die "$CONFIG_FILE tem erro de sintaxe bash"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  : "${PROJECT_NAME:=}"; : "${DEFAULT_BRANCH:=}"; : "${TEST_CMD:=}"
  : "${E2E_CMD:=}"; : "${E2E_DIR:=e2e}"; : "${LINT_CMD:=}"; : "${BUILD_CMD:=}"
  : "${APP_URL:=}"; : "${DEV_UP_CMD:=}"; : "${DEV_READY_CMD:=}"; : "${DEV_READY_TIMEOUT:=90}"
  : "${HANDOFF_DIR:=docs/handoffs}"; : "${QA_DOCS_PATH:=docs/qa}"; : "${TODO_FILE:=TODO.md}"
  : "${MODEL_EXEC:=opus}"; : "${MODEL_QA:=opus}"; : "${MODEL_REVIEW:=opus}"
  : "${MODEL_DOCS:=opus}"; : "${MODEL_PUBLISH:=sonnet}"; : "${MODEL_TICKET:=sonnet}"
  : "${QA_MAX_ITER:=3}"; : "${REVIEW_MAX_ITER:=3}"; : "${EXEC_MAX_RETRY:=1}"
  : "${BUDGET_PER_PHASE_USD:=15}"; : "${PUBLISH_ON_REVIEW_BLOCKED:=off}"
  : "${PERMISSION_MODE:=acceptEdits}"; : "${JIRA_ENABLED:=false}"
  # `acceptEdits` auto-aprova EDIÇÃO DE ARQUIVO, não `Bash`. Sem esta allowlist a sessão de fase
  # não roda TEST_CMD, não roda `git add`/`git commit` e a fase EXEC fica insatisfazível por
  # construção. Descoberto pela missão-fixture 20260814-dry-run-completo, que travou nisso.
  : "${ALLOWED_TOOLS:=Bash}"

  [ -n "$PROJECT_NAME" ]   || die "PROJECT_NAME vazio em $CONFIG_FILE"
  [ -n "$DEFAULT_BRANCH" ] || die "DEFAULT_BRANCH vazio em $CONFIG_FILE"
  [ -n "$TEST_CMD" ]       || die "TEST_CMD vazio em $CONFIG_FILE (é o gate de EXEC)"
  case "$PERMISSION_MODE" in
    bypassPermissions) die "PERMISSION_MODE=bypassPermissions não é aceito pelo kit" ;;
  esac
}

# ---------------------------------------------------------------------------
# Missão
# ---------------------------------------------------------------------------
MISSION=""
MISSION_DIR=""

# Aceita o nome completo (20260814-spinner) ou um prefixo/slug único.
resolve_mission() {
  local want="${1:-}" base="$REPO_ROOT/$HANDOFF_DIR" matches=()
  [ -n "$want" ] || die "falta o nome da missão (ex.: sdd status 20260814-spinner)"
  [ -d "$base" ] || die "$HANDOFF_DIR/ não existe no repo-alvo — nenhuma missão planejada ainda"

  if [ -d "$base/$want" ]; then
    MISSION="$want"
  else
    local d
    while IFS= read -r d; do matches+=("$(basename "$d")"); done \
      < <(find "$base" -mindepth 1 -maxdepth 1 -type d -name "*${want}*" | sort)
    case "${#matches[@]}" in
      0) die "missão '$want' não encontrada em $HANDOFF_DIR/" ;;
      1) MISSION="${matches[0]}" ;;
      *) die "'$want' é ambíguo: ${matches[*]}" ;;
    esac
  fi
  MISSION_DIR="$base/$MISSION"
}

# ---------------------------------------------------------------------------
# Leitura de artefatos
# ---------------------------------------------------------------------------

# frontmatter <arquivo> <chave> → valor (vazio se ausente)
frontmatter() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -v k="$key" '
    NR==1 && $0=="---" { inside=1; next }
    inside && $0=="---" { exit }
    inside {
      idx = index($0, ":")
      if (idx == 0) next
      name = substr($0, 1, idx-1)
      gsub(/^[ \t]+|[ \t]+$/, "", name)
      if (name == k) {
        val = substr($0, idx+1)
        gsub(/^[ \t]+|[ \t]+$/, "", val)
        gsub(/^["'\'']|["'\'']$/, "", val)
        print val
        exit
      }
    }' "$file"
}

# Linhas da tabela do checkpoint como "ID<TAB>título<TAB>check<TAB>status<TAB>commit".
# Ignora cabeçalho, separador e qualquer linha que não tenha as 5 colunas.
checkpoint_rows() {
  local file="$MISSION_DIR/checkpoint.md"
  [ -f "$file" ] || return 0
  awk -F'|' '
    /^[ \t]*\|/ {
      if (NF < 6) next
      for (i = 2; i <= 6; i++) { gsub(/^[ \t]+|[ \t]+$/, "", $i) }
      if ($2 == "ID" || $2 ~ /^-+$/ || $2 == "") next
      if ($5 == "Status") next
      printf "%s\t%s\t%s\t%s\t%s\n", $2, $3, $4, $5, $6
    }' "$file"
}

# Roda um comando do config na raiz do repo-alvo; devolve o exit code.
# Saída vai para o log da missão (quando há missão) — nunca polui o stdout do runner.
#
# Memoizado por processo: `sdd status` avalia sete gates e três deles rodam TEST_CMD.
# Sem cache, olhar o estado custaria três suítes. O cache morre com o processo, então
# `sdd run` sempre reavalia depois de uma fase ter mexido no código.
declare -A _CHECK_RC=()
declare -A _CHECK_LOG=()
LAST_CHECK_LOG=""

run_check_cmd() {
  local cmd="$1" label="${2:-check}" logfile rc=0
  [ -n "$cmd" ] || return 0
  if [ -n "${_CHECK_RC[$cmd]+x}" ]; then
    LAST_CHECK_LOG="${_CHECK_LOG[$cmd]}"
    return "${_CHECK_RC[$cmd]}"
  fi
  logfile="$(log_dir)/${label}-$(date +%H%M%S).log"
  mkdir -p "$(dirname "$logfile")"
  ( cd "$REPO_ROOT" && eval "$cmd" ) >"$logfile" 2>&1 || rc=$?
  _CHECK_RC[$cmd]="$rc"
  _CHECK_LOG[$cmd]="$logfile"
  LAST_CHECK_LOG="$logfile"
  return "$rc"
}

# Invalida o cache de sensores — chamado depois de qualquer fase que mexeu no repo.
invalidate_checks() { _CHECK_RC=(); _CHECK_LOG=(); }

log_dir() {
  if [ -n "$MISSION" ]; then printf '%s\n' "$REPO_ROOT/.sdd/logs/$MISSION"
  else printf '%s\n' "$REPO_ROOT/.sdd/logs/_geral"; fi
}

# Último arquivo de um glob (por ordem de nome — os nomes são datados). Vazio se nenhum.
latest_matching() {
  local pattern="$1"
  # `|| true`: sem match, o `ls` falha e o `pipefail` propagaria o erro para a atribuição
  # de quem chamou — dentro de um gate isso viraria falha silenciosa em vez de "não existe".
  # shellcheck disable=SC2012,SC2086
  ls -1d $pattern 2>/dev/null | sort | tail -1 || true
}

# ---------------------------------------------------------------------------
# Gates — cada um retorna 0 (satisfeito) ou 1, escrevendo o motivo em GATE_WHY.
# ATENÇÃO: nenhum gate pode ser satisfeito por texto do modelo. Só artefato.
# ---------------------------------------------------------------------------
GATE_WHY=""

gate_PLAN() {
  local m="$MISSION_DIR/00-missao.md" p="$MISSION_DIR/01-plano.md" c="$MISSION_DIR/checkpoint.md"
  local f
  for f in "$m" "$p" "$c"; do
    [ -f "$f" ] || { GATE_WHY="falta $(basename "$f") — fase de planejamento é interativa: rode o sdd-planner"; return 1; }
  done
  local aprov; aprov="$(frontmatter "$m" aprovacao)"
  case "$aprov" in
    auto)          : ;;
    humano-*)      : ;;
    *) GATE_WHY="00-missao.md tem 'aprovacao: ${aprov:-<vazio>}' — precisa ser 'auto' (PLAN-AUTO todo ✅) ou 'humano-YYYY-MM-DD'"; return 1 ;;
  esac
  if [ "$JIRA_ENABLED" = "true" ]; then
    local v; v="$(frontmatter "$m" versao)"
    if [ -z "$v" ] || [[ $v == \<* ]]; then
      GATE_WHY="JIRA_ENABLED=true exige 'versao:' preenchida em 00-missao.md (decisão humana, nunca headless)"
      return 1
    fi
  fi
  local n; n="$(checkpoint_rows | wc -l)"
  [ "$n" -gt 0 ] || { GATE_WHY="checkpoint.md não tem nenhuma linha de incremento parseável"; return 1; }
  GATE_WHY="plano aprovado ($aprov), $n incremento(s)"
  return 0
}

gate_TICKET() {
  if [ "$JIRA_ENABLED" != "true" ]; then GATE_WHY="JIRA_ENABLED=false — fase pulada"; return 0; fi
  local t="$MISSION_DIR/10-ticket.md"
  [ -f "$t" ] || { GATE_WHY="falta 10-ticket.md"; return 1; }
  local issue; issue="$(frontmatter "$t" issue)"
  [ -n "$issue" ] || { GATE_WHY="10-ticket.md sem 'issue:' no frontmatter"; return 1; }
  if ! grep -qiE '^sprint:[[:space:]]*\S' "$t"; then
    GATE_WHY="10-ticket.md sem 'sprint:' — a issue precisa estar NA SPRINT ATIVA, não no backlog"
    return 1
  fi
  GATE_WHY="issue $issue na sprint"
  return 0
}

gate_EXEC() {
  local rows; rows="$(checkpoint_rows)"
  [ -n "$rows" ] || { GATE_WHY="checkpoint.md vazio"; return 1; }

  local id status commit bad_rows=0 pending=0 blocked=0 total=0
  while IFS=$'\t' read -r id _ _ status commit; do
    total=$((total + 1))
    case "$status" in
      done)
        if [ -z "$commit" ] || [ "$commit" = "—" ] || [ "$commit" = "-" ]; then
          GATE_WHY="incremento $id está 'done' sem commit — rótulo não é artefato"; return 1
        fi
        if ! ( cd "$REPO_ROOT" && git cat-file -e "${commit}^{commit}" 2>/dev/null ); then
          GATE_WHY="incremento $id aponta commit '$commit' que não existe no repositório"; return 1
        fi
        # `cat-file -e` só diz que o OBJETO existe no banco — não que ele está na história da
        # branch. Depois de um amend/rebase/reset, um checkpoint citando o hash antigo passaria
        # apontando para fora da história, e o commit ainda pode sumir no gc com o gate verde.
        # Isso é exatamente o "rótulo, não artefato" que o kit existe para impedir, dentro do
        # próprio gate. Medido pelo sdd-qa na missão 20260814-dry-run-completo, com um amend real.
        if ! ( cd "$REPO_ROOT" && git merge-base --is-ancestor "$commit" HEAD 2>/dev/null ); then
          GATE_WHY="incremento $id aponta commit '$commit' que existe mas NÃO está na história de HEAD (amend/rebase/reset?) — o gate cobra artefato alcançável, não objeto solto"
          return 1
        fi
        ;;
      pending|doing) pending=$((pending + 1)) ;;
      blocked)       blocked=$((blocked + 1)) ;;
      *) bad_rows=$((bad_rows + 1)); GATE_WHY="incremento $id com status inválido '$status' (use pending|doing|done|blocked)"; return 1 ;;
    esac
  done <<< "$rows"

  if [ "$blocked" -gt 0 ]; then GATE_WHY="$blocked incremento(s) 'blocked' — Jidoka: a linha para"; return 1; fi
  if [ "$pending" -gt 0 ]; then GATE_WHY="$pending de $total incremento(s) ainda por executar"; return 1; fi

  if ! run_check_cmd "$TEST_CMD" "gate-exec-test"; then
    GATE_WHY="TEST_CMD falhou ($TEST_CMD) — ver $LAST_CHECK_LOG"; return 1
  fi
  [ -f "$MISSION_DIR/20-handoff-exec.md" ] \
    || { GATE_WHY="todos os incrementos done e suíte verde, mas falta 20-handoff-exec.md"; return 1; }

  GATE_WHY="$total incremento(s) done, suíte verde, handoff escrito"
  return 0
}

gate_QA() {
  local h="$MISSION_DIR/30-handoff-qa.md" report=""
  [ -f "$h" ] || { GATE_WHY="falta 30-handoff-qa.md"; return 1; }

  local st; st="$(frontmatter "$h" status)"
  if [ "$st" = "skipped" ]; then GATE_WHY="qa: skipped (diff sem mudança user-visible)"; return 0; fi
  if [ "$st" = "blocked" ]; then GATE_WHY="30-handoff-qa.md com status: blocked"; return 1; fi

  # Projeto sem interface: as skills qa-report/qa-execution nunca rodaram (qa_substep manda
  # direto para o sdd-qa), então a árvore docs/qa/ não existe. Exigir o relatório datado delas
  # seria cobrar um artefato que ninguém produz — o gate ficaria insatisfazível justamente no
  # caso em que a QA fez o trabalho e ACHOU coisa. A evidência da jornada andada mora no campo
  # `gate:` do próprio handoff, que é o artefato que existe aqui.
  # (Achado pelo sdd-qa na missão 20260814-dry-run-completo: `skipped` mentiria, `done` batia
  # na Âncora 1 e `blocked` reprova por definição — não havia status honesto E satisfazível.)
  if [ -z "$E2E_CMD" ] && [ -z "$APP_URL" ]; then
    local evidencia; evidencia="$(frontmatter "$h" gate)"
    if [ -z "$evidencia" ]; then
      GATE_WHY="projeto sem interface: 30-handoff-qa.md precisa de 'gate:' com a evidência da jornada andada"
      return 1
    fi
  else
    # Âncora 1: o relatório datado da skill qa-execution.
    report="$(latest_matching "$REPO_ROOT/$QA_DOCS_PATH/reports/*.md")"
    [ -n "$report" ] || { GATE_WHY="nenhum relatório em $QA_DOCS_PATH/reports/"; return 1; }
    # Âncora do relatório da skill qa-execution. O `**Status:**` NÃO começa a linha: o template
    # dela é `- **Started:** <ts> · **Status:** in-progress <!-- in-progress | closed -->`.
    # Exigir início de linha fazia o gate nunca casar, e o runner re-rodava qa-execution para
    # sempre — US$ 15 por volta. Medido no piloto SQ-97.
    # O `closed` tem que vir logo depois de `**Status:**`: o comentário do template contém a
    # palavra `closed` na legenda do enum, e um `.*closed` casaria com a linha `in-progress`.
    if ! report_closed "$report"; then
      GATE_WHY="relatório $(basename "$report") não está 'closed' (o enum é da skill: in-progress|closed, não traduzir)"
      return 1
    fi
    # Âncora 2: nenhuma linha da matriz pode continuar Pending.
    if grep -qE '\|[[:space:]]*Pending[[:space:]]*\|' "$report"; then
      GATE_WHY="relatório $(basename "$report") ainda tem linha(s) 'Pending' na matriz"; return 1
    fi
  fi
  # Âncora 3: registry sem bug aberto. 'wont-fix'/'invalid' são decisão humana, não bloqueiam.
  local openbugs; openbugs="$( { grep -rlE '^\-[[:space:]]+\*\*Status:\*\*[[:space:]]+open' \
      "$REPO_ROOT/$QA_DOCS_PATH/bugs/" 2>/dev/null || true; } | wc -l )"
  if [ "$openbugs" -gt 0 ]; then
    GATE_WHY="$openbugs bug(s) com Status: open no registry — viram incrementos de fix (loop QA⇄EXEC)"
    return 1
  fi
  if ! run_check_cmd "$TEST_CMD" "gate-qa-test"; then
    GATE_WHY="TEST_CMD falhou ($TEST_CMD) — ver $LAST_CHECK_LOG"; return 1
  fi
  if [ -n "$E2E_CMD" ] && ! run_check_cmd "$E2E_CMD" "gate-qa-e2e"; then
    GATE_WHY="E2E_CMD falhou ($E2E_CMD) — ver $LAST_CHECK_LOG"; return 1
  fi
  if [ -n "${report:-}" ]; then
    GATE_WHY="relatório $(basename "$report") fechado, registry limpo, suítes verdes"
  else
    GATE_WHY="jornada andada sem interface de browser (evidência no handoff), suíte verde"
  fi
  return 0
}

gate_REVIEW() {
  local last; last="$(latest_matching "$MISSION_DIR/40-review-r*.md")"
  [ -n "$last" ] || { GATE_WHY="nenhum 40-review-r<N>.md"; return 1; }

  # Âncora documentada: a seção "### Overall Grade" da skill codereview (contrato v1.13.0+),
  # tabela | Criterion | Grade | Rationale | com escala A–F. O gate exige A em TODA linha —
  # "—" (não analisado) também reprova: review parcial não é review.
  local offending
  offending="$(awk '
      /^###[[:space:]]+Overall Grade/ { inside = 1; next }
      # Sai em QUALQUER heading, não só `###`. Saindo só no `###`, uma seção seguinte de nível
      # SUPERIOR (`## Correções desta rodada`) não encerrava a leitura, e o parser seguia
      # engolindo tabelas posteriores do relatório — reprovando um relatório todo Grade A porque
      # achou uma coluna `Commit` numa tabela de commits. Medido no piloto SQ-97.
      inside && /^#{1,6}[[:space:]]/ { exit }
      inside && /^[ \t]*\|/ {
        n = split($0, f, "|")
        if (n < 4) next
        crit = f[2]; grade = f[3]
        gsub(/\*/, "", crit);  gsub(/^[ \t]+|[ \t]+$/, "", crit)
        gsub(/\*/, "", grade); gsub(/^[ \t]+|[ \t]+$/, "", grade)
        if (crit == "Criterion" || crit ~ /^-+$/ || crit == "") next
        rows++
        if (grade != "A") { print crit " = " (grade == "" ? "<vazio>" : grade); exit }
      }
      END { if (rows == 0) print "SEM-TABELA" }
    ' "$last")"
  if [ "$offending" = "SEM-TABELA" ]; then
    GATE_WHY="$(basename "$last") não tem a seção '### Overall Grade' — o gate não tem o que medir"
    return 1
  fi
  if [ -n "$offending" ]; then
    GATE_WHY="$(basename "$last"): $offending — o gate exige Grade A em todos os critérios"; return 1
  fi
  if ! run_check_cmd "$TEST_CMD" "gate-review-test"; then
    GATE_WHY="TEST_CMD falhou ($TEST_CMD) — ver $LAST_CHECK_LOG"; return 1
  fi
  if [ -n "$(cd "$REPO_ROOT" && git status --porcelain)" ]; then
    GATE_WHY="working tree sujo depois do review — correções precisam estar commitadas"; return 1
  fi
  GATE_WHY="$(basename "$last") todo Grade A, suíte verde, tree limpo"
  return 0
}

gate_DOCS() {
  local d="$MISSION_DIR/45-docs.md"
  [ -f "$d" ] || { GATE_WHY="falta 45-docs.md"; return 1; }
  if ! grep -qiE 'drift' "$d"; then
    GATE_WHY="45-docs.md sem checklist de drift"; return 1
  fi
  # Toda área tocada precisa estar ✅ ou n/a justificado — um ✗ pendente reprova.
  if grep -qE '✗|\bTODO\b|<preencher>' "$d"; then
    GATE_WHY="45-docs.md com item pendente (✗/TODO) no checklist de drift"; return 1
  fi
  GATE_WHY="checklist de drift completo"
  return 0
}

gate_PR() {
  local p="$MISSION_DIR/50-pr.md"
  [ -f "$p" ] || { GATE_WHY="falta 50-pr.md"; return 1; }
  local url; url="$(frontmatter "$p" pr_url)"
  [ -n "$url" ] || { GATE_WHY="50-pr.md sem 'pr_url:' no frontmatter"; return 1; }
  local live
  live="$( cd "$REPO_ROOT" && gh pr view "$url" --json url --jq .url 2>/dev/null )" || true
  [ -n "$live" ] || { GATE_WHY="gh não confirma o PR $url — 50-pr.md pode estar mentindo"; return 1; }
  GATE_WHY="PR aberto: $live"
  return 0
}

readonly PHASES="PLAN TICKET EXEC QA REVIEW DOCS PR"

# Primeira fase cujo gate não está satisfeito. Vazio ⇒ missão completa.
current_phase() {
  local ph
  for ph in $PHASES; do
    if ! "gate_$ph"; then printf '%s\n' "$ph"; return 0; fi
  done
  printf '%s\n' ""
}

# Primeira fase DEPOIS de <fase> cujo gate não está satisfeito. Vazio ⇒ acabou a lista.
# Existe só para a projeção do dry-run: como o dry-run não muda nada no disco, re-chamar
# current_phase() devolveria a mesma fase para sempre — laço infinito.
next_pending_phase() {
  local after="$1" ph seen=0
  for ph in $PHASES; do
    if [ "$seen" = "1" ] && ! "gate_$ph"; then printf '%s\n' "$ph"; return 0; fi
    if [ "$ph" = "$after" ]; then seen=1; fi
  done
  printf '%s\n' ""
}

# ---------------------------------------------------------------------------
# Invocação de fase
# ---------------------------------------------------------------------------

# Modelo configurado para a fase.
phase_model() {
  case "$1" in
    EXEC)   printf '%s\n' "$MODEL_EXEC" ;;
    QA)     printf '%s\n' "$MODEL_QA" ;;
    REVIEW) printf '%s\n' "$MODEL_REVIEW" ;;
    DOCS)   printf '%s\n' "$MODEL_DOCS" ;;
    PR)     printf '%s\n' "$MODEL_PUBLISH" ;;
    TICKET) printf '%s\n' "$MODEL_TICKET" ;;
    *)      printf '%s\n' "$MODEL_EXEC" ;;
  esac
}

# Sub-passo da fase QA, DERIVADO dos artefatos — mesma filosofia dos gates, nenhum estado extra.
# A fase QA são três sessões: as skills qa-report/qa-execution têm `disable-model-invocation`,
# então cada uma precisa entrar pelo slash literal como prompt inicial da SUA sessão (verificado
# em 2026-08-14: o slash expande em headless e a skill carrega). O sdd-qa fecha o ciclo depois.
# O relatório datado da skill qa-execution está fechado?
#
# UMA função, usada pelo gate E pelo sub-passo. A âncora vivia duplicada nos dois; ao corrigi-la
# num lugar só, o `gate_QA` passou a aceitar o relatório enquanto o `qa_substep` continuava
# achando que faltava executar — e o runner re-rodou qa-execution a US$ 15 por volta. Contrato
# duplicado é contrato que diverge; a duplicação era o bug, não a regex.
#
# Detalhes da âncora: `**Status:**` NÃO começa a linha (o template é
# `- **Started:** <ts> · **Status:** in-progress <!-- in-progress | closed -->`), e o `closed`
# tem que vir logo depois de `**Status:**` — um `.*closed` casaria com a legenda do enum no
# comentário, aprovando um relatório ainda em andamento.
report_closed() {
  local report="${1:-}"
  [ -n "$report" ] || return 1
  grep -qE '^[[:space:]]*-.*\*\*Status:\*\*[[:space:]]*closed' "$report"
}

qa_substep() {
  local qa="$REPO_ROOT/$QA_DOCS_PATH" report
  # Projeto sem interface para andar (sem E2E_CMD e sem APP_URL): as skills de dogfooding em
  # persona não têm o que fazer. Vai direto ao sdd-qa, que julga se o diff é user-visible e,
  # não sendo, escreve `qa: skipped` com a justificativa. Bootstrapar uma árvore de jornadas
  # de browser num projeto sem browser é a burocracia que o `skipped` existe para evitar.
  if [ -z "$E2E_CMD" ] && [ -z "$APP_URL" ]; then printf 'close\n'; return 0; fi
  [ -n "$(latest_matching "$qa/charters/*.md")" ] || { printf 'plan\n'; return 0; }
  report="$(latest_matching "$qa/reports/*.md")"
  if ! report_closed "$report"; then printf 'exec\n'; return 0; fi
  printf 'close\n'
}

# Identificador do passo: a fase, ou `QA:<sub-passo>`.
phase_step() {
  case "$1" in
    QA) printf 'QA:%s\n' "$(qa_substep)" ;;
    *)  printf '%s\n' "$1" ;;
  esac
}

# Agente responsável pelo passo. Vazio ⇒ quem dirige é a skill do slash, não um agente do kit
# (dois system prompts disputando a sessão é ruído, não reforço).
phase_agent() {
  case "$1" in
    EXEC)      printf '%s\n' "sdd-executor" ;;
    QA:plan)   printf '%s\n' "" ;;
    QA:exec)   printf '%s\n' "" ;;
    QA:close|QA) printf '%s\n' "sdd-qa" ;;
    REVIEW)    printf '%s\n' "sdd-reviewer" ;;
    DOCS)      printf '%s\n' "sdd-docs" ;;
    PR)        printf '%s\n' "sdd-publisher" ;;
    TICKET)    printf '%s\n' "sdd-publisher" ;;
    *)         printf '%s\n' "" ;;
  esac
}

# Slash literal que abre a sessão, quando a fase é dirigida por uma skill de terceiro.
phase_slash() {
  case "$1" in
    QA:plan) printf '/qa-report %s\n' "$QA_DOCS_PATH" ;;
    QA:exec) printf '/qa-execution %s\n' "$QA_DOCS_PATH" ;;
    TICKET)  printf '/ticket open %s\n' "$(frontmatter "$MISSION_DIR/00-missao.md" titulo)" ;;
    *)       printf '%s\n' "" ;;
  esac
}

phase_task() {
  case "$1" in
    EXEC)     printf '%s\n' "executar o PRÓXIMO incremento pendente do checkpoint, em TDD, e commitar" ;;
    QA:plan)  printf '%s\n' "planejar o ciclo de QA desta missão: personas, jornadas, cenários e charters" ;;
    QA:exec)  printf '%s\n' "andar as jornadas em persona e escrever o relatório datado + o registry de bugs" ;;
    QA:close|QA) printf '%s\n' "fechar o ciclo de QA: achado confirmado vira spec e2e, bug sanável vira incremento de fix, e escrever o 30-handoff-qa.md" ;;
    REVIEW)   printf '%s\n' "revisar e corrigir, DENTRO desta sessão, até todos os critérios ficarem Grade A" ;;
    DOCS)     printf '%s\n' "sincronizar a documentação viva do repo com o que esta missão mudou" ;;
    PR)       printf '%s\n' "fazer push e abrir o PR com as evidências das fases anteriores" ;;
    TICKET)   printf '%s\n' "abrir a issue da missão no JIRA, já na sprint ativa, e registrar o 10-ticket.md" ;;
    *)        printf '%s\n' "" ;;
  esac
}

# Instrução extra por fase, quando a fase tem um laço próprio a conduzir.
phase_extra() {
  case "$1" in
    REVIEW) cat <<'EOF'

Conduza o laço revisar → corrigir → re-revisar DENTRO desta sessão, com o relatório de QA em
mãos, até a tabela "### Overall Grade" fechar com A em TODOS os critérios. (O comando `/goal`
NÃO existe neste ambiente — verificado; o laço é seu.) Correções vão commitadas: o gate exige
working tree limpo. Se a sessão terminar sem fechar, escreva o 40-review-r<N>.md com a grade
REAL — o runner abre uma sessão nova continuando. Grade inflada para passar no gate desliga o
único sensor de qualidade da missão.
EOF
    ;;
    QA:plan|QA:exec) cat <<'EOF'

A skill acima é a dona da árvore docs/qa/ — siga as instruções dela. Ao terminar, commite o que
ela escreveu. Não escreva handoff nem toque no checkpoint: isso é do passo seguinte.
EOF
    ;;
    *) printf '' ;;
  esac
}

# Protocolo de boot — fixo, curto, e sempre o mesmo. Tudo que a sessão precisa saber está
# em disco; este prompt só diz ONDE olhar e que não houve conversa anterior.
#
# Quando a fase é dirigida por skill de terceiro, o slash literal precisa ser a PRIMEIRA linha
# do prompt: é assim que ele expande em headless (as skills de QA têm disable-model-invocation,
# então não há outro caminho).
boot_prompt() {
  local step="$1" slash agent
  slash="$(phase_slash "$step")"
  agent="$(phase_agent "$step")"
  [ -n "$slash" ] && printf '%s\n\n' "$slash"
  cat <<EOF
Você está na fase $step da missão \`$MISSION\` do projeto \`$PROJECT_NAME\`${agent:+, como o agente $agent}.

Todo o seu estado vem do disco. NÃO houve conversa anterior — nada foi "combinado" antes.
Leia, nesta ordem, antes de qualquer outra coisa:
  1. $HANDOFF_DIR/$MISSION/00-missao.md   (a intenção e a métrica)
  2. $HANDOFF_DIR/$MISSION/01-plano.md    (o como, e o contexto já verificado — confie nele)
  3. $HANDOFF_DIR/$MISSION/checkpoint.md  (a tabela de incrementos)
  4. o handoff mais recente de $HANDOFF_DIR/$MISSION/ (o que já aconteceu)
  5. .sdd/config.sh (TEST_CMD="$TEST_CMD"${E2E_CMD:+, E2E_CMD=\"$E2E_CMD\"})

Sua tarefa nesta sessão: $(phase_task "$step").
$(phase_extra "$step")
Escreva os artefatos no disco e commite. O runner reavalia o gate por fora — roda os testes,
confere os hashes no git log, lê os arquivos. Sua resposta em texto não prova nada e não
satisfaz gate nenhum. Achado que não cabe nesta missão vai para o $TODO_FILE, nunca para o diff.
EOF
}

PIPELINE_LOG=""
DRY_RUN=0

pipeline_log_line() {
  # Projeção não escreve no diário. Precisão importa aqui, porque a frase fácil ("dry-run não
  # mexe em nada") é falsa: os gates rodam `TEST_CMD`/`E2E_CMD` de verdade durante a projeção e
  # escrevem `.sdd/logs/<missão>/gate-*-test-*.log` — decisão explícita do plano. O que o
  # `--dry-run` garante é mais estreito e é isto: nenhuma sessão do `claude` é gasta e nenhum
  # artefato da missão é tocado. Registrar aqui um evento que só foi PROJETADO mente na
  # trilha de auditoria, e num repo-alvo recém instalado (onde o `sdd install` só ignora
  # `.sdd/logs/`) o `pipeline.log` fica untracked e suja o working tree — tree sujo reprova
  # `gate_REVIEW` e o `sdd preflight`, ou seja: uma projeção derrubaria o gate de outra fase.
  # A guarda mora aqui, e não nos chamadores, para valer para TODOS eles: os caminhos de
  # escalação (`blocked` do checkpoint, orçamento estourado, duas sessões sem progresso) são
  # três, e um quarto adicionado amanhã nasceria com o mesmo defeito. Achado da fase QA da
  # missão 20260814-dry-run-completo (F1).
  [ "$DRY_RUN" = "1" ] && return 0
  [ -n "$PIPELINE_LOG" ] || return 0
  mkdir -p "$(dirname "$PIPELINE_LOG")"
  printf '%s\n' "$*" >> "$PIPELINE_LOG"
}

# Roda uma fase numa sessão headless nova. Devolve 0 se o claude saiu 0 (o que NÃO significa
# que o gate passou — quem julga isso é o gate, sempre depois).
run_phase() {
  local phase="$1" resume_sid="${2:-}"
  local pstep model agent sid prompt logfile started ended cost
  # QA são três sessões (planejar, andar, fechar); o passo sai dos artefatos, não de um contador.
  pstep="$(phase_step "$phase")"
  model="$(phase_model "$phase")"
  agent="$(phase_agent "$pstep")"
  sid="$(uuidgen)"
  prompt="$(boot_prompt "$pstep")"
  if [ -n "$resume_sid" ]; then
    prompt="O gate da fase $phase falhou: ${GATE_WHY}

Corrija exatamente isso. Não recomece a fase: leia o que já está no disco, complete o que falta
e escreva os artefatos. O gate será reavaliado."
  fi

  local -a cmd=(claude -p "$prompt"
    --model "$model"
    --permission-mode "$PERMISSION_MODE"
    --output-format json
    --setting-sources "user,project,local"
    --allowedTools "$ALLOWED_TOOLS"
    --max-budget-usd "$BUDGET_PER_PHASE_USD")
  if [ -n "$agent" ]; then cmd+=(--agent "$agent"); fi
  if [ -n "$resume_sid" ]; then cmd+=(--resume "$resume_sid" --fork-session)
  else cmd+=(--session-id "$sid"); fi

  if [ "$DRY_RUN" = "1" ]; then
    info ""
    printf '%s--- DRY RUN: fase %s ---%s\n' "$C_BOLD" "$pstep" "$C_RESET"
    printf '%scwd:%s   %s\n' "$C_DIM" "$C_RESET" "$REPO_ROOT"
    printf '%smodelo:%s %s   %sagente:%s %s   %ssessão:%s %s\n' \
      "$C_DIM" "$C_RESET" "$model" "$C_DIM" "$C_RESET" "${agent:-<nenhum>}" \
      "$C_DIM" "$C_RESET" "${resume_sid:-$sid}"
    printf '%scomando:%s\n' "$C_DIM" "$C_RESET"
    printf '  %q' "${cmd[@]}"; printf '\n'
    printf '%sprompt de boot:%s\n' "$C_DIM" "$C_RESET"
    printf '%s\n' "$prompt" | sed 's/^/  │ /'
    LAST_PHASE_SID="$sid"
    return 0
  fi

  logfile="$(log_dir)/${phase}-$(date +%Y%m%d-%H%M%S).json"
  mkdir -p "$(dirname "$logfile")"
  started="$(date +%s)"
  step "fase $pstep — ${agent:-skill} ($model) — sessão ${resume_sid:-$sid}"

  local rc=0
  ( cd "$REPO_ROOT" && "${cmd[@]}" ) > "$logfile" 2>"${logfile%.json}.err" || rc=$?
  ended="$(date +%s)"

  cost="$(jq -r '.total_cost_usd // .cost_usd // "?"' "$logfile" 2>/dev/null || echo "?")"
  local dur=$((ended - started))
  pipeline_log_line "$(date -Iseconds)  $phase  agente=$agent  modelo=$model  sessao=${resume_sid:-$sid}  rc=$rc  dur=${dur}s  custo_usd=$cost  log=$logfile"

  if [ "$rc" -ne 0 ]; then
    warn "claude saiu com $rc na fase $phase (ver $logfile e ${logfile%.json}.err)"
  else
    dim "  sessão encerrada em ${dur}s, custo $cost USD"
  fi
  LAST_PHASE_SID="$sid"
  invalidate_checks
  return 0
}
LAST_PHASE_SID=""

# Impressão digital do estado da missão. Serve para responder "essa sessão fez ALGUMA coisa?"
# quando o gate ainda não passou — o caso normal da fase EXEC, que roda um incremento por vez.
state_fingerprint() {
  local head files
  head="$( cd "$REPO_ROOT" && git rev-parse HEAD 2>/dev/null || echo "-" )"
  files="$( ls -1 "$MISSION_DIR" 2>/dev/null | sort | tr '\n' ',' )"
  printf '%s|%s|%s\n' "$head" "$files" \
    "$( cat "$MISSION_DIR/checkpoint.md" 2>/dev/null | md5sum 2>/dev/null | cut -d' ' -f1 )"
}

# Quantas sessões uma fase pode consumir antes de virar BLOCKED.
phase_budget() {
  case "$1" in
    EXEC)   printf '%s\n' "$(( $(checkpoint_rows | wc -l) + EXEC_MAX_RETRY + 2 ))" ;;
    QA)     printf '%s\n' "$(( QA_MAX_ITER * 3 ))" ;;   # 3 sub-passos por volta
    REVIEW) printf '%s\n' "$REVIEW_MAX_ITER" ;;
    *)      printf '%s\n' "$(( EXEC_MAX_RETRY + 1 ))" ;;
  esac
}

# ---------------------------------------------------------------------------
# Comandos
# ---------------------------------------------------------------------------

cmd_install() {
  local force=0
  if [ "${1:-}" = "--force" ]; then force=1; fi
  resolve_repo_root
  step "instalando o sdd em $REPO_ROOT"

  mkdir -p "$REPO_ROOT/.sdd" "$REPO_ROOT/.claude/agents"

  if [ -f "$CONFIG_FILE" ]; then
    ok ".sdd/config.sh já existe (preservado)"
  else
    local branch test_cmd project
    project="$(basename "$REPO_ROOT")"
    # `|| true` obrigatório: repo sem remote não tem origin/HEAD, o git falha e o pipefail
    # derrubaria o install inteiro em silêncio.
    branch="$( cd "$REPO_ROOT" \
      && git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null \
      | sed 's|^origin/||' || true )"
    [ -n "$branch" ] || branch="$( cd "$REPO_ROOT" && git branch --show-current )"
    test_cmd="TODO"
    if [ -f "$REPO_ROOT/package.json" ];   then test_cmd="npm test"; fi
    if [ -f "$REPO_ROOT/pyproject.toml" ]; then test_cmd="pytest -q"; fi
    if [ -f "$REPO_ROOT/Cargo.toml" ];     then test_cmd="cargo test"; fi
    if [ -f "$REPO_ROOT/go.mod" ];         then test_cmd="go test ./..."; fi
    sed -e "s|<PROJECT_NAME>|$project|g" \
        -e "s|<DEFAULT_BRANCH>|$branch|g" \
        -e "s|<TEST_CMD>|$test_cmd|g" \
        -e "s|<SDD_HOME>|$SDD_HOME|g" \
        "$SDD_HOME/config/starter.conf" > "$CONFIG_FILE"
    ok ".sdd/config.sh criado (branch base detectada: $branch — confirme)"
  fi

  local a name target changed=0
  for a in "$SDD_HOME"/agents/sdd-*.md; do
    [ -e "$a" ] || continue
    name="$(basename "$a")"
    target="$REPO_ROOT/.claude/agents/$name"
    if [ ! -f "$target" ]; then
      cp "$a" "$target"; ok "agente $name copiado"
    elif cmp -s "$a" "$target"; then
      ok "agente $name idêntico"
    elif [ "$force" = "1" ]; then
      cp "$a" "$target"; ok "agente $name atualizado (--force)"
    else
      changed=$((changed + 1))
      warn "agente $name difere da versão do kit:"
      diff -u "$target" "$a" | sed 's/^/      /' >&2 || true
    fi
  done
  if [ "$changed" -gt 0 ]; then warn "rode 'sdd install --force' para adotar a versão do kit"; fi

  local gitignore="$REPO_ROOT/.gitignore"
  if ! grep -qxF '.sdd/logs/' "$gitignore" 2>/dev/null; then
    printf '\n# logs efêmeros do runner sdd (o estado durável vive em %s/, commitado)\n.sdd/logs/\n' \
      "${HANDOFF_DIR:-docs/handoffs}" >> "$gitignore"
    ok ".sdd/logs/ adicionado ao .gitignore"
  else
    ok ".sdd/logs/ já no .gitignore"
  fi

  info ""
  dim "próximo: edite .sdd/config.sh e rode 'sdd preflight'"
}

cmd_preflight() {
  load_config
  step "preflight — $PROJECT_NAME ($REPO_ROOT)"
  local fails=0
  _fail() { bad "$1"; fails=$((fails + 1)); }

  # --- ferramentas ---
  if command -v claude >/dev/null 2>&1; then ok "claude $(claude --version 2>&1 | head -1)"
  else _fail "claude CLI não encontrado no PATH"; fi

  local t
  for t in git gh jq uuidgen; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t presente"
    else _fail "$t não encontrado no PATH"; fi
  done

  # --- autenticação ---
  # Sanidade + permissão numa tacada só. "claude -p responde" NÃO cobre o modo de falha que
  # importa: a sessão de fase precisa EXECUTAR (rodar a suíte, commitar), e `acceptEdits`
  # sozinho não libera `Bash`. Este check dispara uma sessão headless real com AS MESMAS flags
  # do run_phase e exige que ela consiga executar um comando.
  if command -v claude >/dev/null 2>&1; then
    local probe
    probe="$( cd "$REPO_ROOT" && claude -p "Rode exatamente: bash -c 'echo sdd-preflight-ok'. Responda somente com a saída do comando." \
        --model haiku --permission-mode "$PERMISSION_MODE" --output-format json \
        --setting-sources "user,project,local" --allowedTools "$ALLOWED_TOOLS" \
        --max-budget-usd 1 2>/dev/null | jq -r '.result // ""' 2>/dev/null || true )"
    if printf '%s' "$probe" | grep -q 'sdd-preflight-ok'; then
      ok "sessão headless executa comandos (OAuth + permissão)"
    elif [ -z "$probe" ]; then
      _fail "claude -p não respondeu — sessão expirada? rode 'claude login'"
    else
      _fail "a sessão headless NÃO consegue executar comandos — as fases não vão rodar a suíte
        nem commitar. Resposta obtida: $(printf '%s' "$probe" | head -c 120)
        Ajuste ALLOWED_TOOLS em .sdd/config.sh (default: Bash)."
    fi
  fi
  if gh auth status >/dev/null 2>&1; then ok "gh autenticado"
  else _fail "gh não autenticado — rode 'gh auth login'"; fi

  # --- browser (só importa se há e2e/QA de UI) ---
  if [ -n "$E2E_CMD" ] || [ -n "$APP_URL" ]; then
    if command -v agent-browser >/dev/null 2>&1; then
      ok "$(agent-browser --version 2>&1 | head -1)"
    else
      _fail "agent-browser ausente/quebrado — a fase QA exploratória depende dele.
        Sintoma conhecido: shim em ~/.nvm/versions/node/*/bin/agent-browser apontando para
        ~/.hermes/... (inexistente). Fix: ln -sf ../lib/node_modules/agent-browser/bin/agent-browser.js <shim>"
    fi
  else
    dim "  ---  agent-browser não checado (E2E_CMD e APP_URL vazios)"
  fi

  # --- config ---
  bash -n "$CONFIG_FILE" && ok "config com sintaxe válida"
  case "$TEST_CMD" in
    TODO|"") _fail "TEST_CMD não configurado em .sdd/config.sh" ;;
    *) ok "TEST_CMD=$TEST_CMD" ;;
  esac
  if [ "$JIRA_ENABLED" = "true" ]; then
    if [ -f "$REPO_ROOT/.jira-project" ]; then ok "JIRA habilitado, .jira-project presente"
    else _fail "JIRA_ENABLED=true mas não há .jira-project no repo (a skill ticket precisa dele)"; fi
  else
    dim "  ---  JIRA_ENABLED=false — fase TICKET será pulada"
  fi

  # --- plugins do repo-alvo ---
  local settings="$REPO_ROOT/.claude/settings.json"
  if [ -f "$settings" ]; then
    local p missing=""
    for p in ddd kaizen-software; do
      grep -q "\"$p@" "$settings" || missing="$missing $p"
    done
    if [ -z "$missing" ]; then ok "plugins ddd + kaizen-software habilitados"
    else warn "plugins não habilitados em .claude/settings.json:$missing (o planner os invoca)"; fi
  else
    warn ".claude/settings.json ausente — plugins ddd/kaizen não habilitados no repo"
  fi

  # --- agentes instalados ---
  local a n=0
  for a in "$SDD_HOME"/agents/sdd-*.md; do
    [ -e "$a" ] || continue
    n=$((n + 1))
    [ -f "$REPO_ROOT/.claude/agents/$(basename "$a")" ] \
      || _fail "agente $(basename "$a") não instalado — rode 'sdd install'"
  done
  # Só afirma "conferidos" se nenhum agente falhou — dizer isso logo depois de seis linhas
  # de falha é a saída se contradizendo, que é o tipo de mentira que o kit proíbe nos gates.
  if [ "$n" -gt 0 ] && [ "$fails" -eq 0 ]; then ok "$n agente(s) do kit conferidos"; fi

  # --- estado do git ---
  local branch; branch="$( cd "$REPO_ROOT" && git branch --show-current )"
  ok "branch atual: $branch"
  if [ "$branch" = "$DEFAULT_BRANCH" ]; then
    warn "você está na branch base ($DEFAULT_BRANCH) — o pipeline commita direto aqui se rodar assim"
  fi
  if [ -n "$( cd "$REPO_ROOT" && git status --porcelain )" ]; then
    _fail "working tree sujo — o pipeline precisa de base limpa para atribuir commits aos incrementos"
  else
    ok "working tree limpo"
  fi

  info ""
  if [ "$fails" -eq 0 ]; then
    printf '%spreflight ok%s\n' "$C_GREEN$C_BOLD" "$C_RESET"; return 0
  fi
  printf '%s%d verificação(ões) falharam%s\n' "$C_RED$C_BOLD" "$fails" "$C_RESET" >&2
  return 1
}

cmd_status() {
  load_config
  resolve_mission "${1:-}"
  step "missão $MISSION — $PROJECT_NAME"
  info ""

  local ph state why
  for ph in $PHASES; do
    if "gate_$ph"; then state="${C_GREEN}✓${C_RESET}"; else state="${C_YELLOW}·${C_RESET}"; fi
    why="$GATE_WHY"
    printf '  %b %-7s %s%s%s\n' "$state" "$ph" "$C_DIM" "$why" "$C_RESET"
  done

  info ""
  local rows; rows="$(checkpoint_rows)"
  if [ -n "$rows" ]; then
    info "  incrementos:"
    local id title _c st commit mark
    while IFS=$'\t' read -r id title _c st commit; do
      case "$st" in
        done)    mark="${C_GREEN}✓${C_RESET}" ;;
        blocked) mark="${C_RED}✗${C_RESET}" ;;
        doing)   mark="${C_YELLOW}▸${C_RESET}" ;;
        *)       mark="${C_DIM}·${C_RESET}" ;;
      esac
      printf '    %b %-4s %-46s %s%s%s\n' "$mark" "$id" "${title:0:46}" "$C_DIM" "${commit:0:8}" "$C_RESET"
    done <<< "$rows"
  fi

  info ""
  local next; next="$(current_phase)"
  if [ -z "$next" ]; then
    printf '  %spipeline completo — falta só o merge (gate humano)%s\n' "$C_GREEN$C_BOLD" "$C_RESET"
  else
    "gate_$next" || true
    printf '  próxima fase: %s%s%s — %s\n' "$C_BOLD" "$next" "$C_RESET" "$GATE_WHY"
    printf '  %srode: sdd run %s%s\n' "$C_DIM" "$MISSION" "$C_RESET"
  fi
}

# Imprime só o nome da fase corrente (ou DONE). Existe para script e para os testes do kit —
# `sdd status` é para humano, este é para máquina.
cmd_phase() {
  load_config
  resolve_mission "${1:-}"
  local next; next="$(current_phase)"
  printf '%s\n' "${next:-DONE}"
}

# Imprime o motivo pelo qual o gate de uma fase específica não passou.
cmd_why() {
  load_config
  resolve_mission "${1:-}"
  local ph="${2:-}"
  [ -n "$ph" ] || ph="$(current_phase)"
  [ -n "$ph" ] || { info "pipeline completo"; return 0; }
  "gate_$ph" || true
  printf '%s: %s\n' "$ph" "$GATE_WHY"
}

cmd_run() {
  local mission_arg="" force_phase="" max_phases=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)     DRY_RUN=1 ;;
      --phase)       force_phase="${2:-}"; shift ;;
      --max-phases)  max_phases="${2:-0}"; shift ;;
      -*)            die "opção desconhecida de run: $1" ;;
      *)             mission_arg="$1" ;;
    esac
    shift
  done

  load_config
  resolve_mission "$mission_arg"
  PIPELINE_LOG="$(log_dir)/pipeline.log"

  step "missão $MISSION — $PROJECT_NAME${DRY_RUN:+}"
  # "nada será executado" seria mentira: avaliar quais fases estão pendentes obriga a rodar os
  # gates, e três deles rodam TEST_CMD. O que o dry-run garante é mais estreito — nenhuma sessão
  # do claude, nenhum toque nos artefatos da missão. Mesma correção de honestidade do --help.
  [ "$DRY_RUN" = "1" ] && dim "  (dry-run: nenhuma sessão será aberta — mas os gates rodam TEST_CMD)"

  local -A attempts=()
  local phases_run=0 phase before after budget
  local dry_next=""   # cursor da projeção do dry-run (distinto de --phase, que imprime uma só)

  while :; do
    if [ -n "$dry_next" ]; then phase="$dry_next"
    elif [ -n "$force_phase" ]; then phase="$force_phase"
    else phase="$(current_phase)"; fi

    if [ -z "$phase" ]; then
      info ""
      printf '%s✓ pipeline completo — falta só o merge (o único gate humano)%s\n' \
        "$C_GREEN$C_BOLD" "$C_RESET"
      local prurl; prurl="$(frontmatter "$MISSION_DIR/50-pr.md" pr_url)"
      [ -n "$prurl" ] && info "  $prurl"
      return 0
    fi

    # PLAN é interativo por design: o humano participa do grill. O runner não boota o planner.
    if [ "$phase" = "PLAN" ]; then
      gate_PLAN || true
      info ""
      warn "fase PLAN não é headless: $GATE_WHY"
      dim "  O planejamento é a participação humana. Abra uma sessão interativa com o agente"
      dim "  sdd-planner (modelo Fable) e produza 00-missao.md, 01-plano.md e checkpoint.md."
      dim "  Quando o gate PLAN-AUTO fechar limpo, 'sdd run $MISSION' segue sozinho até o PR."
      return 2
    fi

    # Jidoka de verdade: incremento `blocked` escala NA HORA. Sem isto o runner via a mudança
    # no checkpoint como "progresso" e rebootava EXEC até estourar o orçamento de fase — três
    # sessões contra a mesma parede. Achado da própria missão-fixture 20260814-dry-run-completo.
    # O status sai para uma variável ANTES do `grep`: sob `pipefail`, `grep -q` fecha o pipe
    # assim que acha o match, o estágio de cima morre de SIGPIPE e o pipeline inteiro devolve
    # 141 — o `if` leria "não há blocked" **existindo** blocked. Com o checkpoint pequeno a
    # corrida quase nunca acontece, mas "quase nunca" não é garantia que se dê a um Jidoka:
    # o falso-negativo aqui é justamente o runner batendo na parede que ele já sabia existir.
    local ckstatus; ckstatus="$(checkpoint_rows | cut -f4)"
    if [ "$phase" = "EXEC" ] && printf '%s\n' "$ckstatus" | grep -qx "blocked"; then
      gate_EXEC || true
      info ""
      bad "BLOCKED em EXEC — $GATE_WHY"
      dim "  A linha parou de propósito: um incremento foi marcado 'blocked' pelo executor."
      dim "  Leia as 'Notas de execução' do checkpoint.md — o motivo está escrito lá."
      dim "  Resolvido o impedimento, volte o incremento para 'pending' e rode 'sdd run' de novo."
      pipeline_log_line "$(date -Iseconds)  BLOCKED  EXEC  incremento marcado blocked pelo executor"
      return 3
    fi

    budget="$(phase_budget "$phase")"
    attempts["$phase"]="$(( ${attempts[$phase]:-0} + 1 ))"
    if [ "${attempts[$phase]}" -gt "$budget" ]; then
      gate_"$phase" || true
      info ""
      bad "BLOCKED em $phase — ${attempts[$phase]} sessões sem satisfazer o gate"
      bad "  motivo atual: $GATE_WHY"
      dim "  'sdd status $MISSION' mostra o estado completo; 'sdd why $MISSION $phase' o motivo."
      if [ "$phase" = "REVIEW" ] && [ "$PUBLISH_ON_REVIEW_BLOCKED" = "draft" ]; then
        warn "PUBLISH_ON_REVIEW_BLOCKED=draft — seguindo para PR em modo draft"
        force_phase="PR"; continue
      fi
      pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
      return 3
    fi

    before="$(state_fingerprint)"
    run_phase "$phase"
    after="$(state_fingerprint)"

    if [ "$DRY_RUN" = "1" ]; then
      # --phase <FASE> pede uma fase específica: imprime só ela.
      [ -n "$force_phase" ] && return 0
      # Projeção honesta: as fases cujo gate está insatisfeito HOJE, na ordem canônica. Não
      # simula o efeito das fases (não adivinha que o EXEC destravaria a QA) — informação
      # honesta vale mais do que informação completa e potencialmente errada.
      dry_next="$(next_pending_phase "$phase")"
      [ -n "$dry_next" ] && continue
      dim "  (dry-run: fim da projeção — nenhuma sessão foi aberta)"
      return 0
    fi

    phases_run=$((phases_run + 1))
    if [ "$max_phases" -gt 0 ] && [ "$phases_run" -ge "$max_phases" ]; then
      info ""; dim "  --max-phases=$max_phases atingido"; return 0
    fi

    if gate_"$phase"; then
      ok "gate $phase: $GATE_WHY"
      force_phase=""
      continue
    fi

    # Gate não passou. Houve progresso? Fase EXEC roda um incremento por vez — não ter
    # satisfeito o gate é o caso NORMAL enquanto sobram incrementos.
    if [ "$before" != "$after" ]; then
      dim "  gate $phase ainda não: $GATE_WHY (mas a sessão avançou — seguindo)"
      force_phase=""
      continue
    fi

    # Nada mudou no disco: a sessão não fez nada. Uma retentativa com o motivo em mãos.
    warn "gate $phase falhou e a sessão não mudou nada: $GATE_WHY"
    warn "  retentando uma vez com o motivo do gate no prompt"
    run_phase "$phase" "$LAST_PHASE_SID"
    if gate_"$phase"; then
      ok "gate $phase (na retentativa): $GATE_WHY"
      force_phase=""
      continue
    fi
    if [ "$(state_fingerprint)" = "$after" ]; then
      info ""
      bad "BLOCKED em $phase — duas sessões sem mover o disco: $GATE_WHY"
      pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
      return 3
    fi
    force_phase=""
  done
}

cmd_retry() {
  load_config
  resolve_mission "${1:-}"
  PIPELINE_LOG="$(log_dir)/pipeline.log"
  local phase; phase="$(current_phase)"
  [ -n "$phase" ] || { info "pipeline completo — nada a re-tentar"; return 0; }
  [ "$phase" = "PLAN" ] && die "PLAN é interativo — não há o que re-tentar headless"
  step "re-tentando $phase com sessão NOVA"
  run_phase "$phase"
  if gate_"$phase"; then ok "gate $phase: $GATE_WHY"; return 0; fi
  bad "gate $phase ainda não: $GATE_WHY"
  return 3
}

cmd_version() { info "sdd $SDD_VERSION ($SDD_HOME)"; }

cmd_help() {
  cat <<'EOF'
sdd — runner do pipeline de agentes autônomos de desenvolvimento

USO
  sdd install [--force]      instala o kit no repo-alvo (.sdd/config.sh + .claude/agents/)
  sdd preflight              sensor de ambiente: ferramentas, auth, config, plugins, git
  sdd status <missão>        onde a missão está, gate a gate, e o que falta
  sdd run <missão>           executa da primeira fase não satisfeita até o PR
  sdd retry <missão>         re-tenta a fase corrente com sessão nova
  sdd close <missão>         pós-merge: fecha a issue do JIRA
  sdd help | sdd version

PARA SCRIPT
  sdd phase <missão>         imprime só a fase corrente (ou DONE)
  sdd why <missão> [FASE]    imprime por que o gate daquela fase não passou

OPÇÕES DE `run`
  --dry-run                  imprime os prompts de boot e sai, sem gastar token e sem tocar
                             nos artefatos da missão (os gates rodam TEST_CMD de verdade)
  --phase <FASE>             força uma fase específica (PLAN|TICKET|EXEC|QA|REVIEW|DOCS|PR)
  --max-phases <N>           para depois de N fases (default: sem limite)

COMO O ESTADO FUNCIONA
  Não há arquivo de estado. A fase corrente é derivada dos artefatos em
  docs/handoffs/<missão>/. Sessão morreu? `sdd run` de novo continua do ponto exato.
  Nenhum gate é satisfeito por texto do modelo — o runner roda os testes e lê o disco.
EOF
}

# ---------------------------------------------------------------------------
main() {
  local subcmd="${1:-help}"
  shift || true
  case "$subcmd" in
    install)   cmd_install "$@" ;;
    preflight) cmd_preflight "$@" ;;
    status)    cmd_status "$@" ;;
    phase)     cmd_phase "$@" ;;
    why)       cmd_why "$@" ;;
    run)       cmd_run "$@" ;;
    retry)     cmd_retry "$@" ;;
    close)     cmd_close "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h) cmd_help ;;
    *) die "comando desconhecido: $subcmd (veja 'sdd help')" ;;
  esac
}

# Pós-merge: fecha a issue do JIRA. Disparado pelo humano depois do merge — é a única coisa
# que acontece DEPOIS do gate humano, e por isso não faz parte de `sdd run`.
cmd_close() {
  load_config
  resolve_mission "${1:-}"
  PIPELINE_LOG="$(log_dir)/pipeline.log"

  [ "$JIRA_ENABLED" = "true" ] || { info "JIRA_ENABLED=false — nada a fechar"; return 0; }
  local issue; issue="$(frontmatter "$MISSION_DIR/10-ticket.md" issue)"
  [ -n "$issue" ] || die "não achei 'issue:' em 10-ticket.md — a fase TICKET rodou?"

  local prurl; prurl="$(frontmatter "$MISSION_DIR/50-pr.md" pr_url)"
  if [ -n "$prurl" ]; then
    local merged
    merged="$( cd "$REPO_ROOT" && gh pr view "$prurl" --json state --jq .state 2>/dev/null || true )"
    if [ "$merged" != "MERGED" ]; then
      die "o PR $prurl está '$merged', não MERGED — 'sdd close' é pós-merge"
    fi
  fi

  step "fechando $issue"
  local sid logfile rc=0
  sid="$(uuidgen)"
  logfile="$(log_dir)/CLOSE-$(date +%Y%m%d-%H%M%S).json"
  mkdir -p "$(dirname "$logfile")"
  ( cd "$REPO_ROOT" && claude -p "/ticket close $issue" \
      --model "$MODEL_TICKET" --permission-mode "$PERMISSION_MODE" --output-format json \
      --setting-sources "user,project,local" --allowedTools "$ALLOWED_TOOLS" \
      --session-id "$sid" --max-budget-usd "$BUDGET_PER_PHASE_USD" ) > "$logfile" 2>&1 || rc=$?
  pipeline_log_line "$(date -Iseconds)  CLOSE  issue=$issue  sessao=$sid  rc=$rc  log=$logfile"
  [ "$rc" -eq 0 ] && ok "$issue fechada" || bad "falha ao fechar $issue — ver $logfile"
  return "$rc"
}

main "$@"
