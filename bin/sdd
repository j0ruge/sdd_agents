#!/usr/bin/env bash
#
# sdd — runner for the autonomous development agent pipeline.
#
# Core principle: there is NO state file. The current phase is DERIVED from the artifacts on
# disk. That gives resume for free after any session death, and eliminates the whole class of
# bug where "the state lies about the disk".
#
# Principle no. 2: success is never the model's answer. Every gate is re-evaluated here — by
# running the tests, grepping the checkpoint, reading the git log, asking gh.
#
# Usage: sdd <command> [mission] [options]   ·   `sdd help` for the list.

set -euo pipefail

readonly SDD_VERSION="0.1.0"

# Associative arrays (the sensor cache) need bash 4. macOS ships bash 3.2 as /bin/bash; failing
# here beats failing with "bad substitution" halfway through a phase.
#
# Bash 4 is necessary and NOT sufficient, and the old message ("On macOS: brew install bash")
# promised otherwise. The kit assumes the GNU userland: `md5sum` and `date -Iseconds` and
# `sort -V` in this file, `sed -i` with no argument (43x) and `grep -P` (1x) across the suite —
# every one of them rejected by the BSD tools macOS ships. Telling someone that fixing bash is
# enough is a message that promises a world which does not exist, which is the same defect the
# gates exist to forbid. So this one stops at what it can honestly claim, and `sdd preflight`
# measures the userland instead of assuming it.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  printf 'error: sdd needs bash 4+ (found: %s) and the GNU userland.\n' "${BASH_VERSION:-unknown}" >&2
  printf '  macOS: brew install bash coreutils gnu-sed grep, then put the gnubin dirs first in\n' >&2
  printf '  PATH — brew names them gmd5sum/gdate, and the kit calls md5sum/date.\n' >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# SDD_HOME resolution (survives being called through a symlink in ~/.local/bin)
#
# ⚠️ `CDPATH=''` on both `cd`s, and it is load-bearing here for the same reason it is in
# ledger_repo_root. `dirname` of a relative invocation (`./bin/sdd`, `bin/sdd`, a relative symlink
# target) is RELATIVE, and bash searches $CDPATH for any operand that does not begin with `/`, `.`
# or `..` — printing the directory it found on stdout, straight into this capture. Both failures
# land on SDD_HOME, which is `readonly` one line below and from which every template, agent and
# starter config is read: the wrong directory silently, or a two-line value that is not a path at
# all. Reachable from an env var on a machine whose $CDPATH names any directory holding a `bin`.
# The sensor is rule 2 of tests/check-pipefail.sh.
# ---------------------------------------------------------------------------
_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(CDPATH='' cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    if [[ $src != /* ]]; then src="$dir/$src"; fi
  done
  CDPATH='' cd -P "$(dirname "$src")/.." && pwd
}
SDD_HOME="$(_resolve_self)"
readonly SDD_HOME

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=''; C_DIM=''; C_BOLD=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''
fi

info() { printf '%s\n' "$*"; }
step() { printf '%s▸%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()   { printf '%s  ok%s   %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s  warn%s  %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
bad()  { printf '%s  fail%s  %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
die()  { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Target repo and configuration
# ---------------------------------------------------------------------------
REPO_ROOT=""
CONFIG_FILE=""

resolve_repo_root() {
  REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "not inside a git repository (cwd: $PWD)"
  CONFIG_FILE="$REPO_ROOT/.sdd/config.sh"
}

# Defaults + validation. An empty required key fails HERE, before spending a session.
load_config() {
  resolve_repo_root
  [ -f "$CONFIG_FILE" ] \
    || die "$CONFIG_FILE does not exist. Run 'sdd install' at the root of the target repo."
  bash -n "$CONFIG_FILE" || die "$CONFIG_FILE has a bash syntax error"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  : "${PROJECT_NAME:=}"; : "${DEFAULT_BRANCH:=}"; : "${TEST_CMD:=}"
  : "${E2E_CMD:=}"; : "${E2E_DIR:=e2e}"; : "${LINT_CMD:=}"; : "${BUILD_CMD:=}"
  : "${APP_URL:=}"; : "${DEV_UP_CMD:=}"; : "${DEV_READY_CMD:=}"; : "${DEV_READY_TIMEOUT:=90}"
  : "${HANDOFF_DIR:=docs/handoffs}"; : "${QA_DOCS_PATH:=docs/qa}"; : "${TODO_FILE:=TODO.md}"
  : "${MODEL_EXEC:=opus}"; : "${MODEL_QA:=opus}"; : "${MODEL_REVIEW:=opus}"
  : "${MODEL_DOCS:=opus}"; : "${MODEL_PUBLISH:=sonnet}"; : "${MODEL_TICKET:=sonnet}"
  : "${MODEL_KAIZEN:=opus}"
  : "${QA_MAX_ITER:=3}"; : "${REVIEW_MAX_ITER:=3}"; : "${EXEC_MAX_RETRY:=1}"
  : "${BUDGET_PER_PHASE_USD:=15}"; : "${PUBLISH_ON_REVIEW_BLOCKED:=off}"
  : "${PERMISSION_MODE:=acceptEdits}"; : "${JIRA_ENABLED:=false}"
  # `acceptEdits` auto-approves FILE EDITS, not `Bash`. Without this allowlist the phase session
  # cannot run TEST_CMD, cannot run `git add`/`git commit`, and the EXEC phase is unsatisfiable
  # by construction. Found by the fixture mission 20260814-dry-run-completo, which stalled on it.
  : "${ALLOWED_TOOLS:=Bash}"
  # Language of the mission ARTIFACTS (handoffs, checkpoint, commits, PR body) — not of the kit,
  # which is English. Empty ⇒ the boot prompt says nothing about language, which is exactly the
  # behaviour of every already-installed repo. Set ("pt-BR", "en", "es") ⇒ one extra paragraph.
  : "${OUTPUT_LANG:=}"

  [ -n "$PROJECT_NAME" ]   || die "PROJECT_NAME is empty in $CONFIG_FILE"
  [ -n "$DEFAULT_BRANCH" ] || die "DEFAULT_BRANCH is empty in $CONFIG_FILE"
  [ -n "$TEST_CMD" ]       || die "TEST_CMD is empty in $CONFIG_FILE (it is the EXEC gate)"
  case "$PERMISSION_MODE" in
    bypassPermissions) die "PERMISSION_MODE=bypassPermissions is not accepted by the kit" ;;
  esac
}

# ---------------------------------------------------------------------------
# Mission
# ---------------------------------------------------------------------------
MISSION=""
MISSION_DIR=""

# Accepts the full name (20260814-spinner) or a unique prefix/slug.
resolve_mission() {
  local want="${1:-}" base="$REPO_ROOT/$HANDOFF_DIR" matches=()
  [ -n "$want" ] || die "missing mission name (e.g. sdd status 20260814-spinner)"
  [ -d "$base" ] || die "$HANDOFF_DIR/ does not exist in the target repo — no mission planned yet"

  if [ -d "$base/$want" ]; then
    MISSION="$want"
  else
    local d
    while IFS= read -r d; do matches+=("$(basename "$d")"); done \
      < <(find "$base" -mindepth 1 -maxdepth 1 -type d -name "*${want}*" | sort)
    case "${#matches[@]}" in
      0) die "mission '$want' not found in $HANDOFF_DIR/" ;;
      1) MISSION="${matches[0]}" ;;
      *) die "'$want' is ambiguous: ${matches[*]}" ;;
    esac
  fi
  MISSION_DIR="$base/$MISSION"
}

# ---------------------------------------------------------------------------
# Reading artifacts
# ---------------------------------------------------------------------------

# frontmatter <file> <key> → value (empty when absent)
frontmatter() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -v k="$key" '
    NR==1 && $0=="---" { inside=1; next }
    inside && $0=="---" { exit }
    inside {
      idx = index($0, ":")
      if (idx == 0) next
      name = substr($0, 1, idx-1)
      gsub(/^[ \t]+|[ \t]+$/, "", name)
      if (name == k) {
        val = substr($0, idx+1)
        gsub(/^[ \t]+|[ \t]+$/, "", val)
        gsub(/^["'\'']|["'\'']$/, "", val)
        print val
        exit
      }
    }' "$file"
}

# frontmatter_write <file> <key> <value> — rewrites ONE key, in place, and nothing else.
#
# The counterpart of frontmatter(), which is read-only: closing the PLAN gate by hand was the only
# way to approve a plan, and a command that does it for the human has to write with the same
# precision the reader expects.
#
# Scoped to the block between the FIRST two `---` lines, never the whole file: a mission body is
# prose that legitimately quotes its own frontmatter (this repo's 00-missao.md writes
# "aprovacao: humano-YYYY-MM-DD" inside a sentence), and a file-wide substitution would rewrite the
# prose too, silently.
#
# awk with index(), never sed: the replacement value would go through sed's own syntax, where `&`
# means "the whole match" and `/` ends the expression — a mission title carrying either character
# is ordinary, and the corruption would land in a committed artifact. index()/substr() also dodge
# the mawk trap of the house (a negated class with a multibyte character negates its BYTES).
#
# Only the FIRST occurrence of the key is rewritten, and an absent key is left absent — the caller
# verifies with frontmatter() and decides. Writing through a temporary and moving it into place
# keeps a failed awk from truncating an artifact that is already committed.
frontmatter_write() {
  local file="$1" key="$2" value="$3" tmp
  [ -f "$file" ] || die "frontmatter_write: $file does not exist"
  # `|| die`: a mission directory the human cannot write to (a root-owned checkout, a 555 dir) makes
  # mktemp fail, and under `set -e` the script would exit through mktemp's own message — no `error:`
  # prefix, no mention of sdd or the artifact. Same family as the cmd_health item in TODO.md.
  tmp="$(mktemp "${file}.XXXXXX")" || die "frontmatter_write: could not create a temporary beside $file"
  awk -v k="$key" -v v="$value" '
    NR==1 && $0=="---" { inside=1; print; next }
    inside && $0=="---" { inside=0; print; next }
    inside && !written {
      idx = index($0, ":")
      if (idx > 0) {
        name = substr($0, 1, idx-1)
        gsub(/^[ \t]+|[ \t]+$/, "", name)
        if (name == k) { printf "%s: %s\n", k, v; written=1; next }
      }
    }
    { print }
  ' "$file" > "$tmp" || { rm -f "$tmp"; die "frontmatter_write: awk failed on $file"; }
  # mktemp creates 0600; without this the artifact would come out of an approval readable only by
  # whoever approved it. Git would not show the change (it tracks the exec bit only), which is what
  # makes it worth a line here instead of a bug report later.
  chmod --reference="$file" "$tmp" 2>/dev/null || true
  # `-f`: GNU mv ASKS before replacing a destination the user cannot write to, and only when stdin
  # is a terminal — which is exactly this command's situation. Without it a second, untranslated,
  # git-plumbing-flavoured question appears right after the [y/N] prompt and eats a line of the
  # human's stdin, and whether it appears at all depends on whether a human is watching. The
  # writability question was already answered by mktemp succeeding in that same directory.
  mv -f "$tmp" "$file" || { rm -f "$tmp"; die "frontmatter_write: could not replace $file"; }
}

# Checkpoint table rows as "ID<TAB>title<TAB>check<TAB>status<TAB>commit".
# Skips the header, the separator, and any line that does not have the 5 columns.
checkpoint_rows() {
  local file="$MISSION_DIR/checkpoint.md"
  [ -f "$file" ] || return 0
  awk -F'|' '
    /^[ \t]*\|/ {
      if (NF < 6) next
      for (i = 2; i <= 6; i++) { gsub(/^[ \t]+|[ \t]+$/, "", $i) }
      if ($2 == "ID" || $2 ~ /^-+$/ || $2 == "") next
      if ($5 == "Status") next
      printf "%s\t%s\t%s\t%s\t%s\n", $2, $3, $4, $5, $6
    }' "$file"
}

# Runs a config command at the root of the target repo; returns its exit code.
# Output goes to the mission log (when there is a mission) — it never pollutes the runner stdout.
#
# Memoized per process: `sdd status` evaluates seven gates and three of them run TEST_CMD.
# Without the cache, looking at the state would cost three suite runs. The cache dies with the
# process, so `sdd run` always re-evaluates after a phase has touched the code.
declare -A _CHECK_RC=()
declare -A _CHECK_LOG=()
LAST_CHECK_LOG=""

run_check_cmd() {
  local cmd="$1" label="${2:-check}" logfile rc=0
  [ -n "$cmd" ] || return 0
  if [ -n "${_CHECK_RC[$cmd]+x}" ]; then
    LAST_CHECK_LOG="${_CHECK_LOG[$cmd]}"
    return "${_CHECK_RC[$cmd]}"
  fi
  logfile="$(log_dir)/${label}-$(date +%H%M%S).log"
  mkdir -p "$(dirname "$logfile")"
  ( cd "$REPO_ROOT" && eval "$cmd" ) >"$logfile" 2>&1 || rc=$?
  _CHECK_RC[$cmd]="$rc"
  _CHECK_LOG[$cmd]="$logfile"
  LAST_CHECK_LOG="$logfile"
  return "$rc"
}

# Invalidates the sensor cache — called after any phase that touched the repo.
invalidate_checks() { _CHECK_RC=(); _CHECK_LOG=(); }

log_dir() {
  if [ -n "$MISSION" ]; then printf '%s\n' "$REPO_ROOT/.sdd/logs/$MISSION"
  else printf '%s\n' "$REPO_ROOT/.sdd/logs/_geral"; fi
}

# Last file of a glob. Empty when there is none.
#
# `sort -V`, never plain `sort`: the names this is called with carry a COUNTER (`40-review-r<N>`),
# and lexicographically `r10` lands between `r1` and `r2` — so from the tenth round on the gate
# would read `r3`, an old and already-approved review, while the round that actually ran sits
# unread. Asserted in tests/check-gates.sh with the r1/r2/r3/r10 fixture.
#
# This comment used to end "version order also keeps the dated names (`YYYY-MM-DD-*`) in the order
# plain `sort` gave them, so the qa call sites are unaffected", citing that same fixture. Both
# halves were wrong, and the citation was the worse half: r1/r2/r3/r10 exercises the REVIEW glob
# and says nothing whatsoever about the dated one. Measured on two same-day reports —
#
#   plain sort | tail -1  ->  2026-01-01-fixture.md
#   sort -V    | tail -1  ->  2026-01-01-fixture-final.md
#
# — because filevercmp special-cases the `.md` suffix and compares the stems, while plain `sort`
# compares `-` (0x2D) against `.` (0x2E) and puts `-final` first. Drop the suffix and the two
# orders agree, which is why reading the code convinced three sessions in a row.
#
# So the qa call sites (`:346`, `:550`) DID change behaviour, and for the better: among same-day
# reports the later-named round now wins instead of losing to the shorter stem. That is no longer
# a claim — it is pinned by its own differential fixture in tests/check-gates.sh, next to this
# one, which goes red the moment either ordering changes under it.
latest_matching() {
  local pattern="$1"
  # `|| true`: with no match, `ls` fails and `pipefail` would propagate the error into the
  # caller's assignment — inside a gate that would read as a silent failure instead of "absent".
  # shellcheck disable=SC2012,SC2086
  ls -1d $pattern 2>/dev/null | sort -V | tail -1 || true
}

# plan_approves_itself → 0 when the mission on disk is a kaizen-born plan carrying `aprovacao: auto`
#
# ONE definition, because two places read it and they must never disagree: gate_PLAN refuses this
# state, and cmd_approve must NOT mistake it for an approval already given. That disagreement is
# not hypothetical — it is the bug this function was extracted to close (found by sdd-qa in mission
# 20260816-portas-do-humano): the gate named `sdd approve` as the one way out while approve read
# the same `auto` as "already approved — nothing to do", so the only remedy the runner printed was
# the one thing it refused to do, and the loop had no exit but hand-editing the frontmatter.
#
# `auto` carries ONE premise: the PLAN-AUTO table was filled with the human in the room. A plan
# born of `sdd kaizen` had no human in the room — the kit planned its own next change — so `auto`
# there is the machine certifying its own homework. agents/sdd-kaizen.md orders the born plan to
# ship with `aprovacao:` empty and gate_KAIZEN refuses to hand one over with the field filled, but
# both of those act at BIRTH: nothing stopped the field from being filled afterwards. A rule that
# lives only in prose is a rule the runner does not have.
#
# `05-verdict.md` beside the mission is the marker, and it is structural rather than agreed: the
# kaizen gate locates the verdict and takes its `dirname` as the born plan's home, so the two are
# siblings by construction. Read per MISSION and never per repo — `ls $HANDOFF_DIR/*/05-verdict.md`
# passes every assertion in this family and then refuses every `auto` in any repo that has ever run
# `sdd kaizen`, the kit's own included (measured in increment I4).
#
# Only `auto` is caught: with a human's own `humano-YYYY-MM-DD` the mission runs, verdict and all,
# or the kit's improvement loop would have no terminating state.
plan_approves_itself() {
  [ "$(frontmatter "$MISSION_DIR/00-missao.md" aprovacao)" = "auto" ] \
    && [ -f "$MISSION_DIR/05-verdict.md" ]
}

# ---------------------------------------------------------------------------
# Gates — each returns 0 (satisfied) or 1, writing the reason into GATE_WHY.
# WARNING: no gate may be satisfied by model text. Artifacts only.
# ---------------------------------------------------------------------------
GATE_WHY=""

gate_PLAN() {
  local m="$MISSION_DIR/00-missao.md" p="$MISSION_DIR/01-plano.md" c="$MISSION_DIR/checkpoint.md"
  local f
  for f in "$m" "$p" "$c"; do
    [ -f "$f" ] || { GATE_WHY="missing $(basename "$f") — the planning phase is interactive: run sdd-planner"; return 1; }
  done
  local approval; approval="$(frontmatter "$m" aprovacao)"
  case "$approval" in
    auto)          : ;;
    humano-*)      : ;;
    # The remedy is named here for the same reason it is named in the kaizen-born branch below,
    # and this is the branch where it matters most: an empty `aprovacao:` is where EVERY
    # human-approved plan starts, so this is the common stall, not the exotic one. Without the
    # command on screen the reason reads as an instruction to type `humano-YYYY-MM-DD` into the
    # frontmatter by hand — the precise failure `sdd approve` exists to end, printed by the gate
    # that ends it. The mission name rides along because `sdd approve` with no argument resolves
    # the LATEST mission, which in a repo with two open ones is the wrong one.
    *) GATE_WHY="00-missao.md has 'aprovacao: ${approval:-<empty>}' — it must be 'auto' (PLAN-AUTO all ✅) or 'humano-YYYY-MM-DD': run 'sdd approve $MISSION'"; return 1 ;;
  esac
  # This gate is what `sdd run` asks before spending a pipeline on a plan the kit wrote about
  # itself; the rule and the marker live with plan_approves_itself, which cmd_approve reads too.
  # The remedy is named in the reason because the alternative — a human hand-typing
  # `humano-YYYY-MM-DD` into the frontmatter — is the exact failure `sdd approve` exists to end,
  # and naming a remedy obliges the remedy to work: that obligation is asserted in
  # tests/check-gates.sh, invoking the command instead of simulating it with `sed`.
  if plan_approves_itself; then
    GATE_WHY="kaizen-born plan (05-verdict.md sits beside it) may not approve itself — a human must: run 'sdd approve $MISSION'"
    return 1
  fi
  if [ "$JIRA_ENABLED" = "true" ]; then
    local v; v="$(frontmatter "$m" versao)"
    if [ -z "$v" ] || [[ $v == \<* ]]; then
      GATE_WHY="JIRA_ENABLED=true requires 'versao:' filled in 00-missao.md (a human decision, never headless)"
      return 1
    fi
  fi
  local n; n="$(checkpoint_rows | wc -l)"
  [ "$n" -gt 0 ] || { GATE_WHY="checkpoint.md has no parseable increment row"; return 1; }
  GATE_WHY="plan approved ($approval), $n increment(s)"
  return 0
}

gate_TICKET() {
  if [ "$JIRA_ENABLED" != "true" ]; then GATE_WHY="JIRA_ENABLED=false — phase skipped"; return 0; fi
  local t="$MISSION_DIR/10-ticket.md"
  [ -f "$t" ] || { GATE_WHY="missing 10-ticket.md"; return 1; }
  local issue; issue="$(frontmatter "$t" issue)"
  [ -n "$issue" ] || { GATE_WHY="10-ticket.md has no 'issue:' in the frontmatter"; return 1; }
  if ! grep -qiE '^sprint:[[:space:]]*\S' "$t"; then
    GATE_WHY="10-ticket.md has no 'sprint:' — the issue must be IN THE ACTIVE SPRINT, not in the backlog"
    return 1
  fi
  GATE_WHY="issue $issue in the sprint"
  return 0
}

gate_EXEC() {
  local rows; rows="$(checkpoint_rows)"
  [ -n "$rows" ] || { GATE_WHY="checkpoint.md is empty"; return 1; }

  local id status commit pending=0 blocked=0 total=0
  while IFS=$'\t' read -r id _ _ status commit; do
    total=$((total + 1))
    case "$status" in
      done)
        if [ -z "$commit" ] || [ "$commit" = "—" ] || [ "$commit" = "-" ]; then
          GATE_WHY="increment $id is 'done' with no commit — a label is not an artifact"; return 1
        fi
        if ! ( cd "$REPO_ROOT" && git cat-file -e "${commit}^{commit}" 2>/dev/null ); then
          GATE_WHY="increment $id points at commit '$commit', which does not exist in the repository"; return 1
        fi
        # `cat-file -e` only says the OBJECT exists in the database — not that it is in the
        # branch history. After an amend/rebase/reset, a checkpoint quoting the old hash would
        # pass while pointing outside the history, and the commit can still vanish at gc with the
        # gate still green. That is exactly the "label, not artifact" failure the kit exists to
        # prevent, inside the gate itself. Measured by sdd-qa in mission
        # 20260814-dry-run-completo, with a real amend.
        if ! ( cd "$REPO_ROOT" && git merge-base --is-ancestor "$commit" HEAD 2>/dev/null ); then
          GATE_WHY="increment $id points at commit '$commit', which exists but is NOT in the history of HEAD (amend/rebase/reset?) — the gate demands a reachable artifact, not a loose object"
          return 1
        fi
        ;;
      pending|doing) pending=$((pending + 1)) ;;
      blocked)       blocked=$((blocked + 1)) ;;
      *) GATE_WHY="increment $id has invalid status '$status' (use pending|doing|done|blocked)"; return 1 ;;
    esac
  done <<< "$rows"

  if [ "$blocked" -gt 0 ]; then GATE_WHY="$blocked increment(s) 'blocked' — Jidoka: the line stops"; return 1; fi
  if [ "$pending" -gt 0 ]; then GATE_WHY="$pending of $total increment(s) still to execute"; return 1; fi

  if ! run_check_cmd "$TEST_CMD" "gate-exec-test"; then
    GATE_WHY="TEST_CMD failed ($TEST_CMD) — see $LAST_CHECK_LOG"; return 1
  fi
  [ -f "$MISSION_DIR/20-handoff-exec.md" ] \
    || { GATE_WHY="every increment done and the suite green, but 20-handoff-exec.md is missing"; return 1; }

  GATE_WHY="$total increment(s) done, suite green, handoff written"
  return 0
}

gate_QA() {
  local h="$MISSION_DIR/30-handoff-qa.md" report=""
  [ -f "$h" ] || { GATE_WHY="missing 30-handoff-qa.md"; return 1; }

  local st; st="$(frontmatter "$h" status)"
  if [ "$st" = "skipped" ]; then GATE_WHY="qa: skipped (diff has no user-visible change)"; return 0; fi
  if [ "$st" = "blocked" ]; then GATE_WHY="30-handoff-qa.md has status: blocked"; return 1; fi

  # Project with no interface: the qa-report/qa-execution skills never ran (qa_substep sends it
  # straight to sdd-qa), so the docs/qa/ tree does not exist. Demanding their dated report would
  # charge for an artifact nobody produces — the gate would be unsatisfiable precisely in the
  # case where QA did the work and FOUND something. The evidence of the journey walked lives in
  # the `gate:` field of the handoff itself, which is the artifact that does exist here.
  # (Found by sdd-qa in mission 20260814-dry-run-completo: `skipped` would lie, `done` hit
  # Anchor 1 and `blocked` fails by definition — no status was both honest AND satisfiable.)
  if [ -z "$E2E_CMD" ] && [ -z "$APP_URL" ]; then
    local evidence; evidence="$(frontmatter "$h" gate)"
    if [ -z "$evidence" ]; then
      GATE_WHY="project with no interface: 30-handoff-qa.md needs 'gate:' carrying the evidence of the journey walked"
      return 1
    fi
  else
    # Anchor 1: the dated report from the qa-execution skill.
    report="$(latest_matching "$REPO_ROOT/$QA_DOCS_PATH/reports/*.md")"
    [ -n "$report" ] || { GATE_WHY="no report in $QA_DOCS_PATH/reports/"; return 1; }
    # Anchor on the qa-execution skill's report. The `**Status:**` does NOT start the line: its
    # template is `- **Started:** <ts> · **Status:** in-progress <!-- in-progress | closed -->`.
    # Requiring line start made the gate never match, and the runner re-ran qa-execution forever
    # — US$ 15 a round. Measured in the SQ-97 pilot.
    # The `closed` must come right after `**Status:**`: the template comment contains the word
    # `closed` in the enum legend, and a `.*closed` would match the `in-progress` line too.
    if ! report_closed "$report"; then
      GATE_WHY="report $(basename "$report") is not 'closed' (the enum belongs to the skill: in-progress|closed, do not translate)"
      return 1
    fi
    # Anchor 2: no row of the matrix may still read Pending.
    if grep -qE '\|[[:space:]]*Pending[[:space:]]*\|' "$report"; then
      GATE_WHY="report $(basename "$report") still has 'Pending' row(s) in the matrix"; return 1
    fi
  fi
  # Anchor 3: registry with no open bug. 'wont-fix'/'invalid' are human calls and do not block.
  local openbugs; openbugs="$( { grep -rlE '^\-[[:space:]]+\*\*Status:\*\*[[:space:]]+open' \
      "$REPO_ROOT/$QA_DOCS_PATH/bugs/" 2>/dev/null || true; } | wc -l )"
  if [ "$openbugs" -gt 0 ]; then
    GATE_WHY="$openbugs bug(s) with Status: open in the registry — they become fix increments (QA⇄EXEC loop)"
    return 1
  fi
  if ! run_check_cmd "$TEST_CMD" "gate-qa-test"; then
    GATE_WHY="TEST_CMD failed ($TEST_CMD) — see $LAST_CHECK_LOG"; return 1
  fi
  if [ -n "$E2E_CMD" ] && ! run_check_cmd "$E2E_CMD" "gate-qa-e2e"; then
    GATE_WHY="E2E_CMD failed ($E2E_CMD) — see $LAST_CHECK_LOG"; return 1
  fi
  if [ -n "${report:-}" ]; then
    GATE_WHY="report $(basename "$report") closed, registry clean, suites green"
  else
    GATE_WHY="journey walked without a browser interface (evidence in the handoff), suite green"
  fi
  return 0
}

gate_REVIEW() {
  local last; last="$(latest_matching "$MISSION_DIR/40-review-r*.md")"
  [ -n "$last" ] || { GATE_WHY="no 40-review-r<N>.md"; return 1; }

  # Documented anchor: the "### Overall Grade" section of the codereview skill (contract
  # v1.13.0+), table | Criterion | Grade | Rationale | on an A–F scale. The gate requires A on
  # EVERY row — "—" (not analysed) fails too: a partial review is not a review.
  local offending
  offending="$(awk '
      /^###[[:space:]]+Overall Grade/ { inside = 1; next }
      # Exit on ANY heading, not only `###`. Exiting only on `###`, a following section of a
      # HIGHER level (`## Fixes this round`) did not end the read, and the parser kept swallowing
      # later tables of the report — failing an all-Grade-A report because it found a `Commit`
      # column in a table of commits. Measured in the SQ-97 pilot.
      inside && /^#{1,6}[[:space:]]/ { exit }
      inside && /^[ \t]*\|/ {
        n = split($0, f, "|")
        if (n < 4) next
        crit = f[2]; grade = f[3]
        gsub(/\*/, "", crit);  gsub(/^[ \t]+|[ \t]+$/, "", crit)
        gsub(/\*/, "", grade); gsub(/^[ \t]+|[ \t]+$/, "", grade)
        if (crit == "Criterion" || crit ~ /^-+$/ || crit == "") next
        rows++
        if (grade != "A") { print crit " = " (grade == "" ? "<empty>" : grade); exit }
      }
      END { if (rows == 0) print "NO-TABLE" }
    ' "$last")"
  if [ "$offending" = "NO-TABLE" ]; then
    GATE_WHY="$(basename "$last") has no '### Overall Grade' section — the gate has nothing to measure"
    return 1
  fi
  if [ -n "$offending" ]; then
    GATE_WHY="$(basename "$last"): $offending — the gate requires Grade A on every criterion"; return 1
  fi
  if ! run_check_cmd "$TEST_CMD" "gate-review-test"; then
    GATE_WHY="TEST_CMD failed ($TEST_CMD) — see $LAST_CHECK_LOG"; return 1
  fi
  if [ -n "$(cd "$REPO_ROOT" && git status --porcelain)" ]; then
    GATE_WHY="working tree dirty after the review — fixes must be committed"; return 1
  fi
  GATE_WHY="$(basename "$last") all Grade A, suite green, tree clean"
  return 0
}

gate_DOCS() {
  local d="$MISSION_DIR/45-docs.md"
  [ -f "$d" ] || { GATE_WHY="missing 45-docs.md"; return 1; }
  if ! grep -qiE 'drift' "$d"; then
    GATE_WHY="45-docs.md has no drift checklist"; return 1
  fi
  # Every area touched must be ✅ or a justified n/a — one pending item fails the gate.
  #
  # Reads the `Status` COLUMN of the drift table, locating it by header position. The previous
  # version grepped the whole file for the word `TODO` and failed every `45-docs.md` that named
  # `TODO.md` — which is exactly what `sdd-docs` is required to do (checking the mission's TODO
  # entries is in its instructions). The gate contradicted the agent. Measured in the SQ-97
  # pilot: 0 `✗` items in the file and a failure all the same.
  local pending_cell
  pending_cell="$(awk -F'|' '
      # find the header and remember which column holds Status
      !col && /^[ \t]*\|/ {
        for (i = 2; i < NF; i++) {
          cell = $i; gsub(/^[ \t]+|[ \t]+$/, "", cell)
          if (cell == "Status") { col = i; next_is_sep = 1 }
        }
        if (col) next
      }
      col && /^[ \t]*\|/ {
        cell = $col; gsub(/^[ \t]+|[ \t]+$/, "", cell)
        if (cell ~ /^-+$/ || cell == "") next
        if (cell == "✅" || cell == "n/a" || cell == "N/A") next
        print cell; exit
      }
      col && !/^[ \t]*\|/ { exit }   # the table ended
    ' "$d")"
  if [ -n "$pending_cell" ]; then
    GATE_WHY="45-docs.md has an area with Status '$pending_cell' in the drift checklist — every row needs ✅ (with a hash) or a justified n/a"
    return 1
  fi
  GATE_WHY="drift checklist complete"
  return 0
}

gate_PR() {
  local p="$MISSION_DIR/50-pr.md"
  [ -f "$p" ] || { GATE_WHY="missing 50-pr.md"; return 1; }
  local url; url="$(frontmatter "$p" pr_url)"
  [ -n "$url" ] || { GATE_WHY="50-pr.md has no 'pr_url:' in the frontmatter"; return 1; }
  local live
  live="$( cd "$REPO_ROOT" && gh pr view "$url" --json url --jq .url 2>/dev/null )" || true
  [ -n "$live" ] || { GATE_WHY="gh does not confirm PR $url — 50-pr.md may be lying"; return 1; }
  GATE_WHY="PR open: $live"
  return 0
}

readonly PHASES="PLAN TICKET EXEC QA REVIEW DOCS PR"

# First phase whose gate is not satisfied. Empty ⇒ mission complete.
current_phase() {
  local ph
  for ph in $PHASES; do
    if ! "gate_$ph"; then printf '%s\n' "$ph"; return 0; fi
  done
  printf '%s\n' ""
}

# First phase AFTER <phase> whose gate is not satisfied. Empty ⇒ the list ended.
# It exists only for the dry-run projection: since the dry-run changes nothing on disk, calling
# current_phase() again would return the same phase forever — an infinite loop.
next_pending_phase() {
  local after="$1" ph seen=0
  for ph in $PHASES; do
    if [ "$seen" = "1" ] && ! "gate_$ph"; then printf '%s\n' "$ph"; return 0; fi
    if [ "$ph" = "$after" ]; then seen=1; fi
  done
  printf '%s\n' ""
}

# ---------------------------------------------------------------------------
# Phase invocation
# ---------------------------------------------------------------------------

# Model configured for the phase.
phase_model() {
  case "$1" in
    EXEC)   printf '%s\n' "$MODEL_EXEC" ;;
    QA)     printf '%s\n' "$MODEL_QA" ;;
    REVIEW) printf '%s\n' "$MODEL_REVIEW" ;;
    DOCS)   printf '%s\n' "$MODEL_DOCS" ;;
    PR)     printf '%s\n' "$MODEL_PUBLISH" ;;
    TICKET) printf '%s\n' "$MODEL_TICKET" ;;
    KAIZEN) printf '%s\n' "$MODEL_KAIZEN" ;;
    *)      printf '%s\n' "$MODEL_EXEC" ;;
  esac
}

# QA sub-step, DERIVED from the artifacts — same philosophy as the gates, no extra state.
# The QA phase is three sessions: the qa-report/qa-execution skills carry
# `disable-model-invocation`, so each one has to enter through the literal slash as the opening
# prompt of ITS OWN session (verified on 2026-08-14: the slash expands headless and the skill
# loads). sdd-qa closes the cycle afterwards.
# Is the qa-execution skill's dated report closed?
#
# ONE function, used by the gate AND by the sub-step. The anchor used to live duplicated in
# both; fixing it in a single place made `gate_QA` accept the report while `qa_substep` still
# believed execution was pending — and the runner re-ran qa-execution at US$ 15 a round. A
# duplicated contract is a contract that diverges; the duplication was the bug, not the regex.
#
# Anchor details: `**Status:**` does NOT start the line (the template is
# `- **Started:** <ts> · **Status:** in-progress <!-- in-progress | closed -->`), and `closed`
# has to come right after `**Status:**` — a `.*closed` would match the enum legend in the
# comment, approving a report that is still in progress.
report_closed() {
  local report="${1:-}"
  [ -n "$report" ] || return 1
  grep -qE '^[[:space:]]*-.*\*\*Status:\*\*[[:space:]]*closed' "$report"
}

qa_substep() {
  local qa="$REPO_ROOT/$QA_DOCS_PATH" report
  # Project with no interface to walk (no E2E_CMD and no APP_URL): the in-persona dogfooding
  # skills have nothing to do. Straight to sdd-qa, which judges whether the diff is user-visible
  # and, when it is not, writes `qa: skipped` with the justification. Bootstrapping a tree of
  # browser journeys in a project with no browser is the paperwork `skipped` exists to avoid.
  if [ -z "$E2E_CMD" ] && [ -z "$APP_URL" ]; then printf 'close\n'; return 0; fi
  [ -n "$(latest_matching "$qa/charters/*.md")" ] || { printf 'plan\n'; return 0; }
  report="$(latest_matching "$qa/reports/*.md")"
  if ! report_closed "$report"; then printf 'exec\n'; return 0; fi
  printf 'close\n'
}

# Step identifier: the phase, or `QA:<sub-step>`.
phase_step() {
  case "$1" in
    QA) printf 'QA:%s\n' "$(qa_substep)" ;;
    *)  printf '%s\n' "$1" ;;
  esac
}

# Agent responsible for the step. Empty ⇒ the slash skill drives, not a kit agent
# (two system prompts fighting over one session is noise, not reinforcement).
phase_agent() {
  case "$1" in
    EXEC)      printf '%s\n' "sdd-executor" ;;
    QA:plan)   printf '%s\n' "" ;;
    QA:exec)   printf '%s\n' "" ;;
    QA:close|QA) printf '%s\n' "sdd-qa" ;;
    REVIEW)    printf '%s\n' "sdd-reviewer" ;;
    DOCS)      printf '%s\n' "sdd-docs" ;;
    PR)        printf '%s\n' "sdd-publisher" ;;
    TICKET)    printf '%s\n' "sdd-publisher" ;;
    KAIZEN)    printf '%s\n' "sdd-kaizen" ;;
    *)         printf '%s\n' "" ;;
  esac
}

# Literal slash that opens the session, when the phase is driven by a third-party skill.
phase_slash() {
  case "$1" in
    QA:plan) printf '/qa-report %s\n' "$QA_DOCS_PATH" ;;
    QA:exec) printf '/qa-execution %s\n' "$QA_DOCS_PATH" ;;
    TICKET)  printf '/ticket open %s\n' "$(frontmatter "$MISSION_DIR/00-missao.md" titulo)" ;;
    *)       printf '%s\n' "" ;;
  esac
}

phase_task() {
  case "$1" in
    EXEC)     printf '%s\n' "execute the NEXT pending increment of the checkpoint, in TDD, and commit" ;;
    QA:plan)  printf '%s\n' "plan the QA cycle for this mission: personas, journeys, scenarios and charters" ;;
    QA:exec)  printf '%s\n' "walk the journeys in persona and write the dated report + the bug registry" ;;
    QA:close|QA) printf '%s\n' "close the QA cycle: a confirmed finding becomes an e2e spec, a fixable bug becomes a fix increment, and write 30-handoff-qa.md" ;;
    REVIEW)   printf '%s\n' "review and fix, INSIDE this session, until every criterion is Grade A" ;;
    DOCS)     printf '%s\n' "sync the repo's living documentation with what this mission changed" ;;
    PR)       printf '%s\n' "push and open the PR carrying the evidence from the earlier phases" ;;
    TICKET)   printf '%s\n' "open the mission's JIRA issue, already in the active sprint, and record 10-ticket.md" ;;
    KAIZEN)   printf '%s\n' "judge the previous kit change, triage $TODO_FILE and give birth to the kit's next mission plan" ;;
    *)        printf '%s\n' "" ;;
  esac
}

# Extra per-phase instruction, when the phase has a loop of its own to drive.
phase_extra() {
  case "$1" in
    REVIEW) cat <<'EOF'

Drive the review → fix → re-review loop INSIDE this session, with the QA report in hand, until
the "### Overall Grade" table closes with A on EVERY criterion. (The `/goal` command does NOT
exist in this environment — verified; the loop is yours.) Fixes go committed: the gate requires
a clean working tree. If the session ends without closing, write 40-review-r<N>.md with the REAL
grade — the runner opens a fresh session to continue. A grade inflated to pass the gate switches
off the mission's only quality sensor.
EOF
    ;;
    QA:plan|QA:exec) cat <<'EOF'

The skill above owns the docs/qa/ tree — follow its instructions. When you finish, commit what
it wrote. Do not write a handoff and do not touch the checkpoint: that belongs to the next step.
EOF
    ;;
    *) printf '' ;;
  esac
}

# Boot protocol — fixed, short, and always the same. Everything the session needs to know is on
# disk; this prompt only says WHERE to look and that there was no earlier conversation.
#
# When the phase is driven by a third-party skill, the literal slash has to be the FIRST line of
# the prompt: that is how it expands headless (the QA skills carry disable-model-invocation, so
# there is no other route).
boot_prompt() {
  local step="$1" slash agent lang_line=""
  slash="$(phase_slash "$step")"
  agent="$(phase_agent "$step")"
  # The kit is English; the ARTIFACT speaks whatever language the target repo declared. Empty ⇒
  # nothing is said, and the prompt stays byte for byte what it was before this key existed.
  if [ -n "$OUTPUT_LANG" ]; then
    lang_line="
Write EVERY artifact of this mission — handoffs, checkpoint, commit messages and PR body — in:
$OUTPUT_LANG. Identifiers, config keys and status tokens (pending, done, blocked, auto, skipped)
stay in English: they are contract, not prose.
"
  fi
  # KAIZEN is the meta-loop, not a mission phase: there is no 00-missao/01-plano/checkpoint to
  # read — the session's first act is running the deterministic series. An early return keeps the
  # mission-phase prompt below byte for byte untouched (the RUN_ignores_output_lang mutation
  # watches part of that; the rest is contract with every already-installed repo).
  if [ "$step" = "KAIZEN" ]; then
    # ADR 0001 splits the judge in two halves that must read ONE series: the runner derives the
    # numbers, the agent gives the verdict citing them. `gate_KAIZEN` reads its half by calling
    # kaizen_series IN PROCESS, so every ledger option the invocation carries reaches it — the
    # prompt below hands the agent a WRITTEN command line, so an option reaches that half only if
    # it is written here. `--all-repos` reached the gate and not the prompt, and the cost is not a
    # wrong number: the prompt orders `kit_sha_judged:` to be the series' latest, the gate hunts
    # for its OWN latest, no verdict satisfies both, the runner retries once and the phase ends in
    # `BLOCKED in KAIZEN — no-progress`. Two opus sessions for a blocked row. The human who typed
    # the flag asked for the cross-project reading; honouring it on BOTH halves restores the
    # invariant without taking away the capability he asked for. Found by sdd-qa (BUG-1).
    local ledger_flags=""
    [ "$LEDGER_ALL_REPOS" = "1" ] && ledger_flags=" --all-repos"
    cat <<EOF
You are in phase KAIZEN of the kit \`$PROJECT_NAME\` — the meta-loop that judges the kit itself —
as the agent sdd-kaizen.

All of your state comes from disk. There was NO earlier conversation — nothing was "agreed"
before. Before anything else:
  1. run: "$SDD_HOME/bin/sdd" kaizen --series$ledger_flags
     That JSON is the deterministic series — your SOURCE OF TRUTH. Cite its numbers; NEVER
     recalculate them from the ledger (recalculating is a contract violation).
  2. read $TODO_FILE, CONTEXT.md and KAIZEN_LOG.md at the repo root
  3. read the kit history: git log --oneline -20
  4. read the artifact templates in $SDD_HOME/templates/
$lang_line
Your task in this session: $(phase_task "$step").

Write the verdict to $HANDOFF_DIR/<YYYYMMDD>-<slug>/05-verdict.md — frontmatter keys \`verdict:\`
(melhorou | piorou | indeterminado), \`kit_sha_judged:\` (the series' latest kit_sha, or "none"),
\`date:\`. If guard.sufficient is false the verdict IS indeterminado — the guard belongs to the
runner and you never override it. If the verdict is piorou, STOP after the verdict and its
escalation section: no plan is born from a regression. Otherwise triage $TODO_FILE and write
00-missao.md (with \`aprovacao:\` EMPTY — the human approves, never you), 01-plano.md and
checkpoint.md beside the verdict, from the templates.

Write the artifacts to disk and commit. The runner re-evaluates the gate from outside — it reads
the files and the frontmatter. Your answer in text proves nothing and satisfies no gate. A
finding that does not fit this mission goes to $TODO_FILE, never to the diff.
EOF
    return 0
  fi
  [ -n "$slash" ] && printf '%s\n\n' "$slash"
  cat <<EOF
You are in phase $step of mission \`$MISSION\` in project \`$PROJECT_NAME\`${agent:+, as the agent $agent}.

All of your state comes from disk. There was NO earlier conversation — nothing was "agreed"
before. Read, in this order, before anything else:
  1. $HANDOFF_DIR/$MISSION/00-missao.md   (the intent and the metric)
  2. $HANDOFF_DIR/$MISSION/01-plano.md    (the how, and the context already verified — trust it)
  3. $HANDOFF_DIR/$MISSION/checkpoint.md  (the increment table)
  4. the most recent handoff in $HANDOFF_DIR/$MISSION/ (what already happened)
  5. .sdd/config.sh (TEST_CMD="$TEST_CMD"${E2E_CMD:+, E2E_CMD=\"$E2E_CMD\"})
$lang_line
Your task in this session: $(phase_task "$step").
$(phase_extra "$step")
Write the artifacts to disk and commit. The runner re-evaluates the gate from outside — it runs
the tests, checks the hashes in the git log, reads the files. Your answer in text proves nothing
and satisfies no gate. A finding that does not fit this mission goes to $TODO_FILE, never to the
diff.
EOF
}

PIPELINE_LOG=""
DRY_RUN=0

pipeline_log_line() {
  # The projection does not write to the journal. Precision matters here, because the easy
  # sentence ("dry-run touches nothing") is false: the gates run `TEST_CMD`/`E2E_CMD` for real
  # during the projection and write `.sdd/logs/<mission>/gate-*-test-*.log` — an explicit
  # decision of the plan. What `--dry-run` guarantees is narrower, and it is this: no `claude`
  # session is spent and no mission artifact is touched. Recording here an event that was only
  # PROJECTED lies in the audit trail, and in a freshly installed target repo (where `sdd
  # install` only ignores `.sdd/logs/`) the `pipeline.log` stays untracked and dirties the
  # working tree — a dirty tree fails `gate_REVIEW` and `sdd preflight`, meaning a projection
  # would knock down another phase's gate. The guard lives here, not in the callers, so it holds
  # for ALL of them: the escalation paths (checkpoint `blocked`, budget blown, two sessions with
  # no progress) are three, and a fourth added tomorrow would be born with the same defect.
  # Found by the QA phase of mission 20260814-dry-run-completo (F1).
  [ "$DRY_RUN" = "1" ] && return 0
  [ -n "$PIPELINE_LOG" ] || return 0
  mkdir -p "$(dirname "$PIPELINE_LOG")"
  printf '%s\n' "$*" >> "$PIPELINE_LOG"
}

# ---------------------------------------------------------------------------
# Autonomy ledger — the series the kaizen judge (I13.3) reads.
#
# It records FACTS only: attempts, whether the session moved the disk, rc, cost, the gate reason.
# No score. `ok|leve|refez` is a LABEL, and a runner that labels its own sessions is exactly the
# "label instead of artifact" every gate here exists to forbid — the judge derives the label from
# these facts, and can change its yardstick later without rewriting the past.
#
# Global on purpose (~/.sdd, not the target repo): "maturity across projects" cannot be measured
# in a per-repo file, and a file the runner writes BETWEEN phases inside the target repo would sit
# untracked and knock down gate_REVIEW and sdd preflight — the pipeline.log defect, fixed in
# 53cf63a by making that one ephemeral, a way out this ledger does not have because its whole
# point is to last.
AUTONOMY_RUN_ID=""
AUTONOMY_INVOCATION=""
AUTONOMY_WARNED=0
# Own one-shot flag, deliberately separate from AUTONOMY_WARNED (jq-missing): the two causes are
# unrelated, and one warning must not suppress the other — a repo with jq installed but the kit
# copied without .git still needs to hear about kit_sha:null, and vice versa.
AUTONOMY_SHA_WARNED=0

autonomy_log_path() { printf '%s/autonomy-log.jsonl' "${SDD_STATE_DIR:-$HOME/.sdd}"; }

# The repo a ledger row BELONGS to — one definition for the writer that stamps `repo` and for the
# three readers that filter on it. Not two spellings of the same question: writer and reader
# disagreeing about identity is a filter that silently excludes rows born in the repo you are
# standing in, which is exactly the defect below.
#
# `sdd autonomy` and `sdd kaizen --series` skip load_config on purpose (they answer a question
# about the LEDGER, not about a mission, and need no target configuration), so REPO_ROOT is still
# empty when they read and the identity has to be resolved from the cwd here. Deliberately NOT
# resolve_repo_root: that one dies, and dying is a worse answer than "nothing in this file is
# yours" for a command whose whole job is to report what the ledger holds.
#
# It is the shared `.git` and NOT `git rev-parse --show-toplevel`, because the toplevel is per
# WORKTREE: a mission run from `git worktree add` stamped a path the main checkout had never seen,
# and every reader outside that worktree counted the rows as `other_repo` — the series went empty
# in the isolation workflow this kit itself recommends. `--git-common-dir` is the same path from
# every worktree of one repo, and the three shapes it comes back in have to end at ONE string or
# the comparison the readers do (verbatim, no normalization on either side) is back to answering
# per worktree: RELATIVE at the root of a checkout (`.git`), relative in a subdirectory
# (`../.git`), absolute only from a linked worktree.
#
# `--path-format=absolute` (git 2.31+) is what collapses the three, and it replaced a hand-rolled
# `cd "$start" && cd "$common" && pwd -P` that needed a `CDPATH=''` guard on each `cd` to keep the
# ENVIRONMENT from answering "which repo is this". Asking git for the absolute path removes the
# class instead of guarding it: no cd, no pwd -P, no guard, nothing for a $CDPATH to redirect.
# Measured equal to the old spelling in all four shapes that matter — checkout root, subdirectory,
# bare repo, linked worktree — and through a symlinked path, where git resolves the link exactly as
# `pwd -P` did. The sensor is the differential pair in tests/check-autonomy.sh, which still runs a
# poisoned CDPATH at the runner and still demands two repos stay two, on one line each.
#
# ⚠️ Rows written BEFORE this carry the old per-worktree path and keep landing in `other_repo`.
# That is history, not a bug: the ledger is append-only and is never migrated.
ledger_repo_root() {
  local start="${REPO_ROOT:-$PWD}" gitdir
  # The identity IS the common dir, never its parent. `cd "$common/.."` was the first spelling and
  # it collapsed two repositories into one string in two shapes, both silently — `other_repo: 0`,
  # nothing excluded, nothing said, which is the very contamination the filter above exists to
  # report: in a SUBMODULE the common dir is `/parent/.git/modules/<name>`, so the parent is
  # `/parent/.git/modules` for EVERY submodule of that parent; in a BARE repo it is `.`, so the
  # parent is the directory that merely contains the repo, shared by every bare repo beside it.
  # `--show-toplevel` got both of those right and only worktrees wrong. The common dir gets all
  # three right, because it is the identity git itself keeps per repository.
  gitdir="$( git -C "$start" rev-parse --path-format=absolute --git-common-dir 2>/dev/null )" || return 0
  # ⚠️ ONE ABSOLUTE LINE, or this is not an answer — and the test is load-bearing on any git older
  # than 2.31, which is where `--path-format` was born. `git rev-parse` ECHOES a token it does not
  # recognize as an option straight back to stdout and still exits 0, so a pre-2.31 git answers TWO
  # lines here: the flag itself, then the common dir, still relative. `|| return 0` never fires (rc
  # is 0) and `-n` never fires (the string is not empty), so the first spelling of this guard let
  # `--path-format=absolute\n.git` through as the repository's IDENTITY — stamped into every ledger
  # row by `--arg repo`, newline and all, matching no reader and never migrated, because the ledger
  # is append-only.
  #
  # ⚠️ REFUSING is not enough, and returning empty here was a second defect wearing the first one's
  # clothes. Empty is the contract for "not a repo", so on git 2.25 (Ubuntu 20.04) and 2.30 (Debian
  # 11) EVERY row would be written `repo: ""`, every reader would file it under `no_repo` — a bucket
  # `--all-repos` deliberately does not admit — and `sdd autonomy` would answer "no data" while
  # `sdd kaizen` could only ever say `indeterminado`. Silent, permanent, and a REGRESSION: the
  # `cd`-based spelling this replaced answered CORRECTLY on those same gits.
  #
  # So the old spelling is the fallback, not the casualty. It is safe to keep now for the reason
  # that made it dangerous before: the `CDPATH=''` guards this mission added to the whole repo. The
  # fast path stays the one-shot `--path-format`; the slow path costs a second `rev-parse` and two
  # `cd`s, and only on a git that cannot do it in one. The sensor is the pre-2.31 differential pair
  # in tests/check-autonomy.sh, which asserts the two gits answer the SAME identity — not merely
  # that the new one does not leak.
  case "$gitdir" in
    /*) [ "$gitdir" = "${gitdir%%$'\n'*}" ] || gitdir="" ;;
    *)  gitdir="" ;;
  esac
  if [ -z "$gitdir" ]; then
    local common
    common="$( git -C "$start" rev-parse --git-common-dir 2>/dev/null )" || return 0
    [ -n "$common" ] || return 0
    # Relative at a checkout root (`.git`), relative in a subdirectory (`../.git`), absolute from a
    # linked worktree — `cd "$start"` first, then `cd "$common"`, resolves all three. Both `cd`s
    # carry the emptied CDPATH: with a relative operand the environment would otherwise pick where
    # this lands AND echo the path it found into the capture. That is the CRITICAL of
    # 20260817-eixo-do-juiz, and it is why this spelling was retired rather than deleted.
    gitdir="$( CDPATH='' cd "$start" && CDPATH='' cd "$common" && pwd -P )" || return 0
    [ -n "$gitdir" ] || return 0
    [ "$gitdir" = "${gitdir%%$'\n'*}" ] || return 0
  fi
  # Cosmetic, and ONLY cosmetic: `/repo/.git` prints back as `/repo`, so the ledger and the header
  # keep naming the root a human recognizes instead of a path inside `.git`. Injective, therefore
  # safe to collapse: exactly one repository can own `/repo/.git`. Withheld from a bare repo, whose
  # common dir is the repository itself and whose parent belongs to nobody.
  # ⚠️ The bare test is `core.bare` and NOT `rev-parse --is-bare-repository`, and the difference is
  # an identity split. `--is-bare-repository` answers about the ENTRY POINT, not the repository: for
  # a bare repo living in a directory named `.git` (`/x/.git`, the shape this very guard exists for)
  # it says `true` read from the repo and `false` read from a worktree of that same repo, so the
  # strip fired on one reading and not the other — measured, `/x/.git` and `/x`, one repository with
  # two identities, which is the defect the whole function exists to prevent. `core.bare` lives in
  # the config of the COMMON dir, so every worktree of a repository answers it the same way. Unset
  # (a repo some tool created without the key) reads empty and means not bare, the same direction
  # `!= "true"` already took.
  if [ "$( git -C "$start" config --bool --get core.bare 2>/dev/null )" != "true" ] \
     && [ "${gitdir##*/}" = ".git" ] && [ -n "${gitdir%/.git}" ]; then
    printf '%s' "${gitdir%/.git}"
  else
    printf '%s' "$gitdir"
  fi
}

# ONE definition of "this row was born in the repo I am standing in", spliced into every reader's
# jq program — the same rule that made is_escalation a single definition after the blocked/degraded
# pair was written out three times and the third copy stayed blind. Emitted as jq TEXT rather than
# evaluated per row in bash: a shell call per line would fork once per row, and — the reason that
# actually matters — a single definition is what lets mut_RUN_ledger_no_repo_filter prove that all
# the readers really go through it. Sabotage a call site and you have measured one call site.
#
# The ledger is global ON PURPOSE (one file per machine keeps cross-repo questions answerable); it
# is the READER that has to ask "mine?". Until it did, a `sdd run` in a /tmp fixture repo wrote
# three rows into the real ledger and the judge read `66% waste · 2 mission(s)` where the truth was
# `0% · 1` — the judge's own source of truth, contaminable by any test.
#
# A row that does not SAY where it came from cannot be attributed to any repo, and a filter that
# swallowed it in silence would be hiding corruption instead of reporting it. So it leaves the
# slice through a bucket of its OWN — `no_repo`, counted by every reader — and never through
# `other_repo`, which is a different accusation ("born elsewhere", not "born nowhere").
#
# ⚠️ This used to answer `true` for such a row: local in EVERY repo. The claim written here was
# that the readers classified them out loud anyway (one counting them `unrecognized`, the other
# dying naming the file), and for a row that is not an object at all that is still true — which is
# why THAT case is left alone below. For a well-formed session row it was false: `is_unrecognized`
# asks `.event`, never `.repo`. Three sessions naming no project walked into the slice and cleared
# the judge's floor of 3, measured in fixture — a guard moved by rows nobody can attribute, with
# nothing in the output saying so.
#
# `--all-repos` flips this ONE definition instead of adding a fourth spelling of the question to
# each reader: the flag reaching the predicate is the flag reaching every reader that an invocation
# carrying it can reach. ⚠️ NOT the post-pipeline reminder, whatever this said before — it is
# called from cmd_run alone, and `sdd run` has no --all-repos, so it always reads per repo. The
# twin of this comment in cmd_kaizen said the same false thing. It is a flag and not the default because
# the default is what got contaminated (d99a7fc) — but the ledger is one file per machine precisely
# so maturity stays comparable BETWEEN projects, and after the filter landed no reader could ask
# that question at all. Opt-in restores the cross-repo answer without restoring the contamination.
LEDGER_ALL_REPOS=0
ledger_row_is_local() {
  # Emitted alongside, never folded in: `no repo at all` and `some other repo` are two different
  # answers, each reader counts them into a bucket of its own, and `--all-repos` opens exactly one
  # of the two. A row that names no project is unattributable in every scope, so the flag does not
  # reach it — widening the question between projects is not the same as admitting rows that
  # belong to none.
  # `(.repo // "") == ""` and not `has("repo") | not`: the three shapes of "this row names no
  # project" are the key absent, the key present and null, and the key present and empty, and the
  # LAST is the one the writer produces — `autonomy_session_row` always passes `--arg repo "$repo"`
  # into `{… repo: $repo …}`, so the key is never missing and comes back `""` whenever
  # `ledger_repo_root` resolved nothing (a session run outside any git repo). Key-absent is the
  # shape the writer can never emit; it and the null arrive by hand edit or partial write, which is
  # precisely the corruption this bucket exists to report. All three are one answer here, which is
  # why the spelling covers them rather than testing for one. Under the old spelling
  # they fell through to `.repo == $repo` and were accused of being `other_repo` ("born elsewhere"),
  # a wrong reason printed with the confidence of a right one; and standing outside any git repo,
  # where $repo is itself empty, a `repo: ""` row compared EQUAL and was counted local in a repo
  # that does not exist.
  printf '%s' 'def ledger_row_no_repo: type == "object" and ((.repo // "") == "");'
  if [ "$LEDGER_ALL_REPOS" = "1" ]; then printf '%s' 'def ledger_row_is_local: ledger_row_no_repo | not;'; return 0; fi
  printf '%s' 'def ledger_row_is_local: if ledger_row_no_repo then false elif (type == "object" and has("repo")) then .repo == $repo else true end;'
}

# Publishes AUTONOMY_KIT_STAMP as "<sha>|<true|false>", or "|" when SDD_HOME is not a git checkout.
# This is the judge's before/after axis: without it, a change in the numbers gets attributed to the
# calendar instead of to the kit change that caused it.
#
# An out-param global and NOT a printed value, for the same reason run_phase publishes LAST_PHASE_*:
# read through `stamp="$(autonomy_kit_stamp)"`, the whole body would run in a SUBSHELL, and the
# `AUTONOMY_SHA_WARNED=1` below would die with it — the flag would be back to 0 on the next row and
# the one-shot warning would fire once per ledger row, which is the opposite of what it says. A
# guard that cannot hold is worse than no guard: it reads as measured and is not.
AUTONOMY_KIT_STAMP=""
autonomy_kit_stamp() {
  local sha
  sha="$( git -C "$SDD_HOME" rev-parse --short HEAD 2>/dev/null || true )"
  if [ -z "$sha" ]; then
    # Someone installed the kit as a plain copy, not a git checkout: every row born from here
    # gets kit_sha:null and is permanently EXCLUDED from the judge's comparable-sessions count —
    # not a crash, just months of silently non-comparable data. One-shot per process so it does
    # not repeat on every row of a long-running `sdd run`.
    [ "$AUTONOMY_SHA_WARNED" = "1" ] \
      || warn "$SDD_HOME is not a git checkout — autonomy rows get kit_sha:null and stay non-comparable forever"
    AUTONOMY_SHA_WARNED=1
    AUTONOMY_KIT_STAMP="|"; return 0
  fi
  if [ -n "$( git -C "$SDD_HOME" status --porcelain 2>/dev/null )" ]
  then AUTONOMY_KIT_STAMP="$sha|true"
  else AUTONOMY_KIT_STAMP="$sha|false"; fi
}

# EVERY row goes through here, so every guard holds for every caller. The guards do NOT live in
# the callers: the journal already paid that lesson — there are three escalation paths, and a
# fourth added tomorrow would be born with the defect.
autonomy_append() {   # autonomy_append <one json object, already built>
  # The projection must not write. Worse here than in the journal: a projected row does not just
  # lie in an audit trail, it enters the judge's arithmetic and shifts the metric forever.
  # NOTE: written as an `if` on purpose, not the journal's `&&`-form guard. The journal's exact
  # guard text is the unique sed anchor of mut_RUN_inverted_journal in the mutation catalogue;
  # reusing that text here would make the mutation sabotage two guards at once and stop measuring
  # what it claims to.
  if [ "$DRY_RUN" = "1" ]; then return 0; fi
  # Every caller builds its argument with `jq -cn` inside a command substitution. A jq failure
  # there yields an empty string, and swallowing it here in silence would leave a gap in the
  # ledger that JSONL gives no way to detect afterwards — the mission goes on, same as the
  # unwritable-file guard right below, so it gets the same warn.
  [ -n "${1:-}" ] || { warn "autonomy ledger row came out empty (jq failed to build it?) — the mission goes on, the row is lost"; return 0; }
  local file; file="$(autonomy_log_path)"
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  # A ledger the mission dies for is worse than a gap in the ledger: ~/.sdd unwritable or a full
  # disk warns and lets the phase carry on. Under `set -e` a failing `>>` would abort the runner.
  # One printf = one write(2) on an O_APPEND fd, which is what keeps two repos running at once
  # from interleaving. jq never writes to the file directly: its stdio may split the output.
  printf '%s\n' "$1" >> "$file" 2>/dev/null || {
    warn "could not write the autonomy ledger at $file — the mission goes on, the row is lost"
    return 0
  }
}

# ONE definition of "the ledger parses", for the same reason `is_escalation` and `mission_key` are
# one definition each. It was written twice, and the two copies did not disagree about the ANSWER —
# they disagreed about who checks: `cmd_autonomy` ran it and died loudly, `kaizen_series` never ran
# it at all, so the judge's own gate read a corrupt ledger as an empty series and reported "no
# verdict for kit  yet". Same file, same rows: one reader refusing to guess and the other guessing
# "pending". Every reader of the ledger calls this before believing a number.
ledger_parses() { jq -se . "$1" >/dev/null 2>&1; }

# Never a malformed row: broken JSONL is the one way the judge reads garbage believing it is data.
# jq is a hard dependency (preflight fails without it), so absence here is an anomaly, not a mode.
autonomy_have_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  [ "$AUTONOMY_WARNED" = "1" ] || warn "jq not found — the autonomy ledger is not being written"
  AUTONOMY_WARNED=1
  return 1
}

# An escalation spends no session, so the session fields are ABSENT rather than zeroed. `kind` is
# an enum and not prose because the judge must not parse sentences: they get rewritten, and the
# escalations mean different things — a deliberate Jidoka is not the same as burnt budget.
#
# `event` is a PARAMETER because there are two of them and they state different facts:
#   blocked  — the line stopped; the runner returns 3 and a human has to act.
#   degraded — the runner lowered its OWN bar and carried on (PUBLISH_ON_REVIEW_BLOCKED=draft).
# Reusing `blocked` for the second would have been cheaper — it inherits the kit_sha axis and the
# aggregation with no jq to touch — but it would record "stopped" for a run that went on, and the
# ledger exists to record fact. Everything ELSE about the two rows is one decision (the kit stamp,
# the gate_why cap, the absent session fields), so it lives here once and cannot drift apart.
autonomy_escalation_row() {   # autonomy_escalation_row <event> <kind> <phase> <gate_why>
  autonomy_have_jq || return 0
  # Called, never substituted: `$(autonomy_kit_stamp)` would reset its one-shot warning flag.
  autonomy_kit_stamp; local stamp="$AUTONOMY_KIT_STAMP"
  # "${4:0:200}" caps gate_why, and WHAT it counts is the locale's call — this comment used to
  # claim it counted characters unconditionally, true in only one of the two regimes.
  # Measured here (bash + glibc): under pt_BR.UTF-8 it yields 200 characters (400 bytes) and
  # never halves a codepoint; under LC_ALL=C it yields 200 BYTES — exactly the `head -c 200` it
  # replaced, half codepoint included. Neither the runner nor the suite pins LC_ALL, so both
  # regimes are reachable, and the honest claim is the weaker one: never WORSE than the head -c
  # it replaced, better whenever the locale is multibyte. That is why the fix here is the comment
  # and not a global LC_ALL — pinning the locale would move `sort` and `printf` across the whole
  # runner, a blast radius this gain does not pay for.
  # The damage when it DOES cut mid-codepoint is also smaller than the old text claimed: jq 1.7
  # here substitutes U+FFFD and exits 0 (measured) instead of rejecting the --arg, so the row
  # survives with a mangled last character rather than vanishing through the emptiness guard.
  # Substituted and NOT called, unlike autonomy_kit_stamp above: ledger_repo_root only prints, so
  # there is no global for the subshell to eat. And it, never $REPO_ROOT, is what the row carries:
  # $REPO_ROOT is the worktree the session runs IN, the row records the repo it BELONGS to, and
  # the readers filter on the second. No `#` inside the `\`-continued block below — a comment
  # there breaks the command in silence and `bash -n` says nothing.
  local repo; repo="$(ledger_repo_root)"
  autonomy_append "$( jq -cn \
    --arg ts "$(date -Iseconds)" --arg event "$1" --arg kind "$2" --arg phase "$3" \
    --arg why "${4:0:200}" \
    --arg run_id "$AUTONOMY_RUN_ID" --arg invocation "$AUTONOMY_INVOCATION" \
    --arg sha "${stamp%%|*}" --arg dirty "${stamp#*|}" \
    --arg project "$PROJECT_NAME" --arg repo "$repo" --arg mission "$MISSION" \
    '{v: 1, ts: $ts, event: $event, kind: $kind,
      run_id: $run_id, invocation: $invocation,
      kit_sha: (if $sha == "" then null else $sha end),
      kit_dirty: (if $dirty == "" then null else ($dirty == "true") end),
      project: $project, repo: $repo, mission: $mission, phase: $phase,
      gate_why: $why}' )"
}

# Called, never substituted, for the same reason the body above says: the kit stamp's one-shot
# warning flag is a global, and a subshell would reset it once per row.
autonomy_blocked_row()  { autonomy_escalation_row "blocked"  "$1" "$2" "$3"; }
autonomy_degraded_row() { autonomy_escalation_row "degraded" "$1" "$2" "$3"; }

# One row per session, written after the gate has been evaluated — the row carries the gate
# result, so it cannot be born before it.
autonomy_session_row() {  # <phase> <attempt> <auto_retry> <moved> <gate> <gate_why>
  autonomy_have_jq || return 0
  # Called, never substituted: `$(autonomy_kit_stamp)` would reset its one-shot warning flag.
  autonomy_kit_stamp; local stamp="$AUTONOMY_KIT_STAMP"
  # "${6:0:200}" caps gate_why under the same locale caveat as autonomy_escalation_row's
  # "${4:0:200}" above — characters when the locale is multibyte, bytes under C/POSIX.
  # Same identity as the escalation row above, for the same reason: one repo per row, resolved by
  # the one definition the readers also go through.
  local repo; repo="$(ledger_repo_root)"
  autonomy_append "$( jq -cn \
    --arg ts "$(date -Iseconds)" --arg phase "$1" --arg attempt "$2" \
    --arg auto_retry "$3" --arg moved "$4" --arg gate "$5" \
    --arg why "${6:0:200}" \
    --arg run_id "$AUTONOMY_RUN_ID" --arg invocation "$AUTONOMY_INVOCATION" \
    --arg sha "${stamp%%|*}" --arg dirty "${stamp#*|}" \
    --arg project "$PROJECT_NAME" --arg repo "$repo" --arg mission "$MISSION" \
    --arg step "$LAST_PHASE_STEP" --arg agent "$LAST_PHASE_AGENT" \
    --arg model "$LAST_PHASE_MODEL" --arg session "$LAST_PHASE_SID" \
    --arg rc "$LAST_PHASE_RC" --arg dur "$LAST_PHASE_DUR" --arg cost "$LAST_PHASE_COST" \
    '{v: 1, ts: $ts, event: "session",
      run_id: $run_id, invocation: $invocation,
      kit_sha: (if $sha == "" then null else $sha end),
      kit_dirty: (if $dirty == "" then null else ($dirty == "true") end),
      project: $project, repo: $repo, mission: $mission,
      phase: $phase, step: $step, agent: $agent, model: $model,
      attempt: ($attempt | tonumber? // null), auto_retry: ($auto_retry == "true"),
      session: $session,
      rc: ($rc | tonumber? // null),
      dur_s: ($dur | tonumber? // null),
      cost_usd: ($cost | tonumber? // null),
      moved: ($moved == "true"),
      gate: $gate, gate_why: $why}' )"
}

# The one `result` object of a stream-json session, or nothing. `tail -1` and not `head -1`: the
# terminal summary is the LAST one by definition, and a stream truncated by a killed session can
# hold a partial line that jq drops here rather than propagate as garbage downstream. Silent on a
# stream with no result — the callers already treat an unreadable summary as an unknown cost, the
# same answer the old single-blob format gave for a session that died before printing.
#
# `|| true` is load-bearing, and the same decision latest_matching() makes one screen up. jq exits
# 5 on the FIRST unparseable line — and a stream cut off by a killed session ends in exactly one of
# those — having already PRINTED every well-formed object before it, the terminal `result`
# included. Under this file's `set -euo pipefail` that 5 leaves the pipeline, leaves the function,
# and aborts the bare call in run_phase: measured, the whole run died with rc 5 having printed not
# one word, no journal line, no ledger row, and no gate ever evaluated — for a session whose
# summary had in fact been distilled correctly onto disk. The line above claims jq "drops" the
# partial line, and swallowing the exit status is what makes that claim true instead of half true.
# The OUTPUT is this function's contract, never the status: nothing on stdout already means
# "unknown cost" to every caller, and the corrupt stream itself stays on disk beside the `.err`
# for whoever reads the mangled session.
stream_summary() { # stream_summary <stream.jsonl>
  jq -c 'select(.type == "result")' "$1" 2>/dev/null | tail -1 || true
}

# The stream closed the blind spot for whoever runs `tail -f` on the file; this closes it for the
# person watching the run. `> "$streamfile"` takes claude's stdout off the terminal, so a phase
# used to print its banner and then nothing for the ten to thirty minutes it lasts.
#
# An observer BESIDE the session, never a `tee` in front of it: a pipeline would put the watcher's
# exit status where claude's has to be, and the phase rc is what the journal and the ledger record.
# Everything it writes goes to the runner's own stderr — the session's stderr belongs to its `.err`
# sibling, and mixing them would file the watcher's chatter as something the session said.
progress_wanted() { # 0=yes. `auto` (the default) means "a human is looking", i.e. a tty on fd 2
  case "${SDD_PHASE_PROGRESS:-auto}" in
    0|off|false) return 1 ;;
    1|on|true)   return 0 ;;
    *)           [ -t 2 ] ;;
  esac
}

stream_watch() { # stream_watch <stream.jsonl> — background; killed by run_phase when the phase ends
  local f="$1" seen=0 n tool
  # Printed BEFORE the polling loop, and that is not decoration: a phase that dies in its first
  # seconds would otherwise leave the same silence this function exists to end, and no fixture
  # short enough to run in a suite would ever reach the first tick.
  printf '  %s⋯ session started%s\n' "$C_DIM" "$C_RESET" >&2
  while :; do
    sleep 5
    [ -f "$f" ] || continue
    n="$(grep -c . "$f" 2>/dev/null || echo 0)"
    [ "$n" -gt "$seen" ] 2>/dev/null || continue
    seen="$n"
    tool="$(tail -5 "$f" 2>/dev/null \
      | jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "tool_use") | .name' 2>/dev/null \
      | tail -1 || true)"
    printf '  %s⋯ %s event(s)%s%s\n' "$C_DIM" "$n" "${tool:+ · $tool}" "$C_RESET" >&2
  done
}

# Runs a phase in a fresh headless session. Returns 0 when claude exited 0 (which does NOT mean
# the gate passed — the gate judges that, always afterwards).
run_phase() {
  local phase="$1" resume_sid="${2:-}"
  local pstep model agent sid prompt logfile streamfile started ended cost
  # QA is three sessions (plan, walk, close); the step comes from the artifacts, not a counter.
  pstep="$(phase_step "$phase")"
  model="$(phase_model "$phase")"
  agent="$(phase_agent "$pstep")"
  sid="$(uuidgen)"
  prompt="$(boot_prompt "$pstep")"
  if [ -n "$resume_sid" ]; then
    prompt="The gate for phase $phase failed: ${GATE_WHY}

Fix exactly that. Do not restart the phase: read what is already on disk, complete what is
missing and write the artifacts. The gate will be re-evaluated."
  fi

  local -a cmd=(claude -p "$prompt"
    --model "$model"
    --permission-mode "$PERMISSION_MODE"
    --output-format stream-json --verbose
    --setting-sources "user,project,local"
    --allowedTools "$ALLOWED_TOOLS"
    --max-budget-usd "$BUDGET_PER_PHASE_USD")
  if [ -n "$agent" ]; then cmd+=(--agent "$agent"); fi
  if [ -n "$resume_sid" ]; then cmd+=(--resume "$resume_sid" --fork-session)
  else cmd+=(--session-id "$sid"); fi

  if [ "$DRY_RUN" = "1" ]; then
    info ""
    printf '%s--- DRY RUN: phase %s ---%s\n' "$C_BOLD" "$pstep" "$C_RESET"
    printf '%scwd:%s   %s\n' "$C_DIM" "$C_RESET" "$REPO_ROOT"
    printf '%smodel:%s %s   %sagent:%s %s   %ssession:%s %s\n' \
      "$C_DIM" "$C_RESET" "$model" "$C_DIM" "$C_RESET" "${agent:-<none>}" \
      "$C_DIM" "$C_RESET" "${resume_sid:-$sid}"
    printf '%scommand:%s\n' "$C_DIM" "$C_RESET"
    printf '  %q' "${cmd[@]}"; printf '\n'
    printf '%sboot prompt:%s\n' "$C_DIM" "$C_RESET"
    printf '%s\n' "$prompt" | sed 's/^/  │ /'
    LAST_PHASE_SID="${resume_sid:-$sid}"
    return 0
  fi

  logfile="$(log_dir)/${phase}-$(date +%Y%m%d-%H%M%S).json"
  streamfile="${logfile%.json}.stream.jsonl"
  mkdir -p "$(dirname "$logfile")"
  started="$(date +%s)"
  step "phase $pstep — ${agent:-skill} ($model) — session ${resume_sid:-$sid}"

  local rc=0
  # The session writes STRAIGHT to the stream file, one JSON event per line, as it happens. Under
  # the old `--output-format json` this file was a single blob printed at exit: it sat at 0 bytes
  # for the ten minutes a phase takes, so a run in flight was unobservable and a session killed
  # halfway left nothing behind saying how far it got. `tail -f` on the stream now answers both.
  #
  # A plain redirect, not the `tee` the plan sketched: the redirect already gives the live file,
  # and a pipeline would put `tee`'s exit status where claude's has to be — recoverable only via
  # PIPESTATUS, for no second consumer to feed.
  local watcher=""
  if progress_wanted; then stream_watch "$streamfile" & watcher=$!; fi
  ( cd "$REPO_ROOT" && "${cmd[@]}" ) > "$streamfile" 2>"${logfile%.json}.err" || rc=$?
  # Before `ended`, so the watcher cannot print over the phase's own closing lines. `wait` is what
  # makes that a guarantee instead of a hope, and both are silenced: the watcher is killed by
  # design, so its death is not news.
  if [ -n "$watcher" ]; then kill "$watcher" 2>/dev/null || true; wait "$watcher" 2>/dev/null || true; fi
  ended="$(date +%s)"

  # The summary every other reader here already knows. `--output-format json` printed exactly the
  # terminal `result` object and nothing else, so distilling that one line back into $logfile
  # leaves the cost below, the `.err` sibling and the journal's `log=` untouched by the change.
  # Reading the raw stream instead would hand jq one answer PER LINE and `tonumber?` would refuse
  # the multi-line string — the ledger going quiet about money with nothing going red.
  stream_summary "$streamfile" > "$logfile"

  # The `|| echo "?"` covers a jq that FAILS; it does not cover a jq that succeeds silently, and
  # that is the case stream_summary() produces most: over an EMPTY $logfile — a session killed
  # before its `result`, or the truncated stream the comment above describes — jq exits 0 having
  # printed nothing, so the fallback never fires and `cost` becomes the empty string. Measured: the
  # journal line came out `cost_usd=  log=…`, an unlabelled hole where every other row says `?`.
  # No data was ever corrupted (`($cost | tonumber? // null)` maps "" and "?" to the same ledger
  # null), but stream_summary()'s contract says in so many words that empty stdout "already means
  # unknown cost to every caller", and this is the caller that has to make that sentence true.
  cost="$(jq -r '.total_cost_usd // .cost_usd // "?"' "$logfile" 2>/dev/null || echo "?")"
  [ -n "$cost" ] || cost="?"
  local dur=$((ended - started))
  pipeline_log_line "$(date -Iseconds)  $phase  agent=$agent  model=$model  session=${resume_sid:-$sid}  rc=$rc  dur=${dur}s  cost_usd=$cost  log=$logfile"

  # Published for the autonomy ledger, which is written by cmd_run — only there is the gate
  # result known, and the row carries it.
  LAST_PHASE_RC="$rc"
  LAST_PHASE_COST="$cost"
  LAST_PHASE_DUR="$dur"
  LAST_PHASE_STEP="$pstep"
  LAST_PHASE_AGENT="$agent"
  LAST_PHASE_MODEL="$model"

  if [ "$rc" -ne 0 ]; then
    warn "claude exited $rc in phase $phase (see $logfile and ${logfile%.json}.err)"
  else
    dim "  session ended in ${dur}s, cost $cost USD"
  fi
  # On a retry, `cmd` was built with `--resume "$resume_sid" --fork-session` and WITHOUT
  # `--session-id`: the `$sid` generated at the top of this call was never handed to claude, so
  # recording it here would leave the retry row pointing at a session that identifies nothing —
  # matches what `pipeline_log_line` above already records for the same session.
  LAST_PHASE_SID="${resume_sid:-$sid}"
  invalidate_checks
  return 0
}
LAST_PHASE_SID=""
LAST_PHASE_RC=""
LAST_PHASE_COST=""
LAST_PHASE_DUR=""
LAST_PHASE_STEP=""
LAST_PHASE_AGENT=""
LAST_PHASE_MODEL=""

# Fingerprint of the mission state. It answers "did this session do ANYTHING?" when the gate has
# not passed yet — the normal case for the EXEC phase, which runs one increment at a time.
state_fingerprint() {
  local head files
  head="$( cd "$REPO_ROOT" && git rev-parse HEAD 2>/dev/null || echo "-" )"
  files="$( ls -1 "$MISSION_DIR" 2>/dev/null | sort | tr '\n' ',' )"
  printf '%s|%s|%s\n' "$head" "$files" \
    "$( cat "$MISSION_DIR/checkpoint.md" 2>/dev/null | md5sum 2>/dev/null | cut -d' ' -f1 )"
}

# How many sessions a phase may consume before turning BLOCKED.
phase_budget() {
  case "$1" in
    EXEC)   printf '%s\n' "$(( $(checkpoint_rows | wc -l) + EXEC_MAX_RETRY + 2 ))" ;;
    QA)     printf '%s\n' "$(( QA_MAX_ITER * 3 ))" ;;   # 3 sub-steps per round
    REVIEW) printf '%s\n' "$REVIEW_MAX_ITER" ;;
    *)      printf '%s\n' "$(( EXEC_MAX_RETRY + 1 ))" ;;
  esac
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_install() {
  local force=0
  if [ "${1:-}" = "--force" ]; then force=1; fi
  resolve_repo_root
  step "installing sdd into $REPO_ROOT"

  mkdir -p "$REPO_ROOT/.sdd" "$REPO_ROOT/.claude/agents"

  if [ -f "$CONFIG_FILE" ]; then
    ok ".sdd/config.sh already exists (preserved)"
  else
    local branch test_cmd project
    project="$(basename "$REPO_ROOT")"
    # `|| true` is mandatory: a repo with no remote has no origin/HEAD, git fails, and pipefail
    # would take the whole install down in silence.
    branch="$( cd "$REPO_ROOT" \
      && git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null \
      | sed 's|^origin/||' || true )"
    [ -n "$branch" ] || branch="$( cd "$REPO_ROOT" && git branch --show-current )"
    test_cmd="TODO"
    if [ -f "$REPO_ROOT/package.json" ];   then test_cmd="npm test"; fi
    if [ -f "$REPO_ROOT/pyproject.toml" ]; then test_cmd="pytest -q"; fi
    if [ -f "$REPO_ROOT/Cargo.toml" ];     then test_cmd="cargo test"; fi
    if [ -f "$REPO_ROOT/go.mod" ];         then test_cmd="go test ./..."; fi
    # The redirect below creates $CONFIG_FILE BEFORE sed runs, so a half-copied kit used to leave
    # a 0-byte config on disk and only then die on sed's rc. rc was already non-zero, which is why
    # this looked harmless: the damage was the ARTIFACT. The next `sdd install` found the file,
    # printed "already exists (preserved)" over it, and the target repo went on without a
    # TEST_CMD — the runner asserting an artifact it never wrote, one level down from the gates.
    # Guard first, and in the kit's own voice: sed's stderr is locale-dependent and says nothing
    # about the consequence.
    [ -f "$SDD_HOME/config/starter.conf" ] \
      || die "the kit at $SDD_HOME has no config/starter.conf — .sdd/config.sh would be created empty, and the next 'sdd install' would report it as already existing. Re-copy or re-clone the kit."
    sed -e "s|<PROJECT_NAME>|$project|g" \
        -e "s|<DEFAULT_BRANCH>|$branch|g" \
        -e "s|<TEST_CMD>|$test_cmd|g" \
        -e "s|<SDD_HOME>|$SDD_HOME|g" \
        "$SDD_HOME/config/starter.conf" > "$CONFIG_FILE"
    ok ".sdd/config.sh created (base branch detected: $branch — confirm it)"
  fi

  local a name target changed=0
  for a in "$SDD_HOME"/agents/sdd-*.md; do
    [ -e "$a" ] || continue
    name="$(basename "$a")"
    target="$REPO_ROOT/.claude/agents/$name"
    if [ ! -f "$target" ]; then
      cp "$a" "$target"; ok "agent $name copied"
    elif cmp -s "$a" "$target"; then
      ok "agent $name identical"
    elif [ "$force" = "1" ]; then
      cp "$a" "$target"; ok "agent $name updated (--force)"
    else
      changed=$((changed + 1))
      warn "agent $name differs from the kit version:"
      diff -u "$target" "$a" | sed 's/^/      /' >&2 || true
    fi
  done
  if [ "$changed" -gt 0 ]; then warn "run 'sdd install --force' to adopt the kit version"; fi

  local gitignore="$REPO_ROOT/.gitignore"
  if ! grep -qxF '.sdd/logs/' "$gitignore" 2>/dev/null; then
    printf '\n# ephemeral logs of the sdd runner (durable state lives in %s/, committed)\n.sdd/logs/\n' \
      "${HANDOFF_DIR:-docs/handoffs}" >> "$gitignore"
    ok ".sdd/logs/ added to .gitignore"
  else
    ok ".sdd/logs/ already in .gitignore"
  fi

  info ""
  dim "next: edit .sdd/config.sh and run 'sdd preflight'"
}

# "you are standing on the base branch" — ONE definition, called by the five doors that can end
# up committing: cmd_preflight, cmd_run, cmd_retry, cmd_kaizen and cmd_approve.
#
# The count is not decoration: it was "four" until `sdd approve` was born committing in silence, in
# the very mission that closed the silence of `sdd retry`. A door is added to this list the moment
# it can reach a `git commit`, whether or not it opens a session — the criterion is what lands in
# the history, and a count left stale here is how the next door gets written without the guard.
#
# It used to be four lines inlined in cmd_preflight and nowhere else, and preflight is OPTIONAL:
# `sdd run` from `main` commits every phase straight into the base branch without a word, `sdd
# retry` does the same for a single redone phase, `sdd approve` did it for the approval commit it
# asks the human to authorise, and `sdd kaizen` is worse — it checks the kit repo and the dirty tree, then writes a verdict and
# three artifacts wherever you happen to be. Same rule that gave `is_escalation` a single home
# after the blocked/degraded pair diverged across three call sites: an enum (or a warning) read in
# more than one place is defined once, or the call sites drift apart one at a time.
#
# It stays a `warn` and is NEVER allowed to become a `die`. Turning it into an error would lock the
# kaizen loop out of its own repo the first time a human forgot to create the branch, and both
# sensors assert the rc on BOTH branches precisely to keep that door shut.
#
# Silent — returning 0 — when git has no branch name to give (a detached HEAD answers empty) or
# when DEFAULT_BRANCH is empty: comparing "" with "" would fire the warning on every detached
# checkout, and a warning that cries wolf is how people learn to skip reading them.
warn_if_on_base_branch() {
  local branch
  branch="$( cd "$REPO_ROOT" && git branch --show-current 2>/dev/null || true )"
  [ -n "$branch" ] && [ -n "$DEFAULT_BRANCH" ] && [ "$branch" = "$DEFAULT_BRANCH" ] || return 0
  warn "you are on the base branch ($DEFAULT_BRANCH) — run like this and the pipeline commits straight into it"
}

# ensure_mission_branch — the runner honours the `branch:` field of 00-missao.md.
#
# The field shipped in templates/missao.md from the first day and NOTHING here ever read it: the
# plan declared where the mission's commits belonged, and honouring it was a manual step before
# every run. In the SQ-97 pilot the step was skipped once and five phases committed into another
# PR's branch — 16 commits, and a `rebase --onto` to undo them.
#
# ONE definition, two call sites (cmd_run, cmd_retry) — the same rule that gave is_escalation and
# warn_if_on_base_branch a single home each: a decision read in more than one place drifts apart
# one call site at a time, and the site that stays behind is the one nobody tests.
#
# NEVER in a dry run. What `--dry-run` promises is narrower than "nothing happens" (the gates do
# run TEST_CMD), but a checkout is a mutation of the working tree, which is precisely the half it
# does promise.
#
# A branch that does not exist yet is cut from the CURRENT branch, never from DEFAULT_BRANCH: the
# commit that carries the plan lives where the human is standing when they run, and cutting from
# the base would leave the whole mission behind.
#
# git refusing the checkout is a `die`, never a warning: a dirty tree or a name git will not take.
# Going on would run the entire pipeline on a branch the plan did not ask for, which is the exact
# failure this function exists to close — and guessing on top of a tree git already refused is how
# a working tree gets destroyed. The reason is git's to give, so its own output is carried into
# the message instead of being replaced by a paraphrase.
ensure_mission_branch() {
  [ "$DRY_RUN" = "1" ] && return 0
  local want current out rc=0
  want="$(frontmatter "$MISSION_DIR/00-missao.md" branch)"
  # Two no-ops: an empty field, and the `<...>` placeholder templates/missao.md ships while the
  # name is still unknown (the TICKET phase fills it in). Neither is a branch name — git rejects
  # the second for both the `<` and the spaces — and a mission that never declared a branch must
  # keep working exactly as it did before this function existed.
  [ -n "$want" ] || return 0
  case "$want" in '<'*) return 0 ;; esac
  # A name git would read as an OPTION dies here, before git sees it, and this is the one path in
  # this function that can destroy work rather than merely land in the wrong place. `git checkout
  # -f` is a legal command: it returns 0, switches to nothing, and throws away every uncommitted
  # change in the tree — so a `branch: -f` would leave the human's work gone, the run going on, and
  # the `ok` line below announcing a switch that never happened.
  #
  # The `-b` path already dies on such a name (git refuses to CREATE it), but that is the wrong
  # half to rely on: `git update-ref refs/heads/-f HEAD` is accepted and `git check-ref-format`
  # calls the name valid, so the ref CAN exist, and then the branch above runs it as a flag.
  # Refusing the shape is one line and does not depend on which of the two paths a given tree
  # takes. Asserted in tests/check-gates.sh with a fixture that builds the ref and a dirty file.
  case "$want" in
    -*) die "the branch '$want' declared in 00-missao.md starts with '-' — git would read it as an option, not a branch" ;;
  esac
  current="$( cd "$REPO_ROOT" && git branch --show-current 2>/dev/null || true )"
  [ "$want" = "$current" ] && return 0
  if ( cd "$REPO_ROOT" && git show-ref --verify --quiet "refs/heads/$want" ); then
    out="$( cd "$REPO_ROOT" && git checkout "$want" 2>&1 )" || rc=$?
  else
    out="$( cd "$REPO_ROOT" && git checkout -b "$want" 2>&1 )" || rc=$?
  fi
  [ "$rc" -eq 0 ] \
    || die "could not switch to the branch '$want' declared in 00-missao.md — git said: $out"
  # The checkout is not the end of the decision, and this is the half that was missing. The plan is
  # read on the branch the human is standing on and the tree is then REPLACED under the runner: if
  # the declared branch was cut before the mission existed — the ordinary flow when the branch comes
  # from the ticket step — the artifacts that justified every choice above are simply gone, and the
  # runner would go on with MISSION_DIR pointing at a path that is no longer there, announcing the
  # switch as a success and then telling the human the mission was never planned. Worse and
  # quieter: a branch carrying an OLDER copy spends real sessions executing a plan nobody approved.
  #
  # So the artifact is re-read AFTER the switch, through the same parser, and it has to still be
  # there and still declare THIS branch. `die`, never a warning, for the reason the refused checkout
  # gives: going on would run the whole pipeline against a plan the human did not approve, which is
  # the failure this function exists to close, entered from the other side.
  if [ ! -f "$MISSION_DIR/00-missao.md" ] \
     || [ "$(frontmatter "$MISSION_DIR/00-missao.md" branch)" != "$want" ]; then
    die "the branch '$want' declared in 00-missao.md does not carry this mission — you are now on it, and the plan that asked for it is on '${current:-<detached>}'"
  fi
  ok "branch: ${current:-<detached>} → $want (declared in 00-missao.md)"
  pipeline_log_line "$(date -Iseconds)  BRANCH  ${current:-<detached>} -> $want"
}

cmd_preflight() {
  load_config
  step "preflight — $PROJECT_NAME ($REPO_ROOT)"
  local fails=0
  _fail() { bad "$1"; fails=$((fails + 1)); }

  # --- tools ---
  if command -v claude >/dev/null 2>&1; then ok "claude $(claude --version 2>&1 | head -1)"
  else _fail "claude CLI not found in PATH"; fi

  local t
  for t in git gh jq uuidgen; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t present"
    else _fail "$t not found in PATH"; fi
  done

  # The GNU userland, probed by BEHAVIOUR and not by presence. `command -v date` passes on macOS
  # and `date -Iseconds` still fails; brew installs GNU coreutils as gmd5sum/gdate unless the
  # gnubin dir comes first in PATH, so the name being there proves nothing. The version check at
  # the top of this file can only speak for bash — this is where the rest of the assumption gets
  # measured. Scope is what the RUNNER needs: the suite's `sed -i`/`grep -P` belong to this
  # repo's TEST_CMD, not to every target repo, and a red suite says so out loud anyway.
  local gnu=""
  md5sum </dev/null >/dev/null 2>&1  || gnu="$gnu md5sum"
  date -Iseconds >/dev/null 2>&1     || gnu="$gnu 'date -Iseconds'"
  sort -V </dev/null >/dev/null 2>&1 || gnu="$gnu 'sort -V'"
  # git 2.31+, probed by BEHAVIOUR for the same reason as the userland above: `git --version`
  # parses into three fields on some builds and four on others, and what the runner needs is not a
  # number but an ANSWER. `ledger_repo_root` asks for `--path-format=absolute`, born in 2.31, and
  # `git rev-parse` ECHOES an option it does not know back to stdout while still exiting 0 — so an
  # older git does not fail here, it answers two lines, and the repository identity written to
  # every ledger row becomes a string no reader can match. The function refuses that shape and then
  # RESOLVES the identity the old way (`cd` + `pwd -P`, both `cd`s with an emptied CDPATH), so an
  # old git costs a second rev-parse and nothing else. This line is where the operator is told that
  # the slow path is the one being taken — a notice, not a broken kit.
  if [ "$( git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | grep -c . )" = 1 ]; then
    ok "git speaks --path-format (2.31+)"
  else
    warn "this git does not know 'rev-parse --path-format' (2.31+, and it does not fail — it
        echoes the flag back and exits 0). 'ledger_repo_root' refuses the echoed shape and falls
        back to resolving the common dir with cd + pwd -P, which answers the same string, so the
        ledger stays correct. Upgrading git removes the extra rev-parse per ledger write."
  fi

  if [ -z "$gnu" ]; then
    ok "GNU userland (md5sum, date -Iseconds, sort -V)"
  else
    _fail "the kit assumes the GNU userland, and these do not answer:$gnu
        macOS: brew install coreutils gnu-sed grep, with the gnubin dirs first in PATH.
        Without md5sum the state fingerprint is empty, every session looks identical to the
        previous one, and the runner escalates phases that were in fact making progress."
  fi

  # --- authentication ---
  # Sanity + permission in one shot. "claude -p answers" does NOT cover the failure mode that
  # matters: the phase session has to EXECUTE (run the suite, commit), and `acceptEdits` alone
  # does not unlock `Bash`. This check fires a real headless session with THE SAME flags as
  # run_phase and demands that it manage to execute a command.
  if command -v claude >/dev/null 2>&1; then
    local probe
    probe="$( cd "$REPO_ROOT" && claude -p "Run exactly: bash -c 'echo sdd-preflight-ok'. Answer with the command output only." \
        --model haiku --permission-mode "$PERMISSION_MODE" --output-format json \
        --setting-sources "user,project,local" --allowedTools "$ALLOWED_TOOLS" \
        --max-budget-usd 1 2>/dev/null | jq -r '.result // ""' 2>/dev/null || true )"
    # Herestring for the same reason as the Jidoka in cmd_run: `printf | grep -q` returns 141
    # under `pipefail` when the grep MATCHES, so the success branch is the one that loses the race.
    if grep -q 'sdd-preflight-ok' <<< "$probe"; then
      ok "headless session executes commands (OAuth + permission)"
    elif [ -z "$probe" ]; then
      _fail "claude -p did not answer — expired session? run 'claude login'"
    else
      _fail "the headless session CANNOT execute commands — the phases will not run the suite
        nor commit. Answer received: $(printf '%s' "$probe" | head -c 120)
        Adjust ALLOWED_TOOLS in .sdd/config.sh (default: Bash)."
    fi
  fi
  if gh auth status >/dev/null 2>&1; then ok "gh authenticated"
  else _fail "gh not authenticated — run 'gh auth login'"; fi

  # --- browser (only matters when there is e2e/UI QA) ---
  if [ -n "$E2E_CMD" ] || [ -n "$APP_URL" ]; then
    if command -v agent-browser >/dev/null 2>&1; then
      ok "$(agent-browser --version 2>&1 | head -1)"
    else
      _fail "agent-browser missing/broken — the exploratory QA phase depends on it.
        Known symptom: a shim in ~/.nvm/versions/node/*/bin/agent-browser pointing at
        ~/.hermes/... (nonexistent). Fix: ln -sf ../lib/node_modules/agent-browser/bin/agent-browser.js <shim>"
    fi
  else
    dim "  ---  agent-browser not checked (E2E_CMD and APP_URL empty)"
  fi

  # --- config ---
  bash -n "$CONFIG_FILE" && ok "config syntax valid"
  case "$TEST_CMD" in
    TODO|"") _fail "TEST_CMD not configured in .sdd/config.sh" ;;
    *) ok "TEST_CMD=$TEST_CMD" ;;
  esac
  if [ "$JIRA_ENABLED" = "true" ]; then
    if [ -f "$REPO_ROOT/.jira-project" ]; then ok "JIRA enabled, .jira-project present"
    else _fail "JIRA_ENABLED=true but there is no .jira-project in the repo (the ticket skill needs it)"; fi
  else
    dim "  ---  JIRA_ENABLED=false — the TICKET phase will be skipped"
  fi

  # --- target repo plugins ---
  local settings="$REPO_ROOT/.claude/settings.json"
  if [ -f "$settings" ]; then
    local p missing=""
    for p in ddd kaizen-software; do
      grep -q "\"$p@" "$settings" || missing="$missing $p"
    done
    if [ -z "$missing" ]; then ok "plugins ddd + kaizen-software enabled"
    else warn "plugins not enabled in .claude/settings.json:$missing (the planner invokes them)"; fi
  else
    warn ".claude/settings.json missing — ddd/kaizen plugins not enabled in the repo"
  fi

  # --- installed agents ---
  # `cmp -s` and not `[ -f ]`: what the harness loads is the COPY in .claude/agents/, so a source
  # that was fixed proves nothing about the text the agent will actually run. Presence-only made
  # the "N kit agent(s) checked" line below a label over a comparison that never happened, and it
  # bit for real — 2132cf5 edited agents/sdd-kaizen.md, the copy stayed behind, green in
  # everything. Two failures and not one: absent and stale are different repairs, and telling an
  # operator to install a file that is right there on disk sends them the wrong way.
  local a name copy n=0
  for a in "$SDD_HOME"/agents/sdd-*.md; do
    [ -e "$a" ] || continue
    n=$((n + 1))
    name="$(basename "$a")"
    copy="$REPO_ROOT/.claude/agents/$name"
    if [ ! -f "$copy" ]; then
      _fail "agent $name not installed — run 'sdd install'"
    elif ! cmp -s "$a" "$copy"; then
      _fail "agent $name stale — .claude/agents/$name no longer matches $a.
        The harness loads the copy, so this agent keeps running the old text while the kit source
        looks corrected. Run 'sdd install --force' (or 'sdd install' to see the diff first)."
    fi
  done
  # Only claims "checked" when no agent failed — saying it right after six failure lines is the
  # output contradicting itself, which is the kind of lie the kit forbids in the gates.
  if [ "$n" -gt 0 ] && [ "$fails" -eq 0 ]; then ok "$n kit agent(s) checked"; fi

  # --- git state ---
  local branch; branch="$( cd "$REPO_ROOT" && git branch --show-current )"
  ok "current branch: $branch"
  warn_if_on_base_branch
  if [ -n "$( cd "$REPO_ROOT" && git status --porcelain )" ]; then
    _fail "working tree dirty — the pipeline needs a clean base to attribute commits to increments"
  else
    ok "working tree clean"
  fi

  info ""
  if [ "$fails" -eq 0 ]; then
    printf '%spreflight ok%s\n' "$C_GREEN$C_BOLD" "$C_RESET"; return 0
  fi
  printf '%s%d check(s) failed%s\n' "$C_RED$C_BOLD" "$fails" "$C_RESET" >&2
  return 1
}

# ---------------------------------------------------------------------------
# Sensor of the KIT (≠ preflight, which is about the target repo's environment).
#
# Reads everything from $SDD_HOME, so it works from inside any target repo and does NOT require
# .sdd/config.sh. It answers a single question: "does the kit still measure what it claims to?"
#
# WARNING when touching this: the file runs with `set -o pipefail`, and `printf ... | grep -q`
# returns 141 when grep FINDS the match and exits before printf finished writing (SIGPIPE) —
# the logic silently inverts for large inputs and stays correct for small ones, which is the
# worst of both worlds. That is why every search below uses a herestring (`<<<`).
# ---------------------------------------------------------------------------
HEALTH_FAILS=0
HEALTH_FINDINGS=""

health_bad() { bad "$*"; HEALTH_FAILS=$((HEALTH_FAILS + 1)); }

# Records a drift finding for the ratchet to judge at the end.
health_finding() { HEALTH_FINDINGS="${HEALTH_FINDINGS}${1}"$'\n'; }

# Keys with a default in load_config(). The block is delimited by the anchor comments, not by
# line number, so it does not rot at the first refactor.
health_default_keys() {
  awk '/^load_config\(\) \{/ { inside = 1 } inside && /^\}/ { exit } inside' "$SDD_HOME/bin/sdd" \
    | grep -oE '\$\{[A-Z0-9_]+:=' | tr -d '${:=' | sort -u
}

cmd_health() {
  local kit="$SDD_HOME" out rc k n

  step "sdd health — kit sensor at $kit"

  # --- 1. the suite, which already includes bash -n and the mutation --------
  # `|| rc=$?` and not `; rc=$?`: this file runs under `set -e`, an assignment takes the exit
  # status of its command substitution, and a RED SUITE is precisely a non-zero one — so the bare
  # form died HERE, on the assignment, and the health_bad three lines down was dead code. The
  # operator got the header, rc 1, and not one word about the suite. Measured against the real
  # runner, four sites of this same family (this one, the score read, the provenance `find` and
  # the ratchet's baseline read); the whole point of `sdd health` is to SAY what is wrong, and the
  # red suite is the case it exists for. Guarded by the `abort:` assertions of check-health.sh.
  rc=0
  out="$( cd "$kit" && tests/run-all.sh 2>&1 )" || rc=$?
  if [ "$rc" -eq 0 ]; then ok "suite green"; else
    health_bad "suite red (rc $rc) — run tests/run-all.sh to see it"
    printf '%s\n' "$out" | tail -15 >&2
  fi

  # --- 2. mutation score, read from the SAME run ---------------------------
  # A missing line fails: if the score format changes, this check would go blind and pass in
  # silence — the very vacuity that check-mutation.sh exists to hunt.
  #
  # The regex below is one contract across two files: the line is emitted by
  # tests/check-mutation.sh. Change the wording on either side alone and the suite goes red.
  #
  # `|| true` for the same reason the TODO.md count below carries one: a grep that matches nothing
  # returns 1, and under `set -e` the assignment took the runner down with it — so the `-z` branch
  # that was written to shout "health went blind" could never be reached, and going blind read as
  # a crash. The sentence below is only sayable because of the two words on this line.
  local score_line
  score_line="$(grep -m1 '^score: ' <<< "$out" || true)"
  if [ -z "$score_line" ]; then
    health_bad "the suite did not print the 'score:' line — health went blind to the mutation"
  elif grep -qE '^score: [0-9]+ caught, 0 known gap' <<< "$score_line"; then
    ok "mutation: $score_line"
  else
    health_bad "mutation with an open gap — $score_line"
  fi

  # --- 3. the TODO.md backlog count, read from the SAME run ----------------
  # The count is a CONTRACT between two files: tests/check-todo.sh writes the line, bin/sdd reads
  # it, and NOBODY EVER RECOUNTS. A `grep -c '^- \[ \]' TODO.md` here answers one too many — it
  # swallows the format example inside the header's fenced block, which the parser of
  # check-todo.sh needed a whole review round to learn to skip. Reword the line on either side
  # alone and this goes red, exactly like the `score:` contract above.
  #
  # Growing is still allowed: principle 5 of CLAUDE.md does not change, and a mission that finds
  # three real things has to be able to write them down. What is forbidden is growing UNDECLARED.
  # The number is a line of tests/health-baseline.txt, so it moves in a diff with an author, and
  # health_ratchet refuses it in both directions — the count that rose without a record and the
  # baseline left behind after a sweep.
  #
  # `|| true` is not noise. Under this file's own `set -e`, a grep that matches nothing makes the
  # assignment return 1 and kills the runner mid-command — rc 1, not one word said — so the
  # `-z` branch below would be unreachable and a broken contract would read as a crash. Same
  # family as the two silent aborts of `find` and `grep -vE` recorded in TODO.md.
  local todo_line
  todo_line="$(grep -m1 -E '^  ok    [0-9]+ finding\(s\)' <<< "$out" || true)"
  if [ -z "$todo_line" ]; then
    health_bad "the suite did not print the TODO.md finding count — health went blind to the backlog"
  else
    health_finding "todo-findings $(sed -E 's/^  ok    ([0-9]+) .*/\1/' <<< "$todo_line")"
  fi

  # --- 4. every gate has a mutation ----------------------------------------
  # Explicit floor: zero gates found would pass by vacuity (a rename, an indentation change).
  #
  # ⚠️ The floor was UNREACHABLE until the r2 review of 20260818-lote-facil, and by the exact
  # mechanism it was written against: the two captures below are how `grep` reports "no match",
  # and under this file's `set -e` a capture that reports non-zero kills the runner AT THE
  # ASSIGNMENT. Renaming the gates — the scenario this comment names — made `sdd health` stop
  # dead after check 2, rc 1, without ever saying `found 0 gates`. Measured. `grep -c` is the
  # second half of the same pair and returns 1 precisely when it counts ZERO, so guarding only
  # the line above would have moved the death one line down.
  local gates; gates="$(grep -oE '^gate_[A-Z]+' "$kit/bin/sdd" | sed 's/^gate_//' | sort -u || true)"
  n="$(grep -c . <<< "$gates" || true)"
  if [ "$n" -ne 8 ]; then
    health_bad "found $n gates in bin/sdd, expected 8 — new/renamed gate: update the floor here"
  else
    local without_mutation=""
    for k in $gates; do
      grep -qE "^mut_${k}_" "$kit/tests/check-mutation.sh" || without_mutation="$without_mutation $k"
    done
    if [ -n "$without_mutation" ]; then
      health_bad "gate(s) with no mutation in the catalogue:$without_mutation — a gate nobody sabotages is not measured"
    else
      ok "all 8 gates have a mutation in the catalogue"
    fi
  fi

  # --- 5. drift load_config() ↔ config/schema.md ----------------------------
  # Both captures guarded for the reason spelled out at check 4, and both measured dying: a
  # reformatted key table in schema.md killed the runner on the first line, a load_config() that
  # lost its `:=` defaults killed it on the second — three ok lines and out, rc 1, silent.
  #
  # `keys` then carries a FLOOR, and the floor is the other half of the fix. Guarding a capture
  # turns "dies loudly by accident" into "carries on with an empty string", and an empty `keys`
  # makes the loop below iterate zero times: check 5 half-blind and check 7 fully blind, both
  # reporting nothing and both looking exactly like a clean kit. An abort at least stopped the
  # line; silent vacuity does not. `documented` needs no floor — empty makes every key land in
  # `key-without-doc`, which the ratchet says out loud.
  local documented; documented="$(grep -oE '^\| `[A-Z0-9_]+`' "$kit/config/schema.md" | tr -d '|` ' | sort -u || true)"
  local keys; keys="$(health_default_keys || true)"
  if [ -z "$keys" ]; then
    health_bad "load_config() declares no defaulted key — checks 5 and 7 have nothing to measure"
  fi
  for k in $keys; do
    grep -qxF "$k" <<< "$documented" || health_finding "key-without-doc $k"
  done
  for k in $documented; do
    grep -qxF "$k" <<< "$keys" || health_finding "doc-without-key $k"
  done

  # --- 6. subcommand missing from --help -----------------------------------
  local subcmds; subcmds="$(awk '/^main\(\) \{/ { inside = 1 } inside && /^\}/ { exit }
      inside && match($0, /^ +[a-z|+-]+\)/) {
        label = substr($0, RSTART, RLENGTH); gsub(/[ )]/, "", label); print label
      }' "$kit/bin/sdd" | tr '|' '\n' | grep -vE '^-' | sort -u || true)"
  # `sdd help` is the one capture here whose command is the runner itself: it exits 0 today, and
  # the day a refactor makes it exit non-zero this check would take the whole command down with
  # it rather than reporting anything. Guarded like the rest; an empty `help_out` then lands every
  # subcommand in `cmd-not-in-help`, which the ratchet says out loud.
  local help_out; help_out="$( "$kit/bin/sdd" help 2>&1 || true )"
  # Floor, same argument as `keys` at check 5: a `main()` whose case labels stop matching leaves
  # this loop with nothing to iterate, and a check measuring nothing prints exactly what a clean
  # kit prints.
  if [ -z "$subcmds" ]; then
    health_bad "no subcommand parsed out of main() — check 6 has nothing to measure"
  fi
  for k in $subcmds; do
    # Appearing as `sdd <cmd>` anywhere in the help is enough: some share a line
    # (`sdd help | sdd version`), and demanding a fixed column would fail a documented command.
    grep -qE "\bsdd $k\b" <<< "$help_out" || health_finding "cmd-not-in-help $k"
  done

  # --- 7. variable with a default and never read ---------------------------
  # BARE word, not `$K`: QA_MAX_ITER and EXEC_MAX_RETRY live in arithmetic context
  # (`$(( QA_MAX_ITER * 3 ))`), and a detector looking for `$K` would call them dead.
  # Scope: bin/sdd only. Sweeping the whole kit would make the key "appear" in schema.md and in
  # starter.conf — the sensor would start measuring the documentation of the debt instead of the
  # debt. A comment line does not count as a read either, for the same reason: quoting the key in
  # an explanation would make it "live" and hide exactly what it represents.
  local body; body="$(awk '/^load_config\(\) \{/ { inside = 1 }
      inside && /^\}/ { inside = 0; next } !inside && !/^[[:space:]]*#/' "$kit/bin/sdd" || true)"
  for k in $keys; do
    grep -qE "\b${k}\b" <<< "$body" || health_finding "var-never-read $k"
  done

  # --- 8. fixture provenance -----------------------------------------------
  health_provenance

  # --- ratchet --------------------------------------------------------------
  health_ratchet

  echo
  if [ "$HEALTH_FAILS" -eq 0 ]; then ok "kit healthy"; return 0; fi
  bad "$HEALTH_FAILS check(s) failed"
  return 1
}

# The fixture has to match what the skill EMITS. It is the countermeasure for the most expensive
# bug in the kit's history, and the only check that depends on the machine — which is why it
# lives here and not in the suite, which has to stay hermetic. Skill absent ⇒ skipped, exactly
# the way the linter check is skipped when the linter is not installed.
# (Do not start a comment line with the linter's name: it would parse as a directive, SC1073.)
health_provenance() {
  local gates="$SDD_HOME/tests/check-gates.sh" tpl line fix skipped=0 checked=0

  # ⚠️ Every `grep` below carries `|| true`, and this is the site where the family of silent
  # aborts costs the most. `-f "$tpl"` proves the FILE is there; it proves nothing about the
  # LINE. A skill that renames the field it pins — `- **Started:**` becoming anything else — is
  # not a hypothetical: it is the precise drift this whole function exists to catch, and it is
  # the way skills actually change. Unguarded, the grep found nothing, returned 1, and `set -e`
  # killed the runner ON THE ASSIGNMENT: `sdd health` printed three ok lines and exited 1 without
  # the words `fixture diverged`, without the ratchet, and without a verdict. The countermeasure
  # for the most expensive bug in the kit's history went silent exactly when it fired. Measured
  # in the r2 review of 20260818-lote-facil, against both skills, both directions; guarded by
  # the `abort:` assertions of check-health.sh and by mut_HEALTH_provenance_line_aborts.
  # Empty is the right value and needs no branch of its own: an absent line can never equal the
  # fixture, so the existing comparison reports it as the divergence it is.
  #
  # qa-execution report: the Status line, with the timestamp made concrete in the fixture.
  # ⚠️ That sentence is a RANGE ANCHOR, not decoration: mut_HEALTH_report_provenance_blind and
  # mut_HEALTH_provenance_blind address themselves between it and the `registry bug` line below,
  # and rewriting this comment without it reported both as CATALOGUE-BROKEN — measured, when the
  # r2 review first replaced the comment wholesale.
  tpl="$HOME/.claude/skills/qa-execution/assets/report-template.md"
  if [ -f "$tpl" ]; then
    line="$(grep -m1 -- '- \*\*Started:\*\*' "$tpl" || true)"
    fix="$(grep -m1 -- '- \*\*Started:\*\*' "$gates" | sed 's/2026-01-01T10:00:00Z/<ISO timestamp>/' || true)"
    # `-n` FIRST, and it is not decoration: with the guard above, two ABSENCES compare equal, so
    # a skill and a fixture that both dropped the line would read as a match and increment
    # `checked`. That is the fail-open the guard would have bought at the price of the abort —
    # the same trade the r1 round of this mission made in check-todo.sh and had to undo.
    if [ -n "$line" ] && [ "$line" = "$fix" ]; then checked=$((checked + 1))
    else health_bad "report fixture diverged from the skill:
         skill:   $line
         fixture: $fix"; fi
  else skipped=$((skipped + 1)); fi

  # registry bug: the Status line with the enum legend
  tpl="$HOME/.claude/skills/qa-report/assets/bug-template.md"
  if [ -f "$tpl" ]; then
    line="$(grep -m1 -- '- \*\*Status:\*\*' "$tpl" || true)"
    fix="$(grep -m1 -- '- \*\*Status:\*\* open' "$gates" || true)"
    if [ -n "$line" ] && [ "$line" = "$fix" ]; then checked=$((checked + 1))
    else health_bad "bug fixture diverged from the skill:
         skill:   $line
         fixture: $fix"; fi
  else skipped=$((skipped + 1)); fi

  # codereview grade table: every criterion of the skill must exist in the fixture.
  # `sort -V` on the plugin version — a lexicographic `sort` would put 1.9 after 1.17. This was
  # once the only version-ordered pick in the file; latest_matching() carried the lexicographic
  # bug and this comment recorded it. It no longer does — both sort by version now.
  #
  # `|| true`: `find` on a missing directory returns 1, `set -o pipefail` carries that through
  # `sort -V | tail -1`, and `set -e` then killed the whole command on the assignment — on a
  # machine with no plugins cache, `sdd health` stopped dead HERE, three ok lines in, and neither
  # provenance nor the ratchet ever ran. A machine without the directory is not a defect, it is a
  # machine: an empty `$tpl` is the skip this branch already knows how to do.
  tpl="$(find "$HOME/.claude/plugins/cache" -path '*/codereview/*/references/report-template.md' \
         2>/dev/null | sort -V | tail -1 || true)"
  if [ -n "$tpl" ] && [ -f "$tpl" ]; then
    local missing=""
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      grep -qF "| $k |" "$gates" || missing="$missing '$k'"
    done < <(awk -F'|' '/^\| Criterion \| Grade/ { t = 1; next }
        t && /^\|-/ { next }
        t && /^\|/ { c = $2; gsub(/^[ \t]+|[ \t]+$/, "", c); if (c !~ /^\*\*/) print c; next }
        t { exit }' "$tpl")
    if [ -n "$missing" ]; then
      health_bad "the skill's grade table has a criterion the fixture does not cover:$missing"
    else checked=$((checked + 1)); fi
  else skipped=$((skipped + 1)); fi

  # The summary reads `checked` and `skipped`, and it may not claim the third state. A DIVERGED
  # fixture increments neither counter — it went to `health_bad` — so with three skills installed
  # and one diverged the old rubric fell through to the `else` and printed `all 3 fixtures match
  # the installed skills` on the line right after saying one of them did not. Unreachable until
  # the r2 review of 20260818-lote-facil guarded the two `grep` captures above, because the run
  # used to die before printing anything at all; guarding them turned a silent abort into a loud
  # lie, and a lie in the summary of the provenance check is worse than either. Three states,
  # three sentences, and the `all 3` wording is reserved for the one world where it is true.
  local diverged=$(( 3 - checked - skipped ))
  if [ "$diverged" -gt 0 ]; then
    ok "provenance: $checked fixture(s) match, $diverged diverged, $skipped skipped"
  elif [ "$skipped" -gt 0 ]; then
    ok "provenance: $checked fixture(s) checked, $skipped skipped (skill not installed)"
  else
    ok "provenance: all 3 fixtures match the installed skills"
  fi
}

# A new finding fails; a baseline line that stopped being a finding fails too. Both directions
# matter: without the first the debt grows on its own, without the second the list turns into
# folklore.
health_ratchet() {
  local bl="$SDD_HOME/tests/health-baseline.txt" known new_findings=0 stale=0 line
  # `|| true`: a baseline with no live line (all comments, or missing outright) makes this grep
  # return 1, and under `set -e` the runner died on the assignment — after the provenance line,
  # before a single word of the ratchet, so it neither said `kit healthy` nor failed anything. An
  # empty `known` is not an error to crash on: it means NOTHING is known debt, so every finding is
  # outside the baseline, which is exactly what the loop below then says out loud.
  known="$(grep -vE '^[[:space:]]*(#|$)' "$bl" | sed 's/[[:space:]]*#.*//' \
           | sed 's/[[:space:]]*$//' || true)"

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    grep -qxF "$line" <<< "$known" \
      || { health_bad "finding outside the baseline: $line"; new_findings=$((new_findings + 1)); }
  done <<< "$HEALTH_FINDINGS"

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    grep -qxF "$line" <<< "$HEALTH_FINDINGS" \
      || { health_bad "stale baseline: '$line' is no longer a finding — delete the line"; stale=$((stale + 1)); }
  done <<< "$known"

  # An `if` and not an `&&` chain, and the difference is a whole line of output. The chain returns
  # the status of its first failing test, so a ratchet that FOUND something made health_ratchet
  # return 1 — and `set -e` killed cmd_health on the call, one line before its own verdict. The
  # finding was printed and then `N check(s) failed` never was: same family as the four capture
  # sites above, same silence, and it hit the path that WORKS rather than a broken one. Every
  # assertion here read only `rc != 0`, which is authored by the `return 1` at the end of
  # cmd_health too, so nothing noticed. Failures are already counted in HEALTH_FAILS; this
  # function's job is to report, never to decide the exit code.
  if [ "$new_findings" -eq 0 ] && [ "$stale" -eq 0 ]; then
    ok "ratchet: $(grep -c . <<< "$known") known debt(s), none new"
  fi
}

cmd_status() {
  load_config
  resolve_mission "${1:-}"
  step "mission $MISSION — $PROJECT_NAME"
  info ""

  local ph state why
  for ph in $PHASES; do
    if "gate_$ph"; then state="${C_GREEN}✓${C_RESET}"; else state="${C_YELLOW}·${C_RESET}"; fi
    why="$GATE_WHY"
    printf '  %b %-7s %s%s%s\n' "$state" "$ph" "$C_DIM" "$why" "$C_RESET"
  done

  info ""
  local rows; rows="$(checkpoint_rows)"
  if [ -n "$rows" ]; then
    info "  increments:"
    local id title _c st commit mark
    while IFS=$'\t' read -r id title _c st commit; do
      case "$st" in
        done)    mark="${C_GREEN}✓${C_RESET}" ;;
        blocked) mark="${C_RED}✗${C_RESET}" ;;
        doing)   mark="${C_YELLOW}▸${C_RESET}" ;;
        *)       mark="${C_DIM}·${C_RESET}" ;;
      esac
      printf '    %b %-4s %-46s %s%s%s\n' "$mark" "$id" "${title:0:46}" "$C_DIM" "${commit:0:8}" "$C_RESET"
    done <<< "$rows"
  fi

  info ""
  local next; next="$(current_phase)"
  if [ -z "$next" ]; then
    printf '  %spipeline complete — only the merge is left (the human gate)%s\n' "$C_GREEN$C_BOLD" "$C_RESET"
  else
    "gate_$next" || true
    printf '  next phase: %s%s%s — %s\n' "$C_BOLD" "$next" "$C_RESET" "$GATE_WHY"
    printf '  %srun: sdd run %s%s\n' "$C_DIM" "$MISSION" "$C_RESET"
  fi
}

# Prints only the name of the current phase (or DONE). It exists for scripts and for the kit's
# own tests — `sdd status` is for humans, this one is for machines.
cmd_phase() {
  load_config
  resolve_mission "${1:-}"
  local next; next="$(current_phase)"
  printf '%s\n' "${next:-DONE}"
}

# Prints why the gate of a specific phase did not pass.
cmd_why() {
  load_config
  resolve_mission "${1:-}"
  local ph="${2:-}"
  [ -n "$ph" ] || ph="$(current_phase)"
  [ -n "$ph" ] || { info "pipeline complete"; return 0; }
  "gate_$ph" || true
  printf '%s: %s\n' "$ph" "$GATE_WHY"
}

# `sdd approve <mission>` — the human gate of the PLAN phase gets a command.
#
# Until this existed, unlocking gate_PLAN meant opening 00-missao.md and typing
# `aprovacao: humano-YYYY-MM-DD` in the exact shape the gate greps. Two ways that goes wrong, and
# both were seen: the format comes out slightly off and the gate stays shut with a message about a
# key the human believes they just wrote, or the edit gets delegated to the session — and the
# session is precisely the party that may not decide whether the plan is worth building.
#
# It is NOT a phase and it never opens a session: approving is the one thing in the pipeline that
# has to come from outside it. The two deliberate `claude -p` calls outside run_phase() stay two
# (the preflight probe and `sdd close`); this command reads stdin and writes a file.
#
# It prints before it asks. An approval given without the plan on screen is the manual edit with
# extra steps, so the whole mission body goes to stdout — title, PLAN-AUTO evidence, out of scope,
# open questions — plus the increment table, which lives in the other file. The body is printed
# whole rather than section by section on purpose: section headings are mission content in
# OUTPUT_LANG, and a runner that grepped for them would work in pt-BR repos and go quietly blind
# everywhere else.
cmd_approve() {
  load_config
  resolve_mission "${1:-}"
  local m="$MISSION_DIR/00-missao.md"

  # The gate's own diagnosis, taken from the gate: this command exists to satisfy gate_PLAN, and a
  # human told "missing 01-plano.md" by `sdd status` must not hear something different from the
  # command that is supposed to fix it. GATE_WHY is read, never re-worded.
  if ! gate_PLAN && [[ $GATE_WHY == missing\ * ]]; then die "$GATE_WHY"; fi

  local approval; approval="$(frontmatter "$m" aprovacao)"
  # Idempotence, with ONE exception, and the exception is the whole point of the guard below.
  # `auto` beside a 05-verdict.md is not an approval anybody gave — it is the machine certifying
  # its own homework, which is exactly the state gate_PLAN refuses while naming THIS command as the
  # way out. Reading it as "already approved" made the named remedy decline every plan the gate
  # stopped: not sometimes, never. plan_approves_itself is the gate's own condition, read here
  # rather than restated, so the two cannot drift apart again.
  #
  # Everything else keeps bailing, and the verdict-less `auto` is why that matters: an approve that
  # simply stopped recognising `auto` would rewrite every planner-written approval into
  # `humano-<today>` on contact, erasing in silence the PLAN-AUTO provenance the value carries.
  case "$approval" in
    auto|humano-*)
      if ! plan_approves_itself; then
        info "plan $MISSION is already approved (aprovacao: $approval) — nothing to do"
        return 0
      fi
      warn "aprovacao: auto with 05-verdict.md beside it — this plan was born of sdd kaizen and"
      warn "cannot certify its own homework. Approving replaces it with your own approval."
      ;;
  esac

  step "approve plan — $MISSION"
  info ""
  local titulo; titulo="$(frontmatter "$m" titulo)"
  info "  ${titulo:-<no titulo: in the frontmatter of 00-missao.md>}"
  info ""
  # From the line after the closing `---` to the end. Same awk shape as frontmatter(), so a file
  # with no frontmatter at all prints nothing rather than printing itself twice.
  awk 'NR==1 && $0=="---" { inside=1; next }
       inside && $0=="---" { inside=0; body=1; next }
       body { print "  " $0 }' "$m"

  local rows; rows="$(checkpoint_rows)"
  info ""
  if [ -n "$rows" ]; then
    info "  increments:"
    local id title _check st _commit
    while IFS=$'\t' read -r id title _check st _commit; do
      printf '    %-4s %-46s %s\n' "$id" "${title:0:46}" "$st"
    done <<< "$rows"
  else
    warn "checkpoint.md has no parseable increment row — the PLAN gate will stay shut"
  fi

  # ONE definition of the value being written, read three times below (the warning, the write, the
  # read-back). Split into a literal at each site, a mutant that writes `auto` — an approval that
  # claims the PLAN-AUTO table was all ✅ when a human in fact typed y — would still satisfy the
  # read-back and reach the commit. Sabotaging this single line is what mut_RUN_approve_writes_auto
  # does, and the assertion that dies is the one demanding `humano-` AND the absence of `auto`.
  local approved_as; approved_as="humano-$(date +%F)"

  info ""
  dim "  approving says: this plan is what you want built. It writes aprovacao: $approved_as"
  dim "  into 00-missao.md and commits that one file. It does NOT start the pipeline."
  # The fifth door, and the only one whose commit a human asks for out loud. It went in written by
  # the same mission that closed the silence of the fourth (`sdd retry`) and shipped silent itself:
  # standing on `main`, approving dropped a `chore(missao)` commit straight into the base branch
  # without a word — the SQ-97 class, reopened by the door this mission created. sdd-qa walked it.
  #
  # A warning and NEVER a `die`, unlike the checkout of ensure_mission_branch: the plan legitimately
  # lives on the base branch before the mission branch is cut, and it is from there that the cut is
  # made — refusing would lock out the ordinary flow.
  #
  # HERE and not at the top of the command, which is where the other four doors call it: those four
  # print almost nothing before acting, while this one prints the entire mission body plus the
  # increment table, and a warning at the top would have scrolled off the screen by the time the
  # question is asked. The rule the other call sites state as "ahead of anything that could scroll
  # it away" reads, at a prompt, as "in the breath before the decision". After the idempotence bail
  # for the second reason those comments give: a warning on a path that cannot commit is the crying
  # wolf that teaches people to skip reading them.
  warn_if_on_base_branch
  printf '  approve this plan? [y/N] '
  # `|| ans=""`: with stdin closed, `read` returns non-zero and `set -e` would abort mid-prompt.
  # Anything that is not an explicit yes is a no — the default of a [y/N] prompt is the safe side.
  local ans=""
  read -r ans || ans=""
  # The prompt ends without a newline, and a terminal supplies one when the human hits Enter. A
  # pipe or a closed stdin does not, and the answer would sit glued to the prompt.
  info ""
  case "$ans" in
    y|Y|yes|Yes|YES) : ;;
    *) info "  not approved — nothing was written"; return 0 ;;
  esac

  frontmatter_write "$m" aprovacao "$approved_as"
  # Read back through the same parser the gate uses. An absent `aprovacao:` key leaves
  # frontmatter_write a no-op by design, and committing that would be an approval that approves
  # nothing — the artifact has to answer the gate's question before the commit is made.
  local written; written="$(frontmatter "$m" aprovacao)"
  [ "$written" = "$approved_as" ] \
    || die "could not write 'aprovacao: $approved_as' into $m (it reads '${written:-<empty>}') — is the 'aprovacao:' key in the frontmatter?"

  local rel="${m#"$REPO_ROOT/"}"
  # `-- "$rel"` on the commit, not `git commit -a`: whatever else the tree is carrying is none of
  # this command's business. `git add` first so the path is known to the index even on the first
  # commit of a brand-new mission directory.
  ( cd "$REPO_ROOT" \
    && git add -- "$rel" \
    && git commit -q -m "chore(missao): plan $MISSION approved by the human" \
         -m "Written by 'sdd approve': closing the PLAN gate used to mean editing the frontmatter
by hand, in the exact shape gate_PLAN greps. Only 00-missao.md enters this commit." \
         -- "$rel" ) \
    || die "git refused the approval commit — 'aprovacao: $approved_as' IS written in $rel, commit it by hand"

  ok "approved: aprovacao: $approved_as"
  dim "  next: sdd run $MISSION"
}

cmd_run() {
  local mission_arg="" force_phase="" max_phases=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)     DRY_RUN=1 ;;
      --phase)       force_phase="${2:-}"; shift ;;
      --max-phases)  max_phases="${2:-0}"; shift ;;
      -*)            die "unknown run option: $1" ;;
      *)             mission_arg="$1" ;;
    esac
    shift
  done

  load_config
  resolve_mission "$mission_arg"
  PIPELINE_LOG="$(log_dir)/pipeline.log"

  # One id per `sdd run` invocation. Without it a resumed mission produces two indistinguishable
  # `attempt:1` rows for the same phase; with it, "this mission needed N runs" becomes countable —
  # a better friction signal than the session count.
  AUTONOMY_RUN_ID="$(uuidgen)"
  AUTONOMY_INVOCATION="run"

  step "mission $MISSION — $PROJECT_NAME${DRY_RUN:+}"
  # "nothing will be executed" would be a lie: working out which phases are pending forces the
  # gates to run, and three of them run TEST_CMD. What the dry-run guarantees is narrower — no
  # claude session, no touching of the mission artifacts. Same honesty fix as in --help.
  [ "$DRY_RUN" = "1" ] && dim "  (dry-run: no session will be opened — but the gates do run TEST_CMD)"
  # BEFORE the base-branch warning, and the order is the point: the checkout is what decides where
  # this pipeline will commit, so warning first would cry wolf at a human the runner is about to
  # move off the base branch anyway — and a warning that cries wolf is how people learn to skip
  # reading them. In a dry run nothing is switched, so the projection still says out loud that you
  # are standing on `main`.
  ensure_mission_branch
  # Before the first gate, so it is on screen ahead of anything that could scroll it away. It warns
  # in a dry run too: the projection is where you look BEFORE spending sessions, which makes it the
  # cheapest moment to learn you are about to commit into the base branch.
  warn_if_on_base_branch

  local -A attempts=()
  # SESSIONS, which is not the same grandeza as `attempts` and was being printed as if it were.
  # `attempts` counts laps of this loop: it rises on the lap that ESCALATES (which opens no session
  # at all) and on every later lap the REVIEW->PR->REVIEW degradation takes, so the blocked line
  # said `3 sessions` over a ledger holding one. It is the last thing a human reads when a run ends.
  # Incremented beside `autonomy_session_row` and nowhere else, so the number the terminal says and
  # the rows the ledger holds cannot drift: one writer, one counter, same two places.
  local -A sessions=()
  local phases_run=0 phase before after budget
  # One-shot per `sdd run`, in the spirit of AUTONOMY_SHA_WARNED above: the runner lowers its own
  # bar ONCE, and both trails have to say so once. A plain local of cmd_run is enough here — the
  # degradation branch runs in this very shell, never through `$( )`, so the CLAUDE.md lesson that
  # killed the kit stamp's guard (a global assigned inside a subshell dies with it) does not bite.
  local degraded_logged=0
  local dry_next=""   # dry-run projection cursor (distinct from --phase, which prints just one)

  while :; do
    if [ -n "$dry_next" ]; then phase="$dry_next"
    elif [ -n "$force_phase" ]; then phase="$force_phase"
    else phase="$(current_phase)"; fi

    if [ -z "$phase" ]; then
      info ""
      printf '%s✓ pipeline complete — only the merge is left (the one human gate)%s\n' \
        "$C_GREEN$C_BOLD" "$C_RESET"
      local prurl; prurl="$(frontmatter "$MISSION_DIR/50-pr.md" pr_url)"
      [ -n "$prurl" ] && info "  $prurl"
      kaizen_reminder
      return 0
    fi

    # PLAN is interactive by design: the human takes part in the grill. The runner does not boot
    # the planner.
    if [ "$phase" = "PLAN" ]; then
      gate_PLAN || true
      info ""
      warn "the PLAN phase is not headless: $GATE_WHY"
      dim "  Planning is where the human takes part. Open an interactive session with the"
      dim "  sdd-planner agent (Fable model) and produce 00-missao.md, 01-plano.md, checkpoint.md."
      dim "  Once the PLAN-AUTO gate closes clean, 'sdd run $MISSION' goes on alone to the PR."
      return 2
    fi

    # Real Jidoka: a `blocked` increment escalates ON THE SPOT. Without this the runner read the
    # checkpoint change as "progress" and rebooted EXEC until the phase budget blew — three
    # sessions against the same wall. Found by the fixture mission 20260814-dry-run-completo.
    # HERESTRING, not a pipe. Under `pipefail`, `grep -q` closes the pipe as soon as it matches,
    # the upstream `printf` dies of SIGPIPE and the whole pipeline returns 141 — the `if` reads
    # "no blocked" while blocked EXISTS. Putting the status in a variable first was NOT enough:
    # the pipe was still there, and the race is decided by the size of the text, not by where it
    # came from. Measured on a fixture checkpoint: the miss starts around 5000 rows, and the
    # runner then spends the whole phase budget against the wall it already knew was there —
    # exactly the false negative a Jidoka must never have. tests/check-gates.sh pins it with a
    # 20000-row checkpoint; the RUN_jidoka_pipefail mutation puts the pipe back and the suite
    # has to die.
    local ckstatus; ckstatus="$(checkpoint_rows | cut -f4)"
    if [ "$phase" = "EXEC" ] && grep -qx "blocked" <<< "$ckstatus"; then
      gate_EXEC || true
      info ""
      bad "BLOCKED in EXEC — $GATE_WHY"
      dim "  The line stopped on purpose: an increment was marked 'blocked' by the executor."
      # Names the section by what it IS, not by its literal title: the heading is artifact
      # content in OUTPUT_LANG, so hardcoding it here would leak one language into the runner.
      dim "  Read the execution-notes section of checkpoint.md — the reason is written there."
      dim "  Once the impediment is cleared, set the increment back to 'pending' and 'sdd run'."
      pipeline_log_line "$(date -Iseconds)  BLOCKED  EXEC  increment marked blocked by the executor"
      autonomy_blocked_row "increment-blocked" "EXEC" "$GATE_WHY"
      return 3
    fi

    budget="$(phase_budget "$phase")"
    attempts["$phase"]="$(( ${attempts[$phase]:-0} + 1 ))"
    if [ "${attempts[$phase]}" -gt "$budget" ]; then
      gate_"$phase" || true
      info ""
      bad "BLOCKED in $phase — ${sessions[$phase]:-0} session(s) without satisfying the gate"
      bad "  current reason: $GATE_WHY"
      dim "  'sdd status $MISSION' shows the full state; 'sdd why $MISSION $phase' the reason."
      if [ "$phase" = "REVIEW" ] && [ "$PUBLISH_ON_REVIEW_BLOCKED" = "draft" ]; then
        # The two writers come BEFORE the `continue`, and that order is the whole I2 increment. The
        # jump used to be above both, so the single most interesting autonomy event a mission can
        # produce — the runner lowering its own bar, alone — left no trace anywhere: the journal
        # showed a PR phase after some failing REVIEW sessions, and the series showed the same,
        # with nothing saying why. `degraded`, not `blocked`: the run went ON.
        #
        # ONE CHANCE, AND ONLY ONE (F1 wrote the row once; I9 made the JUMP happen once). The
        # branch used to end in a bare `force_phase="PR"; continue`, which does not end the run:
        # PR ran, its own gate failed, `current_phase` handed REVIEW straight back with the budget
        # still blown, and the branch was re-entered lap after lap. Measured on the QA walk: warn
        # 3×, two PR sessions, and — the part that actually misinformed — the run finally escalated
        # as `budget-exhausted` in **PR**, blaming the phase that was never over budget for a
        # ceiling REVIEW had blown three laps earlier. F1 stopped the ledger from repeating the
        # `degraded` row; the spin underneath it stayed, and this closes it.
        if [ "$degraded_logged" = "0" ]; then
          degraded_logged=1
          # Inside the guard since I9: on the second entry the runner is NOT moving on to PR, so
          # saying so would be the terminal lying about what it is about to do. It used to sit
          # outside as check-autonomy.sh's witness that the fixture kept re-entering the branch —
          # a role the `budget-exhausted`-in-REVIEW row below now holds, and holds better, because
          # only a second entry can produce it.
          warn "PUBLISH_ON_REVIEW_BLOCKED=draft — moving on to PR in draft mode"
          pipeline_log_line "$(date -Iseconds)  DEGRADED  $phase  PUBLISH_ON_REVIEW_BLOCKED=draft, PR in draft mode — $GATE_WHY"
          autonomy_degraded_row "review-to-draft" "$phase" "$GATE_WHY"
          force_phase="PR"; continue
        fi
        # Second entry: the draft PR ran and its gate failed too. Falling through to the blocked
        # pair below ends the run on REVIEW — the phase whose budget is actually blown — reusing
        # the `blocked`/`budget-exhausted` pair that already sat there. Deliberately NOT a new
        # event kind: three readers share one `is_escalation` definition, and an event none of them
        # learned would be filed as unrecognized by all three.
        warn "  the draft PR did not satisfy its gate either — the run ends here"
      fi
      pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
      autonomy_blocked_row "budget-exhausted" "$phase" "$GATE_WHY"
      return 3
    fi

    before="$(state_fingerprint)"
    run_phase "$phase"
    after="$(state_fingerprint)"

    # The projection branch stays FIRST, exactly where it is today. This is belt-and-suspenders,
    # not a cost saver: `run_check_cmd` memoizes and `run_phase`'s own dry-run branch returns
    # before `invalidate_checks`, so evaluating the gate before this branch would not add a real
    # TEST_CMD run. Keeping the ledger writer out of the projection path entirely — rather than
    # relying on `autonomy_append`'s own DRY_RUN guard as the only defense — is the actual reason.
    # No sensor pins this ordering; what tests/check-autonomy.sh asserts is the outcome, "the
    # projection writes no ledger at all".
    if [ "$DRY_RUN" = "1" ]; then
      # --phase <PHASE> asks for one specific phase: print only that one.
      [ -n "$force_phase" ] && return 0
      # Honest projection: the phases whose gate is unsatisfied TODAY, in canonical order. It
      # does not simulate the effect of the phases (it does not guess that EXEC would unblock
      # QA) — honest information is worth more than complete but possibly wrong information.
      dry_next="$(next_pending_phase "$phase")"
      [ -n "$dry_next" ] && continue
      dim "  (dry-run: end of the projection — no session was opened)"
      return 0
    fi

    # Evaluated ONCE into a variable, then branched on. Writing the ledger row inside each of the
    # four branches would multiply the same defect four times — and gate_ functions run TEST_CMD,
    # so calling them twice is not free either.
    local gate_rc=0 moved="false"
    gate_"$phase" || gate_rc=$?
    [ "$before" != "$after" ] && moved="true"
    autonomy_session_row "$phase" "${attempts[$phase]}" "false" "$moved" \
      "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY"
    sessions["$phase"]="$(( ${sessions[$phase]:-0} + 1 ))"

    phases_run=$((phases_run + 1))
    if [ "$max_phases" -gt 0 ] && [ "$phases_run" -ge "$max_phases" ]; then
      info ""; dim "  --max-phases=$max_phases reached"; return 0
    fi

    if [ "$gate_rc" -eq 0 ]; then
      ok "gate $phase: $GATE_WHY"
      force_phase=""
      continue
    fi

    if [ "$moved" = "true" ]; then
      dim "  gate $phase not yet: $GATE_WHY (but the session moved forward — carrying on)"
      force_phase=""
      continue
    fi

    warn "gate $phase failed and the session changed nothing: $GATE_WHY"
    warn "  retrying once with the gate reason in the prompt"
    run_phase "$phase" "$LAST_PHASE_SID"
    # The retry gets its own pair of fingerprints. Until now it ran with no measurement at all,
    # and `moved/total` is precisely the metric that needs it.
    #
    # `after2` is sampled BEFORE `gate_$phase` runs, and the ordering is a decision, not an
    # accident: `moved2` has to answer "did the SESSION move the disk", so whatever the gate itself
    # writes must fall OUTSIDE the sample. It is sound today because `state_fingerprint` reads HEAD,
    # the mission listing and the checkpoint's md5, and no gate touches those three. A gate that
    # ever starts writing into the mission directory breaks the property silently — the symptom
    # would be `moved2=true` on a retry that changed nothing, which is exactly the reading that
    # keeps the runner from escalating. `cmd_kaizen` samples in the same order for the same reason.
    local after2 moved2="false" gate_rc2=0
    after2="$(state_fingerprint)"
    [ "$after" != "$after2" ] && moved2="true"
    gate_"$phase" || gate_rc2=$?
    autonomy_session_row "$phase" "${attempts[$phase]}" "true" "$moved2" \
      "$( [ "$gate_rc2" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY"
    sessions["$phase"]="$(( ${sessions[$phase]:-0} + 1 ))"

    if [ "$gate_rc2" -eq 0 ]; then
      ok "gate $phase (on the retry): $GATE_WHY"
      force_phase=""
      continue
    fi
    if [ "$moved2" = "false" ]; then
      info ""
      bad "BLOCKED in $phase — two sessions without moving the disk: $GATE_WHY"
      pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
      autonomy_blocked_row "no-progress" "$phase" "$GATE_WHY"
      return 3
    fi
    force_phase=""
  done
}

cmd_retry() {
  load_config
  resolve_mission "${1:-}"
  PIPELINE_LOG="$(log_dir)/pipeline.log"
  AUTONOMY_RUN_ID="$(uuidgen)"
  AUTONOMY_INVOCATION="retry"
  # The second call site of the single definition: `sdd retry` opens a session that COMMITS, so a
  # retry fired from the wrong branch lands the redone phase exactly where `sdd run` would not
  # have put it. Same guard, same die, same silence in a dry run (retry has no dry mode, and the
  # global defaults to 0 — the guard costs nothing and outlives the assumption).
  ensure_mission_branch
  # The fourth door, and the last of the four that existed then: `sdd retry` redoes a phase with a
  # FRESH session, and that session COMMITS. Fired from `main` it used to put the redone phase
  # straight into the base branch without a word — the one door of the four that opened in silence.
  # (`sdd approve`, written in this same mission, turned out to be a fifth and got the guard after.)
  #
  # AFTER ensure_mission_branch, exactly like cmd_run and for the same reason: the checkout is what
  # decides where this retry will commit, so warning first would cry wolf at a human the runner is
  # about to move off the base branch anyway.
  warn_if_on_base_branch
  local phase; phase="$(current_phase)"
  [ -n "$phase" ] || { info "pipeline complete — nothing to retry"; return 0; }
  [ "$phase" = "PLAN" ] && die "PLAN is interactive — there is nothing to retry headless"
  step "retrying $phase with a FRESH session"
  local before after moved="false" gate_rc=0
  before="$(state_fingerprint)"
  run_phase "$phase"
  after="$(state_fingerprint)"
  [ "$before" != "$after" ] && moved="true"
  gate_"$phase" || gate_rc=$?
  autonomy_session_row "$phase" "1" "false" "$moved" \
    "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY"
  if [ "$gate_rc" -eq 0 ]; then ok "gate $phase: $GATE_WHY"; return 0; fi
  bad "gate $phase not yet: $GATE_WHY"
  return 3
}

# ---------------------------------------------------------------------------
# Reader for the autonomy ledger. It prints NUMBERS and never a verdict: whether the kit improved
# is the judge's answer (sdd-kaizen, I13.3), and a reader that opines today becomes the yardstick
# that judge would have to contradict tomorrow.
#
# This command is the human's window; the JUDGE reads the JSONL with jq. Coupling I13.3 to this
# text would freeze a table nobody promised to keep.
#
# ONE sentence for one refusal, reached from the two guards below that mean it: a ledger that is not
# there, and a ledger that holds no row. It was written twice, word for word, and two copies is how
# one of them gets rewritten alone — this is the sentence that separates "empty ledger" from
# "corrupt ledger", and a second voice for it would send the reader hunting for a writer that never
# ran when the rows are merely unreadable. It PRINTS and nothing else: the `return 1` stays at each
# call site, where the control flow is readable, and there is no global to lose in a subshell.
autonomy_no_data() {   # autonomy_no_data <ledger path>
  warn "no data: the ledger at $1 does not exist yet (or has no rows)"
  dim "  It is written by 'sdd run' and 'sdd retry'. Nothing has been recorded on this machine."
}
cmd_autonomy() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --all-repos) LEDGER_ALL_REPOS=1 ;;
      *)           die "unknown autonomy option: $1" ;;
    esac
    shift
  done
  local file; file="$(autonomy_log_path)"
  command -v jq >/dev/null 2>&1 || die "jq not found — it is required to read the ledger"

  # Absent or empty is NOT zero waste. Zeros that look like excellence are exactly the vacuity the
  # floors in check-lang and cmd_health exist to kill.
  if [ ! -s "$file" ]; then
    autonomy_no_data "$file"
    return 1
  fi
  # A malformed row dies loudly. Skipping it quietly is how a judge ends up reading a subset and
  # calling it the whole history.
  ledger_parses "$file" || die "malformed row in $file — the ledger is not readable"

  # A REAL row count, not a line count. `grep -c .` counted LINES: a single pretty-printed JSON
  # row made the header say "9 row(s)" while the table correctly said "1 session(s)" — two
  # different units that only ever agreed by coincidence (and that `assert_bucket_sum` pins
  # jq-derived bucket counts against). Worse, `grep -c .` FAILS (rc 1, no match) on a ledger of
  # blank lines, which under `set -e` aborted this whole command with no output on either stream
  # and rc 1 — the SAME rc as the deliberate "no data" case below, making a corrupt ledger
  # indistinguishable from an empty one in a command whose whole thesis is dying loudly.
  # Counted AFTER the repo filter, and it has to be: the header total is what assert_bucket_sum
  # in check-autonomy.sh pins every bucket against, so a total that counted another repo rows
  # would turn that sum into an accusation against the buckets instead of a measurement.
  local repo; repo="$(ledger_repo_root)"
  local def; def="$(ledger_row_is_local)"
  local total lines norepo
  lines="$(jq -s 'length' "$file")"
  norepo="$(jq -s --arg repo "$repo" "$def"' map(select(ledger_row_no_repo)) | length' "$file")"
  total="$(jq -s --arg repo "$repo" "$def"' map(select(ledger_row_is_local)) | length' "$file")"
  if [ "$total" -eq 0 ]; then
    # FOUR different silences, named apart: an empty file, a ledger of rows that name no repo at
    # all, a cwd that belongs to no repo, and a ledger full of somebody else rows. Collapsing them
    # into one "no data" would send the reader hunting for a runner that never wrote, when the rows
    # are right there under another path. The unattributable case is checked BEFORE the two that
    # name a path, for the same reason: both of those would blame a repo the rows never claimed.
    if [ "$lines" -eq 0 ]; then
      autonomy_no_data "$file"
    elif [ "$norepo" -eq "$lines" ]; then
      warn "no data: none of the $lines row(s) in $file say which repo they came from"
      dim "  A row with no 'repo' field belongs to no project — counted apart, never mixed into one."
    elif [ -z "$repo" ]; then
      warn "no data: the ledger is read per repo and this is not a git repository (cwd: $PWD)"
      dim "  $file holds $lines row(s), all of them belonging to some repo. Run this inside one."
    else
      warn "no data for $repo: none of the $lines row(s) in $file were born in this repo"
      # FIVE states, not four. A MIXED ledger — some rows born elsewhere, some naming no repo at
      # all — used to get this one headline for every row, and the remedy it prints reaches only
      # the first kind: `--all-repos` deliberately does not admit rows that belong to no project,
      # so "run it over there / open the scope" is advice nobody can carry out for them. The split
      # is printed instead of implied, for the same reason every exclusion above is counted.
      if [ "$norepo" -gt 0 ]; then
        dim "  $((lines - norepo)) row(s) came from other repos; $norepo name no repo at all."
        dim "  Run 'sdd autonomy' in the repo you want, or --all-repos for every project — but"
        dim "  neither reaches the $norepo unattributable row(s): no scope can claim them."
      else
        dim "  The ledger is global, the reader is not. Run 'sdd autonomy' in the repo you want."
      fi
    fi
    return 1
  fi
  # The header names the SCOPE it just read, not the cwd: under --all-repos the rows below come
  # from every project on this machine, and a header still pointing at one repo path would read as
  # a claim about that repo — the same misattribution the filter was added to remove.
  local scope="$repo"
  [ "$LEDGER_ALL_REPOS" = "1" ] && scope="all repos (--all-repos)"
  step "sdd autonomy — $file · $total row(s) · $scope"

  # Every row lands in exactly ONE of four buckets, and the buckets are exhaustive: comparable
  # session, non-comparable row, escalation on the axis, or unrecognized (event missing, or a value
  # none of session/blocked/degraded — a future event type, a hand edit, a partial write). Every
  # event the runner itself writes has to be in that list: a row the runner produced and its own
  # reader files as "unrecognized" is the blind spot merely moved from the judge to the human.
  # A row that fit none of them used to vanish with no trace; tests/check-autonomy.sh now asserts
  # the four counts sum to the header total, so a filter that drops a row again fails loudly.
  #
  # ESCALATIONS SIT ON THE kit_sha AXIS, exactly as `kaizen_series` has always sliced them
  # (see the `$ok | map(select(.kit_sha == $shas[-1])) | group_summary` there). This reader used to
  # `group_by(.kind)` over the WHOLE file, with no version axis and no comparability filter: the
  # human's table and the judge's series then printed different escalation counts for the same
  # period with nothing explaining the divergence, and kit version is precisely the axis the ledger
  # exists to measure. Two instruments over one file that disagree corrode the trust the kaizen
  # loop runs on, so `sdd autonomy` bends to the series and not the other way round — the series
  # was already right, and "fixing" both sides would have re-created the divergence it removes.
  # A dirty kit or a null sha cannot be attributed to any version, so those escalations join the
  # non-comparable count instead of being summed into a version that did not produce them.
  #
  # A row whose JSON is syntactically valid but the wrong SHAPE (a bare array, say) cannot be
  # classified at all — indexing it with .event is a jq runtime error, not a false comparison — so
  # that failure is caught below and re-raised through die(), same rc 1 as every other refusal in
  # this command instead of leaking jq's own exit code.
  local out jq_rc=0
  out="$(jq -rs --arg repo "$repo" "$def"'
    # ⚠️ NO APOSTROPHE anywhere below, prose included: everything from here to the closing quote is
    # ONE single-quoted shell string, so a stray one ends it mid-jq and bash then reports a syntax
    # error dozens of lines away from the sentence that broke it. That is why every comment in here
    # is phrased around the possessive ("this repo rows", "the judge series"). `bash -n` does catch
    # it — loudly and in the wrong place, which costs a cycle to read.
    #
    # ONE definition of "attributable to a kit version" for the whole program, exactly as
    # is_escalation is one definition of the escalation pair — and for the same reason. This was
    # written twice, `.kit_dirty == false` for sessions and `.kit_dirty != true` for escalations,
    # two spellings of one question that agree on every row the runner writes (the stamp emits
    # kit_dirty:null only alongside kit_sha:null, and a null sha already fails both) and disagree on
    # the one row it does not: kit_dirty:null WITH a sha. There the table counted an escalation
    # under a version while refusing the session next to it — attribution granted and denied in the
    # same output. `== false` is the spelling that survives: unknown dirtiness is not clean, and a
    # row nobody can attribute belongs in the non-comparable bucket, out loud. kaizen_series holds
    # the same definition for its own jq program; tests/check-autonomy.sh compares the readers to
    # each other so neither can be "improved" alone.
    def on_axis: .kit_dirty == false and .kit_sha != null;
    def comparable: .event == "session" and on_axis and (has("moved"));
    def is_session: .event == "session";
    def is_escalation: .event == "blocked" or .event == "degraded";
    def is_unrecognized: (is_session or is_escalation) | not;
    # ONE definition of "which mission is this row about" for this program too, exactly as
    # kaizen_series holds one: the repo is part of the identity, because two projects run the same
    # dated slug on the same day and --all-repos puts their rows in one reading. Counting by slug
    # alone made `2 mission(s)` out of three, in the very header a human reads to decide whether
    # the kit got better. A no-op in per-repo scope. The two readers keep the same spelling on
    # purpose; check-autonomy.sh compares them to each other so neither can be "improved" alone.
    # An ARRAY, for the same two reasons the twin states: a separator inside a value collides, and
    # `+` on a non-string value makes jq die and takes this whole command down with it.
    def mission_key: [(.repo // ""), (.mission // "")];
    # Money is a COLUMN, and jq interpolates a NUMBER: 2.0 came out `US$ 2` in the column next to
    # `US$ 1.5`, the table stopped lining up, and a reader in a hurry reads "no cents were computed".
    # NOT printf, which is nowhere near this string: the whole row is built inside this one jq
    # program, and taking the number back out to bash to format it would split one line across two
    # languages. The cents are rounded to an INTEGER first and re-split, so the second place is
    # always written, zero or not — `\($c / 100)` alone drops it again.
    def usd: (. * 100 | round) as $c
             | ($c / 100 | floor) as $whole
             | ($c - $whole * 100) as $cents
             | "\($whole).\(if $cents < 10 then "0\($cents)" else "\($cents)" end)";
    # The repo filter runs before every bucket, and its own count is kept for the same reason the
    # other three exclusions are printed: a row that leaves has to say so. Bound BEFORE the pipe
    # so the buckets below still see a plain array of this repo rows and nothing changes shape.
    # TWO counts and not one: "born in another repo" and "says no repo at all" are different
    # accusations, and a single number for both would name the wrong one in every message.
    (map(select(ledger_row_no_repo)) | length) as $norepo
    | (map(select((ledger_row_is_local | not) and (ledger_row_no_repo | not))) | length) as $foreign
    | map(select(ledger_row_is_local))
    | (map(select((is_session and (comparable | not))
                or (is_escalation and (on_axis | not)))) | length) as $skipped
    # group_by SORTS BY KEY, and a kit sha is hex: "the last line of the table" was the lexically
    # largest version, not the most recent one. `kaizen_series` has always ordered its versions by
    # FIRST APPEARANCE in the file (`shas_in_file_order` there — same reduce, same reason), so this
    # window and the judge series answered "which version is latest?" differently over one file,
    # with nothing on screen explaining it. Same spelling on purpose, in both programs;
    # check-autonomy.sh compares the last table row to `.latest.kit_sha` of the series so neither
    # side can be "improved" alone. `index` returns 0 for the first element and 0 is truthy in jq,
    # which is what makes the reduce keep the first occurrence instead of appending it twice.
    # The order is read off the SAME POPULATION the judge reads it off — every on_axis row, session
    # or escalation — and not off the comparable sessions this table happens to draw. Getting that
    # wrong is a second way to answer the same question differently: a version whose first on_axis
    # row is an escalation is already known to the series when the table has never heard of it, so
    # a sha that got blocked before it ever finished a session sorted after one that started later.
    # Measured in the r1 review: rows blocked(aaaaaaa), session(bbbbbbb), session(aaaaaaa) put
    # aaaaaaa last in the table while the series called bbbbbbb the latest. `comparable` implies
    # on_axis by its own definition above, so every group here has a place in this list.
    | (map(select(on_axis)) | map(.kit_sha)
       | reduce .[] as $s ([]; if index($s) then . else . + [$s] end)) as $order
    | (map(select(is_session and comparable))
       | group_by(.kit_sha) | sort_by(.[0].kit_sha as $s | $order | index($s))) as $groups
    | (map(select(is_unrecognized)) | length) as $stray
    | (if ($groups | length) == 0 then
        "  no comparable sessions in this ledger"
      else
        ($groups | map(
            (.[0].kit_sha) as $sha
            | (length) as $n
            | (map(select(.moved == false)) | length) as $stalled
            | (map(mission_key) | unique | length) as $missions
            | (map(.cost_usd // 0) | add) as $cost
            | "  \($sha)  \($n) session(s) · \($stalled) stalled · \(($stalled * 100 / $n) | floor)% waste · \($missions) mission(s) · US$ \($cost | usd)"
          ) | join("\n"))
      end)
    , (map(select(is_escalation and on_axis)) | group_by(.kit_sha, .kind)
       | map("  \(.[0].kit_sha)  \(.[0].kind): \(length)") | join("\n")
       | select(length > 0) | "\nescalations\n" + .)
    # ONE output for the four buckets, and that is the second half of the spacing defect. The first
    # half was `empty` instead of `""` on the zero side: each string opens with a newline AND the jq
    # comma puts every output on a line of its own, so a bucket with nothing to report contributed a
    # blank line by itself and two blanks opened between the table and the accounting. `empty` fixed
    # that and left the other half standing — with two buckets filled the four strings came out
    # block+blank+block, one blank between every two, because each surviving string still carried
    # its own leading newline. The accounting is ONE paragraph: four remarks about where the rows
    # went, not four unrelated asides. Collected into an array and joined, the leading newline is
    # written ONCE, by the paragraph rather than by its lines, and `select(length > 0)` keeps the
    # zero case emitting nothing at all — exactly as the escalations block above does. No count
    # moves: this is spacing only.
    , ([ (if $skipped > 0 then "  (\($skipped) non-comparable row(s) excluded: dirty kit, no kit_sha, or no moved field)" else empty end)
       , (if $stray > 0 then "  (\($stray) unrecognized row(s) excluded: event missing or not one of session/blocked/degraded)" else empty end)
       , (if $foreign > 0 then "  (\($foreign) row(s) excluded: born in another repo — the ledger is global, this reader is not)" else empty end)
       , (if $norepo > 0 then "  (\($norepo) row(s) excluded: no repo field — the row cannot say which project it came from)" else empty end)
       ] | select(length > 0) | "\n" + join("\n"))
  ' "$file" 2>/dev/null)" || jq_rc=$?
  if [ "$jq_rc" -ne 0 ]; then
    # A DIFFERENT sentence from the `ledger_parses` refusal above, because they are different
    # defects with different remedies: there a line is not JSON and somebody edits the line; here
    # every line parses and one of them is not an object, so somebody has to find the writer that
    # produced it. One sentence for both said "malformed row" to a reader who then could not tell
    # which had happened. The other half of the pair keeps ITS wording on purpose — `kaizen_series`
    # refuses the same unparseable ledger with the same words, and renaming one of those two would
    # move the collision instead of removing it.
    die "unreadable row in $file — a row is valid JSON but not an object; find the writer that produced it"
  fi
  printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Kaizen — the deterministic half of the judge (ADR 0001). The runner derives labels and numbers;
# the sdd-kaizen agent gives the verdict CITING them, never recalculating. This function is the
# contract between the two: `sdd kaizen --series` is what the agent's session runs as its source
# of truth.
#
# PURE on purpose: it prints JSON and touches no global, so reading it through `$( )` is safe —
# the autonomy_kit_stamp subshell bug cannot happen here because there is no effect to lose.
#
# The label rubric, per mission×phase group:
#   refez — any escalation, any human retry invocation, or the phase's last session still failing
#           its gate: the work was pushed again, the strongest friction signal there is.
#   leve  — an in-loop auto retry or a session that did not move the disk: friction, absorbed.
#   ok    — none of the above.
# Rows with a dirty kit or no kit_sha are non-comparable (counted, never mixed in), and the
# KAIZEN meta row is excluded from the axis it would otherwise shift — the judge must never see
# its own session inflate the guard that gates its verdict.
#
# latest/previous follow FILE order, not sort order: jq's group_by sorts by key and would call
# the lexically-largest sha "latest" — the reduce/index below keeps first-appearance order, and a
# reappearing old sha joins its old group instead of opening a new one.

# The floor of the guard, and its ONE definition: how many missions WITH a session a kit version
# needs before the series supports any verdict but `indeterminado`. ADR 0003 is why it does not
# loosen. Three voices read it and each used to hold a copy — the jq program below (which decides
# `sufficient` and `degenerate_axis`), the empty-series producer inside it (which has no input to
# run that program on), and the sentence `kaizen_axis_note` prints to the human under a comment
# swearing the number was not repeated. The jq one takes it through --argjson, the producer through
# expansion, the sentence off `.guard.floor` of the series it is explaining: a change here moves
# all three, or none of them.
readonly KAIZEN_GUARD_FLOOR=3

kaizen_series() {
  local file; file="$(autonomy_log_path)"
  command -v jq >/dev/null 2>&1 || die "jq not found — it is required to read the ledger"
  # The SAME readability test cmd_autonomy runs, and the reason it is here is that it was not:
  # `sdd autonomy` died loudly on a corrupt ledger while this function returned an unparsed
  # non-zero to a caller that dropped it, and `gate_KAIZEN` then read the empty string as "no
  # verdict yet" — corruption spelled exactly like pending work, which costs an opus session over a
  # file nobody could read. `warn` and not `die`: this function is read through `$( )`, where `die`
  # exits the SUBSHELL and the caller sees a bare rc anyway, so the sentence is printed here (once)
  # and the decision belongs to whoever called.
  if [ -s "$file" ] && ! ledger_parses "$file"; then
    warn "malformed row in $file — the ledger is not readable"
    return 1
  fi
  # Read PER REPO, from the repo this process is standing in. Standing in none, nothing in the
  # ledger is yours: the series comes back empty, which is the SAFE direction (guard.sufficient
  # false supports only `indeterminado`) and never another repo's numbers read as a verdict about
  # this kit. It is said out loud because an empty series that nobody explained is the kind of
  # zero this file spends the rest of its lines refusing to print.
  local repo; repo="$(ledger_repo_root)"
  # Silenced under --all-repos, and only there: with the filter open the cwd decides nothing, so
  # the warning would be announcing an emptiness that is not going to happen. Kept loud otherwise —
  # an empty series nobody explained is the kind of zero this file spends its lines refusing.
  [ -n "$repo" ] || [ "$LEDGER_ALL_REPOS" = "1" ] \
    || warn "not inside a git repository — the ledger is read per repo, so this series comes back empty (cwd: $PWD)"
  if [ ! -s "$file" ]; then
    # Second producer of the same shape, and it cannot share the jq above (there is no input to
    # run it on), so the key set is kept in step by hand and check-kaizen.sh compares the two as
    # key sets. A consumer reading `null` where the real series gives a number is the drift.
    printf '{"v":1,"latest":null,"previous":null,"guard":{"missions_after_change":0,"missions_with_session":0,"sessions":0,"floor":%s,"sufficient":false,"degenerate_axis":false},"excluded":{"non_comparable":0,"unrecognized":0,"meta":0,"other_repo":0,"no_repo":0}}\n' "$KAIZEN_GUARD_FLOOR"
    return 0
  fi
  jq -n --arg repo "$repo" --argjson floor "$KAIZEN_GUARD_FLOOR" "$(ledger_row_is_local)"'
    # ONE definition of "escalation" for the whole program, exactly as cmd_autonomy has one. The
    # two events state different facts (`blocked` stopped the line, `degraded` lowered the bar and
    # went on) but they answer this rubric the same way, and writing the pair out three times is
    # how they came to disagree: `phase_label` was left knowing only `blocked` on the argument that
    # a degraded run has a failing REVIEW session anyway. True inside that run — and the rubric
    # groups by (mission, phase) across the WHOLE kit_sha slice, so one later `sdd run` where
    # REVIEW passes made the one mission that degraded read `ok`. An escalation outlives the
    # session that provoked it; that is why `blocked` was in the clause to begin with.
    def is_escalation: .event == "blocked" or .event == "degraded";

    # ONE definition of the kit_sha axis for this program too — the third hand-written copy of the
    # same question lived here, as the complementary pair `.kit_dirty == true or .kit_sha == null`
    # / `.kit_dirty != true and .kit_sha != null`. Same words as cmd_autonomy on purpose: the judge
    # and the window the human reads take the SAME file, so a row one of them attributes to a
    # version and the other does not is the divergence the ledger exists to prevent, merely moved
    # from inside one command to between two. (No apostrophes in here: this jq program is a
    # single-quoted shell string, and one would end it mid-comment.)
    def on_axis: .kit_dirty == false and .kit_sha != null;

    # ONE definition of "this axis degenerated", same discipline as the two above, and the reason
    # the field below exists at all: a guard that says only `sufficient: false` cannot tell "not
    # enough missions yet" (a target repo, where waiting works) from "the axis cannot work here"
    # (the repo that BUILDS the kit, where every session commits and the next lands on a fresh sha,
    # so waiting never works). Input is the on-axis rows. MORE THAN ONE sha is required on purpose:
    # a first sha with one mission has not degenerated, it has only just started.
    #
    # ONE definition of the floor, shared by the guard verdict below and by the window this field
    # looks through. They cannot drift: the field says "waiting will never satisfy that floor", so
    # it has to be measured over as many kit versions as the floor asks missions of.
    # The value comes in through --argjson from KAIZEN_GUARD_FLOOR, the single owner: the empty
    # ledger takes the same road above, and neither of them can be moved on its own.
    def guard_floor: $floor;
    # ONE definition of "the distinct kit versions, in FILE order", used by the latest/previous
    # pair below and by the window here. group_by sorts by key and answers a different question;
    # two hand-written copies of this reduce is how the blocked/degraded pair came to disagree.
    def shas_in_file_order: map(.kit_sha) | reduce .[] as $s ([]; if index($s) then . else . + [$s] end);
    # ONE definition of "which mission is this row about", and the repo is PART of it. The slug
    # alone was the first spelling, and it was a no-op bug until this mission opened --all-repos:
    # slugs are dated (`YYYYMMDD-<name>`) and cmd_kaizen mints `$(date +%Y%m%d)-kaizen`, identical
    # in every repo on the same day. Measured with three repos, one session each on one kit_sha and
    # two slugs colliding: missions_with_session fell 3 -> 2, guard.sufficient flipped true ->
    # false, and one project refez absorbed the other project clean ok into a single group — a
    # verdict about the kit decided by a slug coincidence. Since F1 the flag reaches the judge
    # prompt, so this reached the verdict. A NO-OP in per-repo scope, where every row shares one
    # repo, which is why the fix costs the default reading nothing.
    #
    # An ARRAY and not a joined string, which is the shape the old `.mission + "|" + .phase` used.
    # Two reasons, both measured: a separator inside a value collides — repo `a|b` with mission `c`
    # and repo `a` with mission `b|c` joined to the same key and read as ONE mission — and `+` on a
    # value that is not a string makes jq DIE, so a hand-edited row with a numeric `repo` took
    # `sdd autonomy` down with `malformed row` and returned the judge nothing. group_by and unique
    # order any JSON, so the array costs nothing and admits no delimiter to inject.
    #
    # Defined HERE, above degenerate_axis, and not beside group_summary where it used to sit: jq
    # resolves a `def` only after it appears, and the second clause of degenerate_axis counts
    # missions. Moved rather than copied — a second spelling of this question is the exact defect
    # the paragraph above is about.
    def mission_key: [(.repo // ""), (.mission // "")];
    # ...and "how many missions bought a session on this version", which is the number the floor
    # reads. Shared with the guard verdict through guard_floor, so the two cannot drift.
    def missions_on($sha): map(select(.kit_sha == $sha and .event == "session"))
                           | map(mission_key) | unique | length;
    def degenerate_axis:
      . as $rows
      | ($rows | shas_in_file_order) as $order
      # The LAST guard_floor versions, and NOT the whole history. Over all of $ok this was a
      # one-way switch: the ledger is append-only, so one ancient sha that happened to buy two
      # sessions turned the explanation off FOREVER while every recent version sat at exactly one.
      # Measured: 20 shas x 1 session => true; add a second session to the OLDEST sha => false,
      # with nothing about today having changed. An explanation that expires on a fact from last
      # year is exactly the number that moves with nothing explaining why.
      | ($order | length) as $n
      | ($order[(if $n > guard_floor then $n - guard_floor else 0 end):]) as $window
      # MISSIONS per version, not sessions, because `missions_with_session` is the unit the floor
      # reads and this field exists to explain that floor. Counting sessions made the two disagree
      # on the one row shape that separates them: a version whose TWO sessions belong to the SAME
      # mission (an in-loop auto retry, or any second `sdd run` on a phase that neither commits nor
      # dirties the kit tree) still contributes exactly one mission, so the floor stays as
      # unsatisfiable as before — and yet the session count of 2 turned this field to `false` and
      # `kaizen_axis_note` went SILENT. Measured: three versions, the newest with two sessions of
      # one mission => `missions_with_session: 1`, `sufficient: false`, `degenerate_axis: false` and
      # the sentence printed zero times. The human then reads a bare `sufficient: false` and waits
      # for missions that cannot help, which is the exact misreading ADR 0003 built this field to
      # end. Zero is still not one: a version whose rows are all escalations observed NOTHING, a
      # different silence with a different remedy, and `== 1` keeps it out.
      # ...AND the floor was never once reached in this whole ledger. The window alone was the
      # second formulation and it traded one wrong answer for another: it says "the axis cannot work
      # HERE", and a quiet stretch is not a broken axis. Measured on the window alone — two versions
      # carrying 3 missions apiece, then three versions with one mission each => `true`, in a repo
      # whose OWN history proves 3-missions-per-version is reachable twice over. The field then errs
      # at exactly the distinction it was created to make, and it feeds the judge prompt.
      #
      # Never-reached is a PERMANENT fact about a repository, so latching the explanation off on it
      # is correct — which is what separates this clause from the whole-history rule it restores a
      # piece of. That one latched on "some sha once bought two sessions", a coincidence that says
      # nothing about whether the floor is attainable; this one latches on the floor itself having
      # been met. In the repo that BUILDS the kit no version ever reaches it (every session commits
      # and the next lands on a fresh sha), so the explanation stays on, which is the point.
      # Grouped ONCE rather than re-scanning every row per version: written as
      # `all($order[]; ($rows | missions_on(.)) < guard_floor)` this clause is O(versions × rows),
      # and the repo that BUILDS the kit is precisely where versions grow without bound — one per
      # session, forever. Measured on 3000 rows across 750 versions: 1.40 s that way, 0.20 s this
      # way. `group_by` sorts, and here that is safe because only the MAXIMUM is wanted and a
      # maximum has no order — the file-order property lives in $order above, untouched.
      | ($rows | map(select(.event == "session")) | group_by(.kit_sha)
               | map(map(mission_key) | unique | length) | max // 0) as $best_reach
      | ($window | length) > 1
        and all($window[]; . as $sha | ($rows | missions_on($sha)) == 1)
        and $best_reach < guard_floor;

    def phase_label:
      if (map(select(is_escalation)) | length) > 0
         or (map(select(.event == "session" and .invocation == "retry")) | length) > 0
         or ((map(select(.event == "session")) | last | .gate) != "pass")
      then "refez"
      elif (map(select(.event == "session" and (.auto_retry == true or .moved == false))) | length) > 0
      then "leve"
      else "ok"
      end;

    def group_summary:
      . as $rows
      | ($rows | map(select(.event == "session"))) as $sess
      | ($rows | group_by(mission_key + [(.phase // "")])
               | map({repo: .[0].repo, mission: .[0].mission, phase: .[0].phase, label: phase_label,
                      sessions: (map(select(.event == "session")) | length),
                      cost_usd: (map(.cost_usd // 0) | add)})) as $detail
      | {kit_sha: $rows[0].kit_sha,
         missions: ($rows | map(mission_key) | unique | length),
         # The floor of the guard, and NOT the same number as `missions` above: that one counts
         # every mission on the axis, escalations included, which is right for the display and
         # wrong for the floor. A mission that stopped the line without spending a session left
         # the judge nothing to read about this kit version, and three of them used to clear a
         # floor meant to mean "enough observation". Derived from $sess, the one place this
         # program already calls a row a session. Keyed by mission_key like every other count here:
         # this is the number the floor reads, so a slug collision between two projects landing
         # here is a guard moved by a coincidence.
         missions_with_session: ($sess | map(mission_key) | unique | length),
         sessions: ($sess | length),
         moved_rate: (if ($sess | length) == 0 then null
                      else (($sess | map(select(.moved == true)) | length) / ($sess | length) * 100 | round / 100) end),
         labels: ($detail | reduce .[] as $d ({ok: 0, leve: 0, refez: 0}; .[$d.label] += 1)),
         escalations: ($rows | map(select(is_escalation))
                             | group_by(.kind)
                             | map({(.[0].kind): length}) | add // {}),
         cost_usd: ($sess | map(.cost_usd // 0) | add // 0 | . * 100 | round / 100),
         detail: $detail};

    [ inputs ] as $file_rows
    # The repo filter runs BEFORE any classification, and its own count is kept: a row born in
    # another repo is not this repo unrecognized row, it is not this repo row at all — and it is
    # counted rather than dropped, because a number that moved with nothing explaining why is the
    # defect this filter exists to remove, not one to introduce one layer down.
    | ($file_rows | map(select(ledger_row_no_repo)) | length) as $no_repo
    | ($file_rows | map(select(ledger_row_is_local))) as $raw
    # Subtracted out, never lumped in: a row that names no project did not come from another repo,
    # and a bucket that said it did would be a wrong reason printed with the confidence of a right
    # one. The two counts partition what the filter removed, so the arithmetic still closes.
    | (($file_rows | length) - ($raw | length) - $no_repo) as $other_repo
    | ($raw | map(select(type == "object" and .v == 1
                         and (.event == "session" or is_escalation)))) as $all
    | ($all | map(select(.phase == "KAIZEN"))) as $meta
    | ($all | map(select(.phase != "KAIZEN"))) as $rows
    | (($raw | length) - ($all | length)) as $unrec
    | ($rows | map(select(on_axis | not))) as $noncomp
    | ($rows | map(select(on_axis))) as $ok
    | ($ok | shas_in_file_order) as $shas
    | (if ($shas | length) >= 1 then ($ok | map(select(.kit_sha == $shas[-1])) | group_summary) else null end) as $latest
    | (if ($shas | length) >= 2 then ($ok | map(select(.kit_sha == $shas[-2])) | group_summary) else null end) as $previous
    # ONE binding for the number the floor reads, so the exposed field and the verdict of the
    # guard cannot drift apart: written twice, an edit to one of them would leave the series
    # PRINTING a count it did not gate on, which is the same class of divergence I7 closed one
    # field over. Everything the guard says about itself comes from here.
    | (($latest.missions_with_session) // 0) as $observed
    # Derived from the WHOLE comparable slice, never from $latest alone: a degenerate axis is a
    # property of the SET of recent kit versions (each carrying exactly one MISSION — the unit
    # $observed above reads, never sessions), which no single group can state about itself. It adds
    # no fact to the ledger and changes no verdict — it explains one.
    | ($ok | degenerate_axis) as $degenerate
    | {v: 1,
       latest: $latest,
       previous: $previous,
       # The floor below does not loosen, and ADR 0003 is why: verdict evidence comes from real
       # target repos, where many missions share one kit_sha. In the repo that BUILDS the kit every
       # session lands on a fresh sha, so the axis degenerates and the floor is unsatisfiable by
       # construction — that is the axis being read in the wrong place, never a floor set too high.
       guard: {missions_after_change: ($latest.missions // 0),
               missions_with_session: $observed,
               sessions: ($latest.sessions // 0),
               # PUBLISHED, and that is what makes it one number instead of two. The sentence
               # kaizen_axis_note prints to the human used to carry its own hand-written `3`, under
               # a comment swearing it did not — the one voice of this floor a human reads out
               # loud, and the one that would have drifted in silence the day the floor moved.
               floor: guard_floor,
               sufficient: ($observed >= guard_floor),  # missions WITH a session (D4); I13.4 revisits
               degenerate_axis: $degenerate},
       excluded: {non_comparable: ($noncomp | length), unrecognized: $unrec,
                  meta: ($meta | length), other_repo: $other_repo, no_repo: $no_repo}}
  ' < "$file"
}

# One dim line after "pipeline complete": how many missions the CURRENT kit version accumulated
# without a verdict, and where to go. Pull, not push (D6) — the human is the kanban, so it prints
# only when there is something to judge and no verdict for it yet, and it never blocks anything.
# The third reader of the ledger, and it holds no filter of its own on purpose: it reads through
# kaizen_series, so it inherits ledger_row_is_local along with every number it prints. A repo whose
# rows all came from somewhere else gets missions_after_change 0 here and stays silent, which is
# the right silence — there is nothing of THIS repo for the judge to look at.
# The verdicts live in the KIT repo ($SDD_HOME/docs/handoffs/), readable from any target repo.
# Every read goes through a variable or a herestring — never `printf | grep`, the pipefail trap.
kaizen_reminder() {
  # Same one-shot warn as every other jq consumer — a silent return here would be the
  # "errors pass silently" exception in a file that already fixed this once.
  autonomy_have_jq || return 0
  local file; file="$(autonomy_log_path)"
  [ -s "$file" ] || return 0
  local series n sha
  series="$(kaizen_series)" || return 0
  n="$(jq -r '.guard.missions_after_change' <<< "$series")"
  [ "$n" != "0" ] || return 0
  sha="$(jq -r '.latest.kit_sha // empty' <<< "$series")"
  [ -n "$sha" ] || return 0
  # Same search as gate_KAIZEN: by kit_sha_judged content, never by newest file.
  local f
  for f in "$SDD_HOME"/docs/handoffs/*/05-verdict.md; do
    [ -f "$f" ] || continue
    [ "$(frontmatter "$f" kit_sha_judged)" = "$sha" ] && return 0
  done
  dim "  autonomy series: $n mission(s) on kit $sha without a verdict — run 'sdd kaizen' in the kit repo ($SDD_HOME) for the next kit mission plan"
}

# KAIZEN gate — same convention as every gate (0/1, reason in GATE_WHY), but NOT in PHASES:
# KAIZEN is the meta-loop that judges the kit itself, and cmd_kaizen drives it directly.
#
# Satisfied means: a verdict exists for the kit sha the series calls latest, and — unless the
# verdict is `piorou`, which dispenses the plan (ADR 0002) — the born plan sits beside it with an
# EMPTY `aprovacao:`. The verdict is found by CONTENT (`kit_sha_judged == expected`), never by
# "newest file" — and that stays true now that latest_matching() sorts by version: file order,
# however correct, does not know which sha a verdict judged, and an old verdict must never
# satisfy a new sha.
#
# On `piorou` the gate PASSES (the judge did its job) and publishes GATE_KAIZEN_VERDICT so
# cmd_kaizen can stop the line — the gate itself never kills the process, and the global survives
# because gate_KAIZEN is CALLED, never read through $( ) (the autonomy_kit_stamp subshell lesson).
#
# The verdict LABEL is never trusted on its own (principle 1: gate = artifact, never a label):
# the value must be one of the three enum tokens, and any verdict other than `indeterminado`
# demands guard.sufficient from the SAME series the agent was told to cite — the boot prompt's
# "the guard belongs to the runner" is enforced here, not merely requested there.
#
# GATE_KAIZEN_APPROVED carries a non-empty `aprovacao:` out to cmd_kaizen, which must NOT route
# that failure through the generic fix-it retry session: the value may be a HUMAN's approval, and
# a session told to "complete what is missing" could blank it — erasing a human decision that
# `sdd run` may already be acting on.
GATE_KAIZEN_VERDICT=""
GATE_KAIZEN_VERDICT_FILE=""
GATE_KAIZEN_PLAN_DIR=""
GATE_KAIZEN_APPROVED=""
GATE_KAIZEN_UNREADABLE=""
gate_KAIZEN() {
  GATE_KAIZEN_VERDICT=""; GATE_KAIZEN_VERDICT_FILE=""; GATE_KAIZEN_PLAN_DIR=""
  GATE_KAIZEN_APPROVED=""; GATE_KAIZEN_UNREADABLE=""
  local series expected f found="" series_rc=0
  # The rc is READ, and that is the whole point. Written `series="$(kaizen_series)"` bare, this line
  # looked safe because errexit would catch it — and errexit is OFF inside here, every time: every
  # caller invokes this function as `gate_KAIZEN || gate_rc=$?`, which disables it for the entire
  # body. So a failed read left `series` empty, `expected` empty, and the gate answered "no verdict
  # for kit  yet" (that double space was the only tell) — a corrupt ledger routed into the branch
  # meaning "the judge has not run", which spends an opus session on a file that cannot be read.
  # A series that could not be read supports NO statement about the kit, so it gets its own outcome
  # rather than the most optimistic neighbouring one.
  series="$(kaizen_series)" || series_rc=$?
  if [ "$series_rc" -ne 0 ] || [ -z "$series" ]; then
    GATE_KAIZEN_UNREADABLE=1
    GATE_WHY="the ledger could not be read (the series reader exited $series_rc) — this is NOT 'not judged yet': run 'sdd autonomy' to see which row breaks it. No session can judge a series nobody can read."
    return 1
  fi
  expected="$(jq -r '.latest.kit_sha // "none"' <<< "$series")"
  for f in "$REPO_ROOT/$HANDOFF_DIR"/*/05-verdict.md; do
    [ -f "$f" ] || continue
    if [ "$(frontmatter "$f" kit_sha_judged)" = "$expected" ]; then found="$f"; break; fi
  done
  [ -n "$found" ] || { GATE_WHY="no verdict for kit ${expected} yet"; return 1; }
  GATE_KAIZEN_VERDICT_FILE="$found"
  local verdict; verdict="$(frontmatter "$found" verdict)"
  case "$verdict" in
    melhorou|piorou|indeterminado) : ;;
    *) GATE_WHY="verdict '${verdict:-<empty>}' at $found is not one of melhorou|piorou|indeterminado"
       return 1 ;;
  esac
  local sufficient; sufficient="$(jq -r '.guard.sufficient' <<< "$series")"
  if [ "$sufficient" != "true" ] && [ "$verdict" != "indeterminado" ]; then
    GATE_WHY="verdict '$verdict' at $found but guard.sufficient is false — the guard belongs to the runner and an insufficient series only supports 'indeterminado'"
    return 1
  fi
  if [ "$verdict" = "piorou" ]; then
    GATE_KAIZEN_VERDICT="piorou"
    GATE_WHY="verdict piorou at $found — the plan is dispensed, the line must stop"
    return 0
  fi
  local d; d="$(dirname "$found")"
  [ -f "$d/00-missao.md" ] \
    || { GATE_WHY="verdict at $found but 00-missao.md is missing beside it"; return 1; }
  local approval; approval="$(frontmatter "$d/00-missao.md" aprovacao)"
  if [ -n "$approval" ]; then
    GATE_KAIZEN_APPROVED="$approval"
    GATE_WHY="the born plan carries 'aprovacao: $approval' — kaizen never approves itself (pre-I13.4), and a filled value is the human's, never a session's to blank"
    return 1
  fi
  [ -f "$d/01-plano.md" ] \
    || { GATE_WHY="verdict at $found but 01-plano.md is missing beside it"; return 1; }
  [ -f "$d/checkpoint.md" ] \
    || { GATE_WHY="verdict at $found but checkpoint.md is missing beside it"; return 1; }
  GATE_KAIZEN_PLAN_DIR="$d"
  GATE_WHY="verdict ${verdict} + born plan with empty aprovacao at $d"
  return 0
}

# The two terminal outcomes of a satisfied KAIZEN gate, shared by the idempotent pre-check and
# the post-session re-evaluations. Returns 3 on `piorou` (Jidoka — same escalation convention as
# a blocked increment) and 0 when the born plan is waiting for the human.
kaizen_outcome() {
  if [ "$GATE_KAIZEN_VERDICT" = "piorou" ]; then
    info ""
    bad "the previous kit change made autonomy WORSE — the line is stopped"
    dim "  Read the verdict, decide, then re-run: $GATE_KAIZEN_VERDICT_FILE"
    return 3
  fi
  ok "gate KAIZEN: $GATE_WHY"
  dim "  Review the born plan, fill 'aprovacao:', then 'sdd run' the new mission:"
  dim "  $GATE_KAIZEN_PLAN_DIR"
  return 0
}

# Terminal handling of a born plan whose `aprovacao:` is already filled — the one gate failure
# that must NEVER be handed to a fix-it session, because the generic retry prompt ("complete
# what is missing and write the artifacts") reads, to a live agent, as an instruction to blank
# the field. Returns 3 for the loop's own forbidden self-approval, 0 when a human already
# approved (kaizen's job ended when the plan was born; the next step is sdd run).
kaizen_approved_outcome() {
  if [ "$GATE_KAIZEN_APPROVED" = "auto" ]; then
    info ""
    bad "the born plan approved ITSELF (aprovacao: auto) — pre-I13.4 the loop never does that"
    dim "  A human decides: empty the field to hand the plan back, or replace it with your own approval."
    return 3
  fi
  ok "the born plan is already approved (aprovacao: $GATE_KAIZEN_APPROVED)"
  dim "  Kaizen's work here is done — the next step is 'sdd run' on that mission, not another verdict."
  return 0
}

# The structural `indeterminado`, said out loud instead of left for the human to infer. The number
# it reads is derived by kaizen_series (ADR 0001: the runner never opines, it reports), and the
# sentence exists because `guard.sufficient: false` means two different things in two different
# repos — "a few more missions and we are there" in a target, "no number of missions here will ever
# do it" in the repo that builds the kit. Read as the first, the human waits forever.
#
# ADR 0003 is NAMED, not paraphrased: the decision is why the floor does not loosen in answer to
# this, and a sentence carrying its own evidence is the difference between a report and an opinion.
kaizen_axis_note() {
  autonomy_have_jq || return 0
  local series
  # stderr dropped ON PURPOSE, and only here: this is a second read of the same series the gate is
  # about to take, so an unreadable ledger printed jq raw diagnostic TWICE in a row — the same
  # complaint from two voices reads as two problems. Reporting corruption is the gate job, one
  # line down, and it still does it. This function only ever explains a degenerate axis, and it
  # has nothing to explain about a file it could not parse.
  series="$(kaizen_series 2>/dev/null)" || return 0
  [ "$(jq -r '.guard.degenerate_axis' <<< "$series")" = "true" ] || return 0
  # READ off the series this sentence is explaining, never written here. The comment that used to
  # sit on this line said "no count in the sentence on purpose: writing 3 here would be a third copy
  # of a number the jq program already owns, drifting the day the floor moves" — and the `dim` two
  # lines down printed "The floor of 3 missions". The promise was right; the code did the opposite,
  # and this is the only voice of the floor a human ever reads out loud.
  local floor; floor="$(jq -r '.guard.floor' <<< "$series")"
  warn "the kit_sha axis is degenerate here: the recent kit versions each carry exactly one mission, and none ever reached the floor"
  dim "  This repo BUILDS the kit, so each session commits and the next one lands on a fresh sha."
  dim "  The floor of $floor missions per kit version is unsatisfiable here, and 'indeterminado' is then"
  dim "  the CORRECT verdict, not a missing mission: evidence comes from real target repos (ADR 0003)."
}

cmd_kaizen() {
  local series_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --series)  series_only=1 ;;
      --dry-run) DRY_RUN=1 ;;
      # Accepted on the whole command and not just on --series: the KAIZEN gate reads through
      # kaizen_series in this same process, so the flag lands on every number this command derives
      # rather than on the JSON alone. What it must NEVER do is default to on — the judge's own
      # verdict would then be computed over other projects' rows (ADR 0003 is about the axis being
      # read in the right place; this is the same rule about the repo).
      # ⚠️ NOT kaizen_reminder, whatever this comment said before: the reminder is called from
      # cmd_run and nowhere else, and `sdd run` has no --all-repos (it dies on any unknown `-*`).
      # It reads through the same single predicate and WOULD inherit the flag — but no invocation
      # that reaches it can carry one, so today it always reads per repo. Saying otherwise was the
      # same lying comment this mission removed one function up.
      --all-repos) LEDGER_ALL_REPOS=1 ;;
      *)         die "unknown kaizen option: $1" ;;
    esac
    shift
  done
  # The ledger FILE is global (~/.sdd), so no config and no mission are needed to read it — but the
  # reading is per repo, and kaizen_series resolves that itself. Run from outside a git repository
  # it warns and comes back empty, which is the safe direction: an empty series is insufficient by
  # construction and supports only `indeterminado`.
  if [ "$series_only" = "1" ]; then kaizen_series; return 0; fi

  load_config
  # KAIZEN plans the KIT's next mission, never a target project's. Run from anywhere else it
  # would judge the kit but give birth to the plan in the wrong repo.
  local kit_root
  kit_root="$( cd "$SDD_HOME" && git rev-parse --show-toplevel 2>/dev/null || true )"
  # Two distinct refusals, named apart: an empty kit_root means the kit itself has no git
  # history (a plain copy) — blaming the cwd would send the user hunting for the wrong problem,
  # the same misattribution autonomy_kit_stamp already warns about for ledger rows.
  [ -n "$kit_root" ] \
    || die "$SDD_HOME is not a git checkout — the kaizen loop judges kit versions and needs the kit's git history"
  [ "$kit_root" = "$REPO_ROOT" ] \
    || die "sdd kaizen plans the KIT's next mission — run it in the kit repo ($SDD_HOME)"
  # A dirty tree does not block (the judge may be invoked mid-work on purpose), but the rows born
  # now carry kit_dirty:true and stay out of the comparable series forever — worth hearing once.
  [ -z "$( git -C "$REPO_ROOT" status --porcelain 2>/dev/null )" ] \
    || warn "the kit tree is dirty — ledger rows born now carry kit_dirty:true and stay non-comparable"
  # The third door, and the one that most needed it: everything above here validates the kit repo
  # and the tree, and none of it asks WHICH BRANCH the verdict and the three born artifacts are
  # about to land on. `--series` already returned above — a pure read warns about nothing.
  warn_if_on_base_branch
  # Pseudo-mission: logs and the boot prompt need a name, but KAIZEN derives nothing from a
  # mission directory — resolve_mission is NOT called (it requires an existing mission), and this
  # directory is never created by the runner: the agent creates the real handoff directory when
  # it writes the verdict.
  MISSION="$(date +%Y%m%d)-kaizen"
  MISSION_DIR="$REPO_ROOT/$HANDOFF_DIR/$MISSION"
  PIPELINE_LOG="$(log_dir)/pipeline.log"
  AUTONOMY_RUN_ID="$(uuidgen)"
  AUTONOMY_INVOCATION="run"

  step "kaizen — judging the previous kit change and planning the next kit mission"
  [ "$DRY_RUN" = "1" ] && dim "  (dry-run: no session will be opened and nothing is written)"
  # Before the gate, so the explanation reaches the human on BOTH outcomes: a pending gate is
  # exactly where `sufficient: false` is about to be read, and an already-judged one is where the
  # next question ("why indeterminado again?") is asked. CALLED, never `$( )` — it prints.
  kaizen_axis_note

  # Idempotent: already judged ⇒ no session is spent, only the outcome is repeated.
  local gate_rc=0 out_rc=0
  gate_KAIZEN || gate_rc=$?
  if [ "$gate_rc" -eq 0 ]; then
    dim "  already judged: no session to spend"
    kaizen_outcome || out_rc=$?
    return "$out_rc"
  fi
  # An unreadable ledger stops the line BEFORE any session, and ahead of every other bailout: each
  # one below reasons about numbers this series was supposed to carry, and it carries none. The
  # session is the thing being refused — a corrupt ledger is not a state an agent can fix from
  # inside a session (the file lives in $HOME and is not in the repo), so opening one only spends
  # opus to arrive at the same sentence. `die`, exactly as cmd_autonomy does over the same file:
  # this is the same refusal, reached through the gate instead of through the reader.
  if [ -n "$GATE_KAIZEN_UNREADABLE" ]; then
    die "$GATE_WHY"
  fi
  # A filled `aprovacao:` bails out BEFORE any session — see kaizen_approved_outcome.
  if [ -n "$GATE_KAIZEN_APPROVED" ]; then
    out_rc=0; kaizen_approved_outcome || out_rc=$?
    return "$out_rc"
  fi

  local before after moved="false"
  before="$(state_fingerprint)"
  run_phase KAIZEN
  # The projection stops HERE, before the fingerprint and the ledger writer — same decision, same
  # reason, as the dry-run branch in cmd_run: the writer stays out of the projection path
  # entirely instead of leaning on autonomy_append's own guard as the only defense.
  if [ "$DRY_RUN" = "1" ]; then
    dim "  (dry-run: end of the projection — no session was opened)"
    return 0
  fi
  after="$(state_fingerprint)"
  [ "$before" != "$after" ] && moved="true"
  gate_rc=0; gate_KAIZEN || gate_rc=$?
  autonomy_session_row "KAIZEN" "1" "false" "$moved" \
    "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY"
  if [ "$gate_rc" -eq 0 ]; then
    kaizen_outcome || out_rc=$?
    return "$out_rc"
  fi

  # Same bailout after the session: if the agent filled `aprovacao:` itself, a fix-it retry
  # would be told to undo it — the value's owner is a human, so the line stops instead.
  if [ -n "$GATE_KAIZEN_APPROVED" ]; then
    out_rc=0; kaizen_approved_outcome || out_rc=$?
    return "$out_rc"
  fi

  warn "gate KAIZEN failed: $GATE_WHY"
  warn "  retrying once with the gate reason in the prompt"
  run_phase KAIZEN "$LAST_PHASE_SID"
  local after2 moved2="false"
  after2="$(state_fingerprint)"
  [ "$after" != "$after2" ] && moved2="true"
  gate_rc=0; gate_KAIZEN || gate_rc=$?
  autonomy_session_row "KAIZEN" "1" "true" "$moved2" \
    "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY"
  if [ "$gate_rc" -eq 0 ]; then
    kaizen_outcome || out_rc=$?
    return "$out_rc"
  fi
  # Third and last bailout: the RETRY session may be the one that filled `aprovacao:` — falling
  # through would misreport an approval as a no-progress escalation, with a spurious blocked row.
  if [ -n "$GATE_KAIZEN_APPROVED" ]; then
    out_rc=0; kaizen_approved_outcome || out_rc=$?
    return "$out_rc"
  fi

  info ""
  bad "BLOCKED in KAIZEN — two sessions without satisfying the gate: $GATE_WHY"
  dim "  The judge's session did not produce the artifacts. Read the logs in $(log_dir)/."
  autonomy_blocked_row "no-progress" "KAIZEN" "$GATE_WHY"
  return 3
}

cmd_version() { info "sdd $SDD_VERSION ($SDD_HOME)"; }

cmd_help() {
  cat <<'EOF'
sdd — runner for the autonomous development agent pipeline

USAGE
  sdd install [--force]      install the kit into the target repo (.sdd/config.sh + .claude/agents/)
  sdd preflight              environment sensor: tools, auth, config, plugins, git
  sdd health                 KIT sensor: suite, mutation, doc and config drift
  sdd status <mission>       where the mission stands, gate by gate, and what is missing
  sdd approve <mission>      show the plan and, on an explicit y, write the human approval into
                             00-missao.md and commit it (the PLAN gate — never a session)
  sdd run <mission>          run from the first unsatisfied phase through to the PR
  sdd retry <mission>        retry the current phase with a fresh session
  sdd close <mission>        post-merge: close the JIRA issue
  sdd autonomy [--all-repos] waste per kit version, for this repo unless --all-repos, from the ledger
  sdd kaizen [--dry-run]     judge the previous kit change and give birth to the next kit
             [--all-repos]   mission plan (kit repo only; exit 3 = the change made it worse)
  sdd kaizen --series        the deterministic series (JSON) the judge cites, for the repo
             [--all-repos]   it runs in (the ledger file is global, the reading is not)
  sdd help | sdd version

LEDGER OPTIONS (`autonomy` and `kaizen`)
  --all-repos                read the WHOLE ledger, not just the rows born in this repo. The
                             default is per repo because a `sdd run` in a THROWAWAY FIXTURE repo
                             once moved the judge's own numbers, and a verdict about this kit
                             must never rest on rows a test invented. Ask for it when the question
                             really is cross-project maturity — which is why the ledger is one
                             file per machine to begin with.
                             ⚠️ Whether a REAL target repo's rows may carry a verdict is a
                             different question, and an open one: ADR 0003 says verdict evidence
                             comes from target repos (the kit's own axis degenerates), and this
                             flag is the only way to read them — but nothing here yet distinguishes
                             a target from a fixture, so the default stays shut and the judge is
                             not pointed at it. That decision is ADR 0004's, not this flag's.

FOR SCRIPTS
  sdd phase <mission>        print only the current phase (or DONE)
  sdd why <mission> [PHASE]  print why that phase's gate did not pass

`run` OPTIONS
  --dry-run                  print the boot prompts and exit, spending no tokens and touching
                             no mission artifact (the gates do run TEST_CMD for real)
  --phase <PHASE>            force one specific phase (PLAN|TICKET|EXEC|QA|REVIEW|DOCS|PR)
  --max-phases <N>           stop after N phases (default: no limit)

HOW THE STATE WORKS
  There is no state file. The current phase is derived from the artifacts in
  docs/handoffs/<mission>/. Session died? `sdd run` again resumes at the exact point.
  No gate is satisfied by model text — the runner runs the tests and reads the disk.
EOF
}

# ---------------------------------------------------------------------------
main() {
  local subcmd="${1:-help}"
  shift || true
  case "$subcmd" in
    install)   cmd_install "$@" ;;
    preflight) cmd_preflight "$@" ;;
    health)    cmd_health "$@" ;;
    status)    cmd_status "$@" ;;
    approve)   cmd_approve "$@" ;;
    phase)     cmd_phase "$@" ;;
    why)       cmd_why "$@" ;;
    run)       cmd_run "$@" ;;
    retry)     cmd_retry "$@" ;;
    close)     cmd_close "$@" ;;
    autonomy)  cmd_autonomy "$@" ;;
    kaizen)    cmd_kaizen "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h) cmd_help ;;
    *) die "unknown command: $subcmd (see 'sdd help')" ;;
  esac
}

# Post-merge: closes the JIRA issue. Fired by the human after the merge — it is the only thing
# that happens AFTER the human gate, which is why it is not part of `sdd run`.
cmd_close() {
  load_config
  resolve_mission "${1:-}"
  PIPELINE_LOG="$(log_dir)/pipeline.log"

  [ "$JIRA_ENABLED" = "true" ] || { info "JIRA_ENABLED=false — nothing to close"; return 0; }
  local issue; issue="$(frontmatter "$MISSION_DIR/10-ticket.md" issue)"
  [ -n "$issue" ] || die "no 'issue:' found in 10-ticket.md — did the TICKET phase run?"

  local prurl; prurl="$(frontmatter "$MISSION_DIR/50-pr.md" pr_url)"
  if [ -n "$prurl" ]; then
    local merged
    merged="$( cd "$REPO_ROOT" && gh pr view "$prurl" --json state --jq .state 2>/dev/null || true )"
    if [ "$merged" != "MERGED" ]; then
      die "PR $prurl is '$merged', not MERGED — 'sdd close' is post-merge"
    fi
  fi

  step "closing $issue"
  local sid logfile rc=0
  sid="$(uuidgen)"
  logfile="$(log_dir)/CLOSE-$(date +%Y%m%d-%H%M%S).json"
  mkdir -p "$(dirname "$logfile")"
  ( cd "$REPO_ROOT" && claude -p "/ticket close $issue" \
      --model "$MODEL_TICKET" --permission-mode "$PERMISSION_MODE" --output-format json \
      --setting-sources "user,project,local" --allowedTools "$ALLOWED_TOOLS" \
      --session-id "$sid" --max-budget-usd "$BUDGET_PER_PHASE_USD" ) > "$logfile" 2>&1 || rc=$?
  pipeline_log_line "$(date -Iseconds)  CLOSE  issue=$issue  session=$sid  rc=$rc  log=$logfile"
  [ "$rc" -eq 0 ] && ok "$issue closed" || bad "failed to close $issue — see $logfile"
  return "$rc"
}

# The braces and the `exit` are load-bearing, and tests/check-entrypoint.sh is why. bash keeps the
# file offset in sync with what it has parsed, so returning from a bare `main "$@"` sends it back
# to the read loop to ask this file for more input — and the EXEC phase edits bin/sdd DURING the
# `sdd run` executing it. Today the editor writes a new file and renames it, so the running shell
# keeps reading the old inode; an append (`>> "$0"`, `tee -a`) does not, and the shell would then
# execute whatever landed past the old end of file, with rc 0. `exit` means the read loop is never
# reached again, however much the file grew meanwhile.
{ main "$@"; exit $?; }
