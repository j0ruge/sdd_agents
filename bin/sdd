#!/usr/bin/env bash
#
# sdd — runner for the autonomous development agent pipeline.
#
# Core principle: there is NO state file. The current phase is DERIVED from the artifacts on
# disk. That gives resume for free after any session death, and eliminates the whole class of
# bug where "the state lies about the disk".
#
# Principle no. 2: success is never the model's answer. Every gate is re-evaluated here — by
# running the tests, grepping the checkpoint, reading the git log, asking gh.
#
# Usage: sdd <command> [mission] [options]   ·   `sdd help` for the list.

set -euo pipefail

readonly SDD_VERSION="0.1.0"

# Seconds a single TCP connect to APP_URL may take before the probe gives up. A CONSTANT and
# deliberately NOT a load_config key: config/schema.md:40-41 forbids a key the runner does not
# read, and five were deleted in c8070dc for exactly that. A key here would also have to be
# documented in schema.md and mirrored in starter.conf, or checks 5 and 7 of `sdd health` would
# report it — buying a knob nobody asked for with three places to keep in step.
#
# 3s and not 1s: the probe runs against a loopback address in the common case, where a refusal is
# immediate, and the value only matters on the path where the connect HANGS — a firewall dropping
# packets. There the answer is `unknown` whatever the number, so the number only decides how long
# the gate waits before saying so.
readonly APP_PROBE_TIMEOUT=3

# Associative arrays (the sensor cache) need bash 4. macOS ships bash 3.2 as /bin/bash; failing
# here beats failing with "bad substitution" halfway through a phase.
#
# Bash 4 is necessary and NOT sufficient, and the old message ("On macOS: brew install bash")
# promised otherwise. The kit assumes the GNU userland: `md5sum` and `date -Iseconds` and
# `sort -V` in this file, `sed -i` with no argument (43x) and `grep -P` (1x) across the suite —
# every one of them rejected by the BSD tools macOS ships. Telling someone that fixing bash is
# enough is a message that promises a world which does not exist, which is the same defect the
# gates exist to forbid. So this one stops at what it can honestly claim, and `sdd preflight`
# measures the userland instead of assuming it.
if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ]; then
  printf 'error: sdd needs bash 4+ (found: %s) and the GNU userland.\n' "${BASH_VERSION:-unknown}" >&2
  printf '  macOS: brew install bash coreutils gnu-sed grep, then put the gnubin dirs first in\n' >&2
  printf '  PATH — brew names them gmd5sum/gdate, and the kit calls md5sum/date.\n' >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# SDD_HOME resolution (survives being called through a symlink in ~/.local/bin)
#
# ⚠️ `CDPATH=''` on both `cd`s, and it is load-bearing here for the same reason it is in
# ledger_repo_root. `dirname` of a relative invocation (`./bin/sdd`, `bin/sdd`, a relative symlink
# target) is RELATIVE, and bash searches $CDPATH for any operand that does not begin with `/`, `.`
# or `..` — printing the directory it found on stdout, straight into this capture. Both failures
# land on SDD_HOME, which is `readonly` one line below and from which every template, agent and
# starter config is read: the wrong directory silently, or a two-line value that is not a path at
# all. Reachable from an env var on a machine whose $CDPATH names any directory holding a `bin`.
# The sensor is rule 2 of tests/check-pipefail.sh.
# ---------------------------------------------------------------------------
_resolve_self() {
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(CDPATH='' cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    if [[ $src != /* ]]; then src="$dir/$src"; fi
  done
  CDPATH='' cd -P "$(dirname "$src")/.." && pwd
}
SDD_HOME="$(_resolve_self)"
readonly SDD_HOME

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_RED=$'\033[31m'; C_GREEN=$'\033[32m'; C_YELLOW=$'\033[33m'; C_BLUE=$'\033[34m'
else
  C_RESET=''; C_DIM=''; C_BOLD=''; C_RED=''; C_GREEN=''; C_YELLOW=''; C_BLUE=''
fi

info() { printf '%s\n' "$*"; }
step() { printf '%s▸%s %s\n' "$C_BLUE" "$C_RESET" "$*"; }
ok()   { printf '%s  ok%s   %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s  warn%s  %s\n' "$C_YELLOW" "$C_RESET" "$*" >&2; }
bad()  { printf '%s  fail%s  %s\n' "$C_RED" "$C_RESET" "$*" >&2; }
dim()  { printf '%s%s%s\n' "$C_DIM" "$*" "$C_RESET"; }
die()  { printf '%serror:%s %s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Target repo and configuration
# ---------------------------------------------------------------------------
REPO_ROOT=""
CONFIG_FILE=""

resolve_repo_root() {
  REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || die "not inside a git repository (cwd: $PWD)"
  CONFIG_FILE="$REPO_ROOT/.sdd/config.sh"
}

# Defaults + validation. An empty required key fails HERE, before spending a session.
load_config() {
  resolve_repo_root
  [ -f "$CONFIG_FILE" ] \
    || die "$CONFIG_FILE does not exist. Run 'sdd install' at the root of the target repo."
  bash -n "$CONFIG_FILE" || die "$CONFIG_FILE has a bash syntax error"
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"

  : "${PROJECT_NAME:=}"; : "${DEFAULT_BRANCH:=}"; : "${TEST_CMD:=}"
  : "${E2E_CMD:=}"; : "${E2E_DIR:=e2e}"; : "${APP_URL:=}"
  : "${HANDOFF_DIR:=docs/handoffs}"; : "${QA_DOCS_PATH:=docs/qa}"; : "${TODO_FILE:=TODO.md}"
  : "${MODEL_EXEC:=opus}"; : "${MODEL_QA:=opus}"; : "${MODEL_REVIEW:=opus}"
  : "${MODEL_DOCS:=opus}"; : "${MODEL_PUBLISH:=sonnet}"; : "${MODEL_TICKET:=sonnet}"
  : "${MODEL_KAIZEN:=opus}"
  : "${QA_MAX_ITER:=3}"; : "${REVIEW_MAX_ITER:=3}"; : "${EXEC_MAX_RETRY:=1}"
  : "${BUDGET_PER_PHASE_USD:=15}"; : "${PUBLISH_ON_REVIEW_BLOCKED:=off}"
  # The pager (L6 of the 2026-09-03 audit): empty ⇒ the line stops in silence, as it always did.
  : "${ON_ESCALATION_CMD:=}"
  # The cap is per phase because the phases do not cost the same. One number was either too low
  # for REVIEW — the session dies mid-round and the money is spent with nothing on disk — or too
  # high for PR, where it stopped capping anything. The global stays for the cheap phases; raising
  # it does NOT raise these three, which is the trade-off config/schema.md declares.
  : "${BUDGET_EXEC_USD:=25}"; : "${BUDGET_QA_USD:=25}"; : "${BUDGET_REVIEW_USD:=40}"
  # The MISSION ceiling (L2 of the 2026-09-03 audit): the sum of what the journal says was spent,
  # read before a phase opens. `0` ⇒ no ceiling. Refused by name when it is not a number: a cap
  # that silently became "no cap" is the fail-open the audit exists to stop.
  : "${BUDGET_MISSION_USD:=150}"
  case "$BUDGET_MISSION_USD" in
    ''|*[!0-9.]*|.|*.*.*) die "BUDGET_MISSION_USD must be a number in USD (0 = no ceiling), got: '$BUDGET_MISSION_USD'" ;;
  esac
  : "${PERMISSION_MODE:=acceptEdits}"; : "${JIRA_ENABLED:=false}"
  # `acceptEdits` auto-approves FILE EDITS, not `Bash`. Without this allowlist the phase session
  # cannot run TEST_CMD, cannot run `git add`/`git commit`, and the EXEC phase is unsatisfiable
  # by construction. Found by the fixture mission 20260814-dry-run-completo, which stalled on it.
  : "${ALLOWED_TOOLS:=Bash}"
  # Language of the mission ARTIFACTS (handoffs, checkpoint, commits, PR body) — not of the kit,
  # which is English. Empty ⇒ the boot prompt says nothing about language, which is exactly the
  # behaviour of every already-installed repo. Set ("pt-BR", "en", "es") ⇒ one extra paragraph.
  : "${OUTPUT_LANG:=}"

  [ -n "$PROJECT_NAME" ]   || die "PROJECT_NAME is empty in $CONFIG_FILE"
  [ -n "$DEFAULT_BRANCH" ] || die "DEFAULT_BRANCH is empty in $CONFIG_FILE"
  [ -n "$TEST_CMD" ]       || die "TEST_CMD is empty in $CONFIG_FILE (it is the EXEC gate)"
  case "$PERMISSION_MODE" in
    bypassPermissions) die "PERMISSION_MODE=bypassPermissions is not accepted by the kit" ;;
  esac
}

# ---------------------------------------------------------------------------
# Mission
# ---------------------------------------------------------------------------
MISSION=""
MISSION_DIR=""

# Accepts the full name (20260814-spinner) or a unique prefix/slug.
resolve_mission() {
  local want="${1:-}" base="$REPO_ROOT/$HANDOFF_DIR" matches=()
  [ -n "$want" ] || die "missing mission name (e.g. sdd status 20260814-spinner)"
  [ -d "$base" ] || die "$HANDOFF_DIR/ does not exist in the target repo — no mission planned yet"

  if [ -d "$base/$want" ]; then
    MISSION="$want"
  else
    local d
    while IFS= read -r d; do matches+=("$(basename "$d")"); done \
      < <(find "$base" -mindepth 1 -maxdepth 1 -type d -name "*${want}*" | sort)
    case "${#matches[@]}" in
      0) die "mission '$want' not found in $HANDOFF_DIR/" ;;
      1) MISSION="${matches[0]}" ;;
      *) die "'$want' is ambiguous: ${matches[*]}" ;;
    esac
  fi
  MISSION_DIR="$base/$MISSION"
}

# ---------------------------------------------------------------------------
# Reading artifacts
# ---------------------------------------------------------------------------

# frontmatter <file> <key> → value (empty when absent)
# frontmatter <file> <key> [string to print when the key is ABSENT]
#
# The third argument exists because a key written and left blank prints the same empty string as a
# key that is not there at all, and for gate_REVIEW that difference is the whole point. Callers
# that do not care omit it and get exactly the behaviour they had.
frontmatter() {
  local file="$1" key="$2" absent="${3-}"
  if [ ! -f "$file" ]; then
    if [ -n "$absent" ]; then printf '%s\n' "$absent"; fi
    return 0
  fi
  awk -v k="$key" -v absent="$absent" '
    NR==1 && $0=="---" { inside=1; next }
    inside && $0=="---" { exit }
    inside {
      idx = index($0, ":")
      if (idx == 0) next
      name = substr($0, 1, idx-1)
      gsub(/^[ \t]+|[ \t]+$/, "", name)
      if (name == k) {
        found = 1
        val = substr($0, idx+1)
        gsub(/^[ \t]+|[ \t]+$/, "", val)
        gsub(/^["'\'']|["'\'']$/, "", val)
        print val
        exit
      }
    }
    END { if (!found && absent != "") print absent }' "$file"
}

# frontmatter_has <file> <key> — 0 when the key is PRESENT, whatever its value.
#
# Asked THROUGH frontmatter() on purpose. A second copy of the parser would be a second answer to
# "is this key mine?", and the day one of them learns to strip quotes and the other does not they
# disagree in silence — the class CLAUDE.md names in "enum lido em mais de um ponto".
# The sentinel is a value no frontmatter can carry by accident; a file that literally wrote it
# would read as absent, which is the same verdict the round would get by writing nothing.
FRONTMATTER_ABSENT='@sdd-frontmatter-absent@'
frontmatter_has() {
  local v; v="$(frontmatter "$1" "$2" "$FRONTMATTER_ABSENT")"
  [ "$v" != "$FRONTMATTER_ABSENT" ]
}

# frontmatter_write <file> <key> <value> — rewrites ONE key, in place, and nothing else.
#
# The counterpart of frontmatter(), which is read-only: closing the PLAN gate by hand was the only
# way to approve a plan, and a command that does it for the human has to write with the same
# precision the reader expects.
#
# Scoped to the block between the FIRST two `---` lines, never the whole file: a mission body is
# prose that legitimately quotes its own frontmatter (this repo's 00-missao.md writes
# "aprovacao: humano-YYYY-MM-DD" inside a sentence), and a file-wide substitution would rewrite the
# prose too, silently.
#
# awk with index(), never sed: the replacement value would go through sed's own syntax, where `&`
# means "the whole match" and `/` ends the expression — a mission title carrying either character
# is ordinary, and the corruption would land in a committed artifact. index()/substr() also dodge
# the mawk trap of the house (a negated class with a multibyte character negates its BYTES).
#
# Only the FIRST occurrence of the key is rewritten, and an absent key is left absent — the caller
# verifies with frontmatter() and decides. Writing through a temporary and moving it into place
# keeps a failed awk from truncating an artifact that is already committed.
frontmatter_write() {
  local file="$1" key="$2" value="$3" tmp
  [ -f "$file" ] || die "frontmatter_write: $file does not exist"
  # `|| die`: a mission directory the human cannot write to (a root-owned checkout, a 555 dir) makes
  # mktemp fail, and under `set -e` the script would exit through mktemp's own message — no `error:`
  # prefix, no mention of sdd or the artifact. Same family as the cmd_health item in TODO.md.
  tmp="$(mktemp "${file}.XXXXXX")" || die "frontmatter_write: could not create a temporary beside $file"
  awk -v k="$key" -v v="$value" '
    NR==1 && $0=="---" { inside=1; print; next }
    inside && $0=="---" { inside=0; print; next }
    inside && !written {
      idx = index($0, ":")
      if (idx > 0) {
        name = substr($0, 1, idx-1)
        gsub(/^[ \t]+|[ \t]+$/, "", name)
        if (name == k) { printf "%s: %s\n", k, v; written=1; next }
      }
    }
    { print }
  ' "$file" > "$tmp" || { rm -f "$tmp"; die "frontmatter_write: awk failed on $file"; }
  # mktemp creates 0600; without this the artifact would come out of an approval readable only by
  # whoever approved it. Git would not show the change (it tracks the exec bit only), which is what
  # makes it worth a line here instead of a bug report later.
  chmod --reference="$file" "$tmp" 2>/dev/null || true
  # `-f`: GNU mv ASKS before replacing a destination the user cannot write to, and only when stdin
  # is a terminal — which is exactly this command's situation. Without it a second, untranslated,
  # git-plumbing-flavoured question appears right after the [y/N] prompt and eats a line of the
  # human's stdin, and whether it appears at all depends on whether a human is watching. The
  # writability question was already answered by mktemp succeeding in that same directory.
  mv -f "$tmp" "$file" || { rm -f "$tmp"; die "frontmatter_write: could not replace $file"; }
}

# Checkpoint table rows as "ID<TAB>title<TAB>check<TAB>status<TAB>commit".
# Skips the header, the separator, and any line that does not have the 5 columns.
#
# The `escaped_pipe`/rejoin pair below is DUPLICATED from gate_REVIEW (same file, the `### Overall
# Grade` reader) on purpose, and the duplication is cheaper than the extraction: the two programs
# are anchored separately by the mutation catalogue (`mut_REVIEW_escaped_pipe*`,
# `mut_EXEC_escaped_pipe_blind`), and a shared helper would collapse both anchors into one — the
# class the mutation stamp caught between PRs #12 and #13. Change one, change the other, and check
# the neighbour's comment says so too.
# The `- intervention:` note, written by the RUNNER when it is the runner that receives the
# human's hand: `sdd run --phase X`, `sdd retry`, `--budget-override`. Until L4 of the 2026-09-03
# audit the template asked the HUMAN to write it, and the artefact measured what that is worth:
# three launches and zero notes on 20260901-o-revisor-so-acha, three interventions and zero notes
# on 20260902-o-rascunho-legado-fala-cru. The reader (`sdd autonomy --by-mission`) is unchanged —
# it counts `^- intervention:` lines in the checkpoint — so a note the runner writes is counted by
# the same instrument as one the human writes, and the hand-written note keeps its place for what
# the runner cannot see (a fix by hand, a phase done by hand, a BLOCKED taken over).
# Placement: last line of the execution-notes section (`## Notas de execu…`, the heading the
# template fixes), before the next heading; at the end of the file
# when the checkpoint has no such section (fixtures, checkpoints written before the template had
# it). Committed ALONE and at once, by the cmd_approve precedent — the phase session that follows
# commits its own files, and an uncommitted checkpoint would fail the clean-tree gates. A
# checkpoint that is ALREADY dirty gets the note and NOT the commit: committing would carry
# whatever the tree holds, and that is somebody else's work.
# `sdd approve` writes none, on purpose: approving the plan is the human gate the pipeline is
# designed around, it happens before any run_id exists, and counting it would inflate the notes
# against the launches the reader counts beside them. The projection writes nothing.
checkpoint_note_intervention() {   # checkpoint_note_intervention <what the human did> <phase>
  [ "$DRY_RUN" = "1" ] && return 0
  local ck="$MISSION_DIR/checkpoint.md" what="$1" phase="$2" line rel dirty_before tmp
  [ -f "$ck" ] || return 0
  rel="${ck#"$REPO_ROOT/"}"
  line="- intervention: $what — $phase — $(date '+%Y-%m-%d %H:%M') · written by the runner"
  dirty_before="$(cd "$REPO_ROOT" && git status --porcelain -- "$rel" 2>/dev/null)" || dirty_before=""
  tmp="$(mktemp "${TMPDIR:-/tmp}/sdd-ck-XXXXXX")"
  # Blank lines inside the notes section are buffered, so the note lands after the last note and
  # the blank line that separated the section from the next heading is printed after it, intact.
  # `mawk` is byte-oriented: the heading is matched on its ASCII prefix, never on the accented word.
  awk -v line="$line" '
    BEGIN { nb = 0; in_notes = 0; done = 0 }
    !done && !in_notes && /^## Notas de execu/ { in_notes = 1; print; next }
    in_notes && /^[[:space:]]*$/ { buf[nb++] = $0; next }
    in_notes && /^## / { print line; for (i = 0; i < nb; i++) print buf[i]; nb = 0; in_notes = 0; done = 1; print; next }
    in_notes { for (i = 0; i < nb; i++) print buf[i]; nb = 0; print; next }
    { print }
    END {
      if (in_notes) { print line; for (i = 0; i < nb; i++) print buf[i]; done = 1 }
      if (!done) { print ""; print line }
    }' "$ck" > "$tmp" && mv "$tmp" "$ck"
  if [ -n "$dirty_before" ]; then
    warn "intervention noted in checkpoint.md but NOT committed — the file was already dirty; commit it with the work it carries"
    return 0
  fi
  if ( cd "$REPO_ROOT" && git add -- "$rel" && git commit -q -m "chore(checkpoint): intervention — $what — $phase" ); then
    dim "  intervention noted in checkpoint.md and committed: $what — $phase"
  else
    warn "intervention noted in checkpoint.md but the commit failed — commit $rel by hand"
  fi
}

checkpoint_rows() {
  local file="$MISSION_DIR/checkpoint.md"
  [ -f "$file" ] || return 0
  awk -F'|' '
    # PARITY, not "does this field end in a backslash": `\\` is how GFM spells a literal backslash,
    # so a cell ending in one sits against a REAL delimiter. An ODD run of trailing backslashes
    # escapes the pipe; an EVEN one does not. ASCII only — mawk is byte-oriented and a negated
    # class with a multibyte character would negate its BYTES.
    function escaped_pipe(s,   t) { t = s; sub(/\\+$/, "", t); return (length(s) - length(t)) % 2 }
    /^[ \t]*\|/ {
      # A raw split on "|" cuts a Check cell at its `\|` and shifts every column after it one to
      # the left, so Status is read out of the CHECK cell: an increment written `done` was reported
      # as `invalid status`, naming a status the author never wrote, and gate_EXEC refused the
      # phase for a reason that is not true. Rejoined here so every column downstream sees the cell
      # the author wrote. `-F` stays because the escape hatch below still reads $0.
      delete f
      rawn = split($0, raw, "|")
      n = 0
      for (i = 1; i <= rawn; i++) {
        if (n > 0 && escaped_pipe(f[n])) { sub(/\\$/, "|", f[n]); f[n] = f[n] raw[i] }
        else { f[++n] = raw[i] }
      }
      if (n < 6) next
      for (i = 2; i <= 6; i++) { gsub(/^[ \t]+|[ \t]+$/, "", f[i]) }
      # `:?-+:?` and not `-+`: GFM spells column alignment with colons on the separator row, and
      # prettier and markdownlint WRITE them (`|:---|:---:|`). Matched against the bare dashes only,
      # the separator stopped being skipped and became a row whose Status is `:---:` — outside the
      # enum — so gate_EXEC refused a checkpoint with every increment done. The same three-character
      # blindness lives in gate_REVIEW and gate_DOCS; all three carry this regex.
      if (f[2] == "ID" || f[2] ~ /^:?-+:?$/ || f[2] == "") next
      if (f[5] == "Status") next
      printf "%s\t%s\t%s\t%s\t%s\n", f[2], f[3], f[4], f[5], f[6]
    }' "$file"
}

# checkpoint_tally — "<pending>\t<total>\t<blocked>" over checkpoint_rows, and from now on the
# runner's ONE count of increment status. Every number gate_EXEC states about the checkpoint comes
# from here, and so does the photograph cmd_run takes before a session exists to be judged: two
# readings of one file that disagreed would be the whole point of the metric, lost.
#
# PURE — no TEST_CMD, no git, no validation. It answers "how many rows say what", nothing else,
# which is exactly what lets the same call serve a caller that has not run the session yet and a
# gate that has already refused the checkpoint.
#
# `doing` counts as pending, as it always has in gate_EXEC's own sentence: an increment somebody
# left mid-flight has not advanced, and reading it as done would credit the session that abandoned
# it. `+ 0` on every field because an unmatched pattern leaves the variable unset, and mawk prints
# an unset variable as the empty string — a row field the ledger would then read as null.
checkpoint_tally() {
  checkpoint_rows | awk -F'\t' '
    { total++ }
    $4 == "pending" || $4 == "doing" { pending++ }
    $4 == "blocked" { blocked++ }
    END { printf "%d\t%d\t%d\n", pending + 0, total + 0, blocked + 0 }'
}

# ---------------------------------------------------------------------------
# Is anything listening where APP_URL points?
#
# A red e2e says nothing about WHOSE fault it is: a dead app, a stopped database, a missing
# browser binary and a genuinely broken assertion all leave the same non-zero rc. Until this
# existed the runner read every one of them as "QA still has work to do" and bought another opus
# session. Measured on the SQ-111 mission of 2026-08-27: US$ 14,16 for a QA reproved by the
# environment, plus US$ 7,61 for the lap that reopened a mission whose PR was already open.
#
# The runner still does not START anything — bringing the app up is the operator's job, declared
# in config/schema.md. What changes is that the runner now ASKS, and stops.
# ---------------------------------------------------------------------------

# app_url_hostport <url> — prints "host port"; prints nothing and returns 1 when it cannot decide.
#
# PURE: parameter expansion only. No fork, no subprocess, no network. That is what lets the
# assertions in tests/check-gates.sh read the parser through the gate's own sentence instead of
# calling the function directly, and what keeps the cost of asking zero when the answer is "no".
#
# The host comes out BARE — `::1`, not `[::1]` — because that is what bash's /dev/tcp wants.
# Putting the brackets back for the human is app_probe's job, one level up.
app_url_hostport() {
  local url="${1:-}" scheme rest host port=""
  [ -n "$url" ] || return 1
  # Only the two schemes whose default port is a fact. A `file://` or a bare `host:port` are not
  # refused because they are exotic; they are refused because guessing a port for them would make
  # the probe answer `down` about an address nobody wrote.
  #
  # Matched case-INSENSITIVELY, because the scheme IS case-insensitive (RFC 3986 §3.1) and the
  # failure of reading it otherwise is the silent kind: `APP_URL="HTTP://localhost:3000"` fell
  # through to `unknown`, where nothing fails and nothing warns — the whole escalation simply
  # stopped existing for a spelling nobody would think to check. The remainder is taken by OFFSET
  # (7 for `http://`, 8 for `https://`) and never off `${url,,}`: folding the whole string would
  # fold the HOST with it, and the host rides into the sentence an operator reads.
  case "${url,,}" in
    http://*)  scheme=http;  rest="${url:7}" ;;
    https://*) scheme=https; rest="${url:8}" ;;
    *) return 1 ;;
  esac
  # Fragment, then query, then path — and ALL THREE before the userinfo. A path may legitimately
  # carry an `@` (`http://127.0.0.1:8080/a@b`), and stripping the userinfo first would take the
  # host away with it, leaving `b` as the address the operator is told about.
  rest="${rest%%#*}"
  rest="${rest%%\?*}"
  rest="${rest%%/*}"
  # The LAST `@` wins: a password may contain one, and the userinfo may not.
  rest="${rest##*@}"
  [ -n "$rest" ] || return 1
  case "$rest" in
    # An IPv6 literal is bracketed precisely so its own colons stop looking like a port separator.
    # The bracketed-with-port pattern is listed first for the reader; the two are disjoint, since
    # only one of them ends in `]`.
    \[*\]:*) host="${rest#\[}"; host="${host%%\]:*}"; port="${rest##*\]:}" ;;
    \[*\])   host="${rest#\[}"; host="${host%\]}" ;;
    *:*)     host="${rest%%:*}"; port="${rest##*:}" ;;
    *)       host="$rest" ;;
  esac
  [ -n "$host" ] || return 1
  # Whitespace in a host is not an address; letting it through would hand `/dev/tcp` a word that
  # can only fail, and a failure this parser could have named would arrive as an unreadable one.
  case "$host" in *[[:space:]]*) return 1 ;; esac
  if [ -z "$port" ]; then
    case "$scheme" in http) port=80 ;; https) port=443 ;; esac
  fi
  # Digits, and at most five of them. The length bound is not cosmetic: `$((10#$port))` below
  # wraps silently on a 20-digit string, so a port nobody could listen on would come out as a
  # small number the probe would happily connect to.
  # DECLARED LIMIT: the bound is measured on the STRING, before `10#` below strips the zeros, so
  # `http://h:000001/` — port 1 in six characters — is refused too, into `unknown`, where nothing
  # escalates. A port spelled with more leading zeros than digits is not worth a sixth line here.
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  [ "${#port}" -le 5 ] || return 1
  # `10#` and never a bare `[ "$port" -ge 1 ]`: `[` evaluates its operand arithmetically, where a
  # leading zero means OCTAL — `http://h:080/` would abort the runner on "value too great for
  # base" instead of reading as port 80.
  port="$((10#$port))"
  [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
  printf '%s %s\n' "$host" "$port"
}

# app_probe <url> — prints "state|label" and ALWAYS returns 0. State is one of:
#
#   down     nothing is listening there; label is the address
#   up       something answered; label is the address
#   unknown  no verdict either way; label is the REASON, in a sentence a human can act on
#
# rc 0 in every case, and no global touched, because this is the one function of the pair that has
# to survive `$( )`. A function with a side effect on a global loses it to the subshell — the
# family CLAUDE.md records against run_phase and autonomy_kit_stamp. Publishing on stdout is what
# makes calling it from a substitution correct rather than merely convenient.
#
# ONE-SIDED BY CONSTRUCTION, and this is the whole compatibility story. `unknown` is the default
# and it never escalates: an empty APP_URL, a URL this cannot parse, a bash built without
# /dev/tcp, an absent timeout(1), an error string the kernel words differently — every one of them
# lands in `unknown`, where the runner behaves byte for byte as it did before this existed. The
# probe turns a red into a NAMED red; it can never turn a green into a red.
#
# DECLARED LIMIT — not memoised, on purpose. One lap of `cmd_run` can reach here twice: once inside
# `$(current_phase)` and once at the gate call itself. The second connect is not free, and the
# worst case is the one where nothing is refused and nothing answers — a firewall dropping the
# packets — at $APP_PROBE_TIMEOUT seconds a call. It is left uncached because a cache here would
# owe an invalidation contract: `invalidate_checks` exists precisely because a session can change
# the world between two evaluations, and the operator starting the app IS that change. Buying a few
# seconds with a verdict that can go stale across a session is the wrong side of that trade, and
# the seconds are noise beside the E2E_CMD run that has to fail before this is reached at all.
app_probe() {
  # The URL is the ARGUMENT and never read off the global here: both callers pass "$APP_URL" by
  # name, and a fallback to it was a default nothing exercised — a signature that says one thing
  # and a body that quietly accepts another.
  local url="${1:-}" hp host port label err="" rc=0
  [ -n "$url" ] || { printf 'unknown|APP_URL is empty\n'; return 0; }
  # Declared first and assigned inside the `if`: `local hp="$(...)"` would swallow the rc, since
  # `local` reports its OWN success and the parser's refusal would read as a parse.
  if ! hp="$(app_url_hostport "$url")"; then
    printf 'unknown|APP_URL (%s) carries no host:port this can read\n' "$url"; return 0
  fi
  host="${hp%% *}"; port="${hp##* }"
  case "$host" in *:*) label="[$host]:$port" ;; *) label="$host:$port" ;; esac
  if ! command -v timeout >/dev/null 2>&1; then
    printf 'unknown|timeout(1) is not on PATH, and an unbounded connect could hang the gate\n'
    return 0
  fi
  # Host and port as ARGUMENTS, never interpolated into the script text: APP_URL is a string from
  # the target repo's config, and `bash -c "exec 3<>/dev/tcp/$host/$port"` would execute whatever
  # it contains. `$BASH` and not `bash`: the runner already knows which interpreter it trusts.
  # LC_ALL=C because the verdict below is read out of a strerror string.
  err="$(LC_ALL=C timeout "$APP_PROBE_TIMEOUT" "${BASH:-bash}" -c \
      'exec 3<>"/dev/tcp/$0/$1"' "$host" "$port" 2>&1)" || rc=$?
  if [ "$rc" -eq 0 ]; then printf 'up|%s\n' "$label"; return 0; fi
  # ECONNREFUSED, and NOTHING else, is what "the app is down" means here. A name that does not
  # resolve, a route that is missing, a firewall that drops the packet: each of them is a machine
  # this cannot speak for, and each of them lands below, in `unknown`. Herestring and never
  # `printf | grep -q`, which returns 141 under pipefail when the grep MATCHES.
  if grep -q 'Connection refused' <<< "$err"; then printf 'down|%s\n' "$label"; return 0; fi
  if [ "$rc" -eq 124 ]; then
    printf 'unknown|the connect at %s timed out after %ss, which is not a refusal\n' \
      "$label" "$APP_PROBE_TIMEOUT"
    return 0
  fi
  # First line only: bash prints the failed redirection over two lines on some builds, and a
  # GATE_WHY carrying a newline arrives in the ledger as a broken record.
  printf 'unknown|the connect at %s answered neither way: %s\n' "$label" "$(head -1 <<< "$err")"
  return 0
}

# Runs a config command at the root of the target repo; returns its exit code.
# Output goes to the mission log (when there is a mission) — it never pollutes the runner stdout.
#
# Memoized per process: `sdd status` evaluates seven gates and three of them run TEST_CMD.
# Without the cache, looking at the state would cost three suite runs. The cache dies with the
# process, so `sdd run` always re-evaluates after a phase has touched the code.
declare -A _CHECK_RC=()
declare -A _CHECK_LOG=()
LAST_CHECK_LOG=""

run_check_cmd() {
  local cmd="$1" label="${2:-check}" logfile rc=0
  [ -n "$cmd" ] || return 0
  if [ -n "${_CHECK_RC[$cmd]+x}" ]; then
    LAST_CHECK_LOG="${_CHECK_LOG[$cmd]}"
    return "${_CHECK_RC[$cmd]}"
  fi
  # The name has to be unique per EXECUTION, and it was unique per second per LABEL — which is
  # neither. This is the file GATE_WHY sends the operator to read ("see $LAST_CHECK_LOG"), so an
  # overwrite replaces the evidence of the failure being reported with the evidence of a later one.
  # The date is part of the fix and not decoration: this site carried the clock time ALONE, so two
  # runs on different days at the same second collided as well.
  #
  # `mktemp` and not a counter, because a counter cannot be made honest here: EVERY caller reads
  # the phase as `"$(current_phase)"`, and a command substitution is a SUBSHELL — the increment,
  # like the memo beside it, dies with the fork, so the parent's next call reuses the number the
  # subshell just wrote under. Measured on the fixture in tests/check-autonomy.sh: four executions,
  # three files. mktemp creates the file atomically and assumes no shared state at all, which is
  # the only property that survives being called from inside a substitution.
  mkdir -p "$(log_dir)"
  logfile="$(mktemp "$(log_dir)/${label}-$(date +%Y%m%d-%H%M%S)-XXXXXX.log")"
  ( cd "$REPO_ROOT" && eval "$cmd" ) >"$logfile" 2>&1 || rc=$?
  _CHECK_RC[$cmd]="$rc"
  _CHECK_LOG[$cmd]="$logfile"
  LAST_CHECK_LOG="$logfile"
  return "$rc"
}

# Invalidates the sensor cache — called after any phase that touched the repo.
invalidate_checks() { _CHECK_RC=(); _CHECK_LOG=(); }

log_dir() {
  if [ -n "$MISSION" ]; then printf '%s\n' "$REPO_ROOT/.sdd/logs/$MISSION"
  else printf '%s\n' "$REPO_ROOT/.sdd/logs/_geral"; fi
}

# Last file of a glob. Empty when there is none.
#
# `sort -V`, never plain `sort`: the names this is called with carry a COUNTER (`40-review-r<N>`),
# and lexicographically `r10` lands between `r1` and `r2` — so from the tenth round on the gate
# would read `r3`, an old and already-approved review, while the round that actually ran sits
# unread. Asserted in tests/check-gates.sh with the r1/r2/r3/r10 fixture.
#
# This comment used to end "version order also keeps the dated names (`YYYY-MM-DD-*`) in the order
# plain `sort` gave them, so the qa call sites are unaffected", citing that same fixture. Both
# halves were wrong, and the citation was the worse half: r1/r2/r3/r10 exercises the REVIEW glob
# and says nothing whatsoever about the dated one. Measured on two same-day reports —
#
#   plain sort | tail -1  ->  2026-01-01-fixture.md
#   sort -V    | tail -1  ->  2026-01-01-fixture-final.md
#
# — because filevercmp special-cases the `.md` suffix and compares the stems, while plain `sort`
# compares `-` (0x2D) against `.` (0x2E) and puts `-final` first. Drop the suffix and the two
# orders agree, which is why reading the code convinced three sessions in a row.
#
# So the qa call sites (`:346`, `:550`) DID change behaviour, and for the better: among same-day
# reports the later-named round now wins instead of losing to the shorter stem. That is no longer
# a claim — it is pinned by its own differential fixture in tests/check-gates.sh, next to this
# one, which goes red the moment either ordering changes under it.
latest_matching() {
  local pattern="$1"
  # `|| true`: with no match, `ls` fails and `pipefail` would propagate the error into the
  # caller's assignment — inside a gate that would read as a silent failure instead of "absent".
  # shellcheck disable=SC2012,SC2086
  ls -1d $pattern 2>/dev/null | sort -V | tail -1 || true
}

# plan_approves_itself → 0 when the mission on disk is a kaizen-born plan carrying `aprovacao: auto`
#
# ONE definition, because two places read it and they must never disagree: gate_PLAN refuses this
# state, and cmd_approve must NOT mistake it for an approval already given. That disagreement is
# not hypothetical — it is the bug this function was extracted to close (found by sdd-qa in mission
# 20260816-portas-do-humano): the gate named `sdd approve` as the one way out while approve read
# the same `auto` as "already approved — nothing to do", so the only remedy the runner printed was
# the one thing it refused to do, and the loop had no exit but hand-editing the frontmatter.
#
# `auto` carries ONE premise: the PLAN-AUTO table was filled with the human in the room. A plan
# born of `sdd kaizen` had no human in the room — the kit planned its own next change — so `auto`
# there is the machine certifying its own homework. agents/sdd-kaizen.md orders the born plan to
# ship with `aprovacao:` empty and gate_KAIZEN refuses to hand one over with the field filled, but
# both of those act at BIRTH: nothing stopped the field from being filled afterwards. A rule that
# lives only in prose is a rule the runner does not have.
#
# `05-verdict.md` beside the mission is the marker, and it is structural rather than agreed: the
# kaizen gate locates the verdict and takes its `dirname` as the born plan's home, so the two are
# siblings by construction. Read per MISSION and never per repo — `ls $HANDOFF_DIR/*/05-verdict.md`
# passes every assertion in this family and then refuses every `auto` in any repo that has ever run
# `sdd kaizen`, the kit's own included (measured in increment I4).
#
# Only `auto` is caught: with a human's own `humano-YYYY-MM-DD` the mission runs, verdict and all,
# or the kit's improvement loop would have no terminating state.
plan_approves_itself() {
  [ "$(frontmatter "$MISSION_DIR/00-missao.md" aprovacao)" = "auto" ] \
    && [ -f "$MISSION_DIR/05-verdict.md" ]
}

# ---------------------------------------------------------------------------
# Gates — each returns 0 (satisfied) or 1, writing the reason into GATE_WHY.
# WARNING: no gate may be satisfied by model text. Artifacts only.
# ---------------------------------------------------------------------------
GATE_WHY=""

gate_PLAN() {
  local m="$MISSION_DIR/00-missao.md" p="$MISSION_DIR/01-plano.md" c="$MISSION_DIR/checkpoint.md"
  local f
  for f in "$m" "$p" "$c"; do
    [ -f "$f" ] || { GATE_WHY="missing $(basename "$f") — the planning phase is interactive: run sdd-planner"; return 1; }
  done
  local approval; approval="$(frontmatter "$m" aprovacao)"
  case "$approval" in
    auto)          : ;;
    humano-*)      : ;;
    # The remedy is named here for the same reason it is named in the kaizen-born branch below,
    # and this is the branch where it matters most: an empty `aprovacao:` is where EVERY
    # human-approved plan starts, so this is the common stall, not the exotic one. Without the
    # command on screen the reason reads as an instruction to type `humano-YYYY-MM-DD` into the
    # frontmatter by hand — the precise failure `sdd approve` exists to end, printed by the gate
    # that ends it. The mission name rides along because `sdd approve` with no argument resolves
    # the LATEST mission, which in a repo with two open ones is the wrong one.
    *) GATE_WHY="00-missao.md has 'aprovacao: ${approval:-<empty>}' — it must be 'auto' (PLAN-AUTO all ✅) or 'humano-YYYY-MM-DD': run 'sdd approve $MISSION'"; return 1 ;;
  esac
  # This gate is what `sdd run` asks before spending a pipeline on a plan the kit wrote about
  # itself; the rule and the marker live with plan_approves_itself, which cmd_approve reads too.
  # The remedy is named in the reason because the alternative — a human hand-typing
  # `humano-YYYY-MM-DD` into the frontmatter — is the exact failure `sdd approve` exists to end,
  # and naming a remedy obliges the remedy to work: that obligation is asserted in
  # tests/check-gates.sh, invoking the command instead of simulating it with `sed`.
  if plan_approves_itself; then
    GATE_WHY="kaizen-born plan (05-verdict.md sits beside it) may not approve itself — a human must: run 'sdd approve $MISSION'"
    return 1
  fi
  if [ "$JIRA_ENABLED" = "true" ]; then
    local v; v="$(frontmatter "$m" versao)"
    if [ -z "$v" ] || [[ $v == \<* ]]; then
      GATE_WHY="JIRA_ENABLED=true requires 'versao:' filled in 00-missao.md (a human decision, never headless)"
      return 1
    fi
  fi
  local n; n="$(checkpoint_rows | wc -l)"
  [ "$n" -gt 0 ] || { GATE_WHY="checkpoint.md has no parseable increment row"; return 1; }
  GATE_WHY="plan approved ($approval), $n increment(s)"
  return 0
}

gate_TICKET() {
  if [ "$JIRA_ENABLED" != "true" ]; then GATE_WHY="JIRA_ENABLED=false — phase skipped"; return 0; fi
  local t="$MISSION_DIR/10-ticket.md"
  [ -f "$t" ] || { GATE_WHY="missing 10-ticket.md"; return 1; }
  local issue; issue="$(frontmatter "$t" issue)"
  [ -n "$issue" ] || { GATE_WHY="10-ticket.md has no 'issue:' in the frontmatter"; return 1; }
  if ! grep -qiE '^sprint:[[:space:]]*\S' "$t"; then
    GATE_WHY="10-ticket.md has no 'sprint:' — the issue must be IN THE ACTIVE SPRINT, not in the backlog"
    return 1
  fi
  # The branch is BORN in this phase — the `ticket` skill creates it — and used to be recorded in
  # 10-ticket.md alone. `ensure_mission_branch` reads `branch:` from 00-missao.md and nowhere else,
  # so with JIRA on every later phase ran wherever the human happened to be standing while the
  # runner guarded a name that was never written down: the SQ-97 shape, five phases into another
  # PR's branch and a `rebase --onto` to undo them.
  #
  # The WRITE is the session's, never this gate's: a gate that writes breaks `moved2`, the
  # fingerprint that answers "did the session move the disk" (see the comment at that variable).
  # What is left here is the verifiable half — declared in one artifact means declared in both.
  #
  # No `branch:` in 10-ticket.md ⇒ pass. That is every mission planned before the field existed,
  # and refusing them would be rewriting history instead of measuring the phase that just ran.
  local tbranch; tbranch="$(frontmatter "$t" branch)"
  case "$tbranch" in ''|'<'*) ;; *)
    local mbranch; mbranch="$(frontmatter "$MISSION_DIR/00-missao.md" branch)"
    case "$mbranch" in
      ''|'<'*)
        GATE_WHY="10-ticket.md declares branch '$tbranch' and 00-missao.md still carries the placeholder — the TICKET session writes it back, or every later phase runs on whatever branch the human is standing on"
        return 1 ;;
    esac
    if [ "$mbranch" != "$tbranch" ]; then
      GATE_WHY="10-ticket.md declares branch '$tbranch' and 00-missao.md declares '$mbranch' — the runner honours 00-missao.md, so the mission would run on a branch the ticket never created"
      return 1
    fi
  ;; esac
  GATE_WHY="issue $issue in the sprint"
  return 0
}

# Set by gate_EXEC when the suite is red over an uncommitted tree, read by cmd_run's second Jidoka.
# A GLOBAL and not a return value because the gate already spends its rc on pass/fail, and a gate
# that answered the two questions in one code would make every caller decode it. Reset at the entry
# of gate_EXEC below, never at the call site: the gate returns from a dozen places before ever
# reaching the suite, and a marker left over from an earlier evaluation would escalate a run for a
# tree that is long since clean.
GATE_EXEC_DIRTY=0

# Set by any gate that refuses because the phase's own handoff declares `status: blocked`, read by
# cmd_run right after the gate call that could have set it. A GLOBAL for the same reason as
# GATE_EXEC_DIRTY above — the rc is already spent on pass/fail — and a MARKER rather than a grep of
# GATE_WHY because GATE_WHY is prose: every gate spells its refusal its own way, the word "blocked"
# appears in gate_EXEC's Jidoka line too (:534), and an early exit anchored on a substring of prose
# would escalate runs nobody asked it to. The risk is named in 01-plano.md of 20260826-o-laco-da-qa.
#
# CONTRACT for whoever teaches a second gate the token: reset it at the entry of THAT gate, never
# at a call site. `current_phase` walks every gate in order, so a marker left set by an evaluation
# two phases ago would escalate a phase whose own handoff says nothing of the kind. Today gate_QA
# is the only setter, and the only reader is handoff_blocked_escalation.
#
# That reader is called from BOTH doors of cmd_run's loop — the first pass and the inline retry —
# and the second door is not symmetry for its own sake. With only the first, the marker outlived
# the LAP rather than a gate: a retry that declared `blocked` and carried on took it into the next
# lap, gate_EXEC never touched it, and the escalation fired for EXEC with a reason untrue of it.
# That is this very failure, reached with ONE setter instead of the second the paragraph above
# warns about. Found by the QA phase of 20260826-o-laco-da-qa; the reproduction is in its handoff.
#
# ⚠️ So the marker not outliving a lap is a consequence of the FLOW — every lap that finds it armed
# returns 3 — and not of construction. Whoever adds a third door, a second setter or a path that
# can leave a lap with the marker still set has to re-derive that property, not assume it.
GATE_HANDOFF_BLOCKED=0

# Set by gate_QA when the e2e came back RED and a TCP connect to APP_URL was refused, read by
# cmd_run to escalate instead of buying a session against a machine no session can fix. A GLOBAL
# for the third time and for the reason the two above give — the rc is already spent on pass/fail
# — and a MARKER rather than a grep of GATE_WHY, because GATE_WHY is prose: the sentence the arm
# writes is one an operator may reword, and an early exit anchored on a substring of it would
# start and stop escalating on an edit to an error message.
#
# CONTRACT, re-derived here and NOT inherited — the paragraph above says every new marker owes
# this derivation rather than an assumption:
#
#   · reset at the ENTRY of gate_QA, which is also its only setter. `current_phase` walks every
#     gate in order, so a marker armed by an evaluation two phases ago would escalate a phase
#     whose own e2e never ran;
#   · it does not outlive a LAP, and that is a property of the flow: BOTH doors of cmd_run's loop
#     read it — the first pass and the inline retry — and every lap that finds it armed returns 3.
#     Whoever adds a third door, a second setter, or a path that can leave a lap with it still set
#     has to re-derive this, exactly as this comment had to.
#
# Armed ONLY in the `down` arm. `unknown` leaves it at 0 and the runner behaves as it did before
# the probe existed, which is the whole compatibility story — see app_probe.
GATE_APP_DOWN=0

# How many increments were still to execute when this gate last ANSWERED, and how many there are
# in all. Empty until a gate_EXEC gets past its validation loop; read by cmd_run and cmd_retry to
# build the EXEC row of the autonomy ledger, which is why they outlive the call that sets them.
#
# ⚠️ They outlive it across PHASES too, and the reason is NOT `current_phase`: that runs as
# `$(...)`, so the gate_EXEC it evaluates sets these in a subshell that dies immediately. The live
# vector is the DIRECT calls in the parent shell — `gate_EXEC || true` in cmd_status, and
# `gate_"$phase"` in cmd_run's own two doors — after which a REVIEW session opened on the next lap
# is built with these still set. The readers guard on the phase; see the call sites. (Measured
# 2026-08-30: through `$(current_phase)` both come back empty, called directly they come back set.
# The guard is required either way; only the mechanism named here was wrong.)
GATE_EXEC_PENDING=""
GATE_EXEC_TOTAL=""

gate_EXEC() {
  GATE_EXEC_DIRTY=0
  # Emptied on ENTRY, the same reset GATE_EXEC_DIRTY and GATE_APP_DOWN get one screen up and for
  # the same reason: a gate that refuses below must not hand its caller the numbers of the gate
  # before it.
  GATE_EXEC_PENDING=""
  GATE_EXEC_TOTAL=""
  local rows; rows="$(checkpoint_rows)"
  [ -n "$rows" ] || { GATE_WHY="checkpoint.md is empty"; return 1; }

  # The loop VALIDATES and no longer counts: the numbers come from checkpoint_tally, called once
  # below. Two counts of one file is the defect this whole mission is about — the ledger's
  # `pending_after` and the gate's own "N of M" have to be the same reading or the judge is
  # comparing a number against prose that disagrees with it.
  local id status commit
  while IFS=$'\t' read -r id _ _ status commit; do
    case "$status" in
      done)
        if [ -z "$commit" ] || [ "$commit" = "—" ] || [ "$commit" = "-" ]; then
          GATE_WHY="increment $id is 'done' with no commit — a label is not an artifact"; return 1
        fi
        if ! ( cd "$REPO_ROOT" && git cat-file -e "${commit}^{commit}" 2>/dev/null ); then
          GATE_WHY="increment $id points at commit '$commit', which does not exist in the repository"; return 1
        fi
        # `cat-file -e` only says the OBJECT exists in the database — not that it is in the
        # branch history. After an amend/rebase/reset, a checkpoint quoting the old hash would
        # pass while pointing outside the history, and the commit can still vanish at gc with the
        # gate still green. That is exactly the "label, not artifact" failure the kit exists to
        # prevent, inside the gate itself. Measured by sdd-qa in mission
        # 20260814-dry-run-completo, with a real amend.
        if ! ( cd "$REPO_ROOT" && git merge-base --is-ancestor "$commit" HEAD 2>/dev/null ); then
          GATE_WHY="increment $id points at commit '$commit', which exists but is NOT in the history of HEAD (amend/rebase/reset?) — the gate demands a reachable artifact, not a loose object"
          return 1
        fi
        ;;
      # Valid and nothing to check — the arm exists so the enum stays exhaustive and the `*)` below
      # keeps meaning "not one of the four". Counting them is checkpoint_tally's job, below.
      pending|doing|blocked) ;;
      *) GATE_WHY="increment $id has invalid status '$status' (use pending|doing|done|blocked)"; return 1 ;;
    esac
  done <<< "$rows"

  # The publication sits after the validation loop AND after the Jidoka refusal below, deliberately:
  # TWO assertions in tests/check-autonomy.sh are that ordering, "a done without commit publishes
  # no pending_after" and "a blocked increment publishes no pending_after". `pending_before` on the
  # ledger row is a PHOTOGRAPH — cmd_run takes it before the session opens — but `pending_after` is
  # a VERDICT, and a gate that is about to REFUSE has no verdict to give about how far the mission
  # got. Neither the checkpoint refused for a label with no artifact nor the one that stopped the
  # line may buy its session an `advanced`; leaving the pair empty makes the reader fall back to
  # `moved`, exactly as it did before these fields existed.
  local pending total blocked
  IFS=$'\t' read -r pending total blocked <<< "$(checkpoint_tally)"
  # The herestring SWALLOWS the producer's status — the compound's rc is `read`'s, always 0 — unlike
  # the plain assignment one screen up, which propagates. With the three empty, BOTH refusals below
  # are skipped (`[ "" -gt 0 ]` is rc 2, read as false) and the gate falls through to TEST_CMD and
  # can answer `pass` over a checkpoint it never counted. Unreachable today only because `[ -n
  # "$rows" ]` above refuses first — but that guard belongs to a DIFFERENT reading of the file, and
  # a refusal that depends on a neighbour is a refusal nobody will notice losing.
  [ -n "$pending" ] && [ -n "$total" ] && [ -n "$blocked" ] || \
    { GATE_WHY="checkpoint.md tally unreadable"; return 1; }

  # Jidoka goes BEFORE the publication, by the same argument and for a defect measured end to end:
  # `checkpoint_tally` counts `pending|doing` and files `blocked` in a bucket of its own, so GIVING
  # UP on an increment lowers `pending` exactly as FINISHING it does. Published here, the one
  # session in the whole pipeline that STOPPED THE LINE read `pending_before 2 · pending_after 1`
  # and the ledger called it `advanced` at `0% waste` — fail-open in the flattering direction,
  # over a stopped line. Found by sdd-qa on 2026-08-30 with a real `sdd run`; the row it would have
  # spoiled exists in the real ledger. Blocking is not closing, which is also what `sdd autonomy`'s
  # own usage text promises.
  if [ "$blocked" -gt 0 ]; then GATE_WHY="$blocked increment(s) 'blocked' — Jidoka: the line stops"; return 1; fi

  GATE_EXEC_PENDING="$pending"
  GATE_EXEC_TOTAL="$total"

  if [ "$pending" -gt 0 ]; then GATE_WHY="$pending of $total increment(s) still to execute"; return 1; fi

  if ! run_check_cmd "$TEST_CMD" "gate-exec-test"; then
    # A phase that DIED leaves its work uncommitted, and the suite then runs over a working tree
    # nobody approved. Every increment reads `done`, so the runner re-derives EXEC, opens another
    # session against the same red suite, and `state_fingerprint` — HEAD, the mission listing and
    # the checkpoint's md5 — cannot see a dirty tree, so `attempts` resets on every `sdd run` and
    # the lap costs a full EXEC session, for ever. The marker below is what turns that into an
    # escalation in cmd_run, before a session is opened.
    if [ -n "$( cd "$REPO_ROOT" && git status --porcelain )" ]; then
      GATE_EXEC_DIRTY=1
      GATE_WHY="TEST_CMD failed ($TEST_CMD) over a DIRTY working tree — the uncommitted changes are what the suite is running against; a session cannot fix what it cannot see. See $LAST_CHECK_LOG"
      return 1
    fi
    GATE_WHY="TEST_CMD failed ($TEST_CMD) — see $LAST_CHECK_LOG"; return 1
  fi
  [ -f "$MISSION_DIR/20-handoff-exec.md" ] \
    || { GATE_WHY="every increment done and the suite green, but 20-handoff-exec.md is missing"; return 1; }

  GATE_WHY="$total increment(s) done, suite green, handoff written"
  return 0
}

gate_QA() {
  GATE_HANDOFF_BLOCKED=0
  GATE_APP_DOWN=0
  local h="$MISSION_DIR/30-handoff-qa.md" report=""
  [ -f "$h" ] || { GATE_WHY="missing 30-handoff-qa.md"; return 1; }

  local st; st="$(frontmatter "$h" status)"
  if [ "$st" = "skipped" ]; then GATE_WHY="qa: skipped (diff has no user-visible change)"; return 0; fi
  # The marker, not the prose, is what cmd_run reads to escalate on the spot — see
  # GATE_HANDOFF_BLOCKED above. `blocked` means the line stopped and a human has to act (:1602);
  # QA is where that costs the most, because no agent in this pipeline may close the bugs that
  # put it there (the docs/qa/ tree belongs to the skills — agents/sdd-qa.md, "Rules that are not
  # negotiable"; anchored on the heading and not on a line number, which its own § 5.1 shifted).
  if [ "$st" = "blocked" ]; then
    GATE_HANDOFF_BLOCKED=1
    GATE_WHY="30-handoff-qa.md has status: blocked"; return 1
  fi

  # Project with no interface: the qa-report/qa-execution skills never ran (qa_substep sends it
  # straight to sdd-qa), so the docs/qa/ tree does not exist. Demanding their dated report would
  # charge for an artifact nobody produces — the gate would be unsatisfiable precisely in the
  # case where QA did the work and FOUND something. The evidence of the journey walked lives in
  # the `gate:` field of the handoff itself, which is the artifact that does exist here.
  # (Found by sdd-qa in mission 20260814-dry-run-completo: `skipped` would lie, `done` hit
  # Anchor 1 and `blocked` fails by definition — no status was both honest AND satisfiable.)
  if [ -z "$E2E_CMD" ] && [ -z "$APP_URL" ]; then
    local evidence; evidence="$(frontmatter "$h" gate)"
    if [ -z "$evidence" ]; then
      GATE_WHY="project with no interface: 30-handoff-qa.md needs 'gate:' carrying the evidence of the journey walked"
      return 1
    fi
  else
    # Anchor 1: the dated report from the qa-execution skill.
    report="$(latest_matching "$REPO_ROOT/$QA_DOCS_PATH/reports/*.md")"
    [ -n "$report" ] || { GATE_WHY="no report in $QA_DOCS_PATH/reports/"; return 1; }
    # Anchor on the qa-execution skill's report. The `**Status:**` does NOT start the line: its
    # template is `- **Started:** <ts> · **Status:** in-progress <!-- in-progress | closed -->`.
    # Requiring line start made the gate never match, and the runner re-ran qa-execution forever
    # — US$ 15 a round. Measured in the SQ-97 pilot.
    # The `closed` must come right after `**Status:**`: the template comment contains the word
    # `closed` in the enum legend, and a `.*closed` would match the `in-progress` line too.
    if ! report_closed "$report"; then
      GATE_WHY="report $(basename "$report") is not 'closed' (the enum belongs to the skill: in-progress|closed, do not translate)"
      return 1
    fi
    # Anchor 2: no row of the matrix may still read Pending.
    if grep -qE '\|[[:space:]]*Pending[[:space:]]*\|' "$report"; then
      GATE_WHY="report $(basename "$report") still has 'Pending' row(s) in the matrix"; return 1
    fi
  fi
  # Anchor 3: registry with no open bug an AGENT could close. 'wont-fix'/'invalid' are human calls
  # and do not block — and neither does `Closable by: human`, for the same reason one level up.
  #
  # The genre is what makes the promise in GATE_WHY below true. No agent in this pipeline may
  # write the `Status:` line: the docs/qa/ tree belongs to the qa-report/qa-execution skills
  # (agents/sdd-qa.md, "Rules that are not negotiable"), and sdd-executor does not know it exists. So
  # a bug whose fix is a PRODUCT decision had no path out of `open` at all, while this anchor
  # blocked the phase for it anyway and every honest finding bought another lap. Measured in
  # 20260825-frete-cif-fob: 7 of the 12 QA sessions were in that loop, US$ 73,32 of US$ 144,88.
  # `Closable by: agent` still blocks, because for that bug the F<n> cycle does close.
  #
  # ABSENT ⇒ BLOCKS, and the anchor is strict about it. Every bug file written before this field
  # existed lacks it, so a permissive default would switch this anchor off for a whole legacy
  # registry in one step. Strict for the same reason `closed` is strict at :587 — the enum legend
  # `<!-- agent | human -->` is preserved in the real files, so the word `human` appears in EVERY
  # bug on disk and a `.*human` spelling would fail open across the board.
  #
  # THREE STEPS, and all three are load-bearing — this is the first anchor in the gate where a
  # loose match is PERMISSIVE, so every looseness here fails OPEN. Its sibling `Status: open`
  # matches anywhere in the file too, but there anywhere-matching can only make a bug BLOCK.
  # Each step has a mutant of its own (QA_bug_genre_prefix, _anywhere, _fenced) because they fail
  # open INDEPENDENTLY: one mutant for the line would let two of the three rot while staying green.
  #
  #   1. The genre is read from the FIELD. `grep -q` is true for any line of the file, so a bug
  #      whose own field says `agent` stopped blocking the moment its body QUOTED the human line.
  #      Not a contrived body: agents/sdd-qa.md § 5.1 prints that exact line for the agent to copy,
  #      so a bug filed ABOUT this field was the likely first victim.
  #   2. The genre is the WHOLE WORD. Without a right-hand boundary every value that merely STARTS
  #      with `human` read as the genre: `humano` — the pt-BR spelling, in a repo declaring
  #      OUTPUT_LANG=pt-BR — plus `humans`, `humanoid`, `human-ish`. The boundary admits a
  #      following space so the `<!-- agent | human -->` legend the real files preserve still
  #      passes; anchoring a bare `$` here would reject every real bug file instead.
  #
  #   3. The FIELD is the file's own, not the first thing SHAPED like one. Step 1 landed as
  #      `grep -m1`, whose "the first field-shaped line IS the field" holds only while nothing
  #      above the header is shaped like the field — and step 1's own scenario breaks it, because
  #      a bug filed ABOUT the genre whose repro block is pasted before the metadata reads its
  #      genre out of the quote. Reproduced in the REVIEW round of 20260826-o-laco-da-qa: same
  #      `Closable by: agent` field, same fenced `human` line, only the ORDER moved, and the gate
  #      went from blocking to answering `registry clean`. It shipped as a declared limit; a
  #      declared limit is still a fail-open, and this anchor's every looseness is permissive.
  #      So the extraction SKIPS fenced blocks and takes the first field-shaped line outside one.
  #
  # Both of the first two measured in the QA phase of 20260826-o-laco-da-qa, both reported
  # `registry clean`. Declared limit that remains: a quote parked above the header and NOT fenced
  # — bare prose opening with `- **Closable by:** human` — still reads as the field. It is the
  # residue of the same class and it is named here rather than in a comment that claims the class
  # is closed; the fenced form is the one agents/sdd-qa.md § 5.1 actually prints, and the one that
  # reproduced.
  #
  # AWK and not a second `grep`: the fence is STATE, and a line-at-a-time matcher cannot hold it —
  # the lesson check-todo.sh paid for when its parser did not know it was inside an item's code
  # block. `[*][*]` and not `\*\*`: mawk's handling of an escaped literal inside a regex is not
  # worth relying on when a bracket expression says the same thing unambiguously.
  local openbugs=0 bugfile genre_line
  while IFS= read -r bugfile; do
    [ -n "$bugfile" ] || continue
    genre_line="$(awk '
      /^[[:space:]]*(```|~~~)/ { fenced = !fenced; next }
      fenced { next }
      /^-[[:space:]]+[*][*]Closable by:[*][*]/ { print; exit }
    ' "$bugfile" || true)"
    if grep -qE '^\-[[:space:]]+\*\*Closable by:\*\*[[:space:]]+human([[:space:]]|$)' <<< "$genre_line"; then continue; fi
    openbugs=$((openbugs + 1))
  done <<< "$( { grep -rlE '^\-[[:space:]]+\*\*Status:\*\*[[:space:]]+open' \
      "$REPO_ROOT/$QA_DOCS_PATH/bugs/" 2>/dev/null || true; } )"
  if [ "$openbugs" -gt 0 ]; then
    # Names the ESCAPE HATCH, and that is the whole point of the mission this line belongs to.
    # `they become fix increments (QA⇄EXEC loop)` is the promise 00-missao.md quotes as the false
    # one: true for a bug an agent can close, false for a bug waiting on a product decision, and
    # the count above includes every UNMARKED bug — which is exactly the bug whose genre nobody has
    # decided yet. Telling that operator "make it a fix increment" is the wrong instruction in the
    # one case this anchor was rewritten for, so the reason says how a bug leaves by the other
    # door. The substring `with Status: open in the registry` is load-bearing: two assertions in
    # check-gates.sh read it (:486 and the genre differential at :535).
    GATE_WHY="$openbugs bug(s) with Status: open in the registry that an agent could close (an unmarked genre counts) — they become fix increments (QA⇄EXEC loop); one that needs a human decision is marked 'Closable by: human' instead (agents/sdd-qa.md § 5.1)"
    return 1
  fi
  if ! run_check_cmd "$TEST_CMD" "gate-qa-test"; then
    GATE_WHY="TEST_CMD failed ($TEST_CMD) — see $LAST_CHECK_LOG"; return 1
  fi
  # The composed `if` above is left INTACT and the probe goes in the body, which is the whole
  # design: the app is asked about only on the path where the e2e has ALREADY come back red.
  # Probing earlier would be wider than the defect — a repo whose e2e brings its own server up, or
  # whose APP_URL only answers while the test runs, would be blocked for a machine state that
  # never mattered. A false BLOCKED costs a person; the loop only costs money. The fixture at
  # tests/check-gates.sh with `APP_URL="http://example.invalid"` beside a GREEN E2E_CMD is what
  # holds that line, and it is asserted as the other half of the dead-app pair.
  if [ -n "$E2E_CMD" ] && ! run_check_cmd "$E2E_CMD" "gate-qa-e2e"; then
    # Held in a local before the probe runs: LAST_CHECK_LOG is the file this refusal sends the
    # operator to READ, and it is a global that any later run_check_cmd would overwrite.
    local e2e_log="$LAST_CHECK_LOG" probe state label
    probe="$(app_probe "$APP_URL")"
    state="${probe%%|*}"; label="${probe#*|}"
    case "$state" in
      down)
        # The only arm that arms the marker, and the only one cmd_run acts on.
        GATE_APP_DOWN=1
        GATE_WHY="E2E_CMD failed ($E2E_CMD) and nothing is listening at $label (APP_URL) — the app is down; no session can start it. See $e2e_log"
        ;;
      up)
        # The WITNESS, and it is not decoration: without it "the app was never asked about" and
        # "the app was asked about and answered" would read the same to whoever gets this
        # sentence, and `down` would be a claim with no contrast behind it. A TCP accept is ALL the
        # witness proves: it clears the address, never the environment behind it — a stopped
        # database sits behind a port that answers — so the sentence names what it cleared and
        # sends the reader to the log for the rest.
        GATE_WHY="E2E_CMD failed ($E2E_CMD) with the app answering at $label — APP_URL is not the cause; whatever is (a broken assertion, or something behind the port, like a stopped database) is in the log. See $e2e_log"
        ;;
      *)
        # `*` and not `unknown)`: this is the arm that has to catch a state nobody has invented
        # yet, since the two above are the only ones that may change what the runner DOES.
        GATE_WHY="E2E_CMD failed ($E2E_CMD) — see $e2e_log (the app was not probed either way: $label)"
        ;;
    esac
    return 1
  fi
  if [ -n "${report:-}" ]; then
    GATE_WHY="report $(basename "$report") closed, registry clean, suites green"
  else
    GATE_WHY="journey walked without a browser interface (evidence in the handoff), suite green"
  fi
  return 0
}

# How many REVIEW rounds are on disk once the phase has run, and the ceiling they run against.
# Empty until a gate_REVIEW has resolved the round file; read by cmd_run and cmd_retry to build the
# REVIEW row of the autonomy ledger, exactly like GATE_EXEC_PENDING one screen up — including the
# hazard: they outlive the call that sets them, so every read site guards on the phase.
GATE_REVIEW_ROUNDS=""
GATE_REVIEW_MAX=""

gate_REVIEW() {
  # NO reset-on-entry, and that is a decision with a measurement behind it. GATE_EXEC_PENDING needs
  # one because gate_EXEC publishes CONDITIONALLY, below its validation loop, so a refusal above the
  # publication would hand the caller the previous gate's numbers. Here the publication is
  # unconditional and sits above every `return` in the function, so no path can leave a stale value
  # visible: a reset written here is overwritten three lines later, and sabotaging it away leaves
  # the suite green — measured. Redundant rules get removed rather than probed (CLAUDE.md). Move
  # the publication below a `return` and this comment stops being true; the reset comes back with it.
  local last; last="$(latest_matching "$MISSION_DIR/40-review-r*.md")"
  # PUBLISHED HERE, as soon as the round file is resolved — and the asymmetry with EXEC's
  # `pending_after`, which is published only after the gate has validated, is deliberate. EXEC's
  # count is a VERDICT because the checkpoint is a label the executor writes about itself (`done`
  # with no commit), so a gate about to refuse has no verdict to give. The `N` of `40-review-r<N>.md`
  # is STRUCTURAL: it is the file name, resolved by the same `latest_matching` the refusal below
  # reads, and nobody self-declares it. Publishing at the resolve is precisely what lets an r1 that
  # landed with real findings and did NOT reach Grade A count as a round that advanced — which is
  # the whole reason these fields exist. Do not "fix" this into symmetry.
  #
  # `review_rounds_on_disk` and not a second parse of `$last`: one definition, so the ceiling in
  # cmd_run and the number on the ledger row cannot disagree about which round is latest.
  GATE_REVIEW_ROUNDS="$(review_rounds_on_disk)"
  GATE_REVIEW_MAX="$REVIEW_MAX_ITER"
  # `0`, not empty: no round file at all IS a measurement — zero rounds on disk — and it is the
  # honest reading for a phase whose session wrote nothing. With `rounds_before` also 0 the reader's
  # `rounds_after > rounds_before` is false, so the row falls back to `moved`, as it did before
  # these fields existed.
  [ -n "$last" ] || { GATE_WHY="no 40-review-r<N>.md"; return 1; }

  # Documented anchor: the "### Overall Grade" section of the codereview skill (contract
  # v1.13.0+), table | Criterion | Grade | Rationale | on an A–F scale. The gate requires A on
  # EVERY row — "—" (not analysed) fails too: a partial review is not a review.
  #
  # It reads the `Rationale` column too, and refuses a placeholder there. For two missions the
  # extractor took `crit = f[2]; grade = f[3]` and never touched `f[4]`, so a table with `A` on
  # every row and the literal `PREENCHER` on every justification passed — the live instance is
  # docs/handoffs/20260818-lote-facil/40-review-r1.md, whose own `gate:` field records it. An `A`
  # that no sentence supports is a label, and this gate exists to refuse labels.
  # The `gate:` field is the other half of the seal, and it is judged by the SAME rule — so it is
  # fed INTO the awk below instead of being tested again in shell. One definition per program: the
  # day this repo spelled a two-value enum by hand in three places, two learned the new event and
  # the third went blind (CLAUDE.md, "enum lido em mais de um ponto").
  local offending TAB gate_field gate_present
  TAB=$'\t'
  gate_field="$(frontmatter "$last" gate)"
  # Presence, asked separately: `gate:` with nothing after it reads as the empty string, exactly
  # like a file with no `gate:` at all, and the two deserve opposite verdicts.
  gate_present=0
  if frontmatter_has "$last" gate; then gate_present=1; fi
  # Through the ENVIRONMENT and never `awk -v`: an assignment made with `-v` is run through awk's
  # ESCAPE processing before the program ever sees it, so evidence quoting a regex arrives mangled.
  # Measured on this machine's mawk 1.3.4:
  #   awk -v x='grep -E \bcaught\b' 'BEGIN{print x}'  →  grep -E caught
  # The `\b`s are gone, and the same corrupted string is what the GATE-FIELD branch echoes back at
  # the operator — a refusal quoting text that is not what is on disk. ENVIRON is handed over byte
  # for byte. `gate_present` stays on `-v`: it is one digit, and it has to arrive as a NUMBER.
  offending="$(SDD_GATE_FIELD="$gate_field" awk -v gate_present="$gate_present" '
      BEGIN { gate_field = ENVIRON["SDD_GATE_FIELD"] }
      # The refused set, written here so the next reader does not have to guess it: an EMPTY cell;
      # the whole cell wrapped in angle brackets, which is how the `### Overall Grade` table of
      # templates/review.md ships its fill-ins (named by SECTION and not by line number: the two
      # citations this comment used to carry both rotted, one of them by six lines);
      # a bare ellipsis; and the bare fill-in words below. It targets the WHOLE cell,
      # never the presence of a character — a real sentence containing <A> is a real sentence.
      # NOT refused: `clean`, `n/a` and `—`. Those are the codereview skill terse rationales
      # (its `### Overall Grade` section, likewise by name) and mean measured-with-nothing-to-say;
      # refusing them would make this gate contradict the skill it parses — the SQ-97 gate_DOCS bug.
      function placeholder(s,   u, w) {
        if (s == "") return 1
        if (s ~ /^<.*>$/) return 1
        u = toupper(s)
        # `—` is E2 80 94 and mawk is byte-oriented, so every rule written about punctuation sees
        # three non-alphanumeric bytes there and not one character. This line is the ONLY reason
        # the skill terse rationale survives the two rules below. Measured on mawk 1.3.4.
        # The other two, `clean` and `n/a`, need no line here — they carry letters and are not in
        # the list at the bottom, which is the mechanism, and the sensor holds a world for each.
        if (s == "—") return 0
        # A cell with no letter and no digit left in it says nothing at all: `-`, `?`, `.`, `--`,
        # and the ellipsis in both its spellings, `...` and `…`.
        if (u !~ /[[:alnum:]]/) return 1
        # Compare the WORD, not the spelling. Equality alone let one keystroke buy the A: `TODO:`
        # is what a model writes far more often than the bare `TODO` this list used to know, and
        # `TBD.` is the same claim with a full stop.
        w = u; gsub(/[^[:alnum:]]/, "", w)
        if (w == "PREENCHER" || w == "TODO" || w == "TBD" || w == "FIXME" || w == "XXX" ||
            w == "WIP" || w == "FILLME") return 1
        return 0
      }
      # DUPLICATED, deliberately, in checkpoint_rows — see the comment above that function for why
      # a shared helper would cost more than it saves. The two copies must stay identical.
      #
      # PARITY, and not "does this field end in a backslash". `\\` is how GFM spells a literal
      # backslash, so a cell ending in one sits against a REAL delimiter — and the first version of
      # the rejoin below could not tell the two apart. Measured against the runner one commit
      # earlier, which passes the same row: `| Escaping (\\| A | Confirmed no leaks. |` was reported
      # as `Escaping (\| A = Confirmed no leaks.`, a Grade-A row blocked by a criterion nobody
      # wrote. An ODD run of trailing backslashes escapes the pipe; an EVEN one does not.
      function escaped_pipe(s,   t) { t = s; sub(/\\+$/, "", t); return (length(s) - length(t)) % 2 }
      /^###[[:space:]]+Overall Grade/ { inside = 1; next }
      # Exit on ANY heading, not only `###`. Exiting only on `###`, a following section of a
      # HIGHER level (`## Fixes this round`) did not end the read, and the parser kept swallowing
      # later tables of the report — failing an all-Grade-A report because it found a `Commit`
      # column in a table of commits. Measured in the SQ-97 pilot.
      inside && /^#{1,6}[[:space:]]/ { exit }
      inside && /^[ \t]*\|/ {
        # GFM writes a literal pipe INSIDE a cell as `\|`, and a raw split on "|" cuts the row
        # there. Harmless while only f[2] and f[3] were read; the moment f[4] became a verdict it
        # turned into a false RED, which is the same defect as a false green — the gate saying
        # something it did not measure. Measured with the row
        #   | Code Quality (Zen) | A | `TODO\|` list references removed. Confirmed green. |
        # the stump left behind was `TODO\`, which normalises straight into the refused fill-in
        # word: a real justification reported as a placeholder, and a PR blocked for a reason that
        # is not true. Rejoined here so every column downstream sees the cell the author wrote.
        delete f
        rawn = split($0, raw, "|")
        n = 0
        for (i = 1; i <= rawn; i++) {
          if (n > 0 && escaped_pipe(f[n])) { sub(/\\$/, "|", f[n]); f[n] = f[n] raw[i] }
          else { f[++n] = raw[i] }
        }
        if (n < 4) next
        crit = f[2]; grade = f[3]; rat = f[4]
        gsub(/\*/, "", crit);  gsub(/^[ \t]+|[ \t]+$/, "", crit)
        gsub(/\*/, "", grade); gsub(/^[ \t]+|[ \t]+$/, "", grade)
        gsub(/[*`]/, "", rat); gsub(/^[ \t]+|[ \t]+$/, "", rat)
        # `:?-+:?` — a formatter-aligned separator (`|:---|:---:|`) is a separator, not a criterion.
        # Read as a row it graded `:` with `---`, and REVIEW looped to REVIEW_MAX_ITER with a reason
        # naming no criterion anybody wrote. Same regex in checkpoint_rows and gate_DOCS.
        if (crit == "Criterion" || crit ~ /^:?-+:?$/ || crit == "") next
        rows++
        # Grade first, on purpose: a row that is both off-A and unjustified is reported by its
        # grade, which is the older and more specific message.
        if (grade != "A") { verdict = crit " = " (grade == "" ? "<empty>" : grade); exit }
        if (placeholder(rat)) { verdict = "PLACEHOLDER\t" crit "\t" (rat == "" ? "<empty>" : rat); exit }
      }
      END {
        if (verdict != "") { print verdict; exit }
        if (rows == 0)     { print "NO-TABLE"; exit }
        # The other half of the seal. ABSENT is left alone on purpose, and the scope is measured,
        # not assumed: 6 of the 14 rounds on disk in this repo predate the field, and a gate that
        # refused them would be rewriting history instead of measuring the round that just ran.
        # Present-but-unfilled is the case that lies, and it is the one refused — which is why
        # this reads PRESENCE and not the value: `gate:` with nothing after it is present and
        # unfilled, and for two commits the test `gate_field != ""` let exactly that case through
        # while this comment claimed otherwise.
        if (gate_present && placeholder(gate_field))
          print "GATE-FIELD\t" (gate_field == "" ? "<empty>" : gate_field)
      }
    ' "$last")"
  if [ "$offending" = "NO-TABLE" ]; then
    GATE_WHY="$(basename "$last") has no '### Overall Grade' section — the gate has nothing to measure"
    return 1
  fi
  case "$offending" in
    PLACEHOLDER"$TAB"*)
      local rest crit rat
      rest="${offending#PLACEHOLDER$TAB}"
      crit="${rest%%$TAB*}"
      rat="${rest#*$TAB}"
      GATE_WHY="$(basename "$last"): $crit has Grade A with a placeholder Rationale ($rat) — a grade no sentence supports is a label, not a review"
      return 1 ;;
    GATE-FIELD"$TAB"*)
      GATE_WHY="$(basename "$last"): the 'gate:' frontmatter is still a placeholder (${offending#GATE-FIELD$TAB}) — that field carries the evidence the round closed, not the shape of it"
      return 1 ;;
  esac
  if [ -n "$offending" ]; then
    GATE_WHY="$(basename "$last"): $offending — the gate requires Grade A on every criterion"; return 1
  fi
  if ! run_check_cmd "$TEST_CMD" "gate-review-test"; then
    GATE_WHY="TEST_CMD failed ($TEST_CMD) — see $LAST_CHECK_LOG"; return 1
  fi
  if [ -n "$(cd "$REPO_ROOT" && git status --porcelain)" ]; then
    # The CHECK is unchanged and so is the behaviour — only the sentence moved, because since
    # `20260901-o-revisor-so-acha` this phase does not fix: what a REVIEW session leaves behind is
    # its round report and the `R<n>` rows it wrote into the checkpoint. ⚠️ The words BEFORE the
    # dash are load-bearing and stay verbatim: `historic_rounds` declares this refusal as one of the
    # two that name no round file, and the prose is quoted as that declared limit in three places
    # (the def's own comment above, `docs/pipeline.md § Field reference`, `tests/check-autonomy.sh`).
    # For the same reason the tail must NOT name `40-review-r<N>.md`: the recovery's regexes are
    # anchored at `^`, and the world its comment says it could not build is precisely a `gate_why`
    # carrying that name somewhere other than the first character.
    GATE_WHY="working tree dirty after the review — the round and its R<n> rows must be committed"; return 1
  fi
  GATE_WHY="$(basename "$last") all Grade A, suite green, tree clean"
  return 0
}

gate_DOCS() {
  local d="$MISSION_DIR/45-docs.md"
  [ -f "$d" ] || { GATE_WHY="missing 45-docs.md"; return 1; }
  if ! grep -qiE 'drift' "$d"; then
    GATE_WHY="45-docs.md has no drift checklist"; return 1
  fi
  # Every area touched must be ✅ or a justified n/a — one pending item fails the gate.
  #
  # Reads the `Status` COLUMN of the drift table, locating it by header position. The previous
  # version grepped the whole file for the word `TODO` and failed every `45-docs.md` that named
  # `TODO.md` — which is exactly what `sdd-docs` is required to do (checking the mission's TODO
  # entries is in its instructions). The gate contradicted the agent. Measured in the SQ-97
  # pilot: 0 `✗` items in the file and a failure all the same.
  local pending_cell
  pending_cell="$(awk -F'|' '
      # find the header and remember which column holds Status
      !col && /^[ \t]*\|/ {
        for (i = 2; i < NF; i++) {
          cell = $i; gsub(/^[ \t]+|[ \t]+$/, "", cell)
          if (cell == "Status") { col = i; next_is_sep = 1 }
        }
        if (col) next
      }
      col && /^[ \t]*\|/ {
        cell = $col; gsub(/^[ \t]+|[ \t]+$/, "", cell)
        # `:?-+:?` — with a formatter-aligned separator (`|:---:|`) the Status column of the
        # separator row read as a pending Status, and gate_DOCS failed a drift checklist with
        # nothing pending in it. Same regex in checkpoint_rows and gate_REVIEW.
        if (cell ~ /^:?-+:?$/ || cell == "") next
        if (cell == "✅" || cell == "n/a" || cell == "N/A") next
        print cell; exit
      }
      col && !/^[ \t]*\|/ { exit }   # the table ended
    ' "$d")"
  if [ -n "$pending_cell" ]; then
    GATE_WHY="45-docs.md has an area with Status '$pending_cell' in the drift checklist — every row needs ✅ (with a hash) or a justified n/a"
    return 1
  fi
  GATE_WHY="drift checklist complete"
  return 0
}

# ---------------------------------------------------------------------------
# The mutation catalogue's stamp
# ---------------------------------------------------------------------------
# Since 4c86712 the catalogue is OPT-IN: TEST_CMD does not run it, and this repo has no CI. That
# left the one instrument that measures whether the assertions still bite with NO owner, and the
# bill arrived between PR #12 and PR #13 — a fix rotted the anchor of one mutation, the REVIEW and
# PR gates ran the fast suite and answered green, and the base branch carried a score with a live
# survivor for days, until a human happened to type `sdd health`.
#
# The fix is not to RUN the catalogue inside a gate: that is exactly what 4c86712 undid, after
# twenty minutes of held working tree made the REVIEW phase unsatisfiable headless and ended three
# sessions with the words "waiting for the suite". The gate asks for the ARTIFACT instead — a stamp
# `sdd health` writes when the catalogue came back green, and that nothing else in the kit writes.

# The directories the catalogue's verdict is a function of, named in ONE place and read at both
# ends: cmd_health writes the key, gate_PR demands it.
#
# FOUR, and the boundary is declared rather than assumed. sandbox() in tests/check-mutation.sh also
# copies agents/, CLAUDE.md, TODO.md and docs/adr, so a change confined to THOSE is not covered by
# this key. The narrowing is deliberate and its reason is operational: the DOCS phase edits
# CLAUDE.md and TODO.md on its way to the PR, so keying on them would throw the stamp away between
# the last code commit and the gate that reads it — a second twenty-minute run per mission, bought
# for documents no mutant edits. What the mutants DO edit is bin/sdd, and what decides their fate
# is the assertions in tests/ plus the templates/ and config/ those assertions read. The residual
# gap is in TODO.md with its direction, not hidden in a sentence here.
readonly MUTATION_STAMP_PATHS=(bin tests templates config)

# Under .sdd/logs/ and not .sdd/: `sdd install` guarantees .sdd/logs/ is gitignored in every repo
# the kit touches, while .sdd/config.sh right above it is TRACKED. A stamp one directory up would
# appear in the `git status` of every phase — and a phase that dies with a dirty tree makes the
# runner re-derive EXEC in a loop, at about US$ 25 a lap.
readonly MUTATION_STAMP_REL='.sdd/logs/mutation-stamp'

# "Is this root a tree the catalogue is about?" — asked at BOTH ends, and therefore written once.
#
# gate_PR's question ("is a stamp demanded here?") and cmd_health's ("which tree do I measure?")
# have to be the SAME question, or the two ends address different trees and the seal becomes a
# refusal with no reachable remedy. Two spellings of it is precisely how that happened: the writer
# answered about $SDD_HOME and the reader asked about $REPO_ROOT.
#
# Scoped by ARTIFACT and never by the identity of the repository, for the reason gate_PR records
# below: the identity door the kit already has (cmd_kaizen) carries a live worktree bug.
has_mutation_catalogue() { [ -f "$1/tests/check-mutation.sh" ]; }

# The kit tree `sdd health` measures — and therefore the tree it stamps.
#
# NOT $SDD_HOME unconditionally, which is what it used to be. `sdd` on the PATH is the install
# README.md documents, and standing in a worktree or a second clone of the kit made $SDD_HOME and
# gate_PR's $REPO_ROOT two different trees: the stamp landed in one while the gate asked the other,
# so gate_PR was unsatisfiable FOREVER and `sdd health` — the command its own refusal names as the
# remedy — re-measured the wrong tree, twenty to fifty minutes a lap.
#
# The working directory wins only when it is itself a tree with a catalogue, tested by the SAME
# predicate gate_PR scopes on: every root the gate would demand a stamp for is a root this command
# measures and stamps, and every root it would not is left to $SDD_HOME. A target repo has no
# tests/check-mutation.sh, so `sdd health` inside one is the command it always was.
health_kit_root() {
  local cwd_root
  # `|| true`, and not for style: this file runs under `set -e`, an assignment takes the status of
  # its substitution, and "the cwd is not a git repository" is a perfectly ordinary answer here —
  # unguarded, it would kill `sdd health` on its first line for every operator outside a checkout.
  cwd_root="$( git rev-parse --show-toplevel 2>/dev/null || true )"
  if [ -n "$cwd_root" ] && has_mutation_catalogue "$cwd_root"; then
    printf '%s\n' "$cwd_root"
  else
    printf '%s\n' "$SDD_HOME"
  fi
}

# The size below which a catalogue cannot have measured the runner, whatever its score says.
#
# EIGHT because check 4 of cmd_health already demands one mutation per gate, so a catalogue under
# this number fails that check anyway — the floor states a bound the command was already committed
# to, instead of inventing a threshold somebody would have to keep bumping. It is deliberately NOT
# a ratchet at today's census: the size that has to track the catalogue is read off the catalogue
# itself (see check 2), and this constant is only the guard against BOTH sides being gutted at
# once, where that comparison would read 0 == 0 and pass.
readonly MUTATION_CATALOGUE_FLOOR=8

# The content key of the paths above: prints it, or prints NOTHING and returns 1.
#
# The difference is the whole guard. `md5sum` of no input at all is a perfectly valid-looking
# constant, so a root whose four directories are all absent would otherwise be handed a stable key
# that every other empty root matches — a stamp certifying nothing, indistinguishable from a stamp
# certifying everything. Emptiness is refused here, once, instead of at each call site.
#
# ⚠️ `xargs -r`, and it is what makes the sentence above TRUE rather than merely intended: without
# it, `xargs` with nothing on its input runs `md5sum` once with no operands, `md5sum` reads the
# already-drained pipe, and the function hands back the digest of the empty string — the exact
# constant the guard exists to refuse, with the `[ -n "$listing" ]` below satisfied by it. Today no
# caller reaches that state (both ends only ask about a root whose tests/ holds a catalogue, so
# `find` always has at least that file to print), and that is declared, not sold as measured: this
# is a one-token hardening of a guard whose comment was ahead of its code.
mutation_stamp_key() { # mutation_stamp_key <root>
  local listing
  # `md5sum` and not `sha256sum`: it is the digest `sdd preflight` already probes the userland for,
  # so this adds no assumption the kit was not already making. The relative paths ride INSIDE the
  # digest, which is what makes a file that merely MOVED change the key.
  listing="$( CDPATH='' cd "$1" 2>/dev/null \
              && find "${MUTATION_STAMP_PATHS[@]}" -type f -print0 2>/dev/null \
                 | LC_ALL=C sort -z | xargs -0 -r md5sum 2>/dev/null )" || true
  [ -n "$listing" ] || return 1
  # Herestring, never `printf … |`: under `pipefail` that form returns 141 when the reader exits
  # first, which is a failure whose likelihood grows with the size of the tree being hashed.
  md5sum <<< "$listing" | cut -d' ' -f1
}

gate_PR() {
  local p="$MISSION_DIR/50-pr.md"
  [ -f "$p" ] || { GATE_WHY="missing 50-pr.md"; return 1; }
  local url; url="$(frontmatter "$p" pr_url)"
  [ -n "$url" ] || { GATE_WHY="50-pr.md has no 'pr_url:' in the frontmatter"; return 1; }
  local live
  live="$( cd "$REPO_ROOT" && gh pr view "$url" --json url --jq .url 2>/dev/null )" || true
  [ -n "$live" ] || { GATE_WHY="gh does not confirm PR $url — 50-pr.md may be lying"; return 1; }

  # The catalogue's stamp, and LAST on purpose: the two requirements above are the ones that fail
  # in practice, so the message an operator already knows stays the likely one.
  #
  # Scoped by ARTIFACT — "is there a catalogue here?" — and never by the identity of the
  # repository. A target repo has no tests/check-mutation.sh, so nothing about it changes; and the
  # identity door the kit already owns (cmd_kaizen) carries a live worktree bug, recorded in
  # TODO.md, which inheriting would simply buy.
  if has_mutation_catalogue "$REPO_ROOT"; then
    local key stamp
    key="$(mutation_stamp_key "$REPO_ROOT" || true)"
    stamp="$(cat "$REPO_ROOT/$MUTATION_STAMP_REL" 2>/dev/null || true)"
    # ONE refusal and one sentence, with `-z` folded into it rather than given a message of its
    # own. The disjunct is load-bearing and not decoration: an absent stamp file reads as the empty
    # string, so an empty KEY would compare EQUAL to it and open the gate — the two ways of knowing
    # nothing agreeing that everything is fine. It is also, today, unreachable, and that is
    # declared rather than dressed up: the scope condition above is a file INSIDE tests/, so
    # reaching this line at all proves tests/ is non-empty. A second GATE_WHY here would be a
    # sentence no world can print, which is the dead code this repo keeps finding in its own gates.
    #
    # The remedy is IN the sentence, the same rule cmd_health's red-suite line obeys and for the
    # same measured reason: without the command named, the operator runs the fast suite, sees
    # green, and concludes the gate is lying — which is the one thing it may never be.
    if [ -z "$key" ] || [ "$stamp" != "$key" ]; then
      GATE_WHY="no green mutation catalogue for this content — run 'sdd health' (since 4c86712 TEST_CMD does not run the catalogue, so no gate before this one measures it)"
      return 1
    fi
  fi

  GATE_WHY="PR open: $live"
  return 0
}

readonly PHASES="PLAN TICKET EXEC QA REVIEW DOCS PR"

# First phase whose gate is not satisfied. Empty ⇒ mission complete.
current_phase() {
  local ph
  for ph in $PHASES; do
    if ! "gate_$ph"; then printf '%s\n' "$ph"; return 0; fi
  done
  printf '%s\n' ""
}

# First phase AFTER <phase> whose gate is not satisfied. Empty ⇒ the list ended.
# It exists only for the dry-run projection: since the dry-run changes nothing on disk, calling
# current_phase() again would return the same phase forever — an infinite loop.
next_pending_phase() {
  local after="$1" ph seen=0
  for ph in $PHASES; do
    if [ "$seen" = "1" ] && ! "gate_$ph"; then printf '%s\n' "$ph"; return 0; fi
    if [ "$ph" = "$after" ]; then seen=1; fi
  done
  printf '%s\n' ""
}

# ---------------------------------------------------------------------------
# Phase invocation
# ---------------------------------------------------------------------------

# Model configured for the phase.
phase_model() {
  case "$1" in
    EXEC)   printf '%s\n' "$MODEL_EXEC" ;;
    QA)     printf '%s\n' "$MODEL_QA" ;;
    REVIEW) printf '%s\n' "$MODEL_REVIEW" ;;
    DOCS)   printf '%s\n' "$MODEL_DOCS" ;;
    PR)     printf '%s\n' "$MODEL_PUBLISH" ;;
    TICKET) printf '%s\n' "$MODEL_TICKET" ;;
    KAIZEN) printf '%s\n' "$MODEL_KAIZEN" ;;
    *)      printf '%s\n' "$MODEL_EXEC" ;;
  esac
}

# Damage cap configured for the phase, in US$. Mirrors phase_model on purpose: same shape, same
# fallthrough. The phases NOT named here (DOCS, PR, TICKET, KAIZEN) are the cheap ones and stay on
# the global — a body assembled from finished handoffs or an `acli` call with the fields already
# decided does not need its own key.
phase_budget_usd() {
  case "$1" in
    EXEC)   printf '%s\n' "$BUDGET_EXEC_USD" ;;
    QA)     printf '%s\n' "$BUDGET_QA_USD" ;;
    REVIEW) printf '%s\n' "$BUDGET_REVIEW_USD" ;;
    *)      printf '%s\n' "$BUDGET_PER_PHASE_USD" ;;
  esac
}

# QA sub-step, DERIVED from the artifacts — same philosophy as the gates, no extra state.
# The QA phase is three sessions: the qa-report/qa-execution skills carry
# `disable-model-invocation`, so each one has to enter through the literal slash as the opening
# prompt of ITS OWN session (verified on 2026-08-14: the slash expands headless and the skill
# loads). sdd-qa closes the cycle afterwards.
# Is the qa-execution skill's dated report closed?
#
# ONE function, used by the gate AND by the sub-step. The anchor used to live duplicated in
# both; fixing it in a single place made `gate_QA` accept the report while `qa_substep` still
# believed execution was pending — and the runner re-ran qa-execution at US$ 15 a round. A
# duplicated contract is a contract that diverges; the duplication was the bug, not the regex.
#
# Anchor details: `**Status:**` does NOT start the line (the template is
# `- **Started:** <ts> · **Status:** in-progress <!-- in-progress | closed -->`), and `closed`
# has to come right after `**Status:**` — a `.*closed` would match the enum legend in the
# comment, approving a report that is still in progress.
report_closed() {
  local report="${1:-}"
  [ -n "$report" ] || return 1
  grep -qE '^[[:space:]]*-.*\*\*Status:\*\*[[:space:]]*closed' "$report"
}

qa_substep() {
  local qa="$REPO_ROOT/$QA_DOCS_PATH" report
  # Project with no interface to walk (no E2E_CMD and no APP_URL): the in-persona dogfooding
  # skills have nothing to do. Straight to sdd-qa, which judges whether the diff is user-visible
  # and, when it is not, writes `qa: skipped` with the justification. Bootstrapping a tree of
  # browser journeys in a project with no browser is the paperwork `skipped` exists to avoid.
  if [ -z "$E2E_CMD" ] && [ -z "$APP_URL" ]; then printf 'close\n'; return 0; fi
  [ -n "$(latest_matching "$qa/charters/*.md")" ] || { printf 'plan\n'; return 0; }
  report="$(latest_matching "$qa/reports/*.md")"
  if ! report_closed "$report"; then printf 'exec\n'; return 0; fi
  printf 'close\n'
}

# Step identifier: the phase, or `QA:<sub-step>`.
phase_step() {
  case "$1" in
    QA) printf 'QA:%s\n' "$(qa_substep)" ;;
    *)  printf '%s\n' "$1" ;;
  esac
}

# Agent responsible for the step. Empty ⇒ the slash skill drives, not a kit agent
# (two system prompts fighting over one session is noise, not reinforcement).
phase_agent() {
  case "$1" in
    EXEC)      printf '%s\n' "sdd-executor" ;;
    QA:plan)   printf '%s\n' "" ;;
    QA:exec)   printf '%s\n' "" ;;
    QA:close|QA) printf '%s\n' "sdd-qa" ;;
    REVIEW)    printf '%s\n' "sdd-reviewer" ;;
    DOCS)      printf '%s\n' "sdd-docs" ;;
    PR)        printf '%s\n' "sdd-publisher" ;;
    TICKET)    printf '%s\n' "sdd-publisher" ;;
    KAIZEN)    printf '%s\n' "sdd-kaizen" ;;
    *)         printf '%s\n' "" ;;
  esac
}

# Literal slash that opens the session, when the phase is driven by a third-party skill.
#
# ONLY where the skill cannot be reached any other way. The `qa-report` and `qa-execution` skills
# carry `disable-model-invocation`, so the literal slash as the first line of the prompt is their
# only route — and both answer `<none>` in phase_agent, exactly as the invariant above it requires.
# TICKET used to be listed here as well, WITH `sdd-publisher` as its agent: two system prompts over
# one session, which is the thing that invariant refuses. The slash was the half that went, because
# the `ticket` skill has no `disable-model-invocation` and agents/sdd-publisher.md already tells the
# session to invoke `/ticket open`. It also took one read of the PT-BR frontmatter key `titulo` out
# of the runner; the remaining one is `cmd_approve`, which only prints it for the human.
phase_slash() {
  case "$1" in
    QA:plan) printf '/qa-report %s\n' "$QA_DOCS_PATH" ;;
    QA:exec) printf '/qa-execution %s\n' "$QA_DOCS_PATH" ;;
    *)       printf '%s\n' "" ;;
  esac
}

phase_task() {
  case "$1" in
    EXEC)     printf '%s\n' "execute the NEXT pending increment of the checkpoint, in TDD, and commit" ;;
    QA:plan)  printf '%s\n' "plan the QA cycle for this mission: personas, journeys, scenarios and charters" ;;
    QA:exec)  printf '%s\n' "walk the journeys in persona and write the dated report + the bug registry" ;;
    QA:close|QA) printf '%s\n' "close the QA cycle: a confirmed finding becomes an e2e spec, a fixable bug becomes a fix increment, and write 30-handoff-qa.md" ;;
    REVIEW)   printf '%s\n' "review, reproduce and grade honestly; every finding that must be fixed becomes an R<n> increment in the checkpoint — you do NOT fix the code" ;;
    DOCS)     printf '%s\n' "sync the repo's living documentation with what this mission changed" ;;
    PR)       printf '%s\n' "push and open the PR carrying the evidence from the earlier phases" ;;
    TICKET)   printf '%s\n' "open the mission's JIRA issue, already in the active sprint, and record 10-ticket.md" ;;
    KAIZEN)   printf '%s\n' "judge the previous kit change, triage $TODO_FILE and give birth to the kit's next mission plan" ;;
    *)        printf '%s\n' "" ;;
  esac
}

# Extra per-phase instruction, when the phase has a loop of its own to drive.
phase_extra() {
  case "$1" in
    REVIEW) cat <<'EOF'

Drive the FINDING loop inside this session, with the QA report in hand: run the review, reproduce
what you raise and refute with evidence what is wrong. (The `/goal` command does NOT exist in this
environment — verified; the loop is yours.) You do NOT fix the code: every finding that must be
fixed becomes an R<n> increment in checkpoint.md, and the EXEC phase closes it in TDD with a
context of its own. This session commits ONLY 40-review-r<N>.md, checkpoint.md and the findings
file — a source file in your diff means the hat slipped. Write the REAL grade; a B on r1 with
increments written is the normal, healthy round, and the next round re-grades independently. A
grade inflated to pass the gate switches off the mission's only quality sensor.
EOF
    ;;
    QA:plan|QA:exec) cat <<'EOF'

The skill above owns the docs/qa/ tree — follow its instructions. When you finish, commit what
it wrote. Do not write a handoff and do not touch the checkpoint: that belongs to the next step.
EOF
    ;;
    *) printf '' ;;
  esac
}

# Boot protocol — fixed, short, and always the same. Everything the session needs to know is on
# disk; this prompt only says WHERE to look and that there was no earlier conversation.
#
# When the phase is driven by a third-party skill, the literal slash has to be the FIRST line of
# the prompt: that is how it expands headless (the QA skills carry disable-model-invocation, so
# there is no other route).
boot_prompt() {
  local step="$1" slash agent lang_line=""
  # ONE definition, read by every phase — including KAIZEN, which has a heredoc of its own below.
  # Measured 2026-09-02 (20260902-o-rascunho-legado-fala-cru, phase PR): two sdd-publisher sessions
  # ended the turn "waiting for the background task to finish", US$ 2.71 and a PR phase done by
  # hand. In `claude -p` ending the turn ends the session, so nothing resumes. The sentence lived in
  # agents/sdd-reviewer.md alone; a rule that every phase needs is written here, once, never copied
  # into seven agents (the enum rule of CLAUDE.md). tests/check-dry-run.sh reads it per phase.
  local turn_rule
  turn_rule="Never end the turn with a command or a task still running in the background: in a headless
session ending the turn ends the session, and \"I will resume when it finishes\" resumes nothing.
Wait for it, read its result, then write the artifacts and commit."
  slash="$(phase_slash "$step")"
  agent="$(phase_agent "$step")"
  # The kit is English; the ARTIFACT speaks whatever language the target repo declared. Empty ⇒
  # nothing is said, and the prompt stays byte for byte what it was before this key existed.
  if [ -n "$OUTPUT_LANG" ]; then
    lang_line="
Write EVERY artifact of this mission — handoffs, checkpoint, commit messages and PR body — in:
$OUTPUT_LANG. Identifiers, config keys and status tokens (pending, done, blocked, auto, skipped)
stay in English: they are contract, not prose.
"
  fi
  # KAIZEN is the meta-loop, not a mission phase: there is no 00-missao/01-plano/checkpoint to
  # read — the session's first act is running the deterministic series. An early return keeps the
  # mission-phase prompt below byte for byte untouched (the RUN_ignores_output_lang mutation
  # watches part of that; the rest is contract with every already-installed repo).
  if [ "$step" = "KAIZEN" ]; then
    # ADR 0001 splits the judge in two halves that must read ONE series: the runner derives the
    # numbers, the agent gives the verdict citing them. `gate_KAIZEN` reads its half by calling
    # kaizen_series IN PROCESS, so every ledger option the invocation carries reaches it; the
    # prompt below hands the agent a WRITTEN command line, so an option reached that half only if
    # the runner wrote it here. `--all-repos` used to reach the gate and not the prompt, and the
    # cost was not a wrong number: the prompt orders `kit_sha_judged:` to be the series' latest,
    # the gate hunts for its OWN latest, no verdict satisfies both, the runner retries once and the
    # phase ends in `BLOCKED in KAIZEN — no-progress`. Two opus sessions for a blocked row. Found
    # by sdd-qa (BUG-1, 20260817-eixo-do-juiz).
    #
    # Since ADR 0005 the invariant holds BY CONSTRUCTION instead of by upkeep: there is ONE
    # reading, `cmd_kaizen` sets it for the whole process, and the line below carries no option
    # that could disagree with the gate. The `ledger_flags` machinery that propagated the flag is
    # gone with the split it patched, and `mut_KAIZEN_prompt_series_unflagged` with it —
    # `mut_KAIZEN_series_default_per_repo` watches the default that replaced them both.
    cat <<EOF
You are in phase KAIZEN of the kit \`$PROJECT_NAME\` — the meta-loop that judges the kit itself —
as the agent sdd-kaizen.

All of your state comes from disk. There was NO earlier conversation — nothing was "agreed"
before. Before anything else:
  1. run: "$SDD_HOME/bin/sdd" kaizen --series
     That JSON is the deterministic series — your SOURCE OF TRUTH. Cite its numbers; NEVER
     recalculate them from the ledger (recalculating is a contract violation).
  2. read $TODO_FILE, CONTEXT.md and KAIZEN_LOG.md at the repo root
  3. read the kit history: git log --oneline -20
  4. read the artifact templates in $SDD_HOME/templates/
$lang_line
Your task in this session: $(phase_task "$step").

Write the verdict to $HANDOFF_DIR/<YYYYMMDD>-<slug>/05-verdict.md — frontmatter keys \`verdict:\`
(melhorou | piorou | indeterminado), \`kit_sha_judged:\` (the series' latest kit_sha, or "none"),
\`date:\`. If guard.sufficient is false the verdict IS indeterminado — the guard belongs to the
runner and you never override it. If the verdict is piorou, STOP after the verdict and its
escalation section: no plan is born from a regression. Otherwise triage $TODO_FILE and write
00-missao.md (with \`aprovacao:\` EMPTY — the human approves, never you), 01-plano.md and
checkpoint.md beside the verdict, from the templates.

$turn_rule

Write the artifacts to disk and commit. The runner re-evaluates the gate from outside — it reads
the files and the frontmatter. Your answer in text proves nothing and satisfies no gate. A
finding that does not fit this mission goes to $TODO_FILE, never to the diff.
EOF
    return 0
  fi
  [ -n "$slash" ] && printf '%s\n\n' "$slash"
  cat <<EOF
You are in phase $step of mission \`$MISSION\` in project \`$PROJECT_NAME\`${agent:+, as the agent $agent}.

All of your state comes from disk. There was NO earlier conversation — nothing was "agreed"
before. Read, in this order, before anything else:
  1. $HANDOFF_DIR/$MISSION/00-missao.md   (the intent and the metric)
  2. $HANDOFF_DIR/$MISSION/01-plano.md    (the how, and the context already verified — trust it)
  3. $HANDOFF_DIR/$MISSION/checkpoint.md  (the increment table)
  4. the most recent handoff in $HANDOFF_DIR/$MISSION/ (what already happened)
  5. .sdd/config.sh (TEST_CMD="$TEST_CMD"${E2E_CMD:+, E2E_CMD=\"$E2E_CMD\", E2E_DIR=\"$E2E_DIR\"})
  6. the artifact templates in $SDD_HOME/templates/ — start every artifact from the template that
     names it, NEVER from memory: their headings are the contract the gates parse
$lang_line
Your task in this session: $(phase_task "$step").
$(phase_extra "$step")
$turn_rule

Write the artifacts to disk and commit. The runner re-evaluates the gate from outside — it runs
the tests, checks the hashes in the git log, reads the files. Your answer in text proves nothing
and satisfies no gate. A finding that does not fit this mission goes to $TODO_FILE, never to the
diff.
EOF
}

PIPELINE_LOG=""
# The path this process has already complained about, so the warning below is one-shot per
# journal. Keyed on the PATH and not on a boolean: a reset would have to be maintained at each of
# the four sites that assign `PIPELINE_LOG`, and a marker maintained by its callers is the shape
# this kit keeps paying for — derived, the day a second journal is opened it announces itself.
PIPELINE_LOG_WARNED=""
DRY_RUN=0
# `--budget-override` (L2 of the 2026-09-03 audit): the human lifting the mission ceiling for ONE
# run. Global, like DRY_RUN, because the door that reads it (mission_budget_blown) is called from
# two commands. Noted as an intervention the first time it actually lifts something, never before.
BUDGET_OVERRIDE=0
BUDGET_OVERRIDE_NOTED=0
MISSION_BUDGET_PROJECTED=0

pipeline_log_line() {
  # The projection does not write to the journal. Precision matters here, because the easy
  # sentence ("dry-run touches nothing") is false: the gates run `TEST_CMD`/`E2E_CMD` for real
  # during the projection and write `.sdd/logs/<mission>/gate-*-test-*.log` — an explicit
  # decision of the plan. What `--dry-run` guarantees is narrower, and it is this: no `claude`
  # session is spent and no mission artifact is touched. Recording here an event that was only
  # PROJECTED lies in the audit trail, and in a freshly installed target repo (where `sdd
  # install` only ignores `.sdd/logs/`) the `pipeline.log` stays untracked and dirties the
  # working tree — a dirty tree fails `gate_REVIEW` and `sdd preflight`, meaning a projection
  # would knock down another phase's gate. The guard lives here, not in the callers, so it holds
  # for ALL of them: the escalation paths (checkpoint `blocked`, budget blown, two sessions with
  # no progress) are three, and a fourth added tomorrow would be born with the same defect.
  # Found by the QA phase of mission 20260814-dry-run-completo (F1).
  [ "$DRY_RUN" = "1" ] && return 0
  [ -n "$PIPELINE_LOG" ] || return 0
  # A JOURNAL WRITE CANNOT STOP THE LINE, and this is the guard's second tenant for the reason the
  # paragraph above already gives: it holds for EVERY caller, and the one added tomorrow is born
  # with it. ⚠️ THE CENSUS IS THE COMMAND, NEVER THIS SENTENCE. Both paragraphs of this block used
  # to name a count instead, and it was already wrong on the day r3 of `20260901-o-revisor-so-acha`
  # counted — the `44 caught of 44` rubric of CLAUDE.md cashing in right here, because a number
  # written into prose is stale at the next call site, not at the next release. Count, do not read:
  #     grep -cE '^ *pipeline_log_line "' bin/sdd                   # call sites, as statements
  #     grep -E '\$\(pipeline_log_line' bin/sdd | grep -cv '^ *#'   # substituted → must be 0
  # The second one drops comment lines DELIBERATELY: this block displays the forbidden spelling one
  # paragraph down, and the bare grep counts the display — the same one-too-many that rubric names.
  # Under `set -e` a failed redirection kills the shell AT THE REDIRECTION, so with the journal
  # unwritable — a `chmod`, a read-only mount, a full disk, a quota — every caller became a place
  # the runner dies. Two of them advertise the opposite in so many words: `review_scope_check` and
  # `kit_guard_check` are warnings that three pages of this kit describe as stopping nothing, and
  # the sister's trailing ASSIGNMENT does not save her — the shell is already gone one line up,
  # inside here. Measured end to end (regime 7 of the guard's block in tests/check-autonomy.sh):
  # with the journal at mode 000 the run died on run_phase's OWN session line, rc 1, no ledger row
  # and the scope guard never reached — one caller BEFORE the guard, which is why guarding the
  # guard's call site would have fixed the sentence and not the runner.
  #
  # ⚠️ The line is then LOST, and that is a third reason a `grep -c` over this journal answers 0 —
  # next to "the round behaved" and "the guard was not in the running process". The warning is what
  # keeps that from being silent; it is one-shot per journal path because two writes fail per run
  # here already, and a warning repeated per line trains its only reader to scroll past the run it
  # finally mattered on. CALLED at every site and SUBSTITUTED AT NONE (`$(pipeline_log_line …)`
  # would run this in a subshell and lose the flag, the scar `autonomy_kit_stamp` left) — and what
  # holds that property is the second census command above answering 0, never this sentence.
  #
  # THE SHAPE IS `autonomy_append`'s, two screens down, and copied rather than invented: that
  # function has carried `mkdir … || true` plus a guarded `>>` with a warn since it was written
  # ("a ledger the mission dies for is worse than a gap in the ledger"), and the journal — the
  # older writer of the two — never got it. One rule, one spelling, in both writers. The ONE
  # divergence is the one-shot above, and it is divergence with a number: this journal takes
  # several lines per session where the ledger takes one row, and the probe pins `journal:1` over
  # a run in which two writes fail.
  #
  # ⚠️ DECLARED, NO PROBE — and the world WAS built, so this is not "I could not imagine it":
  #  · THE `mkdir` ARM. Sabotaged (the `|| true` removed) the suite stays green, because the world
  #    it answers to is dominated by an earlier death: with `.sdd/logs` at mode 500 the run dies in
  #    `run_phase`'s own `mkdir` for the session's log directory, rc 1 and no ledger row, guarded
  #    or not — measured both ways. So this arm decides WHICH failure an operator reads on the day
  #    the directory becomes writable again between those two calls, never whether the run
  #    survives. It stays for that, and because `autonomy_append` carries the identical unprobed
  #    arm: removing one of two aligned writers' halves is how the spellings drift apart again.
  #  · KEYING THE ONE-SHOT ON THE PATH rather than on a boolean is unobservable today. The four
  #    sites that assign `PIPELINE_LOG` belong to four different `cmd_*`, and `main` dispatches one
  #    per process — no command in this file calls another, so no process opens two journals. It is
  #    written this way because the alternative needs a reset maintained at each of those four
  #    sites, and a marker its callers maintain is the shape this kit has already paid for.
  mkdir -p "$(dirname "$PIPELINE_LOG")" 2>/dev/null || true
  # ⚠️ `2>/dev/null` STANDS TO THE LEFT OF THE `>>`, and the order is the whole point: bash applies
  # redirections LEFT TO RIGHT, so with it on the right the shell's own complaint about the failed
  # `open` goes to an fd 2 that has not been redirected yet. That is r3 finding #1 of
  # `20260901-o-revisor-so-acha`: the curated one-shot below arrived escorted by one raw
  # `Permission denied` PER line, in the same stderr — the one-shot defeated in the only channel
  # its reader stands in. Measured both ways in a throwaway script: three calls, `2>` on the right
  # ⇒ 3 raw lines; on the left ⇒ 0, with this branch still firing. `autonomy_append` carries the
  # identical spelling, for the reason the paragraph above gives: one rule, one spelling, in both
  # writers. The sensor is regime 8 of the guard's block in tests/check-autonomy.sh, which breaks
  # BOTH files in one world so neither half can be closed alone.
  printf '%s\n' "$*" 2>/dev/null >> "$PIPELINE_LOG" || {
    if [ "$PIPELINE_LOG_WARNED" != "$PIPELINE_LOG" ]; then
      PIPELINE_LOG_WARNED="$PIPELINE_LOG"
      warn "the pipeline journal at $PIPELINE_LOG cannot be written — the run carries on, and every line it would have recorded from here on is lost"
    fi
    return 0
  }
}

# ---------------------------------------------------------------------------
# Autonomy ledger — the series the kaizen judge (I13.3) reads.
#
# It records FACTS only: attempts, whether the session moved the disk, rc, cost, the gate reason.
# No score. `ok|leve|refez` is a LABEL, and a runner that labels its own sessions is exactly the
# "label instead of artifact" every gate here exists to forbid — the judge derives the label from
# these facts, and can change its yardstick later without rewriting the past.
#
# Global on purpose (~/.sdd, not the target repo): "maturity across projects" cannot be measured
# in a per-repo file, and a file the runner writes BETWEEN phases inside the target repo would sit
# untracked and knock down gate_REVIEW and sdd preflight — the pipeline.log defect, fixed in
# 53cf63a by making that one ephemeral, a way out this ledger does not have because its whole
# point is to last.
AUTONOMY_RUN_ID=""
AUTONOMY_INVOCATION=""
AUTONOMY_WARNED=0
# Own one-shot flag, deliberately separate from AUTONOMY_WARNED (jq-missing): the two causes are
# unrelated, and one warning must not suppress the other — a repo with jq installed but the kit
# copied without .git still needs to hear about kit_sha:null, and vice versa.
AUTONOMY_SHA_WARNED=0

autonomy_log_path() { printf '%s/autonomy-log.jsonl' "${SDD_STATE_DIR:-$HOME/.sdd}"; }

# The repo a ledger row BELONGS to — one definition for the writer that stamps `repo` and for the
# three readers that filter on it. Not two spellings of the same question: writer and reader
# disagreeing about identity is a filter that silently excludes rows born in the repo you are
# standing in, which is exactly the defect below.
#
# `sdd autonomy` and `sdd kaizen --series` skip load_config on purpose (they answer a question
# about the LEDGER, not about a mission, and need no target configuration), so REPO_ROOT is still
# empty when they read and the identity has to be resolved from the cwd here. Deliberately NOT
# resolve_repo_root: that one dies, and dying is a worse answer than "nothing in this file is
# yours" for a command whose whole job is to report what the ledger holds.
#
# It is the shared `.git` and NOT `git rev-parse --show-toplevel`, because the toplevel is per
# WORKTREE: a mission run from `git worktree add` stamped a path the main checkout had never seen,
# and every reader outside that worktree counted the rows as `other_repo` — the series went empty
# in the isolation workflow this kit itself recommends. `--git-common-dir` is the same path from
# every worktree of one repo, and the three shapes it comes back in have to end at ONE string or
# the comparison the readers do (verbatim, no normalization on either side) is back to answering
# per worktree: RELATIVE at the root of a checkout (`.git`), relative in a subdirectory
# (`../.git`), absolute only from a linked worktree.
#
# `--path-format=absolute` (git 2.31+) is what collapses the three, and it replaced a hand-rolled
# `cd "$start" && cd "$common" && pwd -P` that needed a `CDPATH=''` guard on each `cd` to keep the
# ENVIRONMENT from answering "which repo is this". Asking git for the absolute path removes the
# class instead of guarding it: no cd, no pwd -P, no guard, nothing for a $CDPATH to redirect.
# Measured equal to the old spelling in all four shapes that matter — checkout root, subdirectory,
# bare repo, linked worktree — and through a symlinked path, where git resolves the link exactly as
# `pwd -P` did. The sensor is the differential pair in tests/check-autonomy.sh, which still runs a
# poisoned CDPATH at the runner and still demands two repos stay two, on one line each.
#
# ⚠️ Rows written BEFORE this carry the old per-worktree path and keep landing in `other_repo`.
# That is history, not a bug: the ledger is append-only and is never migrated.
ledger_repo_root() {
  local start="${REPO_ROOT:-$PWD}" gitdir
  # The identity IS the common dir, never its parent. `cd "$common/.."` was the first spelling and
  # it collapsed two repositories into one string in two shapes, both silently — `other_repo: 0`,
  # nothing excluded, nothing said, which is the very contamination the filter above exists to
  # report: in a SUBMODULE the common dir is `/parent/.git/modules/<name>`, so the parent is
  # `/parent/.git/modules` for EVERY submodule of that parent; in a BARE repo it is `.`, so the
  # parent is the directory that merely contains the repo, shared by every bare repo beside it.
  # `--show-toplevel` got both of those right and only worktrees wrong. The common dir gets all
  # three right, because it is the identity git itself keeps per repository.
  gitdir="$( git -C "$start" rev-parse --path-format=absolute --git-common-dir 2>/dev/null )" || return 0
  # ⚠️ ONE ABSOLUTE LINE, or this is not an answer — and the test is load-bearing on any git older
  # than 2.31, which is where `--path-format` was born. `git rev-parse` ECHOES a token it does not
  # recognize as an option straight back to stdout and still exits 0, so a pre-2.31 git answers TWO
  # lines here: the flag itself, then the common dir, still relative. `|| return 0` never fires (rc
  # is 0) and `-n` never fires (the string is not empty), so the first spelling of this guard let
  # `--path-format=absolute\n.git` through as the repository's IDENTITY — stamped into every ledger
  # row by `--arg repo`, newline and all, matching no reader and never migrated, because the ledger
  # is append-only.
  #
  # ⚠️ REFUSING is not enough, and returning empty here was a second defect wearing the first one's
  # clothes. Empty is the contract for "not a repo", so on git 2.25 (Ubuntu 20.04) and 2.30 (Debian
  # 11) EVERY row would be written `repo: ""`, every reader would file it under `no_repo` — a bucket
  # `--all-repos` deliberately does not admit — and `sdd autonomy` would answer "no data" while
  # `sdd kaizen` could only ever say `indeterminado`. Silent, permanent, and a REGRESSION: the
  # `cd`-based spelling this replaced answered CORRECTLY on those same gits.
  #
  # So the old spelling is the fallback, not the casualty. It is safe to keep now for the reason
  # that made it dangerous before: the `CDPATH=''` guards this mission added to the whole repo. The
  # fast path stays the one-shot `--path-format`; the slow path costs a second `rev-parse` and two
  # `cd`s, and only on a git that cannot do it in one. The sensor is the pre-2.31 differential pair
  # in tests/check-autonomy.sh, which asserts the two gits answer the SAME identity — not merely
  # that the new one does not leak.
  case "$gitdir" in
    /*) [ "$gitdir" = "${gitdir%%$'\n'*}" ] || gitdir="" ;;
    *)  gitdir="" ;;
  esac
  if [ -z "$gitdir" ]; then
    local common
    common="$( git -C "$start" rev-parse --git-common-dir 2>/dev/null )" || return 0
    [ -n "$common" ] || return 0
    # Relative at a checkout root (`.git`), relative in a subdirectory (`../.git`), absolute from a
    # linked worktree — `cd "$start"` first, then `cd "$common"`, resolves all three. Both `cd`s
    # carry the emptied CDPATH: with a relative operand the environment would otherwise pick where
    # this lands AND echo the path it found into the capture. That is the CRITICAL of
    # 20260817-eixo-do-juiz, and it is why this spelling was retired rather than deleted.
    gitdir="$( CDPATH='' cd "$start" && CDPATH='' cd "$common" && pwd -P )" || return 0
    [ -n "$gitdir" ] || return 0
    [ "$gitdir" = "${gitdir%%$'\n'*}" ] || return 0
  fi
  # Cosmetic, and ONLY cosmetic: `/repo/.git` prints back as `/repo`, so the ledger and the header
  # keep naming the root a human recognizes instead of a path inside `.git`. Injective, therefore
  # safe to collapse: exactly one repository can own `/repo/.git`. Withheld from a bare repo, whose
  # common dir is the repository itself and whose parent belongs to nobody.
  # ⚠️ The bare test is `core.bare` and NOT `rev-parse --is-bare-repository`, and the difference is
  # an identity split. `--is-bare-repository` answers about the ENTRY POINT, not the repository: for
  # a bare repo living in a directory named `.git` (`/x/.git`, the shape this very guard exists for)
  # it says `true` read from the repo and `false` read from a worktree of that same repo, so the
  # strip fired on one reading and not the other — measured, `/x/.git` and `/x`, one repository with
  # two identities, which is the defect the whole function exists to prevent. `core.bare` lives in
  # the config of the COMMON dir, so every worktree of a repository answers it the same way. Unset
  # (a repo some tool created without the key) reads empty and means not bare, the same direction
  # `!= "true"` already took.
  if [ "$( git -C "$start" config --bool --get core.bare 2>/dev/null )" != "true" ] \
     && [ "${gitdir##*/}" = ".git" ] && [ -n "${gitdir%/.git}" ]; then
    printf '%s' "${gitdir%/.git}"
  else
    printf '%s' "$gitdir"
  fi
}

# ONE definition of "this row was born in the repo I am standing in", spliced into every reader's
# jq program — the same rule that made is_escalation a single definition after the blocked/degraded
# pair was written out three times and the third copy stayed blind. Emitted as jq TEXT rather than
# evaluated per row in bash: a shell call per line would fork once per row, and — the reason that
# actually matters — a single definition is what lets mut_RUN_ledger_no_repo_filter prove that all
# the readers really go through it. Sabotage a call site and you have measured one call site.
#
# The ledger is global ON PURPOSE (one file per machine keeps cross-repo questions answerable); it
# is the READER that has to ask "mine?". Until it did, a `sdd run` in a /tmp fixture repo wrote
# three rows into the real ledger and the judge read `66% waste · 2 mission(s)` where the truth was
# `0% · 1` — the judge's own source of truth, contaminable by any test.
#
# A row that does not SAY where it came from cannot be attributed to any repo, and a filter that
# swallowed it in silence would be hiding corruption instead of reporting it. So it leaves the
# slice through a bucket of its OWN — `no_repo`, counted by every reader — and never through
# `other_repo`, which is a different accusation ("born elsewhere", not "born nowhere").
#
# ⚠️ This used to answer `true` for such a row: local in EVERY repo. The claim written here was
# that the readers classified them out loud anyway (one counting them `unrecognized`, the other
# dying naming the file), and for a row that is not an object at all that is still true — which is
# why THAT case is left alone below. For a well-formed session row it was false: `is_unrecognized`
# asks `.event`, never `.repo`. Three sessions naming no project walked into the slice and cleared
# the judge's floor of 3, measured in fixture — a guard moved by rows nobody can attribute, with
# nothing in the output saying so.
#
# `--all-repos` flips this ONE definition instead of adding a fourth spelling of the question to
# each reader: the flag reaching the predicate is the flag reaching every reader that an invocation
# carrying it can reach. ⚠️ NOT the post-pipeline reminder, whatever this said before — it is
# called from cmd_run alone, and `sdd run` has no --all-repos, so it always reads per repo. The
# twin of this comment in cmd_kaizen said the same false thing. It is a flag and not the default because
# the default is what got contaminated (d99a7fc) — but the ledger is one file per machine precisely
# so maturity stays comparable BETWEEN projects, and after the filter landed no reader could ask
# that question at all. Opt-in restores the cross-repo answer without restoring the contamination.
LEDGER_ALL_REPOS=0
ledger_row_is_local() {
  # Emitted alongside, never folded in: `no repo at all` and `some other repo` are two different
  # answers, each reader counts them into a bucket of its own, and `--all-repos` opens exactly one
  # of the two. A row that names no project is unattributable in every scope, so the flag does not
  # reach it — widening the question between projects is not the same as admitting rows that
  # belong to none.
  # `(.repo // "") == ""` and not `has("repo") | not`: the three shapes of "this row names no
  # project" are the key absent, the key present and null, and the key present and empty, and the
  # LAST is the one the writer produces — `autonomy_session_row` always passes `--arg repo "$repo"`
  # into `{… repo: $repo …}`, so the key is never missing and comes back `""` whenever
  # `ledger_repo_root` resolved nothing (a session run outside any git repo). Key-absent is the
  # shape the writer can never emit; it and the null arrive by hand edit or partial write, which is
  # precisely the corruption this bucket exists to report. All three are one answer here, which is
  # why the spelling covers them rather than testing for one. Under the old spelling
  # they fell through to `.repo == $repo` and were accused of being `other_repo` ("born elsewhere"),
  # a wrong reason printed with the confidence of a right one; and standing outside any git repo,
  # where $repo is itself empty, a `repo: ""` row compared EQUAL and was counted local in a repo
  # that does not exist.
  printf '%s' 'def ledger_row_no_repo: type == "object" and ((.repo // "") == "");'
  if [ "$LEDGER_ALL_REPOS" = "1" ]; then printf '%s' 'def ledger_row_is_local: ledger_row_no_repo | not;'; return 0; fi
  printf '%s' 'def ledger_row_is_local: if ledger_row_no_repo then false elif (type == "object" and has("repo")) then .repo == $repo else true end;'
}

# ONE definition of "what did this session DO", spliced into both readers of the ledger the same
# way ledger_row_is_local is — printed jq, received through `"$(ledger_outcome_defs)"`, never
# spelled twice. `stalled` used to be `moved == false` ("the session wrote nothing"), which is not
# "the phase did not advance": 68 of the 145 sessions in the real ledger wrote something, failed
# their gate and bought the runner another session, and no reader could see them — the human
# window said `0 stalled`, the judge said `ok`, on a phase of seven sessions and five refusals
# (20260825-frete-cif-fob, EXEC). Measured 2026-08-28, before this function existed.
#
#   advanced — the gate passed, OR the row says the increment count went down. The gate is the
#              artifact of the PHASE, and a phase of four increments only passes it on the last of
#              its four sessions — so `gate == pass` alone read the pipeline's DESIGNED loop as
#              waste. Measured on the real ledger 2026-08-29, the day after the three names above
#              landed: 46 of the 72 EXEC rows read `churned` where the real churn is about 5, and
#              49 of the 107 kit versions printed `100% waste`, each one a version whose only
#              session was a middle increment of some mission. The instrument had stopped
#              flattering (`0 stalled`) and started accusing — wrong in both directions.
#              (`pass/false` does not occur in the ledger and is classified here without a fourth
#              arm.)
#   churned  — the session wrote to the disk, closed no increment, and the gate still failed: the
#              runner reads "moved" as progress and buys the next lap. The bucket that was
#              invisible, now with the designed loop taken out of it.
#   idle     — nothing on disk, gate failed: the old `stalled`, under the name that says what it is.
#
# The progress arm carries a THIRD guard, `.moved != false`, and it is a tautology rather than a
# policy: `state_fingerprint` hashes the checkpoint, and closing an increment means editing the
# checkpoint, so a session whose fingerprint did not move cannot have lowered the count. It costs
# the field path nothing — a MEASURED pair with `moved: false` is unreachable — and it exists for
# the recovered path below, where `pending_before` is INFERRED from prose and an empty memory
# infers M, the largest value the field can take. That is right on the first row of a mission and
# wrong on the row after a passing gate: a phase that closed at `4 increment(s) done` and then
# reopened an increment reads `1 of 5`, is handed 5, and read `advanced` over a session that never
# touched the disk — `0% waste` on a session that did nothing, the flattering direction again, and
# the one place an inference outranked a measurement. Measured over the real ledger 2026-08-30
# before the guard: 53 recovered rows, 48 `advanced`, and the guard moves NONE of them, so it fixes
# the reachable hole without restating any history. `!= false` and not `== true`, because an
# escalation row carries no `moved` at all and must stay where both readers already file it.
#
# The other two guards are on BOTH fields being non-null, and they are load-bearing rather
# than defensive: jq orders `null` below every number, so `null < 2` is TRUE. gate_EXEC publishes
# `pending_after` only after it has validated the checkpoint, so a run it refused (a `done` with no
# commit) writes null there — and without the guard that refusal would read as the loudest possible
# progress, `4 → nothing left`. Measured by `a gate that published no pending_after is not an
# increment that advanced` in check-autonomy.sh.
#
# DECLARED, because it is a real edge this arm accepts: a session that closes the LAST increment
# over a red suite reads `advanced` on the count while its gate fails, and the lap it buys reads
# `churned`. That is the honest split — the increment did advance, and the gate is the artifact of
# the lap that follows. Rows written before 2026-08-29 carry neither field and fall through to the
# `moved` arm exactly as they did; I3 is what teaches the readers to recover their count from
# `gate_why`.
#
# THE ROUND ARM is the same fact for REVIEW, added 2026-08-31, and the reason it is a THIRD arm and
# not a generalisation of the second is that the two counts move in opposite directions: EXEC counts
# increments still to do and goes DOWN, REVIEW counts rounds already landed and goes UP. One arm
# reading "the number changed" would call a checkpoint that GREW — the fix increments QA writes —
# progress, which is the opposite of what it is.
#
# REVIEW is a loop by design too: REVIEW_MAX_ITER rounds, each landing its own `40-review-r<N>.md`.
# With `pending_after < pending_before` as the only progress the readers knew, an r1 that landed
# with real findings and did not reach Grade A read `churned` — the runner charging the phase for
# the refusal its own design schedules, which is letter for letter the defect the arm above closed
# for EXEC. Measured on window 2 (kit_sha bf001fe): the REVIEW of
# 20260830-a-tela-que-mente-o-pagamento is the most expensive cell of the whole slice, US$ 47.81,
# labelled `leve` off `1 advanced · 1 churned`, in the phase that consumes 41% of the spend.
#
# The non-null guard is reachable by a route the EXEC sibling does not have: `rounds_before` is a
# PHOTOGRAPH taken before run_phase, so a row born on a path that never took it carries null there
# while `rounds_after` carries a real count — and `2 > null` is TRUE. Without the guard that row
# reads as the loudest progress in the ledger, and `mut_RUN_review_rounds_photo_missing` (which
# produces exactly that shape) would stop moving the histogram at all. Measured by `a REVIEW row
# with no round before it is not a round that advanced` in check-kaizen.sh.
#
# ONE non-null guard here and TWO one arm up, and the asymmetry is the operand order, not an
# oversight. The EXEC arm puts the possibly-null `pending_after` on the LEFT of `<`, where jq's
# ordering makes `null < 2` TRUE; this arm puts the possibly-null `rounds_after` on the LEFT of `>`,
# where `null > 2` is FALSE — and with `rounds_before` already guarded, `.rounds_after != null` can
# change no row's outcome. Measured on jq 1.7 (`null > 5` => false, `null < 5` => true), and the
# sabotage pass agrees: written out, deleting it left the whole suite green, while deleting either
# guard of the EXEC arm kills an assertion. A rule no sabotage can break is redundant, so it is not
# here — CLAUDE.md. Swap the operands or flip the comparison and it comes back with them.
#
# Applied to the sessions each reader admits, and both admit a session only with `moved` present:
# cmd_autonomy's `comparable` has demanded `has("moved")` all along, and kaizen_series now files a
# session without it into `excluded.non_comparable` too — the same bucket, not a second one with
# the same name. (Measured before that fix landed: a session row with no `moved` field read
# on_axis in the series and non-comparable in the window, so a version of 2 comparable sessions on
# the human table came back 3 sessions on the judge, with the extra one always landing `idle`.)
# Never applied to escalation rows, which carry neither `gate` nor `moved` and would all read
# `idle`. Old-schema rows stay where they were.
# `outcome_tally` lives here and not in each program because its three keys ARE the enum, and an
# enum read in more than one place is one definition.
#
# `phase_index` reads the canonical phase order off $PHASES through `--arg phases`, so the order
# has ONE owner. Both readers pass `--arg phases "$PHASES"` even though only cmd_autonomy calls
# phase_index. Measured on jq 1.7: an unbound `$var` inside a def nobody calls COMPILES (`jq -n
# 'def f: $x; 1'` prints 1), so the arg is not strictly required there today — it is passed anyway
# because the emission is one and the day the series calls phase_index must not be the day it
# learns about the arg. (No apostrophe inside the printed jq: it is spliced into single-quoted
# shell strings.)
#
# `historic_progress` is the DATED path that lets `outcome` answer over rows written before the
# fields existed, and it is the second half of the same change. Added 2026-08-29; on that day the
# real ledger held 72 EXEC rows and 49 of them predate `pending_before`. Migrating them is not an
# option — the ledger is append-only by contract — and leaving them on the `moved` arm would have
# the human window reading `churned` over the whole history it exists to explain, for ever, since
# nothing will ever rewrite those lines.
#
# It recovers the SAME fact from the SAME source the fields come from: gate_EXEC has always written
# `N of M increment(s) still to execute` into GATE_WHY, and the row carries it verbatim. A row is
# annotated only when it is an EXEC session, `.pending_before` is null, and the prose matches — and
# the annotation carries `progress_source: "gate_why"` so the reading is never mistaken for a
# measurement. cmd_autonomy prints how many rows it reached, which is also the DELETION SIGNAL:
# the day `sdd autonomy --all-repos` stops printing that sentence, this def has no rows left to
# serve and comes out.
#
# `.pending_before == null` and NOT `has("pending_before")`: autonomy_session_row builds the object
# with `($pbefore | tonumber? // null)`, so the KEY is present on every row THIS runner writes, with
# the value `null` outside EXEC — `has` answers true for all of those and would annotate none of
# them. The rows written BEFORE the fields existed carry no key at all, so `has` is wrong about them
# in the other direction. `== null` is the one spelling that covers both. Measured 2026-08-30 over
# the real ledger, and the earlier version of this comment had the fact backwards — it claimed the
# 49 historical rows carried the key, when `grep -c pending_before ~/.sdd/autonomy-log.jsonl`
# answered 0 over all 158 of them. The choice was right; the reason recorded for it was not.
#
# `pending_before` is the `pending_after` of the previous EXEC row of the same (repo, mission) in
# FILE order, which is write order, with two rules — each with a fixture of its own in
# check-autonomy.sh, because a rule whose removal no fixture notices is a rule with no probe:
#   · a changed M is a new denominator (QA wrote fix increments, so the phase grew): count from M;
#   · a PASSING gate clears the memory, so a session that reopened an increment is measured against
#     M and not against the count from before the phase closed.
# The memory is fed by rows that carry the FIELDS too, and that is load-bearing on a mixed ledger:
# a mission whose first sessions are new-schema and whose later ones are not would otherwise read
# its first old row against M instead of against the row above it.
# The key is `[repo, mission] | tostring` — an ARRAY rendered as JSON, for the reason mission_key
# states in both readers: a separator chosen here would collide with one inside a repo path.
#
# `historic_rounds` is the same second half for REVIEW, added 2026-08-31, and it exists for the
# same reason measured over the same file: on that day the real ledger held 25 REVIEW rows and ZERO
# of them carried `rounds_before`. Without it the round arm above serves nothing but rows written
# from here on, and the whole REVIEW history the window exists to explain stays on the `moved` arm
# reading `churned` for ever.
#
# It recovers the SAME fact from the SAME source the field comes from: gate_REVIEW writes the round
# file's own name into GATE_WHY, so the row carries `40-review-r<N>.md` verbatim, and the `N` is
# STRUCTURAL — it is the file name resolved by `latest_matching`, not a number anybody declared.
# Two spellings, and the second is not a special case but the zero: the fixed string
# `no 40-review-r<N>.md` means the session landed no round file at all, and it recovers 0 — where
# `<N>` is not a digit, so the anchored regex separates the two with no ambiguity. Measured over
# the real ledger: 24 of 25 rows reachable, the one that is not being a `TEST_CMD failed` refusal.
# DECLARED LIMIT, and it is the honest half of the same fact: two of gate_REVIEW's eight refusals
# name no file (`TEST_CMD failed`, `working tree dirty after the review`), and those rows are left
# where they were rather than guessed at.
# DECLARED, no probe: the `^` of the two regexes. The sabotage pass of 2026-08-31 unanchored the
# `test` and the whole suite stayed green, and the world it would take to make that matter is one no
# gate_REVIEW writes today — a `gate_why` naming `40-review-r<N>.md` somewhere other than its first
# character. That is the world I could not build, NOT a claim that none exists, and the anchor stays
# because it decides WHICH failure a future one produces: `test` alone unanchored, with `capture`
# still anchored, makes `capture` return nothing and `null | tonumber` kills the reader outright.
# The `test` itself is NOT redundant and does have a probe — replacing it with `true` makes `capture`
# emit empty on a non-matching row, and empty inside the `as $n` binding DROPS the row: 7 assertions
# in check-autonomy.sh die, the bucket sums among them. `rounds_max` is not recovered at all — it is
# REVIEW_MAX_ITER, a config constant that appears nowhere in the prose, and `outcome` does not read
# it; a recovered row carries the round it landed and no ceiling to read it against.
#
# THE GUARD IS TWO CONDITIONS, `.rounds_before == null AND .rounds_after == null`, and the second is
# where this def deliberately does NOT copy its EXEC sibling. A row carrying `rounds_after` with a
# null `rounds_before` is not pre-schema — it is a row this runner wrote whose PHOTOGRAPH went
# missing, which is exactly the shape `mut_RUN_review_rounds_photo_missing` produces and exactly
# what the non-null guard in `outcome` exists to catch. Repairing it from prose would launder the
# sabotage and leave that mutant scoring a point for nothing. It is also the measured harm the EXEC
# sibling already paid for once and fixed at the WRITER (see the `:-$exec_before` comment in
# cmd_retry): a retry born with `pending_before: null` was annotated by `historic_progress`, handed
# a fabricated count, and read `advanced` over a retry that advanced nothing.
# `== null` and not `has(...)`, for the reason spelled out for the EXEC sibling above: the key is
# on every row this runner writes and absent from every row written before the fields existed.
#
# `rounds_before` is the `rounds_after` of the previous REVIEW row of the same (repo, mission) in
# FILE order, seeded at 0 — and 0 is a MEASUREMENT, not a fallback: a fresh mission dir holds no
# `40-review-r*.md`, so the first REVIEW session of a mission genuinely starts at zero rounds. The
# repo filter runs before this path and a mission belongs to one repo, so the filter cannot truncate
# a mission's history and leave the seed reading a middle row as a first one. A hand-truncated
# ledger can; that is the same declared edge the EXEC sibling's empty memory has, behind the same
# `.moved != false` guard in `outcome`.
#
# NEITHER of the EXEC memory rules is inherited, and that is a decision with a world behind it:
#   · no `M`-changed rule, because there is no M in the prose — the ceiling is config, not disk;
#   · NO RESET ON A PASSING GATE, which is the one that looks like an oversight and is not.
#     EXEC's memory clears on a pass because `pending` resets to M when a closed phase is reopened.
#     REVIEW rounds do the opposite: `review_rounds_on_disk` counts FILES, files are never deleted,
#     and cmd_run deliberately does not reset the ceiling against them. So the count carries ACROSS
#     a pass, and copying the reset over would be a fail-open in the flattering direction — r1
#     passes, the phase is reopened, a session spins on the same r1, and a cleared memory reads
#     `1 > 0` as the loudest progress in the ledger over a session that landed nothing. The world
#     that proves it is the `m10` fixture of the `memory rules of the dated REVIEW path` block in
#     check-autonomy.sh, which goes red the day somebody "restores" the symmetry.
# The memory is fed by rows that carry the FIELD too (`$row.rounds_after`, which is the annotation
# on a recovered row and the written value on a new-schema one), and that is load-bearing on a
# mixed ledger for the same reason it is one screen up.
#
# DECLARED LIMIT, and it is declared rather than filed because the write order forbids it: a
# `gate_pass` row does NOT clear `historic_progress`'s memory, because it carries no `.gate` and
# the reset arm reads `$r.gate == "pass"`. A free EXEC closure therefore leaves `.seen[$k]` stale
# and the next dated-path row computes `pending_before` off it instead of `increments_total`.
# Measured (r2 of 20260831-a-rodada-que-andou): the same history reads `2 advanced · 1 churned`
# with the closure and `4 advanced · 0 churned` when the same closure is bought with a session.
# It is unreachable by construction, not merely unobserved: the dated path only annotates rows
# whose `pending_before` is null, which since 2026-08-29 means rows written BEFORE that date, and
# `gate_pass` was born on 2026-08-31 — no writer can put a dated-path row AFTER a closure. Kept as
# a limit here, by the D15 rule, instead of a backlog line pointing at a world nothing can build.
# The fix if a future writer ever makes it reachable: reset the memory on `is_gate_pass` too.
ledger_outcome_defs() {   # printed jq, spliced into cmd_autonomy AND kaizen_series
  printf '%s' 'def outcome: if .gate == "pass" then "advanced" elif (.pending_before != null and .pending_after != null and .pending_after < .pending_before and .moved != false) then "advanced" elif (.rounds_before != null and .rounds_after > .rounds_before and .moved != false) then "advanced" elif .moved == true then "churned" else "idle" end;'
  printf '%s' 'def historic_progress: reduce .[] as $r ({seen: {}, out: []}; (if ($r | type) == "object" and $r.event == "session" and $r.phase == "EXEC" then ([($r.repo // ""), ($r.mission // "")] | tostring) else null end) as $k | (if $k != null and $r.pending_before == null and (($r.gate_why // "") | test("^[0-9]+ of [0-9]+ increment")) then (($r.gate_why // "") | capture("^(?<n>[0-9]+) of (?<m>[0-9]+) increment") | {n: (.n | tonumber), m: (.m | tonumber)}) else null end) as $p | (if $p == null then $r else (if (.seen[$k] != null and .seen[$k].m == $p.m) then .seen[$k].p else $p.m end) as $before | $r + {pending_before: $before, pending_after: $p.n, increments_total: $p.m, progress_source: "gate_why"} end) as $row | .out += [$row] | (if $k == null then . elif $r.gate == "pass" then .seen[$k] = null elif $row.pending_after != null then .seen[$k] = {p: $row.pending_after, m: $row.increments_total} else . end)) | .out;'
  printf '%s' 'def historic_rounds: reduce .[] as $r ({seen: {}, out: []}; (if ($r | type) == "object" and $r.event == "session" and $r.phase == "REVIEW" then ([($r.repo // ""), ($r.mission // "")] | tostring) else null end) as $k | (if $k != null and $r.rounds_before == null and $r.rounds_after == null then (($r.gate_why // "") | if test("^40-review-r[0-9]+\\.md") then (capture("^40-review-r(?<n>[0-9]+)\\.md") | .n | tonumber) elif test("^no 40-review-r<N>\\.md") then 0 else null end) else null end) as $n | (if $n == null then $r else $r + {rounds_before: (.seen[$k] // 0), rounds_after: $n, rounds_source: "gate_why"} end) as $row | .out += [$row] | (if $k == null then . elif $row.rounds_after != null then .seen[$k] = $row.rounds_after else . end)) | .out;'
  printf '%s' 'def outcome_tally: map(outcome) | reduce .[] as $o ({advanced: 0, churned: 0, idle: 0}; .[$o] += 1);'
  printf '%s' 'def phase_index: . as $p | ($phases | split(" ")) | index($p);'
}

# Publishes AUTONOMY_KIT_STAMP as "<sha>|<true|false>", or "|" when SDD_HOME is not a git checkout.
# This is the judge's before/after axis: without it, a change in the numbers gets attributed to the
# calendar instead of to the kit change that caused it.
#
# An out-param global and NOT a printed value, for the same reason run_phase publishes LAST_PHASE_*:
# read through `stamp="$(autonomy_kit_stamp)"`, the whole body would run in a SUBSHELL, and the
# `AUTONOMY_SHA_WARNED=1` below would die with it — the flag would be back to 0 on the next row and
# the one-shot warning would fire once per ledger row, which is the opposite of what it says. A
# guard that cannot hold is worse than no guard: it reads as measured and is not.
AUTONOMY_KIT_STAMP=""
autonomy_kit_stamp() {
  local sha
  sha="$( git -C "$SDD_HOME" rev-parse --short HEAD 2>/dev/null || true )"
  if [ -z "$sha" ]; then
    # Someone installed the kit as a plain copy, not a git checkout: every row born from here
    # gets kit_sha:null and is permanently EXCLUDED from the judge's comparable-sessions count —
    # not a crash, just months of silently non-comparable data. One-shot per process so it does
    # not repeat on every row of a long-running `sdd run`.
    [ "$AUTONOMY_SHA_WARNED" = "1" ] \
      || warn "$SDD_HOME is not a git checkout — autonomy rows get kit_sha:null and stay non-comparable forever"
    AUTONOMY_SHA_WARNED=1
    AUTONOMY_KIT_STAMP="|"; return 0
  fi
  if [ -n "$( git -C "$SDD_HOME" status --porcelain 2>/dev/null )" ]
  then AUTONOMY_KIT_STAMP="$sha|true"
  else AUTONOMY_KIT_STAMP="$sha|false"; fi
}

# ---------------------------------------------------------------------------
# The kit is not the target repo, and a target-repo session has no business editing it.
#
# Measured on 2026-08-25: an EXEC session whose mission was another repo entirely committed a kit
# finding straight into this kit's `main` (2d28d13). The kit's suite went red, and the ledger rows
# of that very run stamped the sha of the commit the run had just made — the instrument recording
# a kit version that existed only because the run created it. Two causes; this is the half that
# lives in the runner. The other half is the instruction, which named the DESTINATION of a kit
# finding and never said how to get it there.
#
# WARN AND RECORD. It never stops the line, and that is a decision with a named cost on both
# sides: a human editing the kit in another terminal while a mission runs is a real, legitimate
# false positive, and a guard that halts a paid pipeline on one is a guard the next author
# disables — after which it catches nothing at all.
#
# DECLARED LIMITS, so nobody reads this as more than it is:
#   - it is NOT a security boundary. A session that commits and then resets inside the same phase
#     leaves the before/after pair identical and walks past. The guard makes the CAUSE visible; it
#     does not police it.
#   - ledger rows born after a divergence still carry the sha of the run's own commit. The guard
#     does not re-attribute them — the KIT-TOUCHED line is what lets a human reading those rows
#     later know why they say what they say.
#   - an INHERITED `GIT_DIR` in the environment (a git hook, `git rebase --exec`) makes
#     `git -C "$SDD_HOME" rev-parse --short HEAD` answer that repository's HEAD rather than the
#     kit's, so every commit the session makes in the target repo would read as the kit moving.
#     Measured, and left declared rather than guarded: the kit_root probe answers non-empty in that
#     world too, so there is no cheap test that separates it, and the failure direction is a warn
#     nobody can act on — not a silent miss. `sdd` is not run from hooks today.
#
# FOUR CALL SITES, and the arm/check pair is placed by hand at each because the check has an
# ordering constraint run_phase cannot satisfy (see cmd_run: `moved2` must be sampled before the
# check writes anything). cmd_run has two, cmd_retry one, cmd_close one — every path in this file
# that opens a `claude -p` session able to commit. A fifth added tomorrow is born unguarded, which
# is the shape this file otherwise refuses; it is paid for with a probe per site instead
# (tests/check-autonomy.sh, kit-guard regimes 1, 4, 5 and 7), so a site added without one is a site
# whose deletion no assertion notices.
KIT_GUARD_BEFORE=""

# Called, never substituted. `$(kit_guard_arm)` would run the body in a subshell where the
# assignment to KIT_GUARD_BEFORE dies with the substitution, leaving the baseline empty forever —
# which kit_guard_check reads as "disarmed" and skips, so the guard would be silently off while
# every line of this comment still claimed it was on. That is the exact scar autonomy_kit_stamp
# above carries, and the reason it is written down twice.
kit_guard_arm() {
  # THE PROJECTION IS DISARMED, and the earlier round of this work got it wrong in the other
  # direction — the reasoning is written out because the wrong version also sounded measured.
  # It argued that a projection opens no session, so no window exists and no sabotage could turn a
  # probe red. The window was never the point: `autonomy_kit_stamp` is reached from NOWHERE ELSE
  # during a dry run (`autonomy_append` returns early on DRY_RUN, and the row builders sit past the
  # projection's own return in cmd_run), so arming it made `sdd run --dry-run` inherit that
  # function's one-shot warning — "$SDD_HOME is not a git checkout, autonomy rows get kit_sha:null"
  # — printed over a projection that writes no rows at all. Measured on 2026-08-25 against a
  # plain-copy kit: 0 such warnings on the previous version of this file, 1 on the armed one. The
  # probe that "could not go red" is regime 6 of the kit-guard block in tests/check-autonomy.sh,
  # and it is differential: the same kit and the same repo in a REAL run must still warn.
  #
  # HERE and not in kit_guard_check, on purpose: the empty baseline is the disarmed state the check
  # already knows how to read, so one return covers both halves — and the `[ -n "$KIT_GUARD_BEFORE" ]`
  # line below stops being a branch no call site can reach. Cleared rather than left alone because
  # this is the state the check reads: a baseline that survived from somewhere else would make the
  # projection compare against a sample no phase of this run ever took.
  if [ "$DRY_RUN" = "1" ]; then KIT_GUARD_BEFORE=""; return 0; fi
  autonomy_kit_stamp
  KIT_GUARD_BEFORE="$AUTONOMY_KIT_STAMP"
}

# kit_guard_check <phase> — one warn and one journal line per DIVERGENCE, never per session.
kit_guard_check() {
  local phase="${1:-}" kit_root kit_after
  # DISARMED, and it is the projection that gets here that way — kit_guard_arm clears the baseline
  # under DRY_RUN and this is the line that reads the clearing. It is also the honest answer for an
  # arm that ran inside a subshell that ate the assignment: say nothing, rather than compare against
  # an empty string and accuse every phase of every run on the machine.
  #
  # Two probes, and they pull in opposite directions, which is what makes the line a decision rather
  # than a spare `if`: regime 6 (projection) reads the DRY_RUN clearing through it, and the subshell
  # scar is caught either way — with the line, an arm read through `$( )` makes the guard go SILENT
  # and the incident regime goes red; without it, the same scar accuses every clean session and the
  # control regime goes red instead. Silence is the one that does not train a reader to ignore warns.
  [ -n "$KIT_GUARD_BEFORE" ] || return 0
  # No `[ -n "$kit_root" ] || return 0` here either, and again the absence was measured. A kit
  # installed as a plain copy rather than a checkout has no shas to compare — but autonomy_kit_stamp
  # answers the constant "|" for it, so both samples are equal and the guard is already silent by
  # the comparison below. Deleting the guarded branch was the honest move: no sabotage of it could
  # turn a probe red, which is this repo's definition of a rule that is decoration.
  kit_root="$( git -C "$SDD_HOME" rev-parse --show-toplevel 2>/dev/null || true )"
  # A mission whose target IS the kit edits the kit for a living. Warning there would fire on every
  # phase of every kit mission and train the only reader it has to scroll past it — so that when it
  # finally fires on the run that matters, nobody is reading.
  [ "$kit_root" = "$REPO_ROOT" ] && return 0
  autonomy_kit_stamp; kit_after="$AUTONOMY_KIT_STAMP"
  [ "$kit_after" = "$KIT_GUARD_BEFORE" ] && return 0
  warn "the kit at $kit_root changed during $phase, and this mission's repo is $REPO_ROOT — a session that edits the kit is committing outside its own mission (if that was you working on the kit in another terminal, this is that)"
  pipeline_log_line "$(date -Iseconds)  KIT-TOUCHED  $phase  kit_before=$KIT_GUARD_BEFORE  kit_after=$kit_after"
  # Re-armed on the new value, so one divergence is reported ONCE. Left un-rearmed, every later
  # phase of the run would compare against the original baseline and repeat the same warning to
  # the end of the pipeline.
  KIT_GUARD_BEFORE="$kit_after"
}

# review_scope_check <phase> <head before the session> — the REVIEW half of the same idea.
#
# Since 20260901-o-revisor-so-acha the reviewer is READ-ONLY over the code: it reproduces, grades
# honestly, and turns every finding that must be fixed into an `R<n>` increment the EXEC phase
# closes in a session of its own. The prompt is what ASKS for that; this is what MEASURES it. A
# session that carried the whole review in its context and then fixed inside itself is the cost
# this mission exists to delete, and it leaves exactly one trace: a commit touching code.
#
# A WARN AND A JOURNAL LINE, never a boundary — the same call the kit guard makes, for the same
# reason. The reviewer that edits a file has already spent the money; refusing the session here
# would throw away the round report along with it, which is strictly worse than saying so out loud.
#
# THREE CALL SITES, placed by hand for the ordering constraint kit_guard_check documents above:
# cmd_run's first pass, cmd_run's inline retry (with the FIRST pass's head — the retry is reached
# only when nothing moved, so that head is still HEAD when the retry starts), and cmd_retry.
# `cmd_close` is the kit guard's fourth door and deliberately not a fourth here: it runs with
# `phase=CLOSE`, and the first line below answers only to REVIEW. One probe per door, in the
# `== the REVIEW scope guard ==` block of tests/check-autonomy.sh.
#
# ⚠️ DECLARED LIMITS:
#  · A `grep -c REVIEW-EDITED-CODE <log>` ANSWERING 0 IS NOT EVIDENCE THAT THE ROUND BEHAVED. It
#    says "no line was written", and the loudest way to write no line is for this function not to
#    exist: bash parses a definition when it reads past it, so a function that was not in the file
#    at read time is not in the process. (The entrypoint guard on the last line of this script is
#    the neighbouring scar — it stops bash re-reading a file the run itself edited — and neither
#    guard puts a function into a process that started without it.) So a `sdd run` process that
#    predates this guard runs the bin/sdd it parsed at startup, and a mission whose OWN EXEC phase
#    lands the guard is measured by a runner in which the guard is absent. Not hypothetical: on
#    20260901-o-revisor-so-acha the conducting `sdd run` started 17:56:48 and c8c8ec7 — the commit
#    that created this function — landed at 18:58:11, so that mission's REVIEW round reads 0 for the
#    wrong reason. What CAN be computed after the fact is the round's own diff, which is what
#    docs/pipeline.md now teaches to cite. Closing the window for real (comparing bin/sdd's hash at
#    entry and warning, or stopping) is a behaviour change that can fail a healthy mission in
#    flight: a human decision, recorded in that mission's round report, not something this header
#    can fix. Declared, not solved.
#  · it reads COMMITS, not the working tree. A reviewer that edited a file and left it uncommitted
#    is invisible here — and also invisible to the gate, which demands a clean tree, so the run
#    stops for a different reason.
#  · `commit --amend` on the head the session started from leaves `<before>` UNREACHABLE BUT STILL
#    READABLE, and the difference is the whole bullet. The object stays in the ODB until something
#    prunes it, so `git diff <before> HEAD` exits 0 with the right list and this guard WARNS
#    correctly. Measured in a throwaway repo, both halves: `merge-base --is-ancestor <before> HEAD`
#    answers 1 (gone from the graph) while `diff --name-only <before> HEAD` answers 0 and names the
#    file. The world where the capture really does come back empty is the one AFTER that object is
#    dropped — `git reflog expire --expire=now --all && git gc --prune=now`, measured in the same
#    repo: `git diff` exits 128 with `fatal: bad object`, the `|| true` below swallows it, and this
#    function says nothing rather than accusing a session over a diff it could not compute. That is
#    the world this author could build by hand; whether a real mission reaches it between the
#    session's first commit and this call — a gc has to run in that window — is NOT measured here.
#  · THE PROJECTION reaches this function — the call sits above cmd_run's DRY_RUN branch, next to
#    kit_guard_check's — and is silent BY CONSTRUCTION rather than by a guard of its own:
#    `run_phase` returns before opening a session under DRY_RUN, so both heads are the same commit
#    and the diff is empty. Unlike `kit_guard_arm`, nothing here is reached from nowhere else
#    during a projection, so there is no warning for a dry run to inherit. That is the world this
#    author could build; a `DRY_RUN` early return would be a rule no sabotage of mine turns a probe
#    red, which d4deb35 is the scar for asserting too confidently.
#  · THE `tests/health-baseline.txt` ARM IS UNCONDITIONAL. Its comment below scopes it "in the
#    kit's own repo", but nothing in the code asks whether this repo IS the kit: a target repo that
#    happens to carry that path gets a reviewer's edit to it waved through in silence. It is the
#    allowlist's one FAIL-OPEN, it is narrow (one exact path, in a guard that only warns), and it
#    is written here rather than left implied because a limit nobody declared is the thing this
#    whole header exists to separate from a limit that is known. Conditioning it on
#    `kit_root = REPO_ROOT` is a behaviour change with no probe today; declared, not guessed.
#  · `core.quotePath=false` BUYS BACK THE NON-ASCII NAME AND NOT EVERY NAME. Measured in a scratch
#    repo: with it, a path holding a byte >= 0x80 comes out literal, while one holding a double
#    quote or a backslash is STILL C-quoted by git, as is any path holding a control character or a
#    newline. Such a path inside the mission directory would still be counted as outside it and
#    warned about. That world was NOT built here: the fix is one flag, while the residue needs `-z`
#    with a NUL split, which `changed="$( … )"` cannot carry (command substitution drops NUL bytes)
#    and which would rewrite the read loop for a filename nobody has typed yet. Declared, not
#    solved.
#  · ONLY TRAILING SLASHES are normalised out of `$HANDOFF_DIR` below, because that is the spelling
#    that was reproduced and the one regime 5 of check-autonomy.sh holds. A leading `./`, a `//` in
#    the middle, or an absolute `$HANDOFF_DIR` would each miss the same way and none has a probe —
#    a rule written for a world this author did not build would be exactly the over-confidence the
#    bullet above is the scar for.
review_scope_check() {
  local phase="${1:-}" before="${2:-}" head_now changed f outside="" n=0 mission_dir
  [ "$phase" = "REVIEW" ] || return 0
  # `-` is what state_fingerprint answers for a path with no git, and the empty string is what a
  # caller that forgot the argument would pass. Neither is a commit this can diff against.
  [ -n "$before" ] && [ "$before" != "-" ] || return 0
  head_now="$( git -C "$REPO_ROOT" rev-parse HEAD 2>/dev/null || echo "-" )"
  [ "$head_now" != "-" ] && [ "$head_now" != "$before" ] || return 0
  # `|| true` because `set -e` kills the shell AT THE ASSIGNMENT when git refuses — and it still
  # earns its place after the amend bullet above was corrected: the world where git refuses is the
  # PRUNED one (`bad object`, rc 128, measured), not the amend itself, which answers fine. A runner
  # that died on a question it could not answer would turn a warning into an outage.
  #
  # `-c core.quotePath=false` because the allowlist below matches STRINGS git wrote, and with that
  # key on — GIT'S OWN DEFAULT — a tracked path holding one byte outside ASCII comes back C-quoted
  # and octal-escaped: a mission artifact named in pt-BR, in a repo whose OUTPUT_LANG is pt-BR,
  # arrives as `"docs/handoffs/<mission>/relat\303\263rio.md"`. It opens with a `"`, so it matches
  # no arm, and the round's own report reads as code. On the command line and not `git config`, so
  # it holds whatever the target repo set. Regime 6 of the guard's block in
  # tests/check-autonomy.sh, with the escaped spelling as its floor.
  changed="$( git -C "$REPO_ROOT" -c core.quotePath=false diff --name-only "$before" "$head_now" 2>/dev/null || true )"
  # THE TWO SIDES OF THE MATCH BELOW COME FROM DIFFERENT WORLDS, and this line is what makes them
  # comparable: `git diff --name-only` prints a path git has already normalised, while
  # `$HANDOFF_DIR` arrives VERBATIM from the target repo's .sdd/config.sh and is never normalised
  # anywhere else in this runner. `HANDOFF_DIR="docs/handoffs/"` — a spelling nothing forbids or
  # documents against — would make the pattern `docs/handoffs//<mission>/*`, which matches no path
  # git ever prints: the round's OWN report reads as code and the guard warns on every healthy
  # round, which is precisely the noise the allowlist exists to prevent. A LOOP and not
  # `${HANDOFF_DIR%/}`, which strips exactly one slash and leaves `docs/handoffs//` broken.
  mission_dir="$HANDOFF_DIR"
  while [ "${mission_dir%/}" != "$mission_dir" ]; do mission_dir="${mission_dir%/}"; done
  mission_dir="$mission_dir/$MISSION"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      # The three paths the new contract expects a round to touch: its own mission directory (the
      # report and the checkpoint the `R<n>` lines go into), the backlog file, and — in the kit's
      # own repo — the ratchet that backlog moves. Flagging these would fire on every healthy
      # round and train the guard's only reader to scroll past it.
      "$mission_dir"/*) continue ;;
      "$TODO_FILE") continue ;;
      tests/health-baseline.txt) continue ;;
    esac
    n=$(( n + 1 ))
    outside="${outside:+$outside }$f"
  done <<< "$changed"
  [ "$n" -gt 0 ] || return 0
  warn "the $phase session committed $n file(s) outside its mission directory — the reviewer finds and the executor fixes, so a finding belongs in the checkpoint as an R<n> increment: $outside"
  # ⚠️ THE ABSENCE OF THE LINE BELOW IS NOT A MEASUREMENT. Counting this marker in the log answers
  # 0 both when the round behaved and when this function never ran — a `sdd run` process that
  # predates this guard carries the bin/sdd it parsed at startup, and never calls it. First bullet
  # of the DECLARED LIMITS above, with the mission it was measured on; the evidence that survives
  # that window is the round's own `git diff --name-only <head the session opened with> HEAD`.
  # THIRD reading of that 0, since the r2 of the same mission: a journal that could not be written.
  # That one is announced — `pipeline_log_line` warns once naming the file — because the write no
  # longer stops the line, and a dropped line nobody was told about is the fail-open this whole
  # header exists to separate from a limit that is known.
  pipeline_log_line "$(date -Iseconds)  REVIEW-EDITED-CODE  $phase  $n file(s) outside the mission directory: $outside"
}

# ONE definition of "this path is a throwaway checkout" — ADR 0005, part 3.
#
# ⚠️ DECLARED LIMITS, and they are exactly why this is a ratchet against the leak that actually
# happened and never a boundary:
#  · it is a PATH heuristic. It knows $TMPDIR and /tmp. macOS hands out /var/folders/…, /var/tmp
#    is a temp directory it does not know, and a fixture built anywhere else walks straight past
#    it. What covers the miss is part 2: the composition of the slice makes a contaminating repo
#    VISIBLE in the series the judge reads. The two ship together and neither is sufficient alone.
#  · it says nothing about a WORKTREE under /tmp of a real repository, on purpose. The caller
#    hands it `ledger_repo_root`, which is the shared `.git` of the repository and not the
#    checkout the session runs in, so `git worktree add /tmp/x` of a real repo keeps writing —
#    the isolation workflow this kit recommends is not the leak this guard is about.
# No glob metacharacter can escape from $TMPDIR into the pattern: it is quoted, so `case` reads it
# as a literal string rather than as a pattern the environment gets to write.
ledger_repo_is_temp() {   # ledger_repo_is_temp <path> — 0 when it sits under a known temp root
  local repo="${1:-}" tmp="${TMPDIR:-}"
  [ -n "$repo" ] || return 1
  case "$repo" in /tmp/?*) return 0 ;; esac
  # Trailing slashes stripped one at a time: TMPDIR="/var/tmp/" has to answer about the same root
  # as TMPDIR="/var/tmp", and `${tmp%/}` alone leaves "/var/tmp//" one slash short.
  while [ "$tmp" != "${tmp%/}" ]; do tmp="${tmp%/}"; done
  # A TMPDIR of "/" would make every path on the machine a throwaway checkout, and an empty one
  # names nothing. Both mean the same here: this arm has nothing to say.
  case "$tmp" in ''|/) return 1 ;; esac
  case "$repo" in "$tmp"/?*) return 0 ;; esac
  return 1
}

# EVERY row goes through here, so every guard holds for every caller. The guards do NOT live in
# the callers: the journal already paid that lesson — there are three escalation paths, and a
# fourth added tomorrow would be born with the defect.
autonomy_append() {   # autonomy_append <one json object, already built>
  # The projection must not write. Worse here than in the journal: a projected row does not just
  # lie in an audit trail, it enters the judge's arithmetic and shifts the metric forever.
  # NOTE: written as an `if` on purpose, not the journal's `&&`-form guard. The journal's exact
  # guard text is the unique sed anchor of mut_RUN_inverted_journal in the mutation catalogue;
  # reusing that text here would make the mutation sabotage two guards at once and stop measuring
  # what it claims to.
  if [ "$DRY_RUN" = "1" ]; then return 0; fi
  # Every caller builds its argument with `jq -cn` inside a command substitution. A jq failure
  # there yields an empty string, and swallowing it here in silence would leave a gap in the
  # ledger that JSONL gives no way to detect afterwards — the mission goes on, same as the
  # unwritable-file guard right below, so it gets the same warn.
  [ -n "${1:-}" ] || { warn "autonomy ledger row came out empty (jq failed to build it?) — the mission goes on, the row is lost"; return 0; }
  # ADR 0005, part 3 — the real ledger is refused to a checkout that lives under a temp root.
  # HERE and not in the callers, for the reason the header of this function already gives: every
  # row goes through this door, so a writer added tomorrow is born guarded.
  #
  # `die`, and not the `warn`-and-carry-on the two guards below use, because this is a REFUSAL and
  # not an I/O failure. A full disk costs a gap in the ledger; a throwaway checkout costs the
  # judge's evidence, permanently, in a file that is append-only and never migrated — five of the
  # seven repositories in the real ledger got there this way.
  # ⚠️ DECLARED COST: the first row of a `sdd run` is written after the first session, so a mission
  # that hits this has already paid for one (an escalation that spends no session is refused for
  # free). Refusing earlier would mean a guard at every door that opens a session — the shape this
  # repo pays for in four places already, and the shape that guarantees the fifth door is born
  # unguarded.
  # The identity is resolved through the SAME function that fills the row's `.repo`, so the guard
  # and the row it is guarding can never disagree about which repository this is.
  if [ -z "${SDD_STATE_DIR:-}" ]; then
    local guard_repo; guard_repo="$(ledger_repo_root)"
    if ledger_repo_is_temp "$guard_repo"; then
      die "refusing to write the real autonomy ledger: $guard_repo lives under the temp directory, and rows from a throwaway checkout are what the judge reads as missions (ADR 0005). Set SDD_STATE_DIR to a directory of this run's own, or move the repo out of the temp root."
    fi
  fi
  local file; file="$(autonomy_log_path)"
  mkdir -p "$(dirname "$file")" 2>/dev/null || true
  # A ledger the mission dies for is worse than a gap in the ledger: ~/.sdd unwritable or a full
  # disk warns and lets the phase carry on. Under `set -e` a failing `>>` would abort the runner.
  # One printf = one write(2) on an O_APPEND fd, which is what keeps two repos running at once
  # from interleaving. jq never writes to the file directly: its stdio may split the output.
  # `2>/dev/null` to the LEFT of the `>>`, the same spelling and the same reason as
  # `pipeline_log_line`: redirections apply left to right, so on the right the shell's raw
  # complaint about the failed `open` escapes to an un-redirected stderr and rides along beside the
  # curated warning below. Both writers were aligned on purpose (R8), and are corrected together
  # (r3 finding #1) so they do not drift apart a third time.
  printf '%s\n' "$1" 2>/dev/null >> "$file" || {
    warn "could not write the autonomy ledger at $file — the mission goes on, the row is lost"
    return 0
  }
}

# ONE definition of "the ledger parses", for the same reason `is_escalation` and `mission_key` are
# one definition each. It was written twice, and the two copies did not disagree about the ANSWER —
# they disagreed about who checks: `cmd_autonomy` ran it and died loudly, `kaizen_series` never ran
# it at all, so the judge's own gate read a corrupt ledger as an empty series and reported "no
# verdict for kit  yet". Same file, same rows: one reader refusing to guess and the other guessing
# "pending". Every reader of the ledger calls this before believing a number.
ledger_parses() { jq -se . "$1" >/dev/null 2>&1; }

# Never a malformed row: broken JSONL is the one way the judge reads garbage believing it is data.
# jq is a hard dependency (preflight fails without it), so absence here is an anomaly, not a mode.
autonomy_have_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  [ "$AUTONOMY_WARNED" = "1" ] || warn "jq not found — the autonomy ledger is not being written"
  AUTONOMY_WARNED=1
  return 1
}

# An escalation spends no session, so the session fields are ABSENT rather than zeroed. `kind` is
# an enum and not prose because the judge must not parse sentences: they get rewritten, and the
# escalations mean different things — a deliberate Jidoka is not the same as burnt budget.
#
# `event` is a PARAMETER because there are two of them and they state different facts:
#   blocked  — the line stopped; the runner returns 3 and a human has to act.
#   degraded — the runner lowered its OWN bar and carried on (PUBLISH_ON_REVIEW_BLOCKED=draft).
# Reusing `blocked` for the second would have been cheaper — it inherits the kit_sha axis and the
# aggregation with no jq to touch — but it would record "stopped" for a run that went on, and the
# ledger exists to record fact. Everything ELSE about the two rows is one decision (the kit stamp,
# the gate_why cap, the absent session fields), so it lives here once and cannot drift apart.
autonomy_escalation_row() {   # autonomy_escalation_row <event> <kind> <phase> <gate_why>
  autonomy_have_jq || return 0
  # Called, never substituted: `$(autonomy_kit_stamp)` would reset its one-shot warning flag.
  autonomy_kit_stamp; local stamp="$AUTONOMY_KIT_STAMP"
  # "${4:0:200}" caps gate_why, and WHAT it counts is the locale's call — this comment used to
  # claim it counted characters unconditionally, true in only one of the two regimes.
  # Measured here (bash + glibc): under pt_BR.UTF-8 it yields 200 characters (400 bytes) and
  # never halves a codepoint; under LC_ALL=C it yields 200 BYTES — exactly the `head -c 200` it
  # replaced, half codepoint included. Neither the runner nor the suite pins LC_ALL, so both
  # regimes are reachable, and the honest claim is the weaker one: never WORSE than the head -c
  # it replaced, better whenever the locale is multibyte. That is why the fix here is the comment
  # and not a global LC_ALL — pinning the locale would move `sort` and `printf` across the whole
  # runner, a blast radius this gain does not pay for.
  # The damage when it DOES cut mid-codepoint is also smaller than the old text claimed: jq 1.7
  # here substitutes U+FFFD and exits 0 (measured) instead of rejecting the --arg, so the row
  # survives with a mangled last character rather than vanishing through the emptiness guard.
  # Substituted and NOT called, unlike autonomy_kit_stamp above: ledger_repo_root only prints, so
  # there is no global for the subshell to eat. And it, never $REPO_ROOT, is what the row carries:
  # $REPO_ROOT is the worktree the session runs IN, the row records the repo it BELONGS to, and
  # the readers filter on the second. No `#` inside the `\`-continued block below — a comment
  # there breaks the command in silence and `bash -n` says nothing.
  local repo; repo="$(ledger_repo_root)"
  autonomy_append "$( jq -cn \
    --arg ts "$(date -Iseconds)" --arg event "$1" --arg kind "$2" --arg phase "$3" \
    --arg why "${4:0:200}" \
    --arg run_id "$AUTONOMY_RUN_ID" --arg invocation "$AUTONOMY_INVOCATION" \
    --arg sha "${stamp%%|*}" --arg dirty "${stamp#*|}" \
    --arg project "$PROJECT_NAME" --arg repo "$repo" --arg mission "$MISSION" \
    '{v: 1, ts: $ts, event: $event, kind: $kind,
      run_id: $run_id, invocation: $invocation,
      kit_sha: (if $sha == "" then null else $sha end),
      kit_dirty: (if $dirty == "" then null else ($dirty == "true") end),
      project: $project, repo: $repo, mission: $mission, phase: $phase,
      gate_why: $why}' )"
}

# Called, never substituted, for the same reason the body above says: the kit stamp's one-shot
# warning flag is a global, and a subshell would reset it once per row.
# L6 (2026-09-03 audit) — the human's pager. Every escalation that ends the run with rc 3 runs
# ON_ESCALATION_CMD from .sdd/config.sh, when set, with the reason (the ledger `kind`), the phase,
# the mission, the project and the gate's sentence in its environment. Measured before it: zero
# notification sites in this file, and a human watching `tail -F` for hours to learn the line had
# stopped. ONE definition, and it sits in autonomy_blocked_row rather than at the eight call sites,
# because that is the one door every rc 3 goes through — the degraded row is not an rc 3 and gets
# no pager. The projection never runs it. A hook that fails is a warning, never a second failure:
# the escalation is already in the journal and the ledger, and a pager that could stop the run
# from stopping would be the wrong way round. `bash -c` with stdin closed, so a hook that reads
# its terminal cannot hang the runner on a machine with nobody at the keyboard.
escalation_hook() {   # escalation_hook <kind> <phase> <gate_why> — never fails the run
  [ "$DRY_RUN" = "1" ] && return 0
  [ -n "$ON_ESCALATION_CMD" ] || return 0
  if ! SDD_REASON="$1" SDD_PHASE="$2" SDD_GATE_WHY="$3" SDD_MISSION="${MISSION:-}" SDD_PROJECT="${PROJECT_NAME:-}" \
       bash -c "$ON_ESCALATION_CMD" </dev/null >&2; then
    warn "ON_ESCALATION_CMD exited non-zero — the escalation is recorded either way"
  fi
}
autonomy_blocked_row()  { escalation_hook "$1" "$2" "$3"; autonomy_escalation_row "blocked"  "$1" "$2" "$3"; }
autonomy_degraded_row() { autonomy_escalation_row "degraded" "$1" "$2" "$3"; }

# The FACT that a phase closed without buying a session. Not an escalation — nothing went wrong,
# the pipeline moved forward — and not a session, because none was spent; a third event, and the
# first addition to an enum `docs/pipeline.md` documents as closed, so that file changes in the
# same commit.
#
# WHY A ROW AT ALL. A gate that passes for free writes nothing anywhere, so every reader has to
# infer the closure from an absence, and `phase_label` infers it wrong: its third clause asks "did
# the last SESSION pass its gate?" while meaning "did the PHASE close?", and stamps `refez` — the
# loudest friction signal in the rubric — on a phase that closed clean. Measured on window 2: the
# QA of 20260830-o-rascunho-fantasma-do-mount, one session, `escalations: {}`, one launch for the
# whole mission, and REVIEW/DOCS/PR all `ok` after it. The runner MEASURED that closure and threw
# the measurement away; this writes it down instead. Same argument f00c2dc made refusing to infer
# what the runner could record.
#
# NO `gate_why`, and it is a declared limit rather than an omission: the gate that closed was
# evaluated inside `current_phase()`, which runs as `$( )`, so GATE_WHY died with the subshell.
# Re-running the gate here to recover the sentence would run TEST_CMD a second time for prose.
# The session fields are absent for the same reason an escalation row has none — a zeroed `rc` or
# `cost_usd` would enter the judge's arithmetic as a session that ran.
autonomy_gate_pass_row() {   # autonomy_gate_pass_row <phase>
  autonomy_have_jq || return 0
  # Called, never substituted: `$(autonomy_kit_stamp)` would reset its one-shot warning flag.
  autonomy_kit_stamp; local stamp="$AUTONOMY_KIT_STAMP"
  # Substituted and not called, exactly as the escalation row does it: ledger_repo_root only
  # prints, so there is no global for the subshell to eat. No `#` inside the `\`-continued block
  # below — a comment there breaks the command in silence and `bash -n` says nothing.
  local repo; repo="$(ledger_repo_root)"
  autonomy_append "$( jq -cn \
    --arg ts "$(date -Iseconds)" --arg phase "$1" \
    --arg run_id "$AUTONOMY_RUN_ID" --arg invocation "$AUTONOMY_INVOCATION" \
    --arg sha "${stamp%%|*}" --arg dirty "${stamp#*|}" \
    --arg project "$PROJECT_NAME" --arg repo "$repo" --arg mission "$MISSION" \
    '{v: 1, ts: $ts, event: "gate_pass",
      run_id: $run_id, invocation: $invocation,
      kit_sha: (if $sha == "" then null else $sha end),
      kit_dirty: (if $dirty == "" then null else ($dirty == "true") end),
      project: $project, repo: $repo, mission: $mission, phase: $phase}' )"
}

# One row per session, written after the gate has been evaluated — the row carries the gate
# result, so it cannot be born before it.
# Arguments 7–9 are EXEC's alone and empty everywhere else (⇒ `null`, never 0: a zero would enter
# the judge's arithmetic as an increment that stood still, the same reason an escalation row
# carries no session fields at all). They are what lets `outcome` tell the pipeline's DESIGNED loop
# — one session per increment, the gate red until the last one — from real churn, which the gate
# verdict and `moved` alone cannot do.
# Arguments 10–12 are the same fact for REVIEW, which is a loop by design too: REVIEW_MAX_ITER
# rounds, each landing its own `40-review-r<N>.md`. Same rule, same reason — empty outside REVIEW,
# and `rounds_max` is there so "3 of 3, the phase is out of budget" cannot be read as "3 of 10".
# `turns` is NOT among them: it rides in from LAST_PHASE_TURNS exactly as `cost` does, so the
# signature and its four callers stay as they are. The escalation and gate_pass constructors do
# not carry it, for the same reason arguments 7–9 are null outside EXEC — a row that spent no
# session spent no turns, and a 0 there would be counted as one that ran and said nothing.
autonomy_session_row() {  # <phase> <attempt> <auto_retry> <moved> <gate> <gate_why> [<pending_before> <pending_after> <increments_total> <rounds_before> <rounds_after> <rounds_max>]
  autonomy_have_jq || return 0
  # Called, never substituted: `$(autonomy_kit_stamp)` would reset its one-shot warning flag.
  autonomy_kit_stamp; local stamp="$AUTONOMY_KIT_STAMP"
  # "${6:0:200}" caps gate_why under the same locale caveat as autonomy_escalation_row's
  # "${4:0:200}" above — characters when the locale is multibyte, bytes under C/POSIX.
  # Same identity as the escalation row above, for the same reason: one repo per row, resolved by
  # the one definition the readers also go through.
  local repo; repo="$(ledger_repo_root)"
  autonomy_append "$( jq -cn \
    --arg ts "$(date -Iseconds)" --arg phase "$1" --arg attempt "$2" \
    --arg auto_retry "$3" --arg moved "$4" --arg gate "$5" \
    --arg why "${6:0:200}" \
    --arg run_id "$AUTONOMY_RUN_ID" --arg invocation "$AUTONOMY_INVOCATION" \
    --arg sha "${stamp%%|*}" --arg dirty "${stamp#*|}" \
    --arg project "$PROJECT_NAME" --arg repo "$repo" --arg mission "$MISSION" \
    --arg step "$LAST_PHASE_STEP" --arg agent "$LAST_PHASE_AGENT" \
    --arg model "$LAST_PHASE_MODEL" --arg session "$LAST_PHASE_SID" \
    --arg rc "$LAST_PHASE_RC" --arg dur "$LAST_PHASE_DUR" --arg cost "$LAST_PHASE_COST" \
    --arg turns "$LAST_PHASE_TURNS" \
    --arg pbefore "${7:-}" --arg pafter "${8:-}" --arg itotal "${9:-}" \
    --arg rbefore "${10:-}" --arg rafter "${11:-}" --arg rmax "${12:-}" \
    '{v: 1, ts: $ts, event: "session",
      run_id: $run_id, invocation: $invocation,
      kit_sha: (if $sha == "" then null else $sha end),
      kit_dirty: (if $dirty == "" then null else ($dirty == "true") end),
      project: $project, repo: $repo, mission: $mission,
      phase: $phase, step: $step, agent: $agent, model: $model,
      attempt: ($attempt | tonumber? // null), auto_retry: ($auto_retry == "true"),
      session: $session,
      rc: ($rc | tonumber? // null),
      dur_s: ($dur | tonumber? // null),
      cost_usd: ($cost | tonumber? // null),
      turns: ($turns | tonumber? // null),
      moved: ($moved == "true"),
      pending_before: ($pbefore | tonumber? // null),
      pending_after: ($pafter | tonumber? // null),
      increments_total: ($itotal | tonumber? // null),
      rounds_before: ($rbefore | tonumber? // null),
      rounds_after: ($rafter | tonumber? // null),
      rounds_max: ($rmax | tonumber? // null),
      gate: $gate, gate_why: $why}' )"
}

# The one `result` object of a stream-json session, or nothing. `tail -1` and not `head -1`: the
# terminal summary is the LAST one by definition, and a stream truncated by a killed session can
# hold a partial line that jq drops here rather than propagate as garbage downstream. Silent on a
# stream with no result — the callers already treat an unreadable summary as an unknown cost, the
# same answer the old single-blob format gave for a session that died before printing.
#
# `|| true` is load-bearing, and the same decision latest_matching() makes one screen up. jq exits
# 5 on the FIRST unparseable line — and a stream cut off by a killed session ends in exactly one of
# those — having already PRINTED every well-formed object before it, the terminal `result`
# included. Under this file's `set -euo pipefail` that 5 leaves the pipeline, leaves the function,
# and aborts the bare call in run_phase: measured, the whole run died with rc 5 having printed not
# one word, no journal line, no ledger row, and no gate ever evaluated — for a session whose
# summary had in fact been distilled correctly onto disk. The line above claims jq "drops" the
# partial line, and swallowing the exit status is what makes that claim true instead of half true.
# The OUTPUT is this function's contract, never the status: nothing on stdout already means
# "unknown cost" to every caller, and the corrupt stream itself stays on disk beside the `.err`
# for whoever reads the mangled session.
stream_summary() { # stream_summary <stream.jsonl>
  jq -c 'select(.type == "result")' "$1" 2>/dev/null | tail -1 || true
}

# The stream closed the blind spot for whoever runs `tail -f` on the file; this closes it for the
# person watching the run. `> "$streamfile"` takes claude's stdout off the terminal, so a phase
# used to print its banner and then nothing for the ten to thirty minutes it lasts.
#
# An observer BESIDE the session, never a `tee` in front of it: a pipeline would put the watcher's
# exit status where claude's has to be, and the phase rc is what the journal and the ledger record.
# Everything it writes goes to the runner's own stderr — the session's stderr belongs to its `.err`
# sibling, and mixing them would file the watcher's chatter as something the session said.
progress_wanted() { # 0=yes. `auto` (the default) means "a human is looking", i.e. a tty on fd 2
  case "${SDD_PHASE_PROGRESS:-auto}" in
    0|off|false) return 1 ;;
    1|on|true)   return 0 ;;
    *)           [ -t 2 ] ;;
  esac
}

stream_watch() { # stream_watch <stream.jsonl> — background; killed by run_phase when the phase ends
  local f="$1" seen=0 n tool
  # Printed BEFORE the polling loop, and that is not decoration: a phase that dies in its first
  # seconds would otherwise leave the same silence this function exists to end, and no fixture
  # short enough to run in a suite would ever reach the first tick.
  printf '  %s⋯ session started%s\n' "$C_DIM" "$C_RESET" >&2
  while :; do
    sleep 5
    [ -f "$f" ] || continue
    n="$(grep -c . "$f" 2>/dev/null || echo 0)"
    [ "$n" -gt "$seen" ] 2>/dev/null || continue
    seen="$n"
    tool="$(tail -5 "$f" 2>/dev/null \
      | jq -r 'select(.type == "assistant") | .message.content[]? | select(.type == "tool_use") | .name' 2>/dev/null \
      | tail -1 || true)"
    printf '  %s⋯ %s event(s)%s%s\n' "$C_DIM" "$n" "${tool:+ · $tool}" "$C_RESET" >&2
  done
}

# Runs a phase in a fresh headless session. Returns 0 when claude exited 0 (which does NOT mean
# the gate passed — the gate judges that, always afterwards).
# The env a phase session must NOT inherit — ONE definition, read by run_phase below.
# Measured 2026-08-30 (20260830-invariante-do-frete-no-agregado): `sdd run` launched from the Bash
# tool of an interactive Claude session was killed twice with no human action, 1 s after a phase
# started and again mid-REVIEW. The nested `claude -p` had inherited CLAUDECODE,
# CLAUDE_CODE_CHILD_SESSION and CLAUDE_CODE_MESSAGING_SOCKET from the harness and became a child of
# the interactive session, which the harness tears down as a tree. Until L5 of the 2026-09-03 audit
# the incantation lived at the human's terminal (`env -u … setsid nohup …`); a rule the runner needs
# every time is written in the runner. `env -u` of an unset name is a no-op, so a terminal launch
# pays nothing. The dry-run prints the prefix, and tests/check-dry-run.sh counts it per phase.
HARNESS_ENV_UNSET=(-u CLAUDECODE -u CLAUDE_CODE_CHILD_SESSION -u CLAUDE_CODE_MESSAGING_SOCKET
  -u CLAUDE_CODE_MESSAGING_TOKEN -u CLAUDE_PID -u CLAUDE_CODE_SESSION_ID -u CLAUDE_CODE_BRIDGE_SESSION_ID)

run_phase() {
  local phase="$1" resume_sid="${2:-}"
  local pstep model agent sid prompt logfile streamfile started ended cost turns
  # QA is three sessions (plan, walk, close); the step comes from the artifacts, not a counter.
  pstep="$(phase_step "$phase")"
  model="$(phase_model "$phase")"
  agent="$(phase_agent "$pstep")"
  sid="$(uuidgen)"
  prompt="$(boot_prompt "$pstep")"
  if [ -n "$resume_sid" ]; then
    prompt="The gate for phase $phase failed: ${GATE_WHY}

Fix exactly that. Do not restart the phase: read what is already on disk, complete what is
missing and write the artifacts. The gate will be re-evaluated."
  fi

  local -a cmd=(env "${HARNESS_ENV_UNSET[@]}" claude -p "$prompt"
    --model "$model"
    --permission-mode "$PERMISSION_MODE"
    --output-format stream-json --verbose
    --setting-sources "user,project,local"
    --allowedTools "$ALLOWED_TOOLS"
    --max-budget-usd "$(phase_budget_usd "$phase")")
  if [ -n "$agent" ]; then cmd+=(--agent "$agent"); fi
  if [ -n "$resume_sid" ]; then cmd+=(--resume "$resume_sid" --fork-session)
  else cmd+=(--session-id "$sid"); fi

  if [ "$DRY_RUN" = "1" ]; then
    info ""
    printf '%s--- DRY RUN: phase %s ---%s\n' "$C_BOLD" "$pstep" "$C_RESET"
    printf '%scwd:%s   %s\n' "$C_DIM" "$C_RESET" "$REPO_ROOT"
    printf '%smodel:%s %s   %sagent:%s %s   %ssession:%s %s\n' \
      "$C_DIM" "$C_RESET" "$model" "$C_DIM" "$C_RESET" "${agent:-<none>}" \
      "$C_DIM" "$C_RESET" "${resume_sid:-$sid}"
    printf '%scommand:%s\n' "$C_DIM" "$C_RESET"
    printf '  %q' "${cmd[@]}"; printf '\n'
    printf '%sboot prompt:%s\n' "$C_DIM" "$C_RESET"
    printf '%s\n' "$prompt" | sed 's/^/  │ /'
    LAST_PHASE_SID="${resume_sid:-$sid}"
    return 0
  fi

  # `$sid` and never `${resume_sid:-$sid}`, and the distinction is the whole fix. The file names an
  # INVOCATION; `session=` in the journal below names the CONVERSATION. $sid is minted
  # unconditionally at the top of this function, so it is fresh on every call — including a retry,
  # where claude is handed `--resume "$resume_sid" --fork-session` and never sees $sid at all. Two
  # retries of one resumed session share `resume_sid` and would collide again on that spelling.
  #
  # Second-resolution time alone was BUG-20260821-session-log-overwritten-in-the-same-second, filed
  # Data-Loss: the runner tells the operator which file to read and then destroys it, because
  # retrying is exactly what puts two sessions of one phase inside one second. The journal recorded
  # both sessions, with two ids, pointing at one path. `log=$logfile` below prints this same
  # variable, so the pointer follows the file by construction rather than by a second edit.
  logfile="$(log_dir)/${phase}-$(date +%Y%m%d-%H%M%S)-${sid:0:8}.json"
  streamfile="${logfile%.json}.stream.jsonl"
  mkdir -p "$(dirname "$logfile")"
  started="$(date +%s)"
  step "phase $pstep — ${agent:-skill} ($model) — session ${resume_sid:-$sid}"

  local rc=0
  # The session writes STRAIGHT to the stream file, one JSON event per line, as it happens. Under
  # the old `--output-format json` this file was a single blob printed at exit: it sat at 0 bytes
  # for the ten minutes a phase takes, so a run in flight was unobservable and a session killed
  # halfway left nothing behind saying how far it got. `tail -f` on the stream now answers both.
  #
  # A plain redirect, not the `tee` the plan sketched: the redirect already gives the live file,
  # and a pipeline would put `tee`'s exit status where claude's has to be — recoverable only via
  # PIPESTATUS, for no second consumer to feed.
  local watcher=""
  if progress_wanted; then stream_watch "$streamfile" & watcher=$!; fi
  ( cd "$REPO_ROOT" && "${cmd[@]}" ) > "$streamfile" 2>"${logfile%.json}.err" || rc=$?
  # Before `ended`, so the watcher cannot print over the phase's own closing lines. `wait` is what
  # makes that a guarantee instead of a hope, and both are silenced: the watcher is killed by
  # design, so its death is not news.
  if [ -n "$watcher" ]; then kill "$watcher" 2>/dev/null || true; wait "$watcher" 2>/dev/null || true; fi
  ended="$(date +%s)"

  # The summary every other reader here already knows. `--output-format json` printed exactly the
  # terminal `result` object and nothing else, so distilling that one line back into $logfile
  # leaves the cost below, the `.err` sibling and the journal's `log=` untouched by the change.
  # Reading the raw stream instead would hand jq one answer PER LINE and `tonumber?` would refuse
  # the multi-line string — the ledger going quiet about money with nothing going red.
  stream_summary "$streamfile" > "$logfile"

  # The `|| echo "?"` covers a jq that FAILS; it does not cover a jq that succeeds silently, and
  # that is the case stream_summary() produces most: over an EMPTY $logfile — a session killed
  # before its `result`, or the truncated stream the comment above describes — jq exits 0 having
  # printed nothing, so the fallback never fires and `cost` becomes the empty string. Measured: the
  # journal line came out `cost_usd=  log=…`, an unlabelled hole where every other row says `?`.
  # No data was ever corrupted (`($cost | tonumber? // null)` maps "" and "?" to the same ledger
  # null), but stream_summary()'s contract says in so many words that empty stdout "already means
  # unknown cost to every caller", and this is the caller that has to make that sentence true.
  cost="$(jq -r '.total_cost_usd // .cost_usd // "?"' "$logfile" 2>/dev/null || echo "?")"
  [ -n "$cost" ] || cost="?"
  # The other half of what a session cost, out of the same distilled summary and on the same
  # terms. Money alone cannot separate a phase that got cheaper by spending FEWER TURNS from one
  # that got cheaper by luck, and the two ask for opposite next moves: cache-read grows with
  # turns² (corr 0.94 over 28 real REVIEW rounds, 2026-09-01) and is about 30% of the bill, so the
  # turn count is the lever the money is a shadow of. `// ""` and not `// "?"`: the ledger maps
  # both to null through `tonumber?`, and unlike `cost` this value is never journalled as prose,
  # so there is no line for a `?` to make readable. Same `|| echo` guard as the cost above, for
  # the jq that FAILS; the jq that succeeds over an empty summary prints nothing and the empty
  # string is already the answer this one wants.
  turns="$(jq -r '.num_turns // ""' "$logfile" 2>/dev/null || echo "")"
  local dur=$((ended - started))
  pipeline_log_line "$(date -Iseconds)  $phase  agent=$agent  model=$model  session=${resume_sid:-$sid}  rc=$rc  dur=${dur}s  cost_usd=$cost  log=$logfile"

  # Published for the autonomy ledger, which is written by cmd_run — only there is the gate
  # result known, and the row carries it.
  LAST_PHASE_RC="$rc"
  LAST_PHASE_COST="$cost"
  LAST_PHASE_TURNS="$turns"
  LAST_PHASE_DUR="$dur"
  LAST_PHASE_STEP="$pstep"
  LAST_PHASE_AGENT="$agent"
  LAST_PHASE_MODEL="$model"

  if [ "$rc" -ne 0 ]; then
    warn "claude exited $rc in phase $phase (see $logfile and ${logfile%.json}.err)"
  else
    dim "  session ended in ${dur}s, cost $cost USD"
  fi
  # On a retry, `cmd` was built with `--resume "$resume_sid" --fork-session` and WITHOUT
  # `--session-id`: the `$sid` generated at the top of this call was never handed to claude, so
  # recording it here would leave the retry row pointing at a session that identifies nothing —
  # matches what `pipeline_log_line` above already records for the same session.
  LAST_PHASE_SID="${resume_sid:-$sid}"
  invalidate_checks
  return 0
}
LAST_PHASE_SID=""
LAST_PHASE_RC=""
LAST_PHASE_COST=""
LAST_PHASE_TURNS=""
LAST_PHASE_DUR=""
LAST_PHASE_STEP=""
LAST_PHASE_AGENT=""
LAST_PHASE_MODEL=""

# Fingerprint of the mission state. It answers "did this session do ANYTHING?" when the gate has
# not passed yet — the normal case for the EXEC phase, which runs one increment at a time.
state_fingerprint() {
  local head files
  head="$( cd "$REPO_ROOT" && git rev-parse HEAD 2>/dev/null || echo "-" )"
  files="$( ls -1 "$MISSION_DIR" 2>/dev/null | sort | tr '\n' ',' )"
  printf '%s|%s|%s\n' "$head" "$files" \
    "$( cat "$MISSION_DIR/checkpoint.md" 2>/dev/null | md5sum 2>/dev/null | cut -d' ' -f1 )"
}

# skill_findable <name> → 0 when a skill by that name can be found where skills live.
#
# Three phases are driven by skills the kit does not ship: TICKET boots `ticket`, the two QA
# sub-steps boot `qa-report` and `qa-execution`, and REVIEW loads `codereview`. A missing one is not
# a session that fails — it is a session that boots, finds nothing, improvises, and spends the
# phase budget producing something no gate can read.
#
# HEURISTIC, and therefore a warn and never a fail. The roots below are a CONVENTION of the harness,
# not a contract the kit can enforce, and a rule that fails on a heuristic is the rule the next
# author deletes (the ddd/kaizen plugin check one screen down makes the same call). Three roots,
# the two `health_provenance` already walks plus the project's own: a plain `skills/<name>/`
# directory, and the plugin cache, where a skill arrives inside a versioned plugin tree.
#
# SDD_SKILLS_ROOT exists so this is testable at all — with no injectable root the only worlds
# available to a sensor are "this developer's machine" and nothing.
skill_findable() {
  local name="${1:-}" root="${SDD_SKILLS_ROOT:-$HOME/.claude}"
  [ -n "$name" ] || return 1
  [ -d "$root/skills/$name" ] && return 0
  [ -d "$REPO_ROOT/.claude/skills/$name" ] && return 0
  # `-quit` on the first hit: the cache holds every version of every plugin, and this question is
  # "is it anywhere", not "where". `|| true` because `find` on a missing directory returns 1 and
  # pipefail would carry that into the caller's assignment.
  [ -n "$( find "$root/plugins/cache" -maxdepth 6 -type d -name "$name" -print -quit 2>/dev/null || true )" ]
}

# test_cmd_looks_noop <cmd> → 0 when the command would exit 0 having run no test at all.
#
# `TEST_CMD` is the EXEC gate and half the REVIEW gate. A value that runs nothing is worse than an
# empty one: it passes every gate, in every mission, for ever, and each phase certifies itself
# against a run that never happened — a label reached through the one key the whole pipeline
# trusts. The preflight only refused EMPTY and the literal `TODO`.
#
# Two rules, both the shape `sdd health`'s check 2b already uses:
#   - the FIRST WORD is a command that runs nothing. `true` and `:` are what a config carries while
#     it is being wired up, and `echo`/`printf` are what a placeholder turns into;
#   - an argument, matched WHOLE (padded on both sides), that asks the runner to enumerate the
#     tests instead of running them. Unpadded, `*--list*` would also accuse `--listen-port`, and a
#     rule that fires on correct config is a rule the next author deletes.
#
# ONE definition, called from cmd_preflight. Check 2b in cmd_health deliberately keeps its OWN
# narrower `--list` case rather than calling this: its subject is the kit's own suite mode, its
# message says so, and `mut_HEALTH_testcmd_list_blind` anchors on that case pattern. The
# duplication is declared here rather than hidden — a new spelling belongs in BOTH.
# `tc` and not `cmd`: `cmd` is a `local -a` in run_phase, and shellcheck reasons about the name
# across the whole file — a scalar `cmd` here makes it read every use as the first element of an
# array (SC2178/SC2128) and the lint step of the suite goes red.
test_cmd_looks_noop() {
  local tc="${1:-}"
  [ -n "$tc" ] || return 1
  case "${tc%% *}" in
    true|:|echo|printf|exit) return 0 ;;
  esac
  case " $tc " in
    *" --list "*|*" --listTests "*|*" --collect-only "*) return 0 ;;
  esac
  return 1
}

# How many REVIEW rounds this mission has already spent, read off the disk.
#
# `attempts` in cmd_run is a `local -A` born with the PROCESS, so `REVIEW_MAX_ITER` only ever
# capped one invocation: three rounds, escalate — and then `sdd run` again handed out three more,
# for ever, at the price of the most expensive phase there is. The rounds themselves are on disk,
# named `40-review-r<N>.md`, which is the state the whole kit derives from (principle 4). Same
# `latest_matching` the REVIEW gate reads, so the two cannot disagree about which round is latest:
# it sorts `-V`, so r10 comes after r3.
review_rounds_on_disk() {
  local last n
  last="$(latest_matching "$MISSION_DIR/40-review-r*.md")"
  [ -n "$last" ] || { printf '0\n'; return 0; }
  n="${last##*/40-review-r}"
  n="${n%.md}"
  # A file the glob matched but whose N is not a number answers 0 rather than poisoning an
  # arithmetic test with a string — `40-review-rounds.md` would otherwise abort the run.
  case "$n" in ''|*[!0-9]*) printf '0\n'; return 0 ;; esac
  printf '%s\n' "$n"
}

# How many sessions a phase may consume before turning BLOCKED.
# L2 (2026-09-03 audit) — the mission ceiling. Measured: 20260902-o-rascunho-legado-fala-cru cost
# US$ 174.11 against a ceiling of US$ 150 that lived in the PLAN'S PROSE; the runner capped each
# session (--max-budget-usd) and never the mission, so a loop of cheap rounds never met a number.
# The sum is read off the mission journal — the `cost_usd=` field of every session line, `?`
# counting as nothing — and read BEFORE a phase opens: the money that stops the line is money
# already spent, never a session cut mid-way with nothing on disk (the argument config/schema.md
# already makes for BUDGET_REVIEW_USD). Same ledger kind as the phase ceiling, `budget-exhausted`:
# the enum names the friction, and `gate_why` says which ceiling. The projection prints the sum
# and never stops there; `--budget-override` goes on and is written down as the intervention it is.
# LC_ALL=C on BOTH awk calls, and it is not cosmetic: under a pt_BR locale mawk's strtod stops at
# the dot, so `100.5 + 49.5` read 149 and printed `149,00` — a ceiling of 150 never met on a
# machine whose journal said 150.00. Measured on this house's own locale while L2 was written.
# A journal the runner cannot READ sums to 0.00 (no ceiling knowledge, the behaviour before L2)
# and says nothing here: the journal WRITER is the one that names an unwritable file, once.
mission_cost_usd() {   # the journal's sum, 2 decimals; a journal that does not exist is 0.00
  [ -r "$PIPELINE_LOG" ] || { printf '0.00\n'; return 0; }
  LC_ALL=C awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^cost_usd=[0-9.]+$/) s += substr($i, 10) }
       END { printf "%.2f\n", s + 0 }' "$PIPELINE_LOG" 2>/dev/null || printf '0.00\n'
}
mission_budget_blown() {   # mission_budget_blown <phase> — rc 0 = STOP (row written), rc 1 = go on
  local phase="$1" spent ceiling="$BUDGET_MISSION_USD"
  case "$ceiling" in 0|0.*) return 1 ;; esac
  spent="$(mission_cost_usd)"
  if [ "$DRY_RUN" = "1" ]; then
    if [ "$MISSION_BUDGET_PROJECTED" = "0" ]; then
      MISSION_BUDGET_PROJECTED=1
      dim "  mission budget: US\$ $spent of $ceiling spent so far (the projection never stops here)"
    fi
    return 1
  fi
  if ! LC_ALL=C awk -v s="$spent" -v c="$ceiling" 'BEGIN { exit !(s + 0 >= c + 0) }'; then return 1; fi
  if [ "$BUDGET_OVERRIDE" = "1" ]; then
    if [ "$BUDGET_OVERRIDE_NOTED" = "0" ]; then
      BUDGET_OVERRIDE_NOTED=1
      warn "mission budget blown (US\$ $spent of $ceiling) — going on under --budget-override"
      checkpoint_note_intervention "sdd $AUTONOMY_INVOCATION --budget-override (US\$ $spent spent against BUDGET_MISSION_USD=$ceiling)" "$phase"
    fi
    return 1
  fi
  GATE_WHY="mission budget: US\$ $spent spent against BUDGET_MISSION_USD=$ceiling — the line stops before opening $phase"
  info ""
  bad "BLOCKED in $phase — $GATE_WHY"
  dim "  Raise BUDGET_MISSION_USD in .sdd/config.sh, or go on once with --budget-override (noted as an intervention)."
  pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
  autonomy_blocked_row "budget-exhausted" "$phase" "$GATE_WHY"
  return 0
}

phase_budget() {
  case "$1" in
    EXEC)   printf '%s\n' "$(( $(checkpoint_rows | wc -l) + EXEC_MAX_RETRY + 2 ))" ;;
    QA)     printf '%s\n' "$(( QA_MAX_ITER * 3 ))" ;;   # 3 sub-steps per round
    REVIEW) printf '%s\n' "$REVIEW_MAX_ITER" ;;
    *)      printf '%s\n' "$(( EXEC_MAX_RETRY + 1 ))" ;;
  esac
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_install() {
  local force=0
  if [ "${1:-}" = "--force" ]; then force=1; fi
  resolve_repo_root
  step "installing sdd into $REPO_ROOT"

  mkdir -p "$REPO_ROOT/.sdd" "$REPO_ROOT/.claude/agents"

  if [ -f "$CONFIG_FILE" ]; then
    ok ".sdd/config.sh already exists (preserved)"
  else
    local branch test_cmd project
    project="$(basename "$REPO_ROOT")"
    # `|| true` is mandatory: a repo with no remote has no origin/HEAD, git fails, and pipefail
    # would take the whole install down in silence.
    branch="$( cd "$REPO_ROOT" \
      && git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null \
      | sed 's|^origin/||' || true )"
    [ -n "$branch" ] || branch="$( cd "$REPO_ROOT" && git branch --show-current )"
    # `elif`, first match wins. Four independent `if`s meant every one of them ran, so the LAST
    # match won whatever the repo actually is: a Node project carrying a `go.mod` for a sidecar
    # tool was installed with `go test ./...` as the suite every gate runs — the wrong suite,
    # chosen in silence, in the one key the whole pipeline trusts. package.json first because a
    # repo with two manifests is usually a JS project with a helper in another language.
    test_cmd="TODO"
    if   [ -f "$REPO_ROOT/package.json" ];   then test_cmd="npm test"
    elif [ -f "$REPO_ROOT/pyproject.toml" ]; then test_cmd="pytest -q"
    elif [ -f "$REPO_ROOT/Cargo.toml" ];     then test_cmd="cargo test"
    elif [ -f "$REPO_ROOT/go.mod" ];         then test_cmd="go test ./..."
    fi
    # The redirect below creates $CONFIG_FILE BEFORE sed runs, so a half-copied kit used to leave
    # a 0-byte config on disk and only then die on sed's rc. rc was already non-zero, which is why
    # this looked harmless: the damage was the ARTIFACT. The next `sdd install` found the file,
    # printed "already exists (preserved)" over it, and the target repo went on without a
    # TEST_CMD — the runner asserting an artifact it never wrote, one level down from the gates.
    # Guard first, and in the kit's own voice: sed's stderr is locale-dependent and says nothing
    # about the consequence.
    [ -f "$SDD_HOME/config/starter.conf" ] \
      || die "the kit at $SDD_HOME has no config/starter.conf — .sdd/config.sh would be created empty, and the next 'sdd install' would report it as already existing. Re-copy or re-clone the kit."
    sed -e "s|<PROJECT_NAME>|$project|g" \
        -e "s|<DEFAULT_BRANCH>|$branch|g" \
        -e "s|<TEST_CMD>|$test_cmd|g" \
        -e "s|<SDD_HOME>|$SDD_HOME|g" \
        "$SDD_HOME/config/starter.conf" > "$CONFIG_FILE"
    ok ".sdd/config.sh created (base branch detected: $branch — confirm it)"
  fi

  # The two paths the runner cannot work without, both NAMED in the config just written — which is
  # what makes this the installer's job. Without HANDOFF_DIR, `resolve_mission` dies on the FIRST
  # command a new user types ("docs/handoffs/ does not exist in the target repo"), and TODO_FILE is
  # where principle 5 sends every out-of-scope finding.
  #
  # SOURCED in a subshell, the way check 2b of cmd_health reads TEST_CMD: what matters is the value
  # `load_config` will hand the runner after expansion, never the text of the line. `|| true`
  # because the rc of a substitution is its LAST command's, and a config that fails to parse must
  # not take the install down here — it is `sdd preflight`'s job to say so, in its own words.
  local inst_handoff inst_todo
  # shellcheck disable=SC1090
  inst_handoff="$( . "$CONFIG_FILE" >/dev/null 2>&1; printf '%s' "${HANDOFF_DIR:-}" )" || true
  # shellcheck disable=SC1090
  inst_todo="$( . "$CONFIG_FILE" >/dev/null 2>&1; printf '%s' "${TODO_FILE:-}" )" || true
  # Same defaults load_config applies, restated here because a broken config arrives EMPTY.
  [ -n "$inst_handoff" ] || inst_handoff="docs/handoffs"
  [ -n "$inst_todo" ]    || inst_todo="TODO.md"

  if [ -d "$REPO_ROOT/$inst_handoff" ]; then
    ok "$inst_handoff/ already exists"
  else
    mkdir -p "$REPO_ROOT/$inst_handoff"
    ok "$inst_handoff/ created (the mission's durable state lives here, committed)"
  fi

  if [ -f "$REPO_ROOT/$inst_todo" ]; then
    ok "$inst_todo already exists (preserved)"
  else
    # Seeded with the FORMAT, because an empty file teaches nothing and the format is what makes
    # the entries countable. Never overwritten: a second install over a file holding real findings
    # would take them with it.
    cat > "$REPO_ROOT/$inst_todo" <<'SEED'
# Findings

> Out-of-scope findings from `sdd` missions. Never divert the mission to fix one; never lose it.
> One entry, about six lines: what, the anchor, why it matters, the direction, who found it.
> The long analysis belongs in the handoff of the mission cited.
>
> Format:
>
> ```md
> - [ ] <what> — `file:line` — <why it matters> — found by `<agent>` in mission `<slug>` (YYYY-MM-DD)
> ```
>
> Closed is DELETED, never archived: an entry marked `RESOLVED by <hash>` stays here only until
> the PR citing that evidence is merged, then leaves the file. Durable memory already exists in
> `git log -S`, in the handoffs, and in the hash the entry itself quotes. Delete on the artifact
> — `git merge-base --is-ancestor <hash> <base>` — never on a PR label.

## Open

## Resolved
SEED
    ok "$inst_todo created (out-of-scope findings go here — principle 5)"
  fi

  local a name target changed=0
  for a in "$SDD_HOME"/agents/sdd-*.md; do
    [ -e "$a" ] || continue
    name="$(basename "$a")"
    target="$REPO_ROOT/.claude/agents/$name"
    if [ ! -f "$target" ]; then
      cp "$a" "$target"; ok "agent $name copied"
    elif cmp -s "$a" "$target"; then
      ok "agent $name identical"
    elif [ "$force" = "1" ]; then
      cp "$a" "$target"; ok "agent $name updated (--force)"
    else
      changed=$((changed + 1))
      warn "agent $name differs from the kit version:"
      diff -u "$target" "$a" | sed 's/^/      /' >&2 || true
    fi
  done
  if [ "$changed" -gt 0 ]; then warn "run 'sdd install --force' to adopt the kit version"; fi

  local gitignore="$REPO_ROOT/.gitignore"
  if ! grep -qxF '.sdd/logs/' "$gitignore" 2>/dev/null; then
    printf '\n# ephemeral logs of the sdd runner (durable state lives in %s/, committed)\n.sdd/logs/\n' \
      "${HANDOFF_DIR:-docs/handoffs}" >> "$gitignore"
    ok ".sdd/logs/ added to .gitignore"
  else
    ok ".sdd/logs/ already in .gitignore"
  fi

  info ""
  dim "next: edit .sdd/config.sh and run 'sdd preflight'"
}

# "you are standing on the base branch" — ONE definition, called by the five doors that can end
# up committing: cmd_preflight, cmd_run, cmd_retry, cmd_kaizen and cmd_approve.
#
# The count is not decoration: it was "four" until `sdd approve` was born committing in silence, in
# the very mission that closed the silence of `sdd retry`. A door is added to this list the moment
# it can reach a `git commit`, whether or not it opens a session — the criterion is what lands in
# the history, and a count left stale here is how the next door gets written without the guard.
#
# It used to be four lines inlined in cmd_preflight and nowhere else, and preflight is OPTIONAL:
# `sdd run` from `main` commits every phase straight into the base branch without a word, `sdd
# retry` does the same for a single redone phase, `sdd approve` did it for the approval commit it
# asks the human to authorise, and `sdd kaizen` is worse — it checks the kit repo and the dirty tree, then writes a verdict and
# three artifacts wherever you happen to be. Same rule that gave `is_escalation` a single home
# after the blocked/degraded pair diverged across three call sites: an enum (or a warning) read in
# more than one place is defined once, or the call sites drift apart one at a time.
#
# It stays a `warn` and is NEVER allowed to become a `die`. Turning it into an error would lock the
# kaizen loop out of its own repo the first time a human forgot to create the branch, and both
# sensors assert the rc on BOTH branches precisely to keep that door shut.
#
# Silent — returning 0 — when git has no branch name to give (a detached HEAD answers empty) or
# when DEFAULT_BRANCH is empty: comparing "" with "" would fire the warning on every detached
# checkout, and a warning that cries wolf is how people learn to skip reading them.
warn_if_on_base_branch() {
  local branch
  branch="$( cd "$REPO_ROOT" && git branch --show-current 2>/dev/null || true )"
  [ -n "$branch" ] && [ -n "$DEFAULT_BRANCH" ] && [ "$branch" = "$DEFAULT_BRANCH" ] || return 0
  warn "you are on the base branch ($DEFAULT_BRANCH) — run like this and the pipeline commits straight into it"
}

# ensure_mission_branch — the runner honours the `branch:` field of 00-missao.md.
#
# The field shipped in templates/missao.md from the first day and NOTHING here ever read it: the
# plan declared where the mission's commits belonged, and honouring it was a manual step before
# every run. In the SQ-97 pilot the step was skipped once and five phases committed into another
# PR's branch — 16 commits, and a `rebase --onto` to undo them.
#
# ONE definition, two call sites (cmd_run, cmd_retry) — the same rule that gave is_escalation and
# warn_if_on_base_branch a single home each: a decision read in more than one place drifts apart
# one call site at a time, and the site that stays behind is the one nobody tests.
#
# NEVER in a dry run. What `--dry-run` promises is narrower than "nothing happens" (the gates do
# run TEST_CMD), but a checkout is a mutation of the working tree, which is precisely the half it
# does promise.
#
# A branch that does not exist yet is cut from the CURRENT branch, never from DEFAULT_BRANCH: the
# commit that carries the plan lives where the human is standing when they run, and cutting from
# the base would leave the whole mission behind.
#
# git refusing the checkout is a `die`, never a warning: a dirty tree or a name git will not take.
# Going on would run the entire pipeline on a branch the plan did not ask for, which is the exact
# failure this function exists to close — and guessing on top of a tree git already refused is how
# a working tree gets destroyed. The reason is git's to give, so its own output is carried into
# the message instead of being replaced by a paraphrase.
ensure_mission_branch() {
  [ "$DRY_RUN" = "1" ] && return 0
  local want current out rc=0
  want="$(frontmatter "$MISSION_DIR/00-missao.md" branch)"
  # Two no-ops: an empty field, and the `<...>` placeholder templates/missao.md ships while the
  # name is still unknown (the TICKET phase fills it in). Neither is a branch name — git rejects
  # the second for both the `<` and the spaces — and a mission that never declared a branch must
  # keep working exactly as it did before this function existed.
  [ -n "$want" ] || return 0
  case "$want" in '<'*) return 0 ;; esac
  # A name git would read as an OPTION dies here, before git sees it, and this is the one path in
  # this function that can destroy work rather than merely land in the wrong place. `git checkout
  # -f` is a legal command: it returns 0, switches to nothing, and throws away every uncommitted
  # change in the tree — so a `branch: -f` would leave the human's work gone, the run going on, and
  # the `ok` line below announcing a switch that never happened.
  #
  # The `-b` path already dies on such a name (git refuses to CREATE it), but that is the wrong
  # half to rely on: `git update-ref refs/heads/-f HEAD` is accepted and `git check-ref-format`
  # calls the name valid, so the ref CAN exist, and then the branch above runs it as a flag.
  # Refusing the shape is one line and does not depend on which of the two paths a given tree
  # takes. Asserted in tests/check-gates.sh with a fixture that builds the ref and a dirty file.
  case "$want" in
    -*) die "the branch '$want' declared in 00-missao.md starts with '-' — git would read it as an option, not a branch" ;;
  esac
  current="$( cd "$REPO_ROOT" && git branch --show-current 2>/dev/null || true )"
  [ "$want" = "$current" ] && return 0
  if ( cd "$REPO_ROOT" && git show-ref --verify --quiet "refs/heads/$want" ); then
    out="$( cd "$REPO_ROOT" && git checkout "$want" 2>&1 )" || rc=$?
  else
    out="$( cd "$REPO_ROOT" && git checkout -b "$want" 2>&1 )" || rc=$?
  fi
  [ "$rc" -eq 0 ] \
    || die "could not switch to the branch '$want' declared in 00-missao.md — git said: $out"
  # The checkout is not the end of the decision, and this is the half that was missing. The plan is
  # read on the branch the human is standing on and the tree is then REPLACED under the runner: if
  # the declared branch was cut before the mission existed — the ordinary flow when the branch comes
  # from the ticket step — the artifacts that justified every choice above are simply gone, and the
  # runner would go on with MISSION_DIR pointing at a path that is no longer there, announcing the
  # switch as a success and then telling the human the mission was never planned. Worse and
  # quieter: a branch carrying an OLDER copy spends real sessions executing a plan nobody approved.
  #
  # So the artifact is re-read AFTER the switch, through the same parser, and it has to still be
  # there and still declare THIS branch. `die`, never a warning, for the reason the refused checkout
  # gives: going on would run the whole pipeline against a plan the human did not approve, which is
  # the failure this function exists to close, entered from the other side.
  if [ ! -f "$MISSION_DIR/00-missao.md" ] \
     || [ "$(frontmatter "$MISSION_DIR/00-missao.md" branch)" != "$want" ]; then
    die "the branch '$want' declared in 00-missao.md does not carry this mission — you are now on it, and the plan that asked for it is on '${current:-<detached>}'"
  fi
  ok "branch: ${current:-<detached>} → $want (declared in 00-missao.md)"
  pipeline_log_line "$(date -Iseconds)  BRANCH  ${current:-<detached>} -> $want"
}

cmd_preflight() {
  load_config
  step "preflight — $PROJECT_NAME ($REPO_ROOT)"
  local fails=0
  _fail() { bad "$1"; fails=$((fails + 1)); }

  # --- tools ---
  if command -v claude >/dev/null 2>&1; then ok "claude $(claude --version 2>&1 | head -1)"
  else _fail "claude CLI not found in PATH"; fi

  local t
  for t in git gh jq uuidgen; do
    if command -v "$t" >/dev/null 2>&1; then ok "$t present"
    else _fail "$t not found in PATH"; fi
  done

  # The GNU userland, probed by BEHAVIOUR and not by presence. `command -v date` passes on macOS
  # and `date -Iseconds` still fails; brew installs GNU coreutils as gmd5sum/gdate unless the
  # gnubin dir comes first in PATH, so the name being there proves nothing. The version check at
  # the top of this file can only speak for bash — this is where the rest of the assumption gets
  # measured. Scope is what the RUNNER needs: the suite's `sed -i`/`grep -P` belong to this
  # repo's TEST_CMD, not to every target repo, and a red suite says so out loud anyway.
  local gnu=""
  md5sum </dev/null >/dev/null 2>&1  || gnu="$gnu md5sum"
  date -Iseconds >/dev/null 2>&1     || gnu="$gnu 'date -Iseconds'"
  sort -V </dev/null >/dev/null 2>&1 || gnu="$gnu 'sort -V'"
  # git 2.31+, probed by BEHAVIOUR for the same reason as the userland above: `git --version`
  # parses into three fields on some builds and four on others, and what the runner needs is not a
  # number but an ANSWER. `ledger_repo_root` asks for `--path-format=absolute`, born in 2.31, and
  # `git rev-parse` ECHOES an option it does not know back to stdout while still exiting 0 — so an
  # older git does not fail here, it answers two lines, and the repository identity written to
  # every ledger row becomes a string no reader can match. The function refuses that shape and then
  # RESOLVES the identity the old way (`cd` + `pwd -P`, both `cd`s with an emptied CDPATH), so an
  # old git costs a second rev-parse and nothing else. This line is where the operator is told that
  # the slow path is the one being taken — a notice, not a broken kit.
  if [ "$( git rev-parse --path-format=absolute --git-common-dir 2>/dev/null | grep -c . )" = 1 ]; then
    ok "git speaks --path-format (2.31+)"
  else
    warn "this git does not know 'rev-parse --path-format' (2.31+, and it does not fail — it
        echoes the flag back and exits 0). 'ledger_repo_root' refuses the echoed shape and falls
        back to resolving the common dir with cd + pwd -P, which answers the same string, so the
        ledger stays correct. Upgrading git removes the extra rev-parse per ledger write."
  fi

  if [ -z "$gnu" ]; then
    ok "GNU userland (md5sum, date -Iseconds, sort -V)"
  else
    _fail "the kit assumes the GNU userland, and these do not answer:$gnu
        macOS: brew install coreutils gnu-sed grep, with the gnubin dirs first in PATH.
        Without md5sum the state fingerprint is empty, every session looks identical to the
        previous one, and the runner escalates phases that were in fact making progress."
  fi

  # --- authentication ---
  # Sanity + permission in one shot. "claude -p answers" does NOT cover the failure mode that
  # matters: the phase session has to EXECUTE (run the suite, commit), and `acceptEdits` alone
  # does not unlock `Bash`. This check fires a real headless session with THE SAME flags as
  # run_phase and demands that it manage to execute a command.
  if command -v claude >/dev/null 2>&1; then
    local probe
    probe="$( cd "$REPO_ROOT" && claude -p "Run exactly: bash -c 'echo sdd-preflight-ok'. Answer with the command output only." \
        --model haiku --permission-mode "$PERMISSION_MODE" --output-format json \
        --setting-sources "user,project,local" --allowedTools "$ALLOWED_TOOLS" \
        --max-budget-usd 1 2>/dev/null | jq -r '.result // ""' 2>/dev/null || true )"
    # Herestring for the same reason as the Jidoka in cmd_run: `printf | grep -q` returns 141
    # under `pipefail` when the grep MATCHES, so the success branch is the one that loses the race.
    if grep -q 'sdd-preflight-ok' <<< "$probe"; then
      ok "headless session executes commands (OAuth + permission)"
    elif [ -z "$probe" ]; then
      _fail "claude -p did not answer — expired session? run 'claude login'"
    else
      _fail "the headless session CANNOT execute commands — the phases will not run the suite
        nor commit. Answer received: $(printf '%s' "$probe" | head -c 120)
        Adjust ALLOWED_TOOLS in .sdd/config.sh (default: Bash)."
    fi
  fi
  if gh auth status >/dev/null 2>&1; then ok "gh authenticated"
  else _fail "gh not authenticated — run 'gh auth login'"; fi

  # --- browser (only matters when there is e2e/UI QA) ---
  if [ -n "$E2E_CMD" ] || [ -n "$APP_URL" ]; then
    if command -v agent-browser >/dev/null 2>&1; then
      ok "$(agent-browser --version 2>&1 | head -1)"
    else
      _fail "agent-browser missing/broken — the exploratory QA phase depends on it.
        Known symptom: a shim in ~/.nvm/versions/node/*/bin/agent-browser pointing at
        ~/.hermes/... (nonexistent). Fix: ln -sf ../lib/node_modules/agent-browser/bin/agent-browser.js <shim>"
    fi
  else
    dim "  ---  agent-browser not checked (E2E_CMD and APP_URL empty)"
  fi

  # --- is anything listening where APP_URL points? -------------------------
  # Fifteen checks ran here and not one of them touched APP_URL, so the single fact that costs a
  # whole opus session to discover — the app is not up — was the one preflight could not say.
  # Measured on the SQ-111 mission of 2026-08-27: US$ 14,16 for a QA phase reproved by the
  # environment. This is the same probe gate_QA uses, asked one step earlier and for free.
  #
  # A dead app is a REFUSAL only when E2E_CMD is set, and the asymmetry is the policy, not a
  # convenience: with E2E_CMD configured a gate is about to run a suite against an app that is not
  # there, which is precisely the loop this pays for. Without it nothing automatic runs against
  # APP_URL at all, so the same fact is something the human walking the journey should know and
  # never a reason to refuse to start the mission — the kit does not get to decide the app must be
  # up before a human may plan.
  #
  # `unknown` is a warning in BOTH cases, and never a refusal. The probe is one-sided by
  # construction (see app_probe) and the human-facing half has to keep that promise: refusing to
  # start a mission because a URL could not be parsed would break every repo whose APP_URL this
  # does not understand, which is the widest possible reading of the narrowest possible fact.
  if [ -n "$APP_URL" ]; then
    local app_verdict app_state app_label
    app_verdict="$(app_probe "$APP_URL")"
    app_state="${app_verdict%%|*}"; app_label="${app_verdict#*|}"
    case "$app_state" in
      up)   ok "something is listening at $app_label (APP_URL)" ;;
      down)
        if [ -n "$E2E_CMD" ]; then
          _fail "nothing is listening at $app_label (APP_URL), and E2E_CMD is configured —
        gate_QA would run that suite against an app that is not there, and no session in this
        pipeline may start one. Start the app, or clear APP_URL if the e2e brings its own
        server up."
        else
          warn "nothing is listening at $app_label (APP_URL) — with no E2E_CMD no gate runs
        against it, but the exploratory QA session will need it up"
        fi
        ;;
      *) warn "APP_URL not probed: $app_label" ;;
    esac
  else
    dim "  ---  APP_URL not set — nothing to probe"
  fi

  # --- config ---
  bash -n "$CONFIG_FILE" && ok "config syntax valid"
  case "$TEST_CMD" in
    TODO|"") _fail "TEST_CMD not configured in .sdd/config.sh" ;;
    *)
      if test_cmd_looks_noop "$TEST_CMD"; then
        _fail "TEST_CMD runs nothing ($TEST_CMD) — it exits 0 having executed no test, so
        gate_EXEC, gate_QA and gate_REVIEW would pass instantly, in every mission, against a
        run that never happened. Point TEST_CMD at the suite itself."
      else
        # And then RUN it. Everything above is a string heuristic: it knows a handful of spellings
        # of "this executes nothing" and certifies every other value on sight. A repo whose
        # `npm test` dies on a dependency nobody installed passes that heuristic green — and then
        # gate_EXEC, which runs the SAME command for real, refuses for ever at one EXEC session per
        # lap, because a session cannot install what no gate ever told anyone about.
        #
        # Only in the arm the heuristic accepted: a value already judged wrong is not executed, or
        # the preflight would be running whatever someone typed into a key it had just rejected.
        # Through run_check_cmd, which already memoises and already puts the output in the mission
        # log rather than on the runner's stdout.
        local test_rc=0
        run_check_cmd "$TEST_CMD" "preflight-test" || test_rc=$?
        if [ "$test_rc" -eq 0 ]; then
          ok "TEST_CMD ran green ($TEST_CMD)"
        else
          _fail "TEST_CMD FAILED (rc $test_rc): $TEST_CMD
        gate_EXEC, gate_QA and gate_REVIEW run this same command, so a red suite makes the EXEC
        phase unsatisfiable — one session per lap, for ever. Output: $LAST_CHECK_LOG"
        fi
      fi ;;
  esac

  # DEFAULT_BRANCH is the base of `gh pr create` in the PR phase — the LAST phase, after EXEC, QA,
  # REVIEW and DOCS have all been paid for. Nothing ever asked the repository whether the branch was
  # there: load_config demands only a non-empty value, and warn_if_on_base_branch only compares it
  # with the current branch's NAME. The REMOTE ref is what decides, because that is what the PR is
  # opened against — a branch that exists only locally is a warning and not an ok, since the PR
  # still cannot be opened there.
  if ( cd "$REPO_ROOT" && git rev-parse --verify --quiet "refs/remotes/origin/$DEFAULT_BRANCH" >/dev/null ); then
    ok "DEFAULT_BRANCH=$DEFAULT_BRANCH exists on origin"
  elif ( cd "$REPO_ROOT" && git rev-parse --verify --quiet "refs/heads/$DEFAULT_BRANCH" >/dev/null ); then
    warn "DEFAULT_BRANCH=$DEFAULT_BRANCH exists locally but not on origin — 'gh pr create --base'
        opens the PR against the REMOTE branch, so the PR phase would fail there. Push the branch,
        or fix the key in .sdd/config.sh."
  else
    _fail "DEFAULT_BRANCH=$DEFAULT_BRANCH is not a branch of this repository (neither
        origin/$DEFAULT_BRANCH nor a local one). The PR phase ends in 'gh pr create --base
        $DEFAULT_BRANCH' — the last phase there is, so the error would arrive with EXEC, QA,
        REVIEW and DOCS already paid for."
  fi
  if [ "$JIRA_ENABLED" = "true" ]; then
    if [ -f "$REPO_ROOT/.jira-project" ]; then ok "JIRA enabled, .jira-project present"
    else _fail "JIRA_ENABLED=true but there is no .jira-project in the repo (the ticket skill needs it)"; fi
  else
    dim "  ---  JIRA_ENABLED=false — the TICKET phase will be skipped"
  fi

  # --- third-party skills the phases boot ---
  # Asked for BY CONFIG, not by a fixed list: a project with no interface never boots the QA
  # skills, and JIRA off means the TICKET phase is skipped entirely. Warning about a skill the
  # pipeline will not use is how an operator learns to skip reading warnings.
  local sk skills_root missing_skills=""
  skills_root="${SDD_SKILLS_ROOT:-$HOME/.claude}"
  local -a wanted=(codereview)   # REVIEW runs in every mission
  [ "$JIRA_ENABLED" = "true" ] && wanted+=(ticket)
  { [ -n "$E2E_CMD" ] || [ -n "$APP_URL" ]; } && wanted+=(qa-report qa-execution)
  for sk in "${wanted[@]}"; do
    skill_findable "$sk" || missing_skills="$missing_skills $sk"
  done
  if [ -z "$missing_skills" ]; then
    ok "third-party skills present (${wanted[*]})"
  else
    warn "skills not found:$missing_skills
        Looked in $skills_root/skills/, $skills_root/plugins/cache/ and
        $REPO_ROOT/.claude/skills/ — those roots are a convention, so this is a warning and not a
        failure. The phase boots the skill by name anyway: if it really is absent, the session
        improvises and spends the phase budget producing something no gate can read."
  fi

  # --- target repo plugins ---
  local settings="$REPO_ROOT/.claude/settings.json"
  if [ -f "$settings" ]; then
    local p missing=""
    for p in ddd kaizen-software; do
      grep -q "\"$p@" "$settings" || missing="$missing $p"
    done
    if [ -z "$missing" ]; then ok "plugins ddd + kaizen-software enabled"
    else warn "plugins not enabled in .claude/settings.json:$missing (the planner invokes them)"; fi
  else
    warn ".claude/settings.json missing — ddd/kaizen plugins not enabled in the repo"
  fi

  # --- installed agents ---
  # `cmp -s` and not `[ -f ]`: what the harness loads is the COPY in .claude/agents/, so a source
  # that was fixed proves nothing about the text the agent will actually run. Presence-only made
  # the "N kit agent(s) checked" line below a label over a comparison that never happened, and it
  # bit for real — 2132cf5 edited agents/sdd-kaizen.md, the copy stayed behind, green in
  # everything. Two failures and not one: absent and stale are different repairs, and telling an
  # operator to install a file that is right there on disk sends them the wrong way.
  local a name copy n=0
  for a in "$SDD_HOME"/agents/sdd-*.md; do
    [ -e "$a" ] || continue
    n=$((n + 1))
    name="$(basename "$a")"
    copy="$REPO_ROOT/.claude/agents/$name"
    if [ ! -f "$copy" ]; then
      _fail "agent $name not installed — run 'sdd install'"
    elif ! cmp -s "$a" "$copy"; then
      _fail "agent $name stale — .claude/agents/$name no longer matches $a.
        The harness loads the copy, so this agent keeps running the old text while the kit source
        looks corrected. Run 'sdd install --force' (or 'sdd install' to see the diff first)."
    fi
  done
  # Only claims "checked" when no agent failed — saying it right after six failure lines is the
  # output contradicting itself, which is the kind of lie the kit forbids in the gates.
  if [ "$n" -gt 0 ] && [ "$fails" -eq 0 ]; then ok "$n kit agent(s) checked"; fi

  # --- git state ---
  local branch; branch="$( cd "$REPO_ROOT" && git branch --show-current )"
  ok "current branch: $branch"
  warn_if_on_base_branch
  if [ -n "$( cd "$REPO_ROOT" && git status --porcelain )" ]; then
    _fail "working tree dirty — the pipeline needs a clean base to attribute commits to increments"
  else
    ok "working tree clean"
  fi

  info ""
  if [ "$fails" -eq 0 ]; then
    printf '%spreflight ok%s\n' "$C_GREEN$C_BOLD" "$C_RESET"; return 0
  fi
  printf '%s%d check(s) failed%s\n' "$C_RED$C_BOLD" "$fails" "$C_RESET" >&2
  return 1
}

# ---------------------------------------------------------------------------
# Sensor of the KIT (≠ preflight, which is about the target repo's environment).
#
# Reads everything from $SDD_HOME, so it works from inside any target repo and does NOT require
# .sdd/config.sh. It answers a single question: "does the kit still measure what it claims to?"
#
# WARNING when touching this: the file runs with `set -o pipefail`, and `printf ... | grep -q`
# returns 141 when grep FINDS the match and exits before printf finished writing (SIGPIPE) —
# the logic silently inverts for large inputs and stays correct for small ones, which is the
# worst of both worlds. That is why every search below uses a herestring (`<<<`).
# ---------------------------------------------------------------------------
HEALTH_FAILS=0
HEALTH_FINDINGS=""

health_bad() { bad "$*"; HEALTH_FAILS=$((HEALTH_FAILS + 1)); }

# Records a drift finding for the ratchet to judge at the end.
health_finding() { HEALTH_FINDINGS="${HEALTH_FINDINGS}${1}"$'\n'; }
# A check that could not measure declares the KEY it would have produced, so the ratchet can tell
# "this debt is gone" apart from "nobody looked". Without it the stale half judged anyway: with a
# suite that died before printing `N finding(s)`, `sdd health` said in one breath that it had gone
# blind to the backlog and that `todo-findings 74` "is no longer a finding — delete the line".
# Deleting it removes the backlog ratchet's only anchor. Destructive advice drawn from a
# measurement that declared itself impossible.
HEALTH_BLIND=""
health_blind() { HEALTH_BLIND="${HEALTH_BLIND}${1}"$'\n'; }

# Keys with a default in load_config(). The block is delimited by the anchor comments, not by
# line number, so it does not rot at the first refactor.
health_default_keys() {
  awk '/^load_config\(\) \{/ { inside = 1 } inside && /^\}/ { exit } inside' "$SDD_HOME/bin/sdd" \
    | grep -oE '\$\{[A-Z0-9_]+:=' | tr -d '${:=' | sort -u
}

cmd_health() {
  # `catalogue_green` is the ONE thing check 2c reads out of checks 1 and 2, and it is a variable
  # rather than a re-reading of the output because the stamp has to mean BOTH: a green
  # `--with-mutation` run (check 1) AND a score whose two numbers agree (check 2). Either one alone
  # is a world this repo has already shipped — a red suite over a perfect score line, and a green
  # suite over `103 caught … of 104`.
  local out rc k n catalogue_green=0 kit
  # The tree, resolved ONCE and used by every check below — including the stamp, which is the whole
  # point: what this command measures and what it stamps can never again be two different trees.
  kit="$(health_kit_root || true)"

  # The tree is IN the header, because it is now an answer and no longer a constant: an operator
  # standing in a worktree has to be able to see which of their checkouts was just measured.
  step "sdd health — kit sensor at $kit"

  # --- 1. the suite, which already includes bash -n and the mutation --------
  # `|| rc=$?` and not `; rc=$?`: this file runs under `set -e`, an assignment takes the exit
  # status of its command substitution, and a RED SUITE is precisely a non-zero one — so the bare
  # form died HERE, on the assignment, and the health_bad three lines down was dead code. The
  # operator got the header, rc 1, and not one word about the suite. Measured against the real
  # runner, four sites of this same family (this one, the score read, the provenance `find` and
  # the ratchet's baseline read); the whole point of `sdd health` is to SAY what is wrong, and the
  # red suite is the case it exists for. Guarded by the `abort:` assertions of check-health.sh.
  # The content key read BEFORE the suite, and compared with the one read after it — because the
  # run below takes twenty to fifty minutes, and that is the widest window in the whole kit for the
  # tree to move underneath a measurement. Read after the run alone, the stamp would key on whatever
  # is on disk when the command ENDS, so a commit landing during the catalogue would be handed a
  # green it was never part of: the instrument certifying content it did not measure, which is the
  # exact defect the stamp exists to end. Found while reviewing this block, not in production —
  # and reachable in practice, since the phase that runs `sdd health` is the phase that also
  # commits.
  local stamp_key_before
  stamp_key_before="$(mutation_stamp_key "$kit" || true)"

  rc=0
  # `--with-mutation`, and this command is now the ONLY caller that asks for it. The catalogue used
  # to ride inside TEST_CMD, where it held the working tree for over ten minutes per gate and made
  # the REVIEW phase unsatisfiable headless — three sessions ended their turn "waiting for the
  # suite", which in `claude -p` is ending the session. tests/run-all.sh carries the full reasoning.
  # Nothing was loosened: all the assertions are still demanded, here, once, by the command whose
  # whole job is asking whether the kit still measures what it claims to.
  out="$( cd "$kit" && tests/run-all.sh --with-mutation 2>&1 )" || rc=$?
  if [ "$rc" -eq 0 ]; then ok "suite green"; else
    # The flag is IN the reproduction line. Without it the operator runs the fast suite, sees green
    # over a red the catalogue found, and concludes health is lying — the one thing this command
    # may never be. The sentence has to name the command that reproduces what was just measured.
    health_bad "suite red (rc $rc) — run tests/run-all.sh --with-mutation to see it"
    printf '%s\n' "$out" | tail -15 >&2
  fi

  # --- 2. mutation score, read from the SAME run ---------------------------
  # A missing line fails: if the score format changes, this check would go blind and pass in
  # silence — the very vacuity that check-mutation.sh exists to hunt.
  #
  # The regex below is one contract across two files: the line is emitted by
  # tests/check-mutation.sh. Change the wording on either side alone and the suite goes red.
  #
  # `|| true` for the same reason the TODO.md count below carries one: a grep that matches nothing
  # returns 1, and under `set -e` the assignment took the runner down with it — so the `-z` branch
  # that was written to shout "health went blind" could never be reached, and going blind read as
  # a crash. The sentence below is only sayable because of the two words on this line.
  # The THREE numbers of that line, read once, because the verdict needs TWO of them compared.
  # The old form asked `^score: [0-9]+ caught, 0 known gap` and NOTHING about `of` — so
  # `score: 103 caught, 0 known gap(s), of 104`, a catalogue with a mutant ALIVE, printed `ok`
  # here. It is not a hypothetical: the main branch carried exactly that line between PR #12 and
  # #13, for days, while every gate ran the fast suite and answered green. Since 4c86712 the
  # catalogue is opt-in and THIS command is its only caller, so `ok` here is the whole verdict.
  #
  # A survivor is not a gap, and the two get different sentences on purpose: a gap is debt this
  # repo DECLARED, listed by name in KNOWN_GAPS with the increment that closes it; a survivor is
  # protection the catalogue goes on crediting that nobody owns. Same green before, and the
  # operator could not tell which one they had.
  # How many mutants the catalogue DEFINES, read off the file that printed the line being judged.
  # `score: 0 caught, 0 known gap(s), of 0` satisfies both conditions below it — no gap, and
  # `caught == of` — because `CATALOG=()` runs the loop zero times, leaves `errors` at 0 and exits
  # 0: the emptiest possible run printing the greenest possible line, stamped by check 2c, opening
  # gate_PR over a catalogue that measured nothing. A catalogue merely NARROWED does the same, one
  # deleted entry at a time and never once going red. It was the last count of this command with no
  # anti-vacuity floor, beside LINT_FLOOR, SURFACE_FLOOR, CAPTURE_FLOOR and REVIEW_FLOOR.
  #
  # Compared against the mut_*() DEFINITIONS and never against a number written here: `of` is
  # `${#CATALOG[@]}`, so a hand-narrowed CATALOG agrees with itself and the functions left behind
  # are the only thing on disk that can contradict it. MUTATION_CATALOGUE_FLOOR is the other half —
  # gut both and the comparison would read 0 == 0 — and neither number ever needs bumping by hand.
  #
  # `|| true` for the family this whole region is audited for: `grep -c` returns 1 exactly when it
  # counts zero, and unguarded that kills the runner on this line, with every sentence below it
  # dead code. A missing or renamed catalogue lands on 0 and is REFUSED, which is the side of the
  # fence a count that cannot be taken belongs on.
  local score_line score_nums caught gaps total defined
  defined="$(grep -cE '^mut_[A-Za-z0-9_]+\(\) \{' "$kit/tests/check-mutation.sh" 2>/dev/null || true)"
  if [ -z "$defined" ]; then defined=0; fi
  score_line="$(grep -m1 '^score: ' <<< "$out" || true)"
  score_nums="$(sed -nE 's/^score: ([0-9]+) caught, ([0-9]+) known gap\(s\), of ([0-9]+)$/\1 \2 \3/p' <<< "$score_line" || true)"
  if [ -z "$score_line" ]; then
    health_bad "the suite did not print the 'score:' line — health went blind to the mutation"
  elif [ -z "$score_nums" ]; then
    # Shape drift is a contract breach, never a green. Without this branch the whole comparison
    # below would be skipped by a line the sed stopped reading, which is the same vacuity as the
    # missing line above — with the extra insult of a `score:` sitting right there in the log.
    health_bad "the 'score:' line no longer parses — health went blind to the mutation: $score_line"
  else
    read -r caught gaps total <<< "$score_nums"
    # SIZE first, and the order is a dependency rather than a taste: with `of` disagreeing with the
    # catalogue on disk, neither the gap count nor the survivor count is about the catalogue this
    # kit has, so both sentences below would describe a measurement that did not happen. It takes
    # nothing away from them either — a catalogue of the right size can still carry a gap or a
    # survivor, which is the ordinary world both were written for.
    if [ "$total" -ne "$defined" ] || [ "$defined" -lt "$MUTATION_CATALOGUE_FLOOR" ]; then
      health_bad "mutation: the catalogue ran $total of the $defined mutant(s) tests/check-mutation.sh defines (floor $MUTATION_CATALOGUE_FLOOR) — an emptied or narrowed catalogue goes on printing caught == of, and that green is about a loop that ran $total time(s)"
    elif [ "$gaps" -ne 0 ]; then
      health_bad "mutation with an open gap — $score_line"
    elif [ "$caught" -ne "$total" ]; then
      # The reproduction command is IN the sentence, the same rule the red-suite line above obeys:
      # without it the operator runs the fast suite, sees green, and concludes health is lying.
      health_bad "mutation: $caught of $total caught — $((total - caught)) survivor(s), assertions the suite does not have — run tests/run-all.sh --with-mutation"
    else
      ok "mutation: $score_line"
      # An `if` and never `[ … ] && catalogue_green=1`: under this file's `set -e` the `&&` list is
      # the last command of the branch, so a red suite here would make the whole `if` statement
      # return non-zero and kill cmd_health one line after it said the catalogue was clean.
      if [ "$rc" -eq 0 ]; then catalogue_green=1; fi
    fi
  fi

  # --- 2b. the TEST_CMD the GATES will run has to actually RUN something ----
  # `tests/run-all.sh --list` exits 0 having executed nothing. That is the mode's contract and it
  # is correct — what is not correct is that its output is indistinguishable from a suite that
  # passed: a dozen step names and rc 0. As TEST_CMD it makes gate_EXEC, gate_QA and gate_REVIEW
  # pass INSTANTLY, in every mission, forever, and every phase would certify itself against a run
  # that never happened. Label instead of artifact, reached through the one key the whole pipeline
  # trusts, and nothing in the kit said a word.
  #
  # Numbered 2b and not 3: the numbers of these blocks are cited from tests/check-health.sh and
  # from the catalogue's own comments, and renumbering six of them to insert one is how a citation
  # rots. It sits here, beside the other question about the suite, rather than at the end where
  # append-only numbering would have put it.
  #
  # Read off the KIT's own .sdd/config.sh (tracked — only .sdd/logs/ is ignored) and never off
  # $REPO_ROOT, for three reasons that agree: `sdd health` is the kit sensor, and its other eight
  # checks all read $kit; `--list` is a flag of the KIT's suite, so this is where the danger lives
  # and a target repo's `npm test` could not carry it; and resolving $REPO_ROOT here would make the
  # check need a git repository, which neither the check-health.sh fixture nor the mutation sandbox
  # is — it would die where it was written to speak.
  #
  # SOURCED, not grepped, because the value that matters is the one load_config() hands the gates,
  # after expansion — and sourcing this file is what load_config() already does for every other
  # command. In a subshell, so nothing here can reach the rest of the run.
  local kit_cfg="$kit/.sdd/config.sh" kit_test_cmd
  if [ ! -f "$kit_cfg" ]; then
    health_bad "the kit at $kit has no .sdd/config.sh — health cannot say whether TEST_CMD runs anything"
  else
    # `|| true` in the tail, the same family the whole command was audited for — but the reason is
    # the LAST command of the substitution and not the sourcing. Measured, because the first version
    # of this comment claimed the sourcing was what could kill the run and that is false: without
    # `shopt -s inherit_errexit` a `$( … )` does not carry errexit in, so a config that fails to
    # parse still reaches the `printf` and the substitution exits 0.
    # Reproduced with a bad.sh holding `if then fi`, run through this exact assignment under
    # `set -euo pipefail`: the shell reaches the line after it and reports rc 0.
    # (The command is described and not pasted: the `guard:` census of check-health.sh scans this
    # region line by line and would have counted the example as a twenty-third capture — it did,
    # once, and the ratchet went red. Fail-closed, and noted in TODO.md.)
    # What the guard is really for is the day this line grows a different tail — and for the record
    # a broken config lands as EMPTY here, so the operator is told "declares no TEST_CMD" while the
    # parse error itself is swallowed by the redirect. That gap is in TODO.md, not hidden here.
    # shellcheck disable=SC1090
    kit_test_cmd="$( . "$kit_cfg" >/dev/null 2>&1; printf '%s' "${TEST_CMD:-}" )" || true
    # Padded on both sides so `--list` is matched as a WHOLE ARGUMENT: an unpadded `*--list*` would
    # also accuse a suite named `run-all.sh --listen-mode`, and a rule that fails on correct config
    # is a rule the next author deletes.
    case " $kit_test_cmd " in
      *" --list "*)
        health_bad "TEST_CMD carries --list ($kit_test_cmd) — that mode exits 0 having run NOTHING, so every gate would pass against a suite that never ran" ;;
      *)
        if [ -z "$kit_test_cmd" ]; then
          health_bad "the kit's .sdd/config.sh declares no TEST_CMD — the gates have no suite to run"
        else
          ok "TEST_CMD runs the suite ($kit_test_cmd)"
        fi ;;
    esac
  fi

  # --- 2c. the stamp: the catalogue stops depending on somebody REMEMBERING --
  # Checks 1 and 2 have just answered the only question the catalogue can be asked, and until now
  # that answer died with the terminal it was printed on. gate_PR needs it in DISK, because the
  # alternative it replaces is a memory — "somebody ran the catalogue at some point" — which is a
  # label, and this repo's first principle is that a label is not an artifact.
  #
  # Numbered 2c beside its two inputs rather than appended at the end, for the reason 2b spells
  # out: these numbers are cited from tests/check-health.sh and from the catalogue's own comments,
  # and renumbering the blocks below to insert one is how a citation rots.
  #
  # Written AFTER the run and never before, and keyed on the content the run measured, so what
  # lands on disk is "this exact tree was measured green" and never "the command was here".
  local stamp_path="$kit/$MUTATION_STAMP_REL" stamp_key
  stamp_key="$(mutation_stamp_key "$kit" || true)"
  if [ "$catalogue_green" != 1 ] || [ -z "$stamp_key" ]; then
    # REMOVED, not merely left behind. A stamp that outlives the green it certifies is the exact
    # label this block exists to replace: it would go on telling gate_PR that a catalogue which
    # just came back red, over this very content, had been measured and was clean.
    rm -f "$stamp_path"
  elif [ "$stamp_key" != "$stamp_key_before" ]; then
    # The window, closed. Saying it out loud matters as much as refusing: an operator who watched
    # a green catalogue scroll past and then finds gate_PR still asking for a stamp needs to be
    # told that their own commit, not the catalogue, is why.
    health_bad "the measured tree moved WHILE the catalogue was running — nothing was stamped, because the green it just reported is about content that is no longer here. Re-run once the tree stops moving."
    rm -f "$stamp_path"
  elif mkdir -p "${stamp_path%/*}" 2>/dev/null && printf '%s\n' "$stamp_key" > "$stamp_path" 2>/dev/null; then
    # The write is a CONDITION and not a statement, which is what keeps a read-only .sdd/ from
    # killing the command on the very line written to report it — the family every capture in this
    # region carries a guard against.
    ok "mutation stamp written — gate_PR can see that THIS content ran green"
  else
    health_bad "the mutation stamp could not be written at $stamp_path — gate_PR will go on asking for it"
  fi

  # --- 3. the TODO.md backlog count, read from the SAME run ----------------
  # The count is a CONTRACT between two files: tests/check-todo.sh writes the line, bin/sdd reads
  # it, and NOBODY EVER RECOUNTS. A `grep -c '^- \[ \]' TODO.md` here answers one too many — it
  # swallows the format example inside the header's fenced block, which the parser of
  # check-todo.sh needed a whole review round to learn to skip. Reword the line on either side
  # alone and this goes red, exactly like the `score:` contract above.
  #
  # Growing is still allowed: principle 5 of CLAUDE.md does not change, and a mission that finds
  # three real things has to be able to write them down. What is forbidden is growing UNDECLARED.
  # The number is a line of tests/health-baseline.txt, so it moves in a diff with an author, and
  # health_ratchet refuses it in both directions — the count that rose without a record and the
  # baseline left behind after a sweep.
  #
  # `|| true` is not noise. Under this file's own `set -e`, a grep that matches nothing makes the
  # assignment return 1 and kills the runner mid-command — rc 1, not one word said — so the
  # `-z` branch below would be unreachable and a broken contract would read as a crash. Same
  # family as the two silent aborts of `find` and `grep -vE` recorded in TODO.md.
  local todo_line
  todo_line="$(grep -m1 -E '^  ok    [0-9]+ finding\(s\)' <<< "$out" || true)"
  if [ -z "$todo_line" ]; then
    health_bad "the suite did not print the TODO.md finding count — health went blind to the backlog"
    health_blind "todo-findings"
  else
    health_finding "todo-findings $(sed -E 's/^  ok    ([0-9]+) .*/\1/' <<< "$todo_line")"
  fi

  # --- 4. every gate has a mutation ----------------------------------------
  # Explicit floor: zero gates found would pass by vacuity (a rename, an indentation change).
  #
  # ⚠️ The floor was UNREACHABLE until the r2 review of 20260818-lote-facil, and by the exact
  # mechanism it was written against: the two captures below are how `grep` reports "no match",
  # and under this file's `set -e` a capture that reports non-zero kills the runner AT THE
  # ASSIGNMENT. Renaming the gates — the scenario this comment names — made `sdd health` stop
  # dead after check 2, rc 1, without ever saying `found 0 gates`. Measured. `grep -c` is the
  # second half of the same pair and returns 1 precisely when it counts ZERO, so guarding only
  # the line above would have moved the death one line down.
  local gates; gates="$(grep -oE '^gate_[A-Z]+' "$kit/bin/sdd" | sed 's/^gate_//' | sort -u || true)"
  n="$(grep -c . <<< "$gates" || true)"
  if [ "$n" -ne 8 ]; then
    health_bad "found $n gates in bin/sdd, expected 8 — new/renamed gate: update the floor here"
  else
    local without_mutation=""
    for k in $gates; do
      grep -qE "^mut_${k}_" "$kit/tests/check-mutation.sh" || without_mutation="$without_mutation $k"
    done
    if [ -n "$without_mutation" ]; then
      health_bad "gate(s) with no mutation in the catalogue:$without_mutation — a gate nobody sabotages is not measured"
    else
      ok "all 8 gates have a mutation in the catalogue"
    fi
  fi

  # --- 5. drift load_config() ↔ config/schema.md ----------------------------
  # Both captures guarded for the reason spelled out at check 4, and both measured dying: a
  # reformatted key table in schema.md killed the runner on the first line, a load_config() that
  # lost its `:=` defaults killed it on the second — three ok lines and out, rc 1, silent.
  #
  # `keys` then carries a FLOOR, and the floor is the other half of the fix. Guarding a capture
  # turns "dies loudly by accident" into "carries on with an empty string", and an empty `keys`
  # makes the loop below iterate zero times: check 5 half-blind and check 7 fully blind, both
  # reporting nothing and both looking exactly like a clean kit. An abort at least stopped the
  # line; silent vacuity does not. `documented` needs no floor — empty makes every key land in
  # `key-without-doc`, which the ratchet says out loud.
  local documented; documented="$(grep -oE '^\| `[A-Z0-9_]+`' "$kit/config/schema.md" | tr -d '|` ' | sort -u || true)"
  local keys; keys="$(health_default_keys || true)"
  if [ -z "$keys" ]; then
    health_bad "load_config() declares no defaulted key — checks 5 and 7 have nothing to measure"
  fi
  for k in $keys; do
    grep -qxF "$k" <<< "$documented" || health_finding "key-without-doc $k"
  done
  for k in $documented; do
    grep -qxF "$k" <<< "$keys" || health_finding "doc-without-key $k"
  done

  # --- 6. subcommand missing from --help -----------------------------------
  local subcmds; subcmds="$(awk '/^main\(\) \{/ { inside = 1 } inside && /^\}/ { exit }
      inside && match($0, /^ +[a-z|+-]+\)/) {
        label = substr($0, RSTART, RLENGTH); gsub(/[ )]/, "", label); print label
      }' "$kit/bin/sdd" | tr '|' '\n' | grep -vE '^-' | sort -u || true)"
  # `sdd help` is the one capture here whose command is the runner itself: it exits 0 today, and
  # the day a refactor makes it exit non-zero this check would take the whole command down with
  # it rather than reporting anything. Guarded like the rest; an empty `help_out` then lands every
  # subcommand in `cmd-not-in-help`, which the ratchet says out loud.
  local help_out; help_out="$( "$kit/bin/sdd" help 2>&1 || true )"
  # Floor, same argument as `keys` at check 5: a `main()` whose case labels stop matching leaves
  # this loop with nothing to iterate, and a check measuring nothing prints exactly what a clean
  # kit prints.
  if [ -z "$subcmds" ]; then
    health_bad "no subcommand parsed out of main() — check 6 has nothing to measure"
  fi
  for k in $subcmds; do
    # Appearing as `sdd <cmd>` anywhere in the help is enough: some share a line
    # (`sdd help | sdd version`), and demanding a fixed column would fail a documented command.
    grep -qE "\bsdd $k\b" <<< "$help_out" || health_finding "cmd-not-in-help $k"
  done

  # --- 7. variable with a default and never read ---------------------------
  # BARE word, not `$K`: QA_MAX_ITER and EXEC_MAX_RETRY live in arithmetic context
  # (`$(( QA_MAX_ITER * 3 ))`), and a detector looking for `$K` would call them dead.
  # Scope: bin/sdd only. Sweeping the whole kit would make the key "appear" in schema.md and in
  # starter.conf — the sensor would start measuring the documentation of the debt instead of the
  # debt. A comment line does not count as a read either, for the same reason: quoting the key in
  # an explanation would make it "live" and hide exactly what it represents.
  local body; body="$(awk '/^load_config\(\) \{/ { inside = 1 }
      inside && /^\}/ { inside = 0; next } !inside && !/^[[:space:]]*#/' "$kit/bin/sdd" || true)"
  for k in $keys; do
    grep -qE "\b${k}\b" <<< "$body" || health_finding "var-never-read $k"
  done

  # --- 8. fixture provenance -----------------------------------------------
  health_provenance

  # --- ratchet --------------------------------------------------------------
  health_ratchet

  echo
  if [ "$HEALTH_FAILS" -eq 0 ]; then ok "kit healthy"; return 0; fi
  bad "$HEALTH_FAILS check(s) failed"
  return 1
}

# The fixture has to match what the skill EMITS. It is the countermeasure for the most expensive
# bug in the kit's history, and the only check that depends on the machine — which is why it
# lives here and not in the suite, which has to stay hermetic. Skill absent ⇒ skipped, exactly
# the way the linter check is skipped when the linter is not installed.
# (Do not start a comment line with the linter's name: it would parse as a directive, SC1073.)
health_provenance() {
  local gates="$SDD_HOME/tests/check-gates.sh" tpl line fix skipped=0 checked=0
  # The number of fixtures this function pins, in ONE place: the three `if [ -f "$tpl" ]` blocks
  # below. Move it when you add a fourth.
  #
  # DECLARED LIMIT — the kit has a fourth captured third-party fixture and this function does not
  # reach it. `tests/fixtures/acli-workitem-search-done.json` is stdout captured from a CLI, and the
  # mechanism here is a DIFF against the installed file the capture came from; a command's stdout
  # has no installed file, and asking acli live would need credentials and a network, which is a
  # different kind of check from this one. So the gap is written down instead of pretended away: if
  # acli renames `key` or moves it under `fields`, `close_query` stops matching and every close
  # regime stays green on the frozen bytes. What IS pinned is the shape the runner reads, asserted
  # next to the fixture in check-gates.sh — enough to catch a fixture edited until the tests pass,
  # not enough to catch the tool moving underneath it.
  local PROVENANCE_FIXTURES=3

  # ⚠️ Every `grep` below carries `|| true`, and this is the site where the family of silent
  # aborts costs the most. `-f "$tpl"` proves the FILE is there; it proves nothing about the
  # LINE. A skill that renames the field it pins — `- **Started:**` becoming anything else — is
  # not a hypothetical: it is the precise drift this whole function exists to catch, and it is
  # the way skills actually change. Unguarded, the grep found nothing, returned 1, and `set -e`
  # killed the runner ON THE ASSIGNMENT: `sdd health` printed three ok lines and exited 1 without
  # the words `fixture diverged`, without the ratchet, and without a verdict. The countermeasure
  # for the most expensive bug in the kit's history went silent exactly when it fired. Measured
  # in the r2 review of 20260818-lote-facil, against both skills, both directions; guarded by
  # the `abort:` assertions of check-health.sh and by mut_HEALTH_provenance_line_aborts.
  # Empty is the right value and needs no branch of its own: an absent line can never equal the
  # fixture, so the existing comparison reports it as the divergence it is.
  #
  # qa-execution report: the Status line, with the timestamp made concrete in the fixture.
  # ⚠️ That sentence is a RANGE ANCHOR, not decoration: mut_HEALTH_report_provenance_blind and
  # mut_HEALTH_provenance_blind address themselves between it and the `registry bug` line below,
  # and rewriting this comment without it reported both as CATALOGUE-BROKEN — measured, when the
  # r2 review first replaced the comment wholesale.
  tpl="$HOME/.claude/skills/qa-execution/assets/report-template.md"
  if [ -f "$tpl" ]; then
    line="$(grep -m1 -- '- \*\*Started:\*\*' "$tpl" || true)"
    fix="$(grep -m1 -- '- \*\*Started:\*\*' "$gates" | sed 's/2026-01-01T10:00:00Z/<ISO timestamp>/' || true)"
    # `-n` FIRST, and it is not decoration: with the guard above, two ABSENCES compare equal, so
    # a skill and a fixture that both dropped the line would read as a match and increment
    # `checked`. That is the fail-open the guard would have bought at the price of the abort —
    # the same trade the r1 round of this mission made in check-todo.sh and had to undo.
    if [ -n "$line" ] && [ "$line" = "$fix" ]; then checked=$((checked + 1))
    else health_bad "report fixture diverged from the skill:
         skill:   $line
         fixture: $fix"; fi
  else skipped=$((skipped + 1)); fi

  # registry bug: the Status line with the enum legend
  tpl="$HOME/.claude/skills/qa-report/assets/bug-template.md"
  if [ -f "$tpl" ]; then
    line="$(grep -m1 -- '- \*\*Status:\*\*' "$tpl" || true)"
    fix="$(grep -m1 -- '- \*\*Status:\*\* open' "$gates" || true)"
    if [ -n "$line" ] && [ "$line" = "$fix" ]; then checked=$((checked + 1))
    else health_bad "bug fixture diverged from the skill:
         skill:   $line
         fixture: $fix"; fi
  else skipped=$((skipped + 1)); fi

  # codereview grade table: every criterion of the skill must exist in the fixture.
  # `sort -V` on the plugin version — a lexicographic `sort` would put 1.9 after 1.17. This was
  # once the only version-ordered pick in the file; latest_matching() carried the lexicographic
  # bug and this comment recorded it. It no longer does — both sort by version now.
  #
  # `|| true`: `find` on a missing directory returns 1, `set -o pipefail` carries that through
  # `sort -V | tail -1`, and `set -e` then killed the whole command on the assignment — on a
  # machine with no plugins cache, `sdd health` stopped dead HERE, three ok lines in, and neither
  # provenance nor the ratchet ever ran. A machine without the directory is not a defect, it is a
  # machine: an empty `$tpl` is the skip this branch already knows how to do.
  tpl="$(find "$HOME/.claude/plugins/cache" -path '*/codereview/*/references/report-template.md' \
         2>/dev/null | sort -V | tail -1 || true)"
  if [ -n "$tpl" ] && [ -f "$tpl" ]; then
    local missing="" n_crit=0
    while IFS= read -r k; do
      [ -n "$k" ] || continue
      n_crit=$((n_crit + 1))
      grep -qF "| $k |" "$gates" || missing="$missing '$k'"
    done < <(awk -F'|' '/^\| Criterion \| Grade/ { t = 1; next }
        t && /^\|-/ { next }
        t && /^\|/ { c = $2; gsub(/^[ \t]+|[ \t]+$/, "", c); if (c !~ /^\*\*/) print c; next }
        t { exit }' "$tpl")
    # The floor, for the same argument checks 5 and 6 got theirs on: with the skill's heading
    # renamed, the `while` runs ZERO times, `missing` stays empty, `checked` goes up and the
    # summary says `all 3 fixtures match` about a table it never read — which is precisely the
    # drift this function exists to catch. One criterion is enough to prove the awk found the
    # table; demanding today's seven would fail the day the skill legitimately grows an eighth.
    if [ "$n_crit" -eq 0 ]; then
      health_bad "the codereview grade table read as EMPTY — the '| Criterion | Grade' heading this parses was renamed, so nothing was compared"
    elif [ -n "$missing" ]; then
      health_bad "the skill's grade table has a criterion the fixture does not cover:$missing"
    else checked=$((checked + 1)); fi
  else skipped=$((skipped + 1)); fi

  # The summary reads `checked` and `skipped`, and it may not claim the third state. A DIVERGED
  # fixture increments neither counter — it went to `health_bad` — so with three skills installed
  # and one diverged the old rubric fell through to the `else` and printed `all 3 fixtures match
  # the installed skills` on the line right after saying one of them did not. Unreachable until
  # the r2 review of 20260818-lote-facil guarded the two `grep` captures above, because the run
  # used to die before printing anything at all; guarding them turned a silent abort into a loud
  # lie, and a lie in the summary of the provenance check is worse than either. Three states,
  # three sentences, and the `all 3` wording is reserved for the one world where it is true.
  # One owner for the count, read by the arithmetic AND by the sentence. Written twice, the two
  # drifted the moment a fourth fixture was added: the rubric picked its branch from one number
  # and the operator read the other.
  local diverged=$(( PROVENANCE_FIXTURES - checked - skipped ))
  if [ "$diverged" -gt 0 ]; then
    ok "provenance: $checked fixture(s) match, $diverged diverged, $skipped skipped"
  elif [ "$skipped" -gt 0 ]; then
    ok "provenance: $checked fixture(s) checked, $skipped skipped (skill not installed)"
  else
    ok "provenance: all $PROVENANCE_FIXTURES fixtures match the installed skills"
  fi
}

# A new finding fails; a baseline line that stopped being a finding fails too. Both directions
# matter: without the first the debt grows on its own, without the second the list turns into
# folklore.
health_ratchet() {
  local bl="$SDD_HOME/tests/health-baseline.txt" known new_findings=0 stale=0 line
  # `|| true`: a baseline with no live line (all comments, or missing outright) makes this grep
  # return 1, and under `set -e` the runner died on the assignment — after the provenance line,
  # before a single word of the ratchet, so it neither said `kit healthy` nor failed anything. An
  # empty `known` is not an error to crash on: it means NOTHING is known debt, so every finding is
  # outside the baseline, which is exactly what the loop below then says out loud.
  known="$(grep -vE '^[[:space:]]*(#|$)' "$bl" | sed 's/[[:space:]]*#.*//' \
           | sed 's/[[:space:]]*$//' || true)"

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    grep -qxF "$line" <<< "$known" \
      || { health_bad "finding outside the baseline: $line"; new_findings=$((new_findings + 1)); }
  done <<< "$HEALTH_FINDINGS"

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    # The key is the first field: a baseline line is `<key> <value>`, and a blind producer knows
    # its key but not the value it never measured.
    if grep -qxF "${line%% *}" <<< "$HEALTH_BLIND"; then
      info "  baseline '$line' not judged: the check that produces it declared itself blind"
      continue
    fi
    grep -qxF "$line" <<< "$HEALTH_FINDINGS" \
      || { health_bad "stale baseline: '$line' is no longer a finding — delete the line"; stale=$((stale + 1)); }
  done <<< "$known"

  # An `if` and not an `&&` chain, and the difference is a whole line of output. The chain returns
  # the status of its first failing test, so a ratchet that FOUND something made health_ratchet
  # return 1 — and `set -e` killed cmd_health on the call, one line before its own verdict. The
  # finding was printed and then `N check(s) failed` never was: same family as the four capture
  # sites above, same silence, and it hit the path that WORKS rather than a broken one. Every
  # assertion here read only `rc != 0`, which is authored by the `return 1` at the end of
  # cmd_health too, so nothing noticed. Failures are already counted in HEALTH_FAILS; this
  # function's job is to report, never to decide the exit code.
  if [ "$new_findings" -eq 0 ] && [ "$stale" -eq 0 ]; then
    ok "ratchet: $(grep -c . <<< "$known") known debt(s), none new"
  fi
}

cmd_status() {
  load_config
  resolve_mission "${1:-}"
  step "mission $MISSION — $PROJECT_NAME"
  info ""

  local ph state why
  for ph in $PHASES; do
    if "gate_$ph"; then state="${C_GREEN}✓${C_RESET}"; else state="${C_YELLOW}·${C_RESET}"; fi
    why="$GATE_WHY"
    printf '  %b %-7s %s%s%s\n' "$state" "$ph" "$C_DIM" "$why" "$C_RESET"
  done

  info ""
  local rows; rows="$(checkpoint_rows)"
  if [ -n "$rows" ]; then
    info "  increments:"
    local id title _c st commit mark
    while IFS=$'\t' read -r id title _c st commit; do
      case "$st" in
        done)    mark="${C_GREEN}✓${C_RESET}" ;;
        blocked) mark="${C_RED}✗${C_RESET}" ;;
        doing)   mark="${C_YELLOW}▸${C_RESET}" ;;
        *)       mark="${C_DIM}·${C_RESET}" ;;
      esac
      printf '    %b %-4s %-46s %s%s%s\n' "$mark" "$id" "${title:0:46}" "$C_DIM" "${commit:0:8}" "$C_RESET"
    done <<< "$rows"
  fi

  info ""
  local next; next="$(current_phase)"
  if [ -z "$next" ]; then
    printf '  %spipeline complete — only the merge is left (the human gate)%s\n' "$C_GREEN$C_BOLD" "$C_RESET"
  else
    "gate_$next" || true
    printf '  next phase: %s%s%s — %s\n' "$C_BOLD" "$next" "$C_RESET" "$GATE_WHY"
    printf '  %srun: sdd run %s%s\n' "$C_DIM" "$MISSION" "$C_RESET"
  fi
}

# Prints only the name of the current phase (or DONE). It exists for scripts and for the kit's
# own tests — `sdd status` is for humans, this one is for machines.
cmd_phase() {
  load_config
  resolve_mission "${1:-}"
  local next; next="$(current_phase)"
  printf '%s\n' "${next:-DONE}"
}

# Prints why the gate of a specific phase did not pass.
cmd_why() {
  load_config
  resolve_mission "${1:-}"
  local ph="${2:-}"
  [ -n "$ph" ] || ph="$(current_phase)"
  [ -n "$ph" ] || { info "pipeline complete"; return 0; }
  "gate_$ph" || true
  printf '%s: %s\n' "$ph" "$GATE_WHY"
}

# `sdd approve <mission>` — the human gate of the PLAN phase gets a command.
#
# Until this existed, unlocking gate_PLAN meant opening 00-missao.md and typing
# `aprovacao: humano-YYYY-MM-DD` in the exact shape the gate greps. Two ways that goes wrong, and
# both were seen: the format comes out slightly off and the gate stays shut with a message about a
# key the human believes they just wrote, or the edit gets delegated to the session — and the
# session is precisely the party that may not decide whether the plan is worth building.
#
# It is NOT a phase and it never opens a session: approving is the one thing in the pipeline that
# has to come from outside it. The two deliberate `claude -p` calls outside run_phase() stay two
# (the preflight probe and `sdd close`); this command reads stdin and writes a file.
#
# It prints before it asks. An approval given without the plan on screen is the manual edit with
# extra steps, so the whole mission body goes to stdout — title, PLAN-AUTO evidence, out of scope,
# open questions — plus the increment table, which lives in the other file. The body is printed
# whole rather than section by section on purpose: section headings are mission content in
# OUTPUT_LANG, and a runner that grepped for them would work in pt-BR repos and go quietly blind
# everywhere else.
cmd_approve() {
  load_config
  resolve_mission "${1:-}"
  local m="$MISSION_DIR/00-missao.md"

  # The gate's own diagnosis, taken from the gate: this command exists to satisfy gate_PLAN, and a
  # human told "missing 01-plano.md" by `sdd status` must not hear something different from the
  # command that is supposed to fix it. GATE_WHY is read, never re-worded.
  if ! gate_PLAN && [[ $GATE_WHY == missing\ * ]]; then die "$GATE_WHY"; fi

  local approval; approval="$(frontmatter "$m" aprovacao)"
  # Idempotence, with ONE exception, and the exception is the whole point of the guard below.
  # `auto` beside a 05-verdict.md is not an approval anybody gave — it is the machine certifying
  # its own homework, which is exactly the state gate_PLAN refuses while naming THIS command as the
  # way out. Reading it as "already approved" made the named remedy decline every plan the gate
  # stopped: not sometimes, never. plan_approves_itself is the gate's own condition, read here
  # rather than restated, so the two cannot drift apart again.
  #
  # Everything else keeps bailing, and the verdict-less `auto` is why that matters: an approve that
  # simply stopped recognising `auto` would rewrite every planner-written approval into
  # `humano-<today>` on contact, erasing in silence the PLAN-AUTO provenance the value carries.
  case "$approval" in
    auto|humano-*)
      if ! plan_approves_itself; then
        info "plan $MISSION is already approved (aprovacao: $approval) — nothing to do"
        return 0
      fi
      warn "aprovacao: auto with 05-verdict.md beside it — this plan was born of sdd kaizen and"
      warn "cannot certify its own homework. Approving replaces it with your own approval."
      ;;
  esac

  step "approve plan — $MISSION"
  info ""
  local titulo; titulo="$(frontmatter "$m" titulo)"
  info "  ${titulo:-<no titulo: in the frontmatter of 00-missao.md>}"
  info ""
  # From the line after the closing `---` to the end. Same awk shape as frontmatter(), so a file
  # with no frontmatter at all prints nothing rather than printing itself twice.
  awk 'NR==1 && $0=="---" { inside=1; next }
       inside && $0=="---" { inside=0; body=1; next }
       body { print "  " $0 }' "$m"

  local rows; rows="$(checkpoint_rows)"
  info ""
  if [ -n "$rows" ]; then
    info "  increments:"
    local id title _check st _commit
    while IFS=$'\t' read -r id title _check st _commit; do
      printf '    %-4s %-46s %s\n' "$id" "${title:0:46}" "$st"
    done <<< "$rows"
  fi

  # ONE definition of the value being written, read three times below (the warning, the write, the
  # read-back). Split into a literal at each site, a mutant that writes `auto` — an approval that
  # claims the PLAN-AUTO table was all ✅ when a human in fact typed y — would still satisfy the
  # read-back and reach the commit. Sabotaging this single line is what mut_RUN_approve_writes_auto
  # does, and the assertion that dies is the one demanding `humano-` AND the absence of `auto`.
  local approved_as; approved_as="humano-$(date +%F)"

  info ""
  dim "  approving says: this plan is what you want built. It writes aprovacao: $approved_as"
  dim "  into 00-missao.md and commits that one file. It does NOT start the pipeline."
  # The fifth door, and the only one whose commit a human asks for out loud. It went in written by
  # the same mission that closed the silence of the fourth (`sdd retry`) and shipped silent itself:
  # standing on `main`, approving dropped a `chore(missao)` commit straight into the base branch
  # without a word — the SQ-97 class, reopened by the door this mission created. sdd-qa walked it.
  #
  # A warning and NEVER a `die`, unlike the checkout of ensure_mission_branch: the plan legitimately
  # lives on the base branch before the mission branch is cut, and it is from there that the cut is
  # made — refusing would lock out the ordinary flow.
  #
  # HERE and not at the top of the command, which is where the other four doors call it: those four
  # print almost nothing before acting, while this one prints the entire mission body plus the
  # increment table, and a warning at the top would have scrolled off the screen by the time the
  # question is asked. The rule the other call sites state as "ahead of anything that could scroll
  # it away" reads, at a prompt, as "in the breath before the decision". After the idempotence bail
  # for the second reason those comments give: a warning on a path that cannot commit is the crying
  # wolf that teaches people to skip reading them.
  warn_if_on_base_branch
  printf '  approve this plan? [y/N] '
  # `|| ans=""`: with stdin closed, `read` returns non-zero and `set -e` would abort mid-prompt.
  # Anything that is not an explicit yes is a no — the default of a [y/N] prompt is the safe side.
  local ans=""
  read -r ans || ans=""
  # The prompt ends without a newline, and a terminal supplies one when the human hits Enter. A
  # pipe or a closed stdin does not, and the answer would sit glued to the prompt.
  info ""
  case "$ans" in
    y|Y|yes|Yes|YES) : ;;
    *) info "  not approved — nothing was written"; return 0 ;;
  esac

  frontmatter_write "$m" aprovacao "$approved_as"
  # Read back through the same parser the gate uses. An absent `aprovacao:` key leaves
  # frontmatter_write a no-op by design, and committing that would be an approval that approves
  # nothing — the artifact has to answer the gate's question before the commit is made.
  local written; written="$(frontmatter "$m" aprovacao)"
  [ "$written" = "$approved_as" ] \
    || die "could not write 'aprovacao: $approved_as' into $m (it reads '${written:-<empty>}') — is the 'aprovacao:' key in the frontmatter?"

  local rel="${m#"$REPO_ROOT/"}"
  # `-- "$rel"` on the commit, not `git commit -a`: whatever else the tree is carrying is none of
  # this command's business. `git add` first so the path is known to the index even on the first
  # commit of a brand-new mission directory.
  ( cd "$REPO_ROOT" \
    && git add -- "$rel" \
    && git commit -q -m "chore(missao): plan $MISSION approved by the human" \
         -m "Written by 'sdd approve': closing the PLAN gate used to mean editing the frontmatter
by hand, in the exact shape gate_PLAN greps. Only 00-missao.md enters this commit." \
         -- "$rel" ) \
    || die "git refused the approval commit — 'aprovacao: $approved_as' IS written in $rel, commit it by hand"

  ok "approved: aprovacao: $approved_as"

  # ASK THE GATE AGAIN. It was asked once, at the top, and only `missing *` was allowed to stop the
  # command — every other reason gate_PLAN can hold was carried straight past the commit into a
  # `next: sdd run` that the very next `sdd why` refuses. The reproduction is a config, not a corner
  # case: JIRA_ENABLED=true with `versao:` still a placeholder is what the pilot's target repo ships.
  #
  # Re-asking rather than adding a second condition here is the point. gate_PLAN holds for approval,
  # for a kaizen-born plan, for `versao:` and for an unparseable checkpoint today, and every reason
  # it learns tomorrow would inherit the defect for free if this command carried its own list.
  # The hand-written "the PLAN gate will stay shut" warning above the prompt went with it: it was a
  # restatement of one of those reasons, and the gate says it now, in the gate's own words.
  if gate_PLAN; then
    dim "  next: sdd run $MISSION"
  else
    warn "the PLAN gate is still shut, for a reason approving does not touch:"
    warn "  $GATE_WHY"
    dim "  fix that first — 'sdd run $MISSION' would refuse."
  fi
}

# Third Jidoka: the handoff itself says the line stopped. `blocked` already meant exactly that
# (:1602), but the refusal used to go through the fingerprint heuristic like any other gate failure
# — so a phase NOBODY can satisfy paid for proving its own unsatisfiability twice, at one session
# apiece, and a session that committed something honest read as `moved=true` and bought another lap
# instead. In QA that is not hypothetical: no agent in this pipeline may write the registry's
# `Status:` line, so a bug needing a product decision has no path out at all. Measured in
# 20260825-frete-cif-fob — 7 of the 12 QA sessions in that loop, US$ 73,32 of US$ 144,88.
#
# Read from the MARKER and not from GATE_WHY: see the contract above GATE_HANDOFF_BLOCKED.
#
# ONE definition and TWO doors in cmd_run's loop — the first pass and the inline retry — which is
# the same shape kit_guard_check already has, for the same reason: the body must not drift between
# the call sites, but WHERE the doors sit is a property of the loop and cannot be hoisted in here.
# The retry door is not decoration. The marker is a global, `current_phase` runs in a SUBSHELL and
# cannot clear the parent's copy, and every gate but gate_QA leaves it alone — so a retry that
# declared `blocked` and carried on took the marker into the next lap, where gate_EXEC ran with it
# still set and this escalation fired for EXEC: "the phase's handoff declares 'status: blocked'"
# printed over a 20-handoff-exec.md that said `done`, the retry EXEC was owed swallowed, and
# {phase: EXEC, kind: handoff-blocked} written into the ledger the kaizen judge reads. Found by the
# QA phase of 20260826-o-laco-da-qa, and reached by the pipeline obeying its own instructions:
# `agents/sdd-qa.md` § 4 tells the QA session to answer a fixable bug with a `pending` F<n> row, and
# a pending row is exactly what sends the next lap to EXEC.
#
# Returns 0 when it escalated — the caller answers with `return 3` — and 1 when the marker is unset.
# Callers spell that `if handoff_blocked_escalation "$phase"; then return 3; fi` rather than
# `... && return 3`: under `set -e` the status of an && list whose left side failed is not worth
# reasoning about at a call site whose whole job is to NOT exit.
#
# CALLED, never substituted. `x="$(handoff_blocked_escalation …)"` would run it in a subshell and
# send the ledger row and the five lines a human is meant to act on into the substitution instead
# of to the ledger and the terminal — the family CLAUDE.md records against `run_phase`.
handoff_blocked_escalation() {
  local phase="$1"
  [ "$GATE_HANDOFF_BLOCKED" = "1" ] || return 1
  info ""
  bad "BLOCKED in $phase — $GATE_WHY"
  dim "  The line stopped on purpose: the phase's handoff declares 'status: blocked'."
  dim "  Another session would re-read the same handoff and refuse the same way."
  # Same refusal as the EXEC Jidoka: names the section by what it IS, never by a heading that is
  # artifact content in OUTPUT_LANG.
  dim "  Read the handoff — the decisions it needs from a human are written there."
  dim "  Once they are taken, set the handoff's status back and 'sdd run'."
  pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
  autonomy_blocked_row "handoff-blocked" "$phase" "$GATE_WHY"
  return 0
}

# Fourth Jidoka, and the sibling of the one above in every respect that matters: same marker
# discipline, same two doors, same rc 3. What differs is WHO has to act. `handoff-blocked` says a
# human owes the pipeline a decision; this one says a human owes it a MACHINE — the e2e came back
# red and nothing is listening where APP_URL points, and no agent in this pipeline is allowed to
# bring an environment up (config/schema.md declares that the operator's job, and this mission
# deliberately did not change it: the runner learns to ASK, not to act).
#
# Without it the runner read a dead app as "QA still has work to do" and bought another opus
# session, for ever: measured on the SQ-111 mission of 2026-08-27 at US$ 14,16 for one such QA,
# plus US$ 7,61 for the lap that reopened a mission whose PR was already open.
#
# TWO DOORS, for exactly the reason the paragraph above GATE_APP_DOWN re-derives rather than
# assumes: the first pass and the inline retry. With only the first, a retry whose gate armed the
# marker would carry it into the next lap, where gate_EXEC — which never touches it — would let
# this escalation fire for EXEC, printing an APP_URL diagnosis over a phase that never ran an e2e.
# That is the F2 failure measured on the handoff-blocked sibling, one house along; the contract
# above the marker says every new marker owes the derivation, and this is it.
#
# Returns 0 when it escalated and 1 when the marker is unset, and it is CALLED, never substituted
# — a subshell would send the ledger row and the five lines a human is meant to act on into the
# substitution instead of to the ledger and the terminal.
app_down_escalation() {
  local phase="$1"
  [ "$GATE_APP_DOWN" = "1" ] || return 1
  info ""
  bad "BLOCKED in $phase — $GATE_WHY"
  dim "  The line stopped on purpose: the e2e is red and the address in APP_URL refuses"
  dim "  connections. No session in this pipeline may bring an environment up."
  dim "  Another session would run the same e2e against the same dead address and refuse"
  dim "  the same way."
  dim "  Start the app and 'sdd run' — or, if the e2e brings its own server up, clear APP_URL."
  pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
  autonomy_blocked_row "app-down" "$phase" "$GATE_WHY"
  return 0
}

# Writes one `gate_pass` row for every phase that bought a session in THIS run, failed its gate,
# and has since closed without buying another. Called from the derived branch of cmd_run's loop and
# from nowhere else — it reads cmd_run's own `sessions`, `gate_failed` and `gate_pass_logged` maps
# through dynamic scope, so it is CALLED and never `$( )`: substituted, the `gate_pass_logged`
# write would die with the subshell and the row would be re-emitted every lap. That is the
# autonomy_kit_stamp scar, one function over.
#
# PRECONDITION, stated because dynamic scope does not state itself: the three `local -A` maps must
# be in scope at the call site. `cmd_retry` calls `current_phase()` too and is the obvious next place
# somebody adds a second call — without the maps, `set -u` reads `${sessions[$ph]:-0}` as an INDEXED
# subscript and arithmetic-evaluates `PLAN`, so the runner dies with `PLAN: unbound variable` on the
# first phase. Loud, which is the right direction, and named here so the next writer does not have
# to discover it.
#
# THE ARGUMENT IS THE DERIVED PHASE, and it is what makes this cheap and provable at once.
# `current_phase()` returns the FIRST phase of $PHASES whose gate fails, so every phase BEFORE its
# answer has a gate that just passed — measured by the very derivation that produced `$upto`, in
# this same lap. An empty `$upto` means the pipeline is complete and every phase passed. No gate is
# re-run here: doing so would run TEST_CMD again to learn what the derivation already knew.
#
# THE CONDITION IS NARROW, and deliberately so (decided with the human, grill of 2026-08-31).
# `current_phase()` re-evaluates every gate on every derivation, so "a gate passed without a
# session" is the NORMAL state of every already-closed phase of every resumed run, and `sdd status`
# asks the same question. Without it this would append up to six rows a lap to a file that is
# append-only by contract. With it, the row exists only where the judge was about to be wrong: the
# phase paid for a session, that session failed the gate, and the gate closed later for free.
#
# DECLARED, NO PROBE: the `sessions > 0` test is redundant TODAY and is kept anyway. `gate_failed`
# is written at exactly the two sites that increment `sessions`, so the test below it already
# implies this one — sabotaged away, the whole suite stays green, and that is stated here rather
# than dressed up as coverage. It stays because it decides WHICH failure the next writer of
# `gate_failed` produces, and one is a line away: arming the marker in the `over_ceiling` branch
# (a phase whose ceiling came off the DISK opens no session in this invocation) would, without this
# test, record that a phase closed for free in a run where it never ran at all. That is the world I
# could not build with today's code, NOT a claim that none exists — the distinction this repo paid
# for in d4deb35 and had to undo in 7cbc8e2.
#
# DECLARED LIMIT: a phase whose session was paid for in run N and whose gate closes for free in run
# N+1 gets no row — `sessions` dies with the process. Its `refez` corrects itself on the first run
# where the whole pattern happens again. The alternative, writing on every derivation, is the six
# rows a lap above.
#
# NOT reachable from the projection: `--dry-run` returns before `autonomy_session_row`, so
# `sessions` is empty on every lap and this loop writes nothing. Pinned from the outside by
# "the projection writes no ledger at all" in tests/check-autonomy.sh rather than by a DRY_RUN
# branch here — a guard whose removal no probe could notice is a guard this repo does not keep.
gate_pass_rows() {   # gate_pass_rows <derived-phase, empty when the pipeline is complete>
  local upto="$1" ph
  for ph in $PHASES; do
    if [ "$ph" = "$upto" ]; then break; fi
    if [ "${sessions[$ph]:-0}" -eq 0 ]; then continue; fi
    if [ "${gate_failed[$ph]:-0}" -eq 0 ]; then continue; fi
    if [ -n "${gate_pass_logged[$ph]:-}" ]; then continue; fi
    gate_pass_logged["$ph"]=1
    autonomy_gate_pass_row "$ph"
  done
}

cmd_run() {
  local mission_arg="" force_phase="" max_phases=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run)     DRY_RUN=1 ;;
      --phase)       force_phase="${2:-}"; shift ;;
      --max-phases)  max_phases="${2:-0}"; shift ;;
      --budget-override) BUDGET_OVERRIDE=1 ;;
      -*)            die "unknown run option: $1" ;;
      *)             mission_arg="$1" ;;
    esac
    shift
  done

  load_config
  resolve_mission "$mission_arg"
  PIPELINE_LOG="$(log_dir)/pipeline.log"

  # One id per `sdd run` invocation. Without it a resumed mission produces two indistinguishable
  # `attempt:1` rows for the same phase; with it, "this mission needed N runs" becomes countable —
  # a better friction signal than the session count.
  AUTONOMY_RUN_ID="$(uuidgen)"
  AUTONOMY_INVOCATION="run"

  step "mission $MISSION — $PROJECT_NAME${DRY_RUN:+}"
  # "nothing will be executed" would be a lie: working out which phases are pending forces the
  # gates to run, and three of them run TEST_CMD. What the dry-run guarantees is narrower — no
  # claude session, no touching of the mission artifacts. Same honesty fix as in --help.
  [ "$DRY_RUN" = "1" ] && dim "  (dry-run: no session will be opened — but the gates do run TEST_CMD)"
  # BEFORE the base-branch warning, and the order is the point: the checkout is what decides where
  # this pipeline will commit, so warning first would cry wolf at a human the runner is about to
  # move off the base branch anyway — and a warning that cries wolf is how people learn to skip
  # reading them. In a dry run nothing is switched, so the projection still says out loud that you
  # are standing on `main`.
  ensure_mission_branch
  # Before the first gate, so it is on screen ahead of anything that could scroll it away. It warns
  # in a dry run too: the projection is where you look BEFORE spending sessions, which makes it the
  # cheapest moment to learn you are about to commit into the base branch.
  warn_if_on_base_branch
  # L4 (2026-09-03 audit): `--phase` is the human forcing the starting point. The note is written
  # HERE, off the CLI value and before the loop — inside it, force_phase is also set by the runner
  # itself (PUBLISH_ON_REVIEW_BLOCKED=draft), and that is the runner's hand, not the human's.
  [ -n "$force_phase" ] && checkpoint_note_intervention "sdd run --phase $force_phase (the human forced the starting phase)" "$force_phase"

  local -A attempts=()
  # SESSIONS, which is not the same grandeza as `attempts` and was being printed as if it were.
  # `attempts` counts laps of this loop: it rises on the lap that ESCALATES (which opens no session
  # at all) and on every later lap the REVIEW->PR->REVIEW degradation takes, so the blocked line
  # said `3 sessions` over a ledger holding one. It is the last thing a human reads when a run ends.
  # Incremented beside `autonomy_session_row` and nowhere else, so the number the terminal says and
  # the rows the ledger holds cannot drift: one writer, one counter, same two places.
  local -A sessions=()
  # The last gate verdict of each phase in THIS run, and the one-shot marker of the row that says
  # the gate closed afterwards for free. Written beside `sessions` at both session sites and read
  # by gate_pass_rows alone, so the three maps cannot drift out of step: one writer, one reader.
  local -A gate_failed=()
  local -A gate_pass_logged=()
  local phases_run=0 phase before after budget
  # One-shot per `sdd run`, in the spirit of AUTONOMY_SHA_WARNED above: the runner lowers its own
  # bar ONCE, and both trails have to say so once. A plain local of cmd_run is enough here — the
  # degradation branch runs in this very shell, never through `$( )`, so the CLAUDE.md lesson that
  # killed the kit stamp's guard (a global assigned inside a subshell dies with it) does not bite.
  local degraded_logged=0
  local dry_next=""   # dry-run projection cursor (distinct from --phase, which prints just one)

  while :; do
    if [ -n "$dry_next" ]; then phase="$dry_next"
    elif [ -n "$force_phase" ]; then phase="$force_phase"
    # The DERIVED branch alone, and that is the whole licence gate_pass_rows has to speak: this
    # `current_phase()` call is what proves every earlier phase's gate passed. `--phase X` and the
    # dry-run cursor never consult the derivation, so under either of them the runner knows nothing
    # about the other phases and says nothing about them. Called, never `$( )` — see the function.
    else phase="$(current_phase)"; gate_pass_rows "$phase"; fi

    if [ -z "$phase" ]; then
      info ""
      printf '%s✓ pipeline complete — only the merge is left (the one human gate)%s\n' \
        "$C_GREEN$C_BOLD" "$C_RESET"
      local prurl; prurl="$(frontmatter "$MISSION_DIR/50-pr.md" pr_url)"
      [ -n "$prurl" ] && info "  $prurl"
      kaizen_reminder
      return 0
    fi

    # PLAN is interactive by design: the human takes part in the grill. The runner does not boot
    # the planner.
    if [ "$phase" = "PLAN" ]; then
      gate_PLAN || true
      info ""
      warn "the PLAN phase is not headless: $GATE_WHY"
      dim "  Planning is where the human takes part. Open an interactive session with the"
      dim "  sdd-planner agent (Fable model) and produce 00-missao.md, 01-plano.md, checkpoint.md."
      dim "  Once the PLAN-AUTO gate closes clean, 'sdd run $MISSION' goes on alone to the PR."
      return 2
    fi

    # Real Jidoka: a `blocked` increment escalates ON THE SPOT. Without this the runner read the
    # checkpoint change as "progress" and rebooted EXEC until the phase budget blew — three
    # sessions against the same wall. Found by the fixture mission 20260814-dry-run-completo.
    # HERESTRING, not a pipe. Under `pipefail`, `grep -q` closes the pipe as soon as it matches,
    # the upstream `printf` dies of SIGPIPE and the whole pipeline returns 141 — the `if` reads
    # "no blocked" while blocked EXISTS. Putting the status in a variable first was NOT enough:
    # the pipe was still there, and the race is decided by the size of the text, not by where it
    # came from. Measured on a fixture checkpoint: the miss starts around 5000 rows, and the
    # runner then spends the whole phase budget against the wall it already knew was there —
    # exactly the false negative a Jidoka must never have. tests/check-gates.sh pins it with a
    # 20000-row checkpoint; the RUN_jidoka_pipefail mutation puts the pipe back and the suite
    # has to die.
    local ckstatus; ckstatus="$(checkpoint_rows | cut -f4)"
    if [ "$phase" = "EXEC" ] && grep -qx "blocked" <<< "$ckstatus"; then
      gate_EXEC || true
      info ""
      bad "BLOCKED in EXEC — $GATE_WHY"
      dim "  The line stopped on purpose: an increment was marked 'blocked' by the executor."
      # Names the section by what it IS, not by its literal title: the heading is artifact
      # content in OUTPUT_LANG, so hardcoding it here would leak one language into the runner.
      dim "  Read the execution-notes section of checkpoint.md — the reason is written there."
      dim "  Once the impediment is cleared, set the increment back to 'pending' and 'sdd run'."
      pipeline_log_line "$(date -Iseconds)  BLOCKED  EXEC  increment marked blocked by the executor"
      autonomy_blocked_row "increment-blocked" "EXEC" "$GATE_WHY"
      return 3
    fi

    # The second Jidoka of the same phase, and the one that costs money when it is missing. A phase
    # that dies mid-way leaves the tree uncommitted; the suite then runs against changes nobody
    # approved and comes back red; every increment still reads `done`, so EXEC is re-derived and
    # another session opens against the same wall. `state_fingerprint` does not read the working
    # tree, so `attempts` starts at zero on every `sdd run` — measured at about US$ 25 a lap, with
    # no end condition. A human has to commit or discard; no session can.
    #
    # gate_EXEC is CALLED, never `$( )`: read through a command substitution it runs in a subshell
    # and GATE_EXEC_DIRTY dies with it — the lesson autonomy_kit_stamp paid for. `|| true` because
    # the gate failing is the whole point here.
    if [ "$phase" = "EXEC" ]; then
      gate_EXEC || true
      if [ "$GATE_EXEC_DIRTY" = "1" ]; then
        info ""
        bad "BLOCKED in EXEC — $GATE_WHY"
        dim "  The line stopped on purpose: the working tree is dirty and the suite is red."
        dim "  A session would run against the same uncommitted changes and fail the same way."
        dim "  Commit what belongs to the mission, or 'git restore' what does not, then 'sdd run'."
        pipeline_log_line "$(date -Iseconds)  BLOCKED  EXEC  red suite over a dirty working tree"
        autonomy_blocked_row "dirty-tree" "EXEC" "$GATE_WHY"
        return 3
      fi
    fi

    # L2: the mission ceiling comes before the phase ceiling — money already spent, before a session.
    if mission_budget_blown "$phase"; then return 3; fi
    budget="$(phase_budget "$phase")"
    # `attempts` is the LAP number and it stays exactly that: it is what the ledger's `attempt`
    # field carries, and the retry inside a lap is told apart by `auto_retry` rather than by a
    # number of its own. It no longer decides anything about the ceiling.
    attempts["$phase"]="$(( ${attempts[$phase]:-0} + 1 ))"
    local over_ceiling=0 ceiling_note=""
    # SESSIONS, never laps. This line used to read `attempts`, which rises ONCE per lap, before the
    # first run_phase of that lap — and the retry inside the lap opens a second session without
    # touching it. So a budget of N bought up to 2N sessions, and QA's `QA_MAX_ITER * 3` = 9 was a
    # ceiling of 18. Every budget in phase_budget is already written in sessions ("3 sub-steps per
    # round"), so this makes the unit match the arithmetic instead of lowering a limit.
    #
    # Measured on 20260825-frete-cif-fob: the ceiling WORKED — 9 laps, exactly the limit — and 3 of
    # those laps bought a retry, turning 9 sessions into 12 at US$ 11.27. The phase was not out of
    # control; the meter was reading the wrong unit.
    #
    # `sessions` is the counter this loop already keeps at BOTH session sites and the blocked
    # headline already reads, so the number in the escalation and the number that caused it are one
    # quantity rather than two that agree by habit.
    #
    # ⚠️ `-ge`, and read BEFORE the lap, so the bound is budget + 1 rather than budget: the test
    # happens once per lap and a lap already admitted may still buy its retry. Said out loud
    # instead of hidden — exact accounting would need a second ceiling inside the lap, which is a
    # second door, and this file pays for that shape in four places already.
    [ "${sessions[$phase]:-0}" -ge "$budget" ] && over_ceiling=1
    # REVIEW's ceiling counts rounds IN TOTAL, and the total is on disk. `attempts` dies with the
    # process, so `sdd run` after a blown REVIEW used to hand out a fresh set of rounds, and the
    # most expensive phase in the kit had no ceiling at all across invocations. `phase_budget
    # REVIEW` stays as the intra-invocation guard: a session that writes no `40-review-r<N>.md`
    # moves nothing on disk and would otherwise loop inside one run.
    #
    # DERIVED path only. `--phase REVIEW` is a human asking for one specific round with their eyes
    # on it, and refusing that would leave no way to run the round that unblocks the mission.
    # `force_phase` is also how the PUBLISH_ON_REVIEW_BLOCKED=draft jump reaches PR, and it is
    # empty again by the time REVIEW is re-derived — so that degradation keeps its one chance.
    if [ "$phase" = "REVIEW" ] && [ -z "$force_phase" ]; then
      local rounds; rounds="$(review_rounds_on_disk)"
      if [ "$rounds" -ge "$REVIEW_MAX_ITER" ]; then
        over_ceiling=1
        ceiling_note="$rounds review round(s) already on disk, REVIEW_MAX_ITER=$REVIEW_MAX_ITER — the ceiling counts rounds IN TOTAL, derived from the 40-review-r<N>.md files, so 'sdd run' does not reset it"
      fi
    fi
    if [ "$over_ceiling" -eq 1 ]; then
      gate_"$phase" || true
      info ""
      bad "BLOCKED in $phase — ${sessions[$phase]:-0} session(s) without satisfying the gate"
      # `bad` and not `dim`, and directly under the headline: this is the line that makes the
      # headline's number true. When the ceiling comes off the DISK the count above is `0` — this
      # invocation opened no session, because the ceiling refused before it could — and read alone
      # that reads as a runner bug. `bad` writes to stderr and `dim` to stdout, so on `dim` the two
      # halves travelled on different channels: `sdd run 2>/dev/null` kept the sentence and dropped
      # the headline, `sdd run >file` kept the headline and dropped the sentence, and the escalation
      # a human is meant to ACT on lost the half that says what to do. Every other assertion about
      # this branch merges the channels with `2>&1` and cannot see the difference; the one in
      # tests/check-gates.sh that pins it reads stderr ALONE.
      [ -n "$ceiling_note" ] && bad "  $ceiling_note"
      bad "  current reason: $GATE_WHY"
      dim "  'sdd status $MISSION' shows the full state; 'sdd why $MISSION $phase' the reason."
      if [ "$phase" = "REVIEW" ] && [ "$PUBLISH_ON_REVIEW_BLOCKED" = "draft" ]; then
        # The two writers come BEFORE the `continue`, and that order is the whole I2 increment. The
        # jump used to be above both, so the single most interesting autonomy event a mission can
        # produce — the runner lowering its own bar, alone — left no trace anywhere: the journal
        # showed a PR phase after some failing REVIEW sessions, and the series showed the same,
        # with nothing saying why. `degraded`, not `blocked`: the run went ON.
        #
        # ONE CHANCE, AND ONLY ONE (F1 wrote the row once; I9 made the JUMP happen once). The
        # branch used to end in a bare `force_phase="PR"; continue`, which does not end the run:
        # PR ran, its own gate failed, `current_phase` handed REVIEW straight back with the budget
        # still blown, and the branch was re-entered lap after lap. Measured on the QA walk: warn
        # 3×, two PR sessions, and — the part that actually misinformed — the run finally escalated
        # as `budget-exhausted` in **PR**, blaming the phase that was never over budget for a
        # ceiling REVIEW had blown three laps earlier. F1 stopped the ledger from repeating the
        # `degraded` row; the spin underneath it stayed, and this closes it.
        if [ "$degraded_logged" = "0" ]; then
          degraded_logged=1
          # Inside the guard since I9: on the second entry the runner is NOT moving on to PR, so
          # saying so would be the terminal lying about what it is about to do. It used to sit
          # outside as check-autonomy.sh's witness that the fixture kept re-entering the branch —
          # a role the `budget-exhausted`-in-REVIEW row below now holds, and holds better, because
          # only a second entry can produce it.
          warn "PUBLISH_ON_REVIEW_BLOCKED=draft — moving on to PR in draft mode"
          pipeline_log_line "$(date -Iseconds)  DEGRADED  $phase  PUBLISH_ON_REVIEW_BLOCKED=draft, PR in draft mode — $GATE_WHY"
          autonomy_degraded_row "review-to-draft" "$phase" "$GATE_WHY"
          force_phase="PR"; continue
        fi
        # Second entry: the draft PR ran and its gate failed too. Falling through to the blocked
        # pair below ends the run on REVIEW — the phase whose budget is actually blown — reusing
        # the `blocked`/`budget-exhausted` pair that already sat there. Deliberately NOT a new
        # event kind: three readers share one `is_escalation` definition, and an event none of them
        # learned would be filed as unrecognized by all three.
        warn "  the draft PR did not satisfy its gate either — the run ends here"
      fi
      pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
      autonomy_blocked_row "budget-exhausted" "$phase" "$GATE_WHY"
      return 3
    fi

    before="$(state_fingerprint)"
    # The photograph, and it has to be taken HERE: once run_phase returns, the checkpoint the
    # session just edited is the only one left on disk and "how many were pending before" is
    # unanswerable. Guarded on the phase because it is the only phase with increments to count,
    # and empty is what the ledger writes as `null`.
    local exec_before=""
    if [ "$phase" = "EXEC" ]; then exec_before="$(checkpoint_tally | cut -f1)"; fi
    # The same photograph for REVIEW, and for the same reason: once the reviewer has written
    # `40-review-r<N>.md` the question "how many rounds were there before" is unanswerable.
    #
    # ⚠️ OUTSIDE the `[ -z "$force_phase" ]` guard the ceiling check above sits behind, and that is
    # the placement, not an oversight. `sdd run --phase REVIEW` is how a human asks for one specific
    # round with their eyes on it — the round that unblocks a mission — and a photograph taken
    # inside that guard would write `rounds_before: null` on exactly those. Pinned by the
    # `--phase REVIEW` fixture in tests/check-autonomy.sh.
    local review_before=""
    if [ "$phase" = "REVIEW" ]; then review_before="$(review_rounds_on_disk)"; fi
    kit_guard_arm
    run_phase "$phase"
    after="$(state_fingerprint)"
    kit_guard_check "$phase"
    # DOOR 1 of the review scope guard, beside its sibling and on the same terms: it writes only to
    # pipeline.log, none of state_fingerprint's three inputs, and `after` is already sampled one
    # line up. `${before%%|*}` is the first field of the fingerprint — the HEAD this session opened
    # against.
    review_scope_check "$phase" "${before%%|*}"

    # The projection branch stays FIRST, exactly where it is today. This is belt-and-suspenders,
    # not a cost saver: `run_check_cmd` memoizes and `run_phase`'s own dry-run branch returns
    # before `invalidate_checks`, so evaluating the gate before this branch would not add a real
    # TEST_CMD run. Keeping the ledger writer out of the projection path entirely — rather than
    # relying on `autonomy_append`'s own DRY_RUN guard as the only defense — is the actual reason.
    # No sensor pins this ordering; what tests/check-autonomy.sh asserts is the outcome, "the
    # projection writes no ledger at all".
    if [ "$DRY_RUN" = "1" ]; then
      # --phase <PHASE> asks for one specific phase: print only that one.
      [ -n "$force_phase" ] && return 0
      # Honest projection: the phases whose gate is unsatisfied TODAY, in canonical order. It
      # does not simulate the effect of the phases (it does not guess that EXEC would unblock
      # QA) — honest information is worth more than complete but possibly wrong information.
      dry_next="$(next_pending_phase "$phase")"
      [ -n "$dry_next" ] && continue
      dim "  (dry-run: end of the projection — no session was opened)"
      return 0
    fi

    # Evaluated ONCE into a variable, then branched on. Writing the ledger row inside each of the
    # four branches would multiply the same defect four times — and gate_ functions run TEST_CMD,
    # so calling them twice is not free either.
    local gate_rc=0 moved="false"
    gate_"$phase" || gate_rc=$?
    [ "$before" != "$after" ] && moved="true"
    # Captured into locals rather than read straight from the globals at the two call sites below,
    # and the phase guard is why. GATE_EXEC_PENDING outlives its gate ON PURPOSE, and
    # The vector is the DIRECT `gate_"$phase"` call one line up (and cmd_status's), never
    # `$(current_phase)`, whose subshell throws the assignments away: without the guard the REVIEW
    # session that follows a PASSING EXEC gate would be born carrying EXEC's counts and read as a
    # phase that advanced an increment it never had. Pinned by "a non-EXEC row carries the three as null" in
    # tests/check-autonomy.sh, in the one fixture where that sequence is reachable.
    local exec_after="" exec_total=""
    if [ "$phase" = "EXEC" ]; then exec_after="$GATE_EXEC_PENDING"; exec_total="$GATE_EXEC_TOTAL"; fi
    # Same door, same guard, for the REVIEW pair: GATE_REVIEW_ROUNDS outlives its gate the way
    # GATE_EXEC_PENDING does, so without the phase test the QA session that follows a REVIEW gate
    # would be born carrying a round count it never had.
    local review_after="" review_max=""
    if [ "$phase" = "REVIEW" ]; then review_after="$GATE_REVIEW_ROUNDS"; review_max="$GATE_REVIEW_MAX"; fi
    autonomy_session_row "$phase" "${attempts[$phase]}" "false" "$moved" \
      "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY" \
      "$exec_before" "$exec_after" "$exec_total" \
      "$review_before" "$review_after" "$review_max"
    sessions["$phase"]="$(( ${sessions[$phase]:-0} + 1 ))"
    # Beside the counter and never anywhere else, the discipline `sessions` itself is held to: the
    # gate verdict the ledger row carries and the one gate_pass_rows reads are the same quantity,
    # sampled once. Overwritten rather than accumulated — what the writer needs is the LAST verdict
    # of this phase, so a phase that failed twice and then passed correctly says nothing.
    gate_failed["$phase"]="$( [ "$gate_rc" -eq 0 ] && echo 0 || echo 1 )"

    # DOOR 1 of the blocked escalation — see handoff_blocked_escalation above for why it exists.
    # It is read immediately after the `gate_"$phase"` call that could have set the marker, and
    # BEFORE `moved` is consulted: the whole point is to stop depending on the fingerprint.
    #
    # ABOVE `--max-phases`, and that placement is the fix, not a preference. This is the THIRD
    # Jidoka, and its two siblings — the `blocked` increment (:3415) and the dirty tree (:3438) —
    # sit above the ceiling check and escalate whatever it says. Below it, this one alone answered
    # `--max-phases` FIRST: `sdd run <mission> --max-phases 1` on a handoff declaring
    # `status: blocked` opened and paid for a QA session, armed the marker, and returned **0** with
    # no ledger row and no pipeline.log line. An operator or CI wrapper pacing the pipeline one
    # phase at a time got the pre-fix behaviour for ever, with a SUCCESS exit code every time — the
    # very loop this mission exists to delete, wearing a green rc. Found in the REVIEW round of
    # 20260826-o-laco-da-qa, differentially against the increment-blocked sibling (rc 3 + row)
    # under the same flag. The session row above is already written, so the ledger keeps its order.
    if handoff_blocked_escalation "$phase"; then return 3; fi
    # DOOR 1 of the app-down escalation, on the same terms and in the same place: read right after
    # the gate call that could have armed it, BEFORE `moved` is consulted, and ABOVE the
    # `--max-phases` ceiling — a phase no session can satisfy must not answer a paced run with 0.
    if app_down_escalation "$phase"; then return 3; fi

    phases_run=$((phases_run + 1))
    if [ "$max_phases" -gt 0 ] && [ "$phases_run" -ge "$max_phases" ]; then
      info ""; dim "  --max-phases=$max_phases reached"; return 0
    fi

    if [ "$gate_rc" -eq 0 ]; then
      ok "gate $phase: $GATE_WHY"
      force_phase=""
      continue
    fi

    if [ "$moved" = "true" ]; then
      dim "  gate $phase not yet: $GATE_WHY (but the session moved forward — carrying on)"
      force_phase=""
      continue
    fi

    warn "gate $phase failed and the session changed nothing: $GATE_WHY"
    warn "  retrying once with the gate reason in the prompt"
    run_phase "$phase" "$LAST_PHASE_SID"
    # The retry gets its own pair of fingerprints. Until now it ran with no measurement at all,
    # and `moved/total` is precisely the metric that needs it.
    #
    # `after2` is sampled BEFORE `gate_$phase` runs, and the ordering is a decision, not an
    # accident: `moved2` has to answer "did the SESSION move the disk", so whatever the gate itself
    # writes must fall OUTSIDE the sample. It is sound today because `state_fingerprint` reads HEAD,
    # the mission listing and the checkpoint's md5, and no gate touches those three. A gate that
    # ever starts writing into the mission directory breaks the property silently — the symptom
    # would be `moved2=true` on a retry that changed nothing, which is exactly the reading that
    # keeps the runner from escalating. `cmd_kaizen` samples in the same order for the same reason.
    local after2 moved2="false" gate_rc2=0
    after2="$(state_fingerprint)"
    [ "$after" != "$after2" ] && moved2="true"
    # After `moved2` is settled, and outside the ordering constraint above. The check writes only
    # to pipeline.log — none of state_fingerprint's three inputs — but keeping it outside the
    # sampled window means that stays true whatever the fingerprint learns to read tomorrow.
    kit_guard_check "$phase"
    # DOOR 2, after `moved2` is settled for the same reason. `$before` and NOT `$after`: this retry
    # is reachable only through the `moved == "false"` guard above, so the first pass changed
    # nothing and the two heads are the same commit — but reading the one the LAP opened against
    # keeps that true the day a first pass can move the disk and still land here.
    review_scope_check "$phase" "${before%%|*}"
    gate_"$phase" || gate_rc2=$?
    # The retry takes NO photograph of its own: the gate ran between the two passes, so the first
    # pass's `pending_after` — `exec_after`, captured above and now already overwritten in the
    # global by the call one line up — IS where this retry started. Reading checkpoint_tally here
    # would sample a file the gate had judged one line earlier and credit the retry with the
    # progress of the pass before it.
    #
    # `:-$exec_before` and not a bare `$exec_after`, because `exec_after` is EMPTY whenever the
    # first pass's gate refused before publishing — a `done` with no commit, or the Jidoka block —
    # and an empty seventh argument writes `pending_before: null`. That null is not inert: the row
    # then matches `historic_progress`, the dated path built for rows written BEFORE these fields
    # existed, which hands it a `pending_before` of M and reads `advanced` over a retry that
    # advanced nothing. Reproduced end to end on 2026-08-30 with a real `sdd run` (the fixture is
    # the `== the inline retry records the count it started from ==` block of check-autonomy.sh):
    # photograph 1, `pending_after` 1, answer `advanced` off a fabricated 2. Fail-open in the
    # flattering direction, and it also made `sdd autonomy` count a minutes-old row in its
    # "older than the pending fields" disclosure — the very number that says when that path may be
    # deleted.
    #
    # The fallback is EXACT, not an approximation: this retry is reachable only through the
    # `moved == "false"` guard a few lines up, so the first pass changed nothing, and
    # `state_fingerprint` reads the checkpoint's md5 — the file the retry starts on is the same
    # bytes the photograph read. When the first gate DID publish, `exec_after` is non-empty and
    # wins, so no path that worked before changes.
    local exec_after2="" exec_total2=""
    if [ "$phase" = "EXEC" ]; then exec_after2="$GATE_EXEC_PENDING"; exec_total2="$GATE_EXEC_TOTAL"; fi
    # The REVIEW pair on the same terms, `:-` fallback included. `review_after` is where this retry
    # started — the gate ran between the two passes — and it is non-empty whenever the first pass's
    # gate ran at all, because gate_REVIEW publishes at the RESOLVE and answers 0 for no round file.
    # The fallback is what keeps a row from being born with `rounds_before: null` should a future
    # refusal ever return before that publication, which is the null the EXEC sibling one screen up
    # paid for end to end.
    local review_after2="" review_max2=""
    if [ "$phase" = "REVIEW" ]; then review_after2="$GATE_REVIEW_ROUNDS"; review_max2="$GATE_REVIEW_MAX"; fi
    autonomy_session_row "$phase" "${attempts[$phase]}" "true" "$moved2" \
      "$( [ "$gate_rc2" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY" \
      "${exec_after:-$exec_before}" "$exec_after2" "$exec_total2" \
      "${review_after:-$review_before}" "$review_after2" "$review_max2"
    sessions["$phase"]="$(( ${sessions[$phase]:-0} + 1 ))"
    # The retry is a session site of its own, so it is a `gate_failed` site of its own — one probe
    # per door, the shape CLAUDE.md spells out. Its verdict is the later one and overwrites the
    # first pass's, which is exactly what "the LAST verdict of this phase" means.
    gate_failed["$phase"]="$( [ "$gate_rc2" -eq 0 ] && echo 0 || echo 1 )"

    if [ "$gate_rc2" -eq 0 ]; then
      ok "gate $phase (on the retry): $GATE_WHY"
      force_phase=""
      continue
    fi

    # DOOR 2, on the same terms, and it is what keeps the marker from outliving the lap. Placed
    # after `moved2` is already settled, so it takes nothing away from the sampling window the
    # comment above defends — it only refuses to let `moved2` answer a question that is not its.
    if handoff_blocked_escalation "$phase"; then return 3; fi
    # DOOR 2, and it is what keeps THIS marker from outliving the lap either. Placed after
    # `moved2` is settled, so it takes nothing away from the sampling window.
    if app_down_escalation "$phase"; then return 3; fi

    if [ "$moved2" = "false" ]; then
      info ""
      bad "BLOCKED in $phase — two sessions without moving the disk: $GATE_WHY"
      pipeline_log_line "$(date -Iseconds)  BLOCKED  $phase  $GATE_WHY"
      autonomy_blocked_row "no-progress" "$phase" "$GATE_WHY"
      return 3
    fi
    force_phase=""
  done
}

cmd_retry() {
  local mission_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --budget-override) BUDGET_OVERRIDE=1 ;;
      -*)                die "unknown retry option: $1" ;;
      *)                 mission_arg="$1" ;;
    esac
    shift
  done
  load_config
  resolve_mission "$mission_arg"
  PIPELINE_LOG="$(log_dir)/pipeline.log"
  AUTONOMY_RUN_ID="$(uuidgen)"
  AUTONOMY_INVOCATION="retry"
  # The second call site of the single definition: `sdd retry` opens a session that COMMITS, so a
  # retry fired from the wrong branch lands the redone phase exactly where `sdd run` would not
  # have put it. Same guard, same die, same silence in a dry run (retry has no dry mode, and the
  # global defaults to 0 — the guard costs nothing and outlives the assumption).
  ensure_mission_branch
  # The fourth door, and the last of the four that existed then: `sdd retry` redoes a phase with a
  # FRESH session, and that session COMMITS. Fired from `main` it used to put the redone phase
  # straight into the base branch without a word — the one door of the four that opened in silence.
  # (`sdd approve`, written in this same mission, turned out to be a fifth and got the guard after.)
  #
  # AFTER ensure_mission_branch, exactly like cmd_run and for the same reason: the checkout is what
  # decides where this retry will commit, so warning first would cry wolf at a human the runner is
  # about to move off the base branch anyway.
  warn_if_on_base_branch
  local phase; phase="$(current_phase)"
  [ -n "$phase" ] || { info "pipeline complete — nothing to retry"; return 0; }
  [ "$phase" = "PLAN" ] && die "PLAN is interactive — there is nothing to retry headless"
  # L4 (2026-09-03 audit): a retry IS the human's hand — the template's own first example of one.
  checkpoint_note_intervention "sdd retry (the human relaunched the phase with a fresh session)" "$phase"
  # L2: the second door of the mission ceiling — a retry is a session too.
  if mission_budget_blown "$phase"; then return 3; fi
  step "retrying $phase with a FRESH session"
  local before after moved="false" gate_rc=0
  before="$(state_fingerprint)"
  # Same photograph, same phase guard, same reasons as cmd_run's — see the two comments there.
  local exec_before="" exec_after="" exec_total=""
  local review_before="" review_after="" review_max=""
  if [ "$phase" = "EXEC" ]; then exec_before="$(checkpoint_tally | cut -f1)"; fi
  # `sdd retry REVIEW` is the other way a human forces a round, and it has no `--phase` guard to
  # sit outside of: the photograph belongs here for the same reason it belongs in cmd_run.
  if [ "$phase" = "REVIEW" ]; then review_before="$(review_rounds_on_disk)"; fi
  kit_guard_arm
  run_phase "$phase"
  after="$(state_fingerprint)"
  kit_guard_check "$phase"
  # DOOR 3. `sdd retry REVIEW` opens a FRESH session that commits and never goes through cmd_run's
  # loop, so it needs its own call exactly as the kit guard does.
  review_scope_check "$phase" "${before%%|*}"
  [ "$before" != "$after" ] && moved="true"
  gate_"$phase" || gate_rc=$?
  # DECLARED, NO PROBE — and MEASURED, not assumed. These two guards are inert today: this function
  # calls `gate_"$phase"` only for the phase it is retrying, and `current_phase()` runs its gates
  # inside `$( )`, whose assignments die with the subshell. So both globals still hold the empty
  # string their declarations gave them (:736, :1015), and deleting either guard changes no byte of
  # the row — sabotaged one at a time, the suite stays green, where the two PHOTOGRAPH guards above
  # turn it red (both pinned by "sdd retry photographs only the phase it is retrying" in
  # tests/check-autonomy.sh). They stay because they decide WHICH failure the next writer gets the
  # day a second gate call in the parent shell is added here — the world this fixture could not
  # build, NOT a claim that none exists. That distinction is what d4deb35 got wrong and 7cbc8e2
  # had to undo.
  if [ "$phase" = "EXEC" ]; then exec_after="$GATE_EXEC_PENDING"; exec_total="$GATE_EXEC_TOTAL"; fi
  if [ "$phase" = "REVIEW" ]; then review_after="$GATE_REVIEW_ROUNDS"; review_max="$GATE_REVIEW_MAX"; fi
  autonomy_session_row "$phase" "1" "false" "$moved" \
    "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY" \
    "$exec_before" "$exec_after" "$exec_total" \
    "$review_before" "$review_after" "$review_max"
  if [ "$gate_rc" -eq 0 ]; then ok "gate $phase: $GATE_WHY"; return 0; fi
  bad "gate $phase not yet: $GATE_WHY"
  return 3
}

# ---------------------------------------------------------------------------
# Reader for the autonomy ledger. It prints NUMBERS and never a verdict: whether the kit improved
# is the judge's answer (sdd-kaizen, I13.3), and a reader that opines today becomes the yardstick
# that judge would have to contradict tomorrow.
#
# This command is the human's window; the JUDGE reads the JSONL with jq. Coupling I13.3 to this
# text would freeze a table nobody promised to keep.
#
# ONE sentence for one refusal, reached from the two guards below that mean it: a ledger that is not
# there, and a ledger that holds no row. It was written twice, word for word, and two copies is how
# one of them gets rewritten alone — this is the sentence that separates "empty ledger" from
# "corrupt ledger", and a second voice for it would send the reader hunting for a writer that never
# ran when the rows are merely unreadable. It PRINTS and nothing else: the `return 1` stays at each
# call site, where the control flow is readable, and there is no global to lose in a subshell.
autonomy_no_data() {   # autonomy_no_data <ledger path>
  warn "no data: the ledger at $1 does not exist yet (or has no rows)"
  dim "  It is written by 'sdd run' and 'sdd retry'. Nothing has been recorded on this machine."
}
cmd_autonomy() {
  # The kit_sha table answers "did this VERSION get better". D12 asks a different question — US$ per
  # merged PR, and how many times a human had to step in — and its unit is the MISSION. The two are
  # groupings of ONE population, so the money has to add up the same either way; check-autonomy.sh
  # compares the two sums to each other for exactly that reason.
  local by_mission=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all-repos)  LEDGER_ALL_REPOS=1 ;;
      --by-mission) by_mission=1 ;;
      *)            die "unknown autonomy option: $1" ;;
    esac
    shift
  done
  local file; file="$(autonomy_log_path)"
  command -v jq >/dev/null 2>&1 || die "jq not found — it is required to read the ledger"

  # Absent or empty is NOT zero waste. Zeros that look like excellence are exactly the vacuity the
  # floors in check-lang and cmd_health exist to kill.
  if [ ! -s "$file" ]; then
    autonomy_no_data "$file"
    return 1
  fi
  # A malformed row dies loudly. Skipping it quietly is how a judge ends up reading a subset and
  # calling it the whole history.
  ledger_parses "$file" || die "malformed row in $file — the ledger is not readable"

  # A REAL row count, not a line count. `grep -c .` counted LINES: a single pretty-printed JSON
  # row made the header say "9 row(s)" while the table correctly said "1 session(s)" — two
  # different units that only ever agreed by coincidence (and that `assert_bucket_sum` pins
  # jq-derived bucket counts against). Worse, `grep -c .` FAILS (rc 1, no match) on a ledger of
  # blank lines, which under `set -e` aborted this whole command with no output on either stream
  # and rc 1 — the SAME rc as the deliberate "no data" case below, making a corrupt ledger
  # indistinguishable from an empty one in a command whose whole thesis is dying loudly.
  # Counted AFTER the repo filter, and it has to be: the header total is what assert_bucket_sum
  # in check-autonomy.sh pins every bucket against, so a total that counted another repo rows
  # would turn that sum into an accusation against the buckets instead of a measurement.
  local repo; repo="$(ledger_repo_root)"
  local def; def="$(ledger_row_is_local)"
  local odefs; odefs="$(ledger_outcome_defs)"
  local total lines norepo
  lines="$(jq -s 'length' "$file")"
  norepo="$(jq -s --arg repo "$repo" "$def"' map(select(ledger_row_no_repo)) | length' "$file")"
  total="$(jq -s --arg repo "$repo" "$def"' map(select(ledger_row_is_local)) | length' "$file")"
  if [ "$total" -eq 0 ]; then
    # FOUR different silences, named apart: an empty file, a ledger of rows that name no repo at
    # all, a cwd that belongs to no repo, and a ledger full of somebody else rows. Collapsing them
    # into one "no data" would send the reader hunting for a runner that never wrote, when the rows
    # are right there under another path. The unattributable case is checked BEFORE the two that
    # name a path, for the same reason: both of those would blame a repo the rows never claimed.
    if [ "$lines" -eq 0 ]; then
      autonomy_no_data "$file"
    elif [ "$norepo" -eq "$lines" ]; then
      warn "no data: none of the $lines row(s) in $file say which repo they came from"
      dim "  A row with no 'repo' field belongs to no project — counted apart, never mixed into one."
    elif [ -z "$repo" ]; then
      warn "no data: the ledger is read per repo and this is not a git repository (cwd: $PWD)"
      dim "  $file holds $lines row(s), all of them belonging to some repo. Run this inside one."
    else
      warn "no data for $repo: none of the $lines row(s) in $file were born in this repo"
      # FIVE states, not four. A MIXED ledger — some rows born elsewhere, some naming no repo at
      # all — used to get this one headline for every row, and the remedy it prints reaches only
      # the first kind: `--all-repos` deliberately does not admit rows that belong to no project,
      # so "run it over there / open the scope" is advice nobody can carry out for them. The split
      # is printed instead of implied, for the same reason every exclusion above is counted.
      if [ "$norepo" -gt 0 ]; then
        dim "  $((lines - norepo)) row(s) came from other repos; $norepo name no repo at all."
        dim "  Run 'sdd autonomy' in the repo you want, or --all-repos for every project — but"
        dim "  neither reaches the $norepo unattributable row(s): no scope can claim them."
      else
        dim "  The ledger is global, the reader is not. Run 'sdd autonomy' in the repo you want."
      fi
    fi
    return 1
  fi
  # The header names the SCOPE it just read, not the cwd: under --all-repos the rows below come
  # from every project on this machine, and a header still pointing at one repo path would read as
  # a claim about that repo — the same misattribution the filter was added to remove.
  local scope="$repo"
  [ "$LEDGER_ALL_REPOS" = "1" ] && scope="all repos (--all-repos)"
  step "sdd autonomy — $file · $total row(s) · $scope"

  # The `- intervention:` notes of the mission checkpoint — what the human DID, in prose. Until
  # 2026-08-28 this was the intervention COUNT the D12 metric read (D16), and it was measured to
  # be a label the executor had to remember to write: the pilot missions carried 0, 1 and 0 notes,
  # and the one with three launches had none. The count is `launch(es)` now, distinct run_id per
  # mission, on every line of every repo; the notes are printed beside it as `intervention
  # note(s)`, and ONLY when there is a checkpoint on disk to read them from. No `?`: it stood in
  # for "nobody looked" so that no false zero reached the official number, and the official number
  # no longer comes from this file. A mission with no checkpoint simply has no notes to show.
  #
  # The TOKEN is English and the prose after it is not, exactly like the status words the boot
  # prompt already tells every session to leave alone: pending, done, blocked, auto, skipped. D12
  # wrote the marker in pt-BR; spelling it that way here would have put a new Portuguese contract
  # token on the kit surface — the very lock CLAUDE.md lists as debt for `aprovacao`, `versao` and
  # `titulo`, and that tests/check-lang.sh refuses. The checkpoint is an OUTPUT_LANG artifact, so
  # what follows the colon is written in whatever language the repo declared.
  #
  # Only for missions of THIS repo: the file lives under `$repo/$HANDOFF_DIR/`, and HANDOFF_DIR is a
  # key of the config of the repo the reader is standing in. Under --all-repos the missions of
  # other projects print no cell — and the jq below also refuses to lend this repo notes to a
  # foreign mission that merely shares the slug.
  local interventions="{}"
  if [ "$by_mission" = "1" ] && [ -n "$repo" ]; then
    local mlist m ck n hdir
    # SOURCED in a subshell, the way check 2b of cmd_health reads TEST_CMD, and NOT through
    # load_config: `sdd autonomy` has never required a .sdd/config.sh — it has a branch for "this is
    # not a git repository" — and making it demand one to answer a question about the ledger would
    # be a new requirement bought with nothing. An absent or broken config costs the default, not
    # the command. Same default load_config applies, restated here because a broken config arrives
    # EMPTY.
    # shellcheck disable=SC1090
    hdir="$( . "$repo/.sdd/config.sh" >/dev/null 2>&1; printf '%s' "${HANDOFF_DIR:-}" )" || true
    [ -n "$hdir" ] || hdir="docs/handoffs"
    # Guarded, like every capture in this file: jq answering nothing must leave an empty list and a
    # census of zero missions, never abort the command it is a detail of.
    mlist="$(jq -rs --arg repo "$repo" "$def"'
               map(select(ledger_row_is_local and (.repo == $repo)))
               | map(.mission // "") | unique | .[] | select(length > 0)' "$file" 2>/dev/null || true)"
    while IFS= read -r m; do
      [ -n "$m" ] || continue
      ck="$repo/$hdir/$m/checkpoint.md"
      # A checkpoint that is not on disk contributes NO entry, so the cell does not print: absent
      # is not zero. `|| true`: grep exits 1 when it counts zero, and `set -e` would take the whole
      # command down on the first mission whose checkpoint has no note — the common case.
      [ -f "$ck" ] || continue
      n="$(grep -cE '^[[:space:]]*-[[:space:]]*intervention:' "$ck" || true)"
      interventions="$(jq -c --arg m "$m" --argjson n "${n:-0}" '. + {($m): $n}' <<< "$interventions")"
    done <<< "$mlist"
  fi

  # Every row lands in exactly ONE of four buckets, and the buckets are exhaustive: comparable
  # session, non-comparable row, escalation on the axis, or unrecognized (event missing, or a value
  # none of session/blocked/degraded — a future event type, a hand edit, a partial write). Every
  # event the runner itself writes has to be in that list: a row the runner produced and its own
  # reader files as "unrecognized" is the blind spot merely moved from the judge to the human.
  # A row that fit none of them used to vanish with no trace; tests/check-autonomy.sh now asserts
  # the four counts sum to the header total, so a filter that drops a row again fails loudly.
  #
  # ESCALATIONS SIT ON THE kit_sha AXIS, exactly as `kaizen_series` has always sliced them
  # (see the `$ok | map(select(.kit_sha == $shas[-1])) | group_summary` there). This reader used to
  # `group_by(.kind)` over the WHOLE file, with no version axis and no comparability filter: the
  # human's table and the judge's series then printed different escalation counts for the same
  # period with nothing explaining the divergence, and kit version is precisely the axis the ledger
  # exists to measure. Two instruments over one file that disagree corrode the trust the kaizen
  # loop runs on, so `sdd autonomy` bends to the series and not the other way round — the series
  # was already right, and "fixing" both sides would have re-created the divergence it removes.
  # A dirty kit or a null sha cannot be attributed to any version, so those escalations join the
  # non-comparable count instead of being summed into a version that did not produce them.
  #
  # A row whose JSON is syntactically valid but the wrong SHAPE (a bare array, say) cannot be
  # classified at all — indexing it with .event is a jq runtime error, not a false comparison — so
  # that failure is caught below and re-raised through die(), same rc 1 as every other refusal in
  # this command instead of leaking jq's own exit code.
  local out jq_rc=0
  out="$(jq -rs --arg repo "$repo" --argjson interventions "$interventions" \
                --argjson by_mission "$by_mission" --arg allrepos "$LEDGER_ALL_REPOS" \
                --arg phases "$PHASES" "$def""$odefs"'
    # ⚠️ NO APOSTROPHE anywhere below, prose included: everything from here to the closing quote is
    # ONE single-quoted shell string, so a stray one ends it mid-jq and bash then reports a syntax
    # error dozens of lines away from the sentence that broke it. That is why every comment in here
    # is phrased around the possessive ("this repo rows", "the judge series"). `bash -n` does catch
    # it — loudly and in the wrong place, which costs a cycle to read.
    #
    # ONE definition of "attributable to a kit version" for the whole program, exactly as
    # is_escalation is one definition of the escalation pair — and for the same reason. This was
    # written twice, `.kit_dirty == false` for sessions and `.kit_dirty != true` for escalations,
    # two spellings of one question that agree on every row the runner writes (the stamp emits
    # kit_dirty:null only alongside kit_sha:null, and a null sha already fails both) and disagree on
    # the one row it does not: kit_dirty:null WITH a sha. There the table counted an escalation
    # under a version while refusing the session next to it — attribution granted and denied in the
    # same output. `== false` is the spelling that survives: unknown dirtiness is not clean, and a
    # row nobody can attribute belongs in the non-comparable bucket, out loud. kaizen_series holds
    # the same definition for its own jq program; tests/check-autonomy.sh compares the readers to
    # each other so neither can be "improved" alone.
    # outcome / outcome_tally / phase_index arrive spliced from ledger_outcome_defs: what a session
    # DID is one definition for this program and for kaizen_series, and check-autonomy.sh compares
    # the two histograms over one file so neither can be improved alone.
    def on_axis: .kit_dirty == false and .kit_sha != null;
    def comparable: .event == "session" and on_axis and (has("moved"));
    def is_session: .event == "session";
    def is_escalation: .event == "blocked" or .event == "degraded";
    # ONE definition of the third event for this program, on the same terms as the pair above. It
    # is NOT an escalation and must never be folded into that pair: a gate that closed is the
    # pipeline working, and `escalations` is the map a human reads to find where it did not.
    def is_gate_pass: .event == "gate_pass";
    def is_unrecognized: (is_session or is_escalation or is_gate_pass) | not;
    # ONE definition of "which mission is this row about" for this program too, exactly as
    # kaizen_series holds one: the repo is part of the identity, because two projects run the same
    # dated slug on the same day and --all-repos puts their rows in one reading. Counting by slug
    # alone made `2 mission(s)` out of three, in the very header a human reads to decide whether
    # the kit got better. A no-op in per-repo scope. The two readers keep the same spelling on
    # purpose; check-autonomy.sh compares them to each other so neither can be "improved" alone.
    # An ARRAY, for the same two reasons the twin states: a separator inside a value collides, and
    # `+` on a non-string value makes jq die and takes this whole command down with it.
    def mission_key: [(.repo // ""), (.mission // "")];
    # The number the D12 metric reads, since D16 was amended on 2026-08-28: distinct run_id — how
    # many times a human typed `sdd run` or `sdd retry` for this mission. The FACT, never
    # `launches - 1`: "interventions = launches - 1" is the reading, written in CONTEXT.md and in
    # the judge prompt, and a `- 1` here would be the first arithmetic of opinion inside an
    # instrument that prints facts — and would read 0 on a mission abandoned after its first
    # launch, which is an intervention. It UNDERCOUNTS by design: bringing the app up by hand
    # between two launches is one new run_id, not two. An honest floor, where the prose
    # (`- intervention:` notes) was a ceiling nobody filled — the mission with three launches
    # (SQ-111) had zero notes.
    # Four more limits, declared here because this is the program that prints the number:
    #   - a launch that ended in an escalation before any session row (a run stopped by
    #     handoff-blocked, for instance) is invisible: the population is the session rows, by the
    #     spec, and an escalation row is not one of them — a second undercount, same direction;
    #     measured: three increment-blocked rows of a /tmp fixture mission carry run_ids that never
    #     got a session row;
    #   - a mission whose sessions are ALL non-comparable prints no line at all and contributes
    #     nothing to the accounting sentence below, exactly as before these two cells existed;
    #   - neither cell enters the judge series: it groups by kit_sha, and a mission that crossed
    #     two kit versions would count its launches twice (design §4.6);
    #   - a row with no run_id would count as one launch: `[{run_id:"a"},{run_id:"a"},{}]` reads 2,
    #     not 1. The runner writes run_id on every row it emits and the real ledger has 0 such rows,
    #     so this is declared, not filtered.
    def launches: map(.run_id) | unique | length;
    # A session in a phase BELOW one whose gate had already PASSED, in $PHASES order — the pipeline
    # going backwards after it had gone forward. NOT "the phase index went down": that counts the
    # designed loop (QA fails, opens a fix increment, EXEC runs it), which frete-cif-fob did three
    # times with QA REFUSED, all of it the pipeline working. With the gate in the clause that
    # mission reads 0 and SQ-111, which ran QA after PR had passed, reads 1. A phase outside the
    # order (KAIZEN) has a null index and counts on neither side — the `!= null` guards are
    # load-bearing, because jq orders null below every number. Input in file order, which is
    # write order: the ledger is append-only, and group_by keeps it (jq sorts stably).
    def reopened: reduce .[] as $r ({maxpass: -1, n: 0};
                    ($r.phase | phase_index) as $i
                    | (if $i != null and $i < .maxpass then .n += 1 else . end)
                    | (if $i != null and $r.gate == "pass" then .maxpass = ([.maxpass, $i] | max) else . end)) | .n;
    # Money is a COLUMN, and jq interpolates a NUMBER: 2.0 came out `US$ 2` in the column next to
    # `US$ 1.5`, the table stopped lining up, and a reader in a hurry reads "no cents were computed".
    # NOT printf, which is nowhere near this string: the whole row is built inside this one jq
    # program, and taking the number back out to bash to format it would split one line across two
    # languages. The cents are rounded to an INTEGER first and re-split, so the second place is
    # always written, zero or not — `\($c / 100)` alone drops it again.
    def usd: (. * 100 | round) as $c
             | ($c / 100 | floor) as $whole
             | ($c - $whole * 100) as $cents
             | "\($whole).\(if $cents < 10 then "0\($cents)" else "\($cents)" end)";
    # The repo filter runs before every bucket, and its own count is kept for the same reason the
    # other three exclusions are printed: a row that leaves has to say so. Bound BEFORE the pipe
    # so the buckets below still see a plain array of this repo rows and nothing changes shape.
    # TWO counts and not one: "born in another repo" and "says no repo at all" are different
    # accusations, and a single number for both would name the wrong one in every message.
    (map(select(ledger_row_no_repo)) | length) as $norepo
    | (map(select((ledger_row_is_local | not) and (ledger_row_no_repo | not))) | length) as $foreign
    | map(select(ledger_row_is_local))
    # The dated recovery of the pre-2026-08-29 rows, applied ONCE, here, before any bucket sees the
    # list — so every count below this line reads one history and not two. Length-preserving by
    # construction: it annotates rows, it never adds or drops one, which is what keeps $local_total
    # and assert_bucket_sum meaning what they meant. kaizen_series applies it at the same point of
    # its own program, and check-autonomy.sh compares the two readers over one prose ledger.
    | historic_progress
    # The REVIEW half of the same dated recovery, applied at the same point and for the same
    # reason. Two defs and not one because the two counts move in opposite directions and read
    # different prose; both are length-preserving, so $local_total and assert_bucket_sum keep
    # meaning what they meant.
    | historic_rounds
    # Bound over `comparable` and NOT over the bare annotation, which is the fix for a measured
    # fail-open: these two sentences are DELETION SIGNALS — they say how much of the window was
    # read through a dated path, and therefore when that path may come out — and a count taken
    # before the comparability filter counts rows that then leave as non-comparable, so the number
    # reconciles with nothing on screen. Measured on the real ledger: the EXEC sentence said
    # "2 rows" over a table of one session. `comparable` already demands `.event == "session"`, so
    # no second conjunct for it; `type == "object"` comes first because historic_progress preserves
    # non-object rows and `.event` on a number is an error, not a false.
    | (map(select(type == "object" and comparable and .progress_source == "gate_why")) | length) as $historic
    | (map(select(type == "object" and comparable and .rounds_source == "gate_why")) | length) as $historic_rounds
    # The header total, re-derived here so the accounting paragraph can NAME it. The two exclusions
    # bound above were computed before this filter and were therefore never in it.
    | (length) as $local_total
    | (map(select((is_session and (comparable | not))
                or (is_escalation and (on_axis | not)))) | length) as $skipped
    # group_by SORTS BY KEY, and a kit sha is hex: "the last line of the table" was the lexically
    # largest version, not the most recent one. `kaizen_series` has always ordered its versions by
    # FIRST APPEARANCE in the file (`shas_in_file_order` there — same reduce, same reason), so this
    # window and the judge series answered "which version is latest?" differently over one file,
    # with nothing on screen explaining it. Same spelling on purpose, in both programs;
    # check-autonomy.sh compares the last table row to `.latest.kit_sha` of the series so neither
    # side can be "improved" alone. `index` returns 0 for the first element and 0 is truthy in jq,
    # which is what makes the reduce keep the first occurrence instead of appending it twice.
    # The order is read off every row the table and the escalations block admit — comparable
    # sessions and on_axis escalations — which is exactly the population kaizen_series reads
    # through `comparable_row`, and not off `on_axis` alone: a SESSION with no `moved` field (old
    # schema) is on_axis but not comparable, so it lands on neither side of that population, and
    # the earlier spelling of this clause admitted it anyway, putting the two readers on different
    # versions again. Measured on a three-row ledger session(aaaaaaa, no moved) ·
    # session(bbbbbbb) · session(aaaaaaa): the last row of the table read bbbbbbb while
    # `.latest.kit_sha` of the series read aaaaaaa, over the same file (tests/check-autonomy.sh,
    # fixture D4c). A version whose first admitted row is an escalation is the separate case this
    # clause already covers: `comparable` implies `on_axis` by its own definition above, so an
    # escalation reaches this list through the `is_escalation and on_axis` arm and a session
    # through the other, and every group in $groups below still has a place in this list.
    | (map(select((is_session and comparable) or (is_escalation and on_axis))) | map(.kit_sha)
       | reduce .[] as $s ([]; if index($s) then . else . + [$s] end)) as $order
    | (map(select(is_session and comparable))
       | group_by(.kit_sha) | sort_by(.[0].kit_sha as $s | $order | index($s))) as $groups
    | (map(select(is_unrecognized)) | length) as $stray
    # The fifth bucket, and it exists because RECOGNISING a row is not the same as accounting for
    # it: without a count of its own the recorded closures would leave the header total without
    # leaving any line, which is `unrecognized` with the alarm switched off. tests/check-autonomy.sh
    # closes the sum over all five.
    | (map(select(is_gate_pass)) | length) as $closed
    # The SAME population the kit_sha table draws, regrouped. Not a second reading of the file: two
    # instruments over one ledger that disagreed about the money would corrode the trust the whole
    # kaizen loop runs on, which is the argument that already bent this reader onto the series axis.
    # Escalations ride along per mission for the same reason they do per version — they are the
    # loudest friction signal a mission can produce — and are counted on the axis, exactly as the
    # escalations block below counts them.
    | (map(select(is_session and comparable))
       | group_by(mission_key) | sort_by(.[0].ts)) as $mgroups
    # EVERY local session of each mission, comparable or not — the population launches and
    # reopened are drawn over. They are facts about the human history of the mission and not about
    # a kit version: a launch that landed on a dirty kit was a launch. Measured on SQ-111, the
    # mission that motivated the two fields: its post-PR QA row carries kit_dirty:true, and over
    # the comparable rows alone `reopened` read 0 exactly there. session(s), the outcomes and US$
    # stay on the comparable rows, because that is the sum check-autonomy.sh closes against the
    # version table. When the two populations differ for a printed mission the accounting
    # paragraph says so, once, with the difference summed over the missions printed.
    | (map(select(is_session)) | group_by(mission_key)) as $every_session
    # DECLARED LIMIT: history_of scans $every_session once per printed mission, so the by-mission
    # table is quadratic in the number of missions the ledger holds. Unmeasured, on purpose: the
    # real ledger is 145 rows over a dozen missions, and the scan that WAS measured (the
    # degenerate_axis rewrite in kaizen_series) only earned its index at 750 versions over 3000 rows.
    | def history_of: . as $k | $every_session | map(select((.[0] | mission_key) == $k)) | .[0] // [];
      (if $by_mission == 1
       then ($mgroups | map((.[0] | mission_key | history_of | length) - length) | add // 0)
       else 0 end) as $history_extra
    | (if $by_mission == 1 then
        (if ($mgroups | length) == 0 then
          "  no comparable sessions in this ledger"
        else
          ($mgroups | map(
              (.[0].mission // "") as $m
              | (.[0].repo // "") as $r
              | (if $allrepos == "1" then "\($r | split("/") | last)/\($m)" else $m end) as $label
              | (length) as $n
              | (outcome_tally) as $t
              | (map(.cost_usd // 0) | add) as $cost
              | (.[0] | mission_key | history_of) as $every
              | ($every | launches) as $launches
              | ($every | reopened) as $reopened
              # The narrative, under the name that says what it is, and only when the checkpoint
              # was readable: a mission of THIS repo with the file on disk. `$r == $repo` keeps a
              # foreign mission that shares the slug (--all-repos) from borrowing this repo notes —
              # the map is keyed by slug alone. Absent, the cell does not print: no `?`, no zero.
              | (if $r == $repo and ($interventions | has($m)) then " · \($interventions[$m]) intervention note(s)" else "" end) as $iv
              # The review LOOP, which is not the REVIEW phase: it is that phase plus every EXEC
              # session it sent back — the `R<n>` increments a round writes. Summing the REVIEW
              # rows alone would call a change that merely MOVED money into the phase next door a
              # cut. The index of the first REVIEW session is the frontier: EXEC before it is the
              # mission doing its own work, EXEC after it is the loop. DOCS and PR after the round
              # are not in it either — they are the pipeline moving on, not the review going round
              # again. Same shape as $iv above: a mission with no round prints no cell, rather
              # than a `0%` that would read as a loop that cost nothing.
              # DECLARED LIMITS, both of them belonging to the metric and written down where the
              # number is printed: a QA that re-blocks AFTER the first round puts its EXEC rows in
              # here (they are indistinguishable from an `R<n>` on the ledger alone), and the
              # percentage is over the COMPARABLE sessions of the mission, the same population the
              # US$ cell sums — a mission whose rows are half non-comparable reports the share of
              # the half that is here.
              | (map(.phase) | index("REVIEW")) as $fr
              | (if $fr == null then "" else
                   ([to_entries[]
                     | select(.value.phase == "REVIEW" or (.value.phase == "EXEC" and .key > $fr))
                     | .value.cost_usd // 0] | add // 0) as $loop
                   # The zero guard is not decoration: jq DIES on a division by zero and takes the
                   # whole command with it, and a mission whose every session cost null sums to 0
                   # here — the `cost_usd: null` a session that died before its `result` writes.
                   | " · review loop US$ \($loop | usd)\(if $cost > 0 then " (\(($loop * 100 / $cost) | round)%)" else "" end)"
                 end) as $rl
              | "  \($label)  \($n) session(s) · \($t.advanced) advanced · \($t.churned) churned · \($t.idle) idle · \($launches) launch(es) · \($reopened) reopened\($iv)\($rl) · US$ \($cost | usd)"
            ) | join("\n"))
        end)
      elif ($groups | length) == 0 then
        "  no comparable sessions in this ledger"
      else
        # waste = churned + idle: every session that did not make the phase advance. It was idle
        # alone (then called stalled) until 2026-08-28 — the approximation the name never meant.
        ($groups | map(
            (.[0].kit_sha) as $sha
            | (length) as $n
            | (outcome_tally) as $t
            | (map(mission_key) | unique | length) as $missions
            | (map(.cost_usd // 0) | add) as $cost
            | "  \($sha)  \($n) session(s) · \($t.advanced) advanced · \($t.churned) churned · \($t.idle) idle · \((($t.churned + $t.idle) * 100 / $n) | floor)% waste · \($missions) mission(s) · US$ \($cost | usd)"
          ) | join("\n"))
      end)
    , (map(select(is_escalation and on_axis)) | group_by(.kit_sha, .kind)
       | map("  \(.[0].kit_sha)  \(.[0].kind): \(length)") | join("\n")
       | select(length > 0) | "\nescalations\n" + .)
    # ONE output for the four buckets, and that is the second half of the spacing defect. The first
    # half was `empty` instead of `""` on the zero side: each string opens with a newline AND the jq
    # comma puts every output on a line of its own, so a bucket with nothing to report contributed a
    # blank line by itself and two blanks opened between the table and the accounting. `empty` fixed
    # that and left the other half standing — with two buckets filled the four strings came out
    # block+blank+block, one blank between every two, because each surviving string still carried
    # its own leading newline. The accounting is ONE paragraph: four remarks about where the rows
    # went, not four unrelated asides. Collected into an array and joined, the leading newline is
    # written ONCE, by the paragraph rather than by its lines, and `select(length > 0)` keeps the
    # zero case emitting nothing at all — exactly as the escalations block above does. No count
    # moves: this is spacing only.
    # TWO paragraphs, and the split is arithmetic rather than taste. The first two lines are rows
    # that WERE in the header total and then left a bucket; a reader can add them to the table and
    # arrive at the header. The last two were bound BEFORE the repo filter, so they were never in
    # the total at all — printed among the others they invited an impossible subtraction, and the
    # real ledger showed it: header 96, table 89 sessions, 7 non-comparable (89 + 7 = 96, correct),
    # and underneath "11 row(s) excluded: born in another repo", inviting 96 - 11.
    #
    # DELETING those two lines would have closed the arithmetic and broken something older: what
    # leaves has to be NAMED, or the filter is the silent instrument this reader was rewritten to
    # stop being. A sentence that says they were never counted holds both at once, and it appears
    # only when there is something to disclaim.
    , ([ (if $skipped > 0 then "  (\($skipped) non-comparable row(s) excluded: dirty kit, no kit_sha, or no moved field)" else empty end)
       , (if $closed > 0 then "  (\($closed) gate(s) closed without a session — the pipeline moved on for free, recorded rather than inferred)" else empty end)
       , (if $stray > 0 then "  (\($stray) unrecognized row(s) excluded: event missing or not one of session/blocked/degraded/gate_pass)" else empty end)
       , (if $history_extra > 0 then "  (launches and reopened are counted over every session of the mission, \($history_extra) of them non-comparable)" else empty end)
       # NOT an exclusion — nothing left a bucket — which is why it rides at the end of the first
       # paragraph rather than among the four. It is the disclosure that half this ledger was read
       # through a dated compatibility path, and the signal that says when that path can be deleted.
       , (if $historic > 0 then "  (\($historic) EXEC row(s) older than the pending fields read their progress from gate_why)" else empty end)
       # Its REVIEW twin, and a SECOND sentence rather than one summed line: the two paths are
       # deleted independently — the day every EXEC row carries the pending fields is not the day
       # every REVIEW row carries the round ones — and a single number could never say which of
       # them is finally empty.
       , (if $historic_rounds > 0 then "  (\($historic_rounds) REVIEW row(s) older than the round fields read their round from gate_why)" else empty end)
       ] as $inside
       | [ (if $foreign > 0 then "  (\($foreign) row(s) excluded: born in another repo — the ledger is global, this reader is not)" else empty end)
         , (if $norepo > 0 then "  (\($norepo) row(s) excluded: no repo field — the row cannot say which project it came from)" else empty end)
         ] as $outside
       | ($inside
          + (if ($outside | length) > 0
             then ["  never part of the \($local_total) counted above — these left before the header:"] + $outside
             else [] end))
       | select(length > 0) | "\n" + join("\n"))
  ' "$file" 2>/dev/null)" || jq_rc=$?
  if [ "$jq_rc" -ne 0 ]; then
    # A DIFFERENT sentence from the `ledger_parses` refusal above, because they are different
    # defects with different remedies: there a line is not JSON and somebody edits the line; here
    # every line parses and one of them is not an object, so somebody has to find the writer that
    # produced it. One sentence for both said "malformed row" to a reader who then could not tell
    # which had happened. The other half of the pair keeps ITS wording on purpose — `kaizen_series`
    # refuses the same unparseable ledger with the same words, and renaming one of those two would
    # move the collision instead of removing it.
    die "unreadable row in $file — a row is valid JSON but not an object; find the writer that produced it"
  fi
  printf '%s\n' "$out"
}

# ---------------------------------------------------------------------------
# Kaizen — the deterministic half of the judge (ADR 0001). The runner derives labels and numbers;
# the sdd-kaizen agent gives the verdict CITING them, never recalculating. This function is the
# contract between the two: `sdd kaizen --series` is what the agent's session runs as its source
# of truth.
#
# PURE on purpose: it prints JSON and touches no global, so reading it through `$( )` is safe —
# the autonomy_kit_stamp subshell bug cannot happen here because there is no effect to lose.
#
# The label rubric, per mission×phase group:
#   refez — any escalation, any human retry invocation, or the phase's last session still failing
#           its gate: the work was pushed again, the strongest friction signal there is.
#   leve  — an in-loop auto retry, a session that did not move the disk, or ANY session of the
#           phase that failed its gate (churn: it wrote, the gate refused, the runner bought the
#           next lap — frete-cif-fob EXEC was seven sessions, five refusals, and read `ok` until
#           2026-08-28): friction, absorbed.
#   ok    — none of the above.
# Rows with a dirty kit or no kit_sha are non-comparable (counted, never mixed in), and the
# KAIZEN meta row is excluded from the axis it would otherwise shift — the judge must never see
# its own session inflate the guard that gates its verdict.
#
# latest/previous follow FILE order, not sort order: jq's group_by sorts by key and would call
# the lexically-largest sha "latest" — the reduce/index below keeps first-appearance order, and a
# reappearing old sha joins its old group instead of opening a new one.

# The floor of the guard, and its ONE definition: how many missions WITH a session a kit version
# needs before the series supports any verdict but `indeterminado`. ADR 0003 is why it does not
# loosen. Three voices read it and each used to hold a copy — the jq program below (which decides
# `sufficient` and `degenerate_axis`), the empty-series producer inside it (which has no input to
# run that program on), and the sentence `kaizen_axis_note` prints to the human under a comment
# swearing the number was not repeated. The jq one takes it through --argjson, the producer through
# expansion, the sentence off `.guard.floor` of the series it is explaining: a change here moves
# all three, or none of them.
readonly KAIZEN_GUARD_FLOOR=3

kaizen_series() {
  local file; file="$(autonomy_log_path)"
  command -v jq >/dev/null 2>&1 || die "jq not found — it is required to read the ledger"
  # The SAME readability test cmd_autonomy runs, and the reason it is here is that it was not:
  # `sdd autonomy` died loudly on a corrupt ledger while this function returned an unparsed
  # non-zero to a caller that dropped it, and `gate_KAIZEN` then read the empty string as "no
  # verdict yet" — corruption spelled exactly like pending work, which costs an opus session over a
  # file nobody could read. `warn` and not `die`: this function is read through `$( )`, where `die`
  # exits the SUBSHELL and the caller sees a bare rc anyway, so the sentence is printed here (once)
  # and the decision belongs to whoever called.
  if [ -s "$file" ] && ! ledger_parses "$file"; then
    warn "malformed row in $file — the ledger is not readable"
    return 1
  fi
  # Read PER REPO, from the repo this process is standing in. Standing in none, nothing in the
  # ledger is yours: the series comes back empty, which is the SAFE direction (guard.sufficient
  # false supports only `indeterminado`) and never another repo's numbers read as a verdict about
  # this kit. It is said out loud because an empty series that nobody explained is the kind of
  # zero this file spends the rest of its lines refusing to print.
  local repo; repo="$(ledger_repo_root)"
  # Silenced under --all-repos, and only there: with the filter open the cwd decides nothing, so
  # the warning would be announcing an emptiness that is not going to happen. Kept loud otherwise —
  # an empty series nobody explained is the kind of zero this file spends its lines refusing.
  [ -n "$repo" ] || [ "$LEDGER_ALL_REPOS" = "1" ] \
    || warn "not inside a git repository — the ledger is read per repo, so this series comes back empty (cwd: $PWD)"
  if [ ! -s "$file" ]; then
    # Second producer of the same shape, and it cannot share the jq above (there is no input to
    # run it on), so the key set is kept in step by hand and check-kaizen.sh compares the two as
    # key sets. A consumer reading `null` where the real series gives a number is the drift.
    printf '{"v":1,"latest":null,"previous":null,"guard":{"missions_after_change":0,"missions_with_session":0,"sessions":0,"floor":%s,"sufficient":false,"degenerate_axis":false},"excluded":{"non_comparable":0,"unrecognized":0,"meta":0,"other_repo":0,"no_repo":0}}\n' "$KAIZEN_GUARD_FLOOR"
    return 0
  fi
  jq -n --arg repo "$repo" --argjson floor "$KAIZEN_GUARD_FLOOR" --arg phases "$PHASES" "$(ledger_row_is_local)""$(ledger_outcome_defs)"'
    # ONE definition of "escalation" for the whole program, exactly as cmd_autonomy has one. The
    # two events state different facts (`blocked` stopped the line, `degraded` lowered the bar and
    # went on) but they answer this rubric the same way, and writing the pair out three times is
    # how they came to disagree: `phase_label` was left knowing only `blocked` on the argument that
    # a degraded run has a failing REVIEW session anyway. True inside that run — and the rubric
    # groups by (mission, phase) across the WHOLE kit_sha slice, so one later `sdd run` where
    # REVIEW passes made the one mission that degraded read `ok`. An escalation outlives the
    # session that provoked it; that is why `blocked` was in the clause to begin with.
    def is_escalation: .event == "blocked" or .event == "degraded";
    # ONE definition of the third event for this program too, and kept OUT of the pair above on
    # purpose: `escalations` is the map the judge prompt cites first, and a gate that closed is the
    # opposite of the line stopping. It is admitted alongside them (see the $all binding at the
    # bottom) rather than dropped, because a row this reader does not admit lands in
    # `excluded.unrecognized`, which the judge is told to read as a bug in the kit itself — the
    # runner accusing itself of a row it wrote on purpose. Measured before this line existed:
    # `unrecognized: 1` over a ledger of four sessions and one recorded closure.
    def is_gate_pass: .event == "gate_pass";

    # ONE definition of the kit_sha axis for this program too — the third hand-written copy of the
    # same question lived here, as the complementary pair `.kit_dirty == true or .kit_sha == null`
    # / `.kit_dirty != true and .kit_sha != null`. `on_axis` alone is what an ESCALATION needs to be
    # admitted — it never carries `moved`, and demanding one would exclude every escalation that
    # ever happened. A SESSION needs more: `comparable_row` below adds `has("moved")` on top of
    # `on_axis` for a session row, which is exactly the rule cmd_autonomy names `comparable`.
    # Divergent for one measured row shape until this fix: a session with no `moved` field (old
    # schema) read on_axis here and non-comparable there — 2 sessions on the human table read 3 on
    # the judge series, 1 idle read 2 — so the judge and the window the human reads now admit the
    # SAME rows from the SAME file, never merely the same kit_sha filter. (No apostrophes in here:
    # this jq program is a single-quoted shell string, and one would end it mid-comment.)
    def on_axis: .kit_dirty == false and .kit_sha != null;
    # SESSION admission is the human window rule named comparable (on_axis and has("moved"));
    # ESCALATION admission stays bare `on_axis`, because .event != "session" short-circuits the
    # has("moved") arm before it ever runs on a row that could never satisfy it. Used by BOTH
    # bindings of the $noncomp/$ok partition below, so a session without `moved` cannot land in
    # $ok through one binding while excluded through the other.
    def comparable_row: on_axis and ((.event != "session") or has("moved"));

    # ONE definition of "this axis degenerated", same discipline as the two above, and the reason
    # the field below exists at all: a guard that says only `sufficient: false` cannot tell "not
    # enough missions yet" (a target repo, where waiting works) from "the axis cannot work here"
    # (the repo that BUILDS the kit, where every session commits and the next lands on a fresh sha,
    # so waiting never works). Input is the on-axis rows. MORE THAN ONE sha is required on purpose:
    # a first sha with one mission has not degenerated, it has only just started.
    #
    # ONE definition of the floor, shared by the guard verdict below and by the window this field
    # looks through. They cannot drift: the field says "waiting will never satisfy that floor", so
    # it has to be measured over as many kit versions as the floor asks missions of.
    # The value comes in through --argjson from KAIZEN_GUARD_FLOOR, the single owner: the empty
    # ledger takes the same road above, and neither of them can be moved on its own.
    def guard_floor: $floor;
    # ONE definition of "the distinct kit versions, in FILE order", used by the latest/previous
    # pair below and by the window here. group_by sorts by key and answers a different question;
    # two hand-written copies of this reduce is how the blocked/degraded pair came to disagree.
    # ONE definition of the axis the whole judge stands on, and its population is a decision rather
    # than a detail: a version is borne by a row that OBSERVED something — a session that ran, or an
    # escalation that stopped the line. A `gate_pass` row observes nothing; it says a phase closed
    # for free. It MODIFIES the cell of a version, and it must never BE one. Same sentence as the
    # `$detail` filter in group_summary, one level up: that filter stops the phantom CELL, this
    # select stops the phantom VERSION, and until 2026-08-31 only the first half existed.
    #
    # THE KIT REPO IS WHERE THIS BITES, and by construction rather than by luck: every session here
    # commits, so the sha ADVANCES between the phase whose gate failed and the lap that closes it —
    # the closure lands on a sha no session ever touched. Measured on the real reader, one row
    # added: `latest` ccc3333 → ddd4444 (0 sessions), `previous` bbb2222 → ccc3333, `labels`
    # {ok:1} → {ok:0}, `degenerate_axis` true → false. Downstream, `gate_KAIZEN` derives its
    # expected sha from `latest.kit_sha`, so a verdict already written stopped satisfying the gate
    # and `sdd kaizen` would buy an opus session to judge a slice with zero sessions — a phase no
    # session can satisfy, the failure mode principle 1 of CLAUDE.md exists to forbid.
    #
    # Written POSITIVELY (`session or escalation`) and not as `is_gate_pass | not`, though the two
    # agree on the population of today: a FOURTH event has to opt IN to minting a version, instead
    # of minting one by default the day somebody adds it. Fail-safe is the direction the axis wants.
    # Both callers — `$shas` below and the `$order` of degenerate_axis — ask this same question,
    # which is why the filter lives in the definition and not at the two call sites.
    #
    # ⚠️ No apostrophe anywhere in this block, which is why the prose above says "the population of
    # today" instead of the natural phrasing: the whole jq program is ONE single-quoted shell string
    # opened at the `jq -n` far above, so a stray single quote closes it and bash dies at parse
    # time — several screens away from the line that caused it. Caught by `bash -n`, never silent.
    def shas_in_file_order: map(select(.event == "session" or is_escalation))
                            | map(.kit_sha) | reduce .[] as $s ([]; if index($s) then . else . + [$s] end);
    # ONE definition of "which mission is this row about", and the repo is PART of it. The slug
    # alone was the first spelling, and it was a no-op bug until this mission opened --all-repos:
    # slugs are dated (`YYYYMMDD-<name>`) and cmd_kaizen mints `$(date +%Y%m%d)-kaizen`, identical
    # in every repo on the same day. Measured with three repos, one session each on one kit_sha and
    # two slugs colliding: missions_with_session fell 3 -> 2, guard.sufficient flipped true ->
    # false, and one project refez absorbed the other project clean ok into a single group — a
    # verdict about the kit decided by a slug coincidence. Since F1 the flag reaches the judge
    # prompt, so this reached the verdict. A NO-OP in per-repo scope, where every row shares one
    # repo, which is why the fix costs the default reading nothing.
    #
    # An ARRAY and not a joined string, which is the shape the old `.mission + "|" + .phase` used.
    # Two reasons, both measured: a separator inside a value collides — repo `a|b` with mission `c`
    # and repo `a` with mission `b|c` joined to the same key and read as ONE mission — and `+` on a
    # value that is not a string makes jq DIE, so a hand-edited row with a numeric `repo` took
    # `sdd autonomy` down with `malformed row` and returned the judge nothing. group_by and unique
    # order any JSON, so the array costs nothing and admits no delimiter to inject.
    #
    # Defined HERE, above degenerate_axis, and not beside group_summary where it used to sit: jq
    # resolves a `def` only after it appears, and the second clause of degenerate_axis counts
    # missions. Moved rather than copied — a second spelling of this question is the exact defect
    # the paragraph above is about.
    def mission_key: [(.repo // ""), (.mission // "")];
    # ...and "how many missions bought a session on this version", which is the number the floor
    # reads. Shared with the guard verdict through guard_floor, so the two cannot drift.
    def missions_on($sha): map(select(.kit_sha == $sha and .event == "session"))
                           | map(mission_key) | unique | length;
    def degenerate_axis:
      . as $rows
      | ($rows | shas_in_file_order) as $order
      # The LAST guard_floor versions, and NOT the whole history. Over all of $ok this was a
      # one-way switch: the ledger is append-only, so one ancient sha that happened to buy two
      # sessions turned the explanation off FOREVER while every recent version sat at exactly one.
      # Measured: 20 shas x 1 session => true; add a second session to the OLDEST sha => false,
      # with nothing about today having changed. An explanation that expires on a fact from last
      # year is exactly the number that moves with nothing explaining why.
      | ($order | length) as $n
      | ($order[(if $n > guard_floor then $n - guard_floor else 0 end):]) as $window
      # MISSIONS per version, not sessions, because `missions_with_session` is the unit the floor
      # reads and this field exists to explain that floor. Counting sessions made the two disagree
      # on the one row shape that separates them: a version whose TWO sessions belong to the SAME
      # mission (an in-loop auto retry, or any second `sdd run` on a phase that neither commits nor
      # dirties the kit tree) still contributes exactly one mission, so the floor stays as
      # unsatisfiable as before — and yet the session count of 2 turned this field to `false` and
      # `kaizen_axis_note` went SILENT. Measured: three versions, the newest with two sessions of
      # one mission => `missions_with_session: 1`, `sufficient: false`, `degenerate_axis: false` and
      # the sentence printed zero times. The human then reads a bare `sufficient: false` and waits
      # for missions that cannot help, which is the exact misreading ADR 0003 built this field to
      # end. Zero is still not one: a version whose rows are all escalations observed NOTHING, a
      # different silence with a different remedy, and `== 1` keeps it out.
      # ...AND the floor was never once reached in this whole ledger. The window alone was the
      # second formulation and it traded one wrong answer for another: it says "the axis cannot work
      # HERE", and a quiet stretch is not a broken axis. Measured on the window alone — two versions
      # carrying 3 missions apiece, then three versions with one mission each => `true`, in a repo
      # whose OWN history proves 3-missions-per-version is reachable twice over. The field then errs
      # at exactly the distinction it was created to make, and it feeds the judge prompt.
      #
      # Never-reached is a PERMANENT fact about a repository, so latching the explanation off on it
      # is correct — which is what separates this clause from the whole-history rule it restores a
      # piece of. That one latched on "some sha once bought two sessions", a coincidence that says
      # nothing about whether the floor is attainable; this one latches on the floor itself having
      # been met. In the repo that BUILDS the kit no version ever reaches it (every session commits
      # and the next lands on a fresh sha), so the explanation stays on, which is the point.
      # Grouped ONCE rather than re-scanning every row per version: written as
      # `all($order[]; ($rows | missions_on(.)) < guard_floor)` this clause is O(versions × rows),
      # and the repo that BUILDS the kit is precisely where versions grow without bound — one per
      # session, forever. Measured on 3000 rows across 750 versions: 1.40 s that way, 0.20 s this
      # way. `group_by` sorts, and here that is safe because only the MAXIMUM is wanted and a
      # maximum has no order — the file-order property lives in $order above, untouched.
      | ($rows | map(select(.event == "session")) | group_by(.kit_sha)
               | map(map(mission_key) | unique | length) | max // 0) as $best_reach
      | ($window | length) > 1
        and all($window[]; . as $sha | ($rows | missions_on($sha)) == 1)
        and $best_reach < guard_floor;

    # The `leve` clause reads `outcome` — the SAME definition the histogram and the human window
    # read, spliced from ledger_outcome_defs — and never `.gate` directly. Its previous spelling
    # was `(.auto_retry == true or .moved == false or .gate == "fail")`, added by 20260828 so that
    # a phase which failed five gates and then passed could not read `ok`; measured against the
    # real ledger one day later, that spelling labelled `leve` EVERY EXEC phase of two or more
    # increments, because gate_EXEC refuses once per increment BY DESIGN. A rubric that cannot
    # tell the designed loop of the pipeline from a phase that spun is not stricter, it is blind
    # in a new direction — and it was about to stamp `leve` on the mission that came to fix it.
    #
    # `outcome != "advanced"` keeps everything 20260828 bought: the session that wrote and moved
    # no increment is `churned`, the one that wrote nothing is `idle`, and either one still makes
    # the phase `leve`. What it stops charging for is the refusal that the design itself schedules.
    # `.moved == false` is subsumed rather than dropped — a session that wrote nothing and passed
    # its gate reads `advanced`, which is the honest answer for a phase whose artifact was already
    # on disk. `refez` does not move: a phase whose last session did not pass has not closed, and
    # that is a fact about the gate, not about an increment.
    #
    # THE THIRD CLAUSE asks "did the PHASE close?", and until 2026-08-31 it could only ask "did the
    # last SESSION pass its gate?" — the same question only while every gate that ever passes costs
    # a session, which is false. The QA⇄EXEC fix loop closes QA for free: QA files a bug and the fix
    # increment for it, gate_QA refuses, the derivation goes BACK to EXEC, EXEC closes both, and the
    # next derivation finds gate_QA green with no second QA session anywhere. Measured on window 2:
    # the QA of 20260830-o-rascunho-fantasma-do-mount read `refez` — the loudest friction signal in
    # this rubric — over a phase that closed clean, with `escalations: {}`, ONE launch for the whole
    # mission and REVIEW/DOCS/PR all `ok` after it.
    #
    # ⚠️ It reads the closure as a POSITION and never as set membership, and the difference is a
    # measured defect rather than a style. Written `... != "pass" and (map(select(is_gate_pass)) |
    # length) == 0`, ONE recorded closure disabled the clause for the whole life of that
    # (repo, mission, phase) group: the ledger is append-only and the group spans every run, so a
    # closure written on lap 3 outvoted every failing session AFTER it, for ever. The runner cannot
    # correct that from its side — `gate_pass_logged` and `sessions` die with the process, so a
    # phase that reopens and stays red writes no second row to argue with. Reproduced end to end on
    # a real `sdd run`: QA closes for free, the REVIEW round reopens QA, three more QA sessions fail
    # at US$ 21 and none passes, and the rubric read `leve` where it has to read `refez` — the same
    # fail-open in the flattering direction this comment forbids two paragraphs down. All of it on
    # ONE kit_sha, which is the NORMAL case in a target repo, so it was the common path and not an
    # edge. Asking for the LAST of (sessions ∪ closures) answers "did the phase close?" at the point
    # in time the group actually ends: a closure last means it closed, a failing session last means
    # it did not, and with no closure at all the expression is the old one, term for term.
    # `last` over an empty list is `null` and `null.event == "session"` is false, so a group of pure
    # escalations still falls to the first arm exactly as before.
    #
    # It reads a FACT the runner wrote (`event: "gate_pass"`, autonomy_gate_pass_row) and never the
    # absence of one: an inference over the phase order would have been cheaper and is the shape
    # f00c2dc refused, "an inference does not go in front of what the runner measured". What it does
    # NOT do is turn the cell green — the surviving session is still churn on its own count, so the
    # cascade lands on `leve`. Trading a false `refez` for a false `ok` would be the same defect.
    def phase_label:
      if (map(select(is_escalation)) | length) > 0
         or (map(select(.event == "session" and .invocation == "retry")) | length) > 0
         or ((map(select(.event == "session" or is_gate_pass)) | last
              | (.event == "session" and .gate != "pass")))
      then "refez"
      elif (map(select(.event == "session" and (.auto_retry == true or outcome != "advanced"))) | length) > 0
      then "leve"
      else "ok"
      end;

    def group_summary:
      . as $rows
      | ($rows | map(select(.event == "session"))) as $sess
      | ($rows | group_by(mission_key + [(.phase // "")])
               # A `gate_pass` row MODIFIES a cell; it never is the subject of one. It says a phase
               # closed for free — and a phase that spent nothing in this slice is not a phase this
               # slice can grade. Without this filter a group whose ONLY row is the closure falls
               # through every arm of phase_label (no escalation, no retry, and `map(select(.event
               # == "session")) | last` is `null`, so `null | .gate != "pass"` is true but the new
               # second conjunct is false) and lands on the `else`, minting a phantom `ok` cell with
               # `sessions: 0` and `cost_usd: 0` — a clean grade for a phase this slice never saw.
               # Measured on two worlds, both reachable: (1) the closure and the session it explains
               # land on different `kit_sha`, which is EVERY run in the repo that BUILDS the kit,
               # because each session commits and the sha advances between the phase that failed and
               # the lap that closes it; (2) the session was written with a dirty kit and the closure
               # clean, which drops the session into `non_comparable` and leaves the closure alone.
               # Before `gate_pass` existed no session-less group could read `ok`: the only other
               # row shape is an escalation, and an escalation-only group reads `refez` off the
               # first arm. That is why the filter admits escalations too and removes nothing that
               # was ever counted.
               #
               # DECLARED LIMIT, and it is the honest half of the same fact: in world (1) the cell
               # of the session itself, one slice back, still reads `refez`. The closure cannot reach
               # it — the rubric grades one `kit_sha` at a time and the row is not in that slice.
               # This line stops the false `ok`; moving the false `refez` needs the closure to be
               # readable ACROSS slices, which is a decision about the axis and not about this line.
               | map(select((map(select(.event == "session" or is_escalation)) | length) > 0))
               | map({repo: .[0].repo, mission: .[0].mission, phase: .[0].phase, label: phase_label,
                      sessions: (map(select(.event == "session")) | length),
                      outcomes: (map(select(.event == "session")) | outcome_tally),
                      cost_usd: (map(.cost_usd // 0) | add)})) as $detail
      | {kit_sha: $rows[0].kit_sha,
         missions: ($rows | map(mission_key) | unique | length),
         # The floor of the guard, and NOT the same number as `missions` above: that one counts
         # every mission on the axis, escalations included, which is right for the display and
         # wrong for the floor. A mission that stopped the line without spending a session left
         # the judge nothing to read about this kit version, and three of them used to clear a
         # floor meant to mean "enough observation". Derived from $sess, the one place this
         # program already calls a row a session. Keyed by mission_key like every other count here:
         # this is the number the floor reads, so a slug collision between two projects landing
         # here is a guard moved by a coincidence.
         missions_with_session: ($sess | map(mission_key) | unique | length),
         # ADR 0005, part 2 — how many missions each repo contributed to this slice. It is what
         # makes reading every repo SAFE: a verdict resting on rows from a throwaway clone is a
         # verdict about nothing, and under a silent filter nobody could tell. Contamination
         # becomes a thing you SEE rather than a thing the runner guesses at.
         #
         # Derived from $rows and NEVER from $sess. The rows the guard admits are sessions AND
         # escalations, and three of the seven repositories in the real ledger contribute
         # escalations only — counted over sessions this field reports a clean slice over a
         # contaminated one, which is the mistake the first draft of the ADR made (it answered
         # "four repos" over seven) and the reason the record says so about itself.
         #
         # BOTH numbers, because the guard above reads two and they read different rows:
         # `missions` is what missions_after_change reports, `missions_with_session` is what the
         # FLOOR gates on. Each sum closes against its own field, which is what makes this an
         # explanation of the guard instead of a second opinion beside it.
         #
         # An ARRAY of objects and not an object keyed by path, for the same reason mission_key is
         # an array: a repo path is arbitrary text, and a key set built out of it admits a
         # delimiter nobody chose. sort_by is what makes the order a fact of the data rather than
         # of jq — group_by already sorts by key, and leaning on that would publish an order no
         # line of this program states.
         composition: ($rows | group_by(.repo // "")
                             | map({repo: (.[0].repo // ""),
                                    missions: (map(mission_key) | unique | length),
                                    missions_with_session:
                                      (map(select(.event == "session")) | map(mission_key) | unique | length)})
                             | sort_by(-.missions, .repo)),
         sessions: ($sess | length),
         # What the sessions DID, and how often the gate passed — the headline since
         # 20260828-instrumento-honesto (the judge prompt cites these two before moved_rate).
         # moved_rate stays: its name says what it measures, and it has a consumer. Same yardstick
         # as the human window BY CONSTRUCTION: both programs splice ledger_outcome_defs, and
         # check-autonomy.sh compares the two histograms over one file, so a program that grew a
         # local copy of the definition is caught by the comparison and not by a sentence here.
         outcomes: ($sess | outcome_tally),
         # advance_rate is the `advanced` slice of `outcomes` and NOT a second count beside it —
         # written as `.gate == "pass"` until 20260829 it disagreed with the histogram printed one
         # line above it, and the disagreement was exactly the designed loop: the ten EXEC sessions
         # of the 20260816 kit mission, each closing an increment, read `0.10` here while the phase
         # had not tripped once. One yardstick, two readings of it, so the headline the judge quotes
         # cannot contradict the tally the judge is looking at.
         advance_rate: (if ($sess | length) == 0 then null
                        else (($sess | map(select(outcome == "advanced")) | length) / ($sess | length) * 100 | round / 100) end),
         moved_rate: (if ($sess | length) == 0 then null
                      else (($sess | map(select(.moved == true)) | length) / ($sess | length) * 100 | round / 100) end),
         labels: ($detail | reduce .[] as $d ({ok: 0, leve: 0, refez: 0}; .[$d.label] += 1)),
         escalations: ($rows | map(select(is_escalation))
                             | group_by(.kind)
                             | map({(.[0].kind): length}) | add // {}),
         cost_usd: ($sess | map(.cost_usd // 0) | add // 0 | . * 100 | round / 100),
         detail: $detail};

    [ inputs ] as $file_rows
    # The repo filter runs BEFORE any classification, and its own count is kept: a row born in
    # another repo is not this repo unrecognized row, it is not this repo row at all — and it is
    # counted rather than dropped, because a number that moved with nothing explaining why is the
    # defect this filter exists to remove, not one to introduce one layer down.
    | ($file_rows | map(select(ledger_row_no_repo)) | length) as $no_repo
    # historic_progress at the SAME point of this program as of cmd_autonomy: right after the repo
    # filter, before any classification. One dated recovery, spliced from one definition, so the
    # judge and the human window cannot end up reading two different histories out of one file —
    # check-autonomy.sh compares them over a prose-only ledger for exactly that.
    | ($file_rows | map(select(ledger_row_is_local)) | historic_progress | historic_rounds) as $raw
    # Subtracted out, never lumped in: a row that names no project did not come from another repo,
    # and a bucket that said it did would be a wrong reason printed with the confidence of a right
    # one. The two counts partition what the filter removed, so the arithmetic still closes.
    | (($file_rows | length) - ($raw | length) - $no_repo) as $other_repo
    | ($raw | map(select(type == "object" and .v == 1
                         and (.event == "session" or is_escalation or is_gate_pass)))) as $all
    | ($all | map(select(.phase == "KAIZEN"))) as $meta
    | ($all | map(select(.phase != "KAIZEN"))) as $rows
    | (($raw | length) - ($all | length)) as $unrec
    | ($rows | map(select(comparable_row | not))) as $noncomp
    | ($rows | map(select(comparable_row))) as $ok
    | ($ok | shas_in_file_order) as $shas
    | (if ($shas | length) >= 1 then ($ok | map(select(.kit_sha == $shas[-1])) | group_summary) else null end) as $latest
    | (if ($shas | length) >= 2 then ($ok | map(select(.kit_sha == $shas[-2])) | group_summary) else null end) as $previous
    # ONE binding for the number the floor reads, so the exposed field and the verdict of the
    # guard cannot drift apart: written twice, an edit to one of them would leave the series
    # PRINTING a count it did not gate on, which is the same class of divergence I7 closed one
    # field over. Everything the guard says about itself comes from here.
    | (($latest.missions_with_session) // 0) as $observed
    # Derived from the WHOLE comparable slice, never from $latest alone: a degenerate axis is a
    # property of the SET of recent kit versions (each carrying exactly one MISSION — the unit
    # $observed above reads, never sessions), which no single group can state about itself. It adds
    # no fact to the ledger and changes no verdict — it explains one.
    | ($ok | degenerate_axis) as $degenerate
    | {v: 1,
       latest: $latest,
       previous: $previous,
       # The floor below does not loosen, and ADR 0003 is why: verdict evidence comes from real
       # target repos, where many missions share one kit_sha. In the repo that BUILDS the kit every
       # session lands on a fresh sha, so the axis degenerates and the floor is unsatisfiable by
       # construction — that is the axis being read in the wrong place, never a floor set too high.
       guard: {missions_after_change: ($latest.missions // 0),
               missions_with_session: $observed,
               sessions: ($latest.sessions // 0),
               # PUBLISHED, and that is what makes it one number instead of two. The sentence
               # kaizen_axis_note prints to the human used to carry its own hand-written `3`, under
               # a comment swearing it did not — the one voice of this floor a human reads out
               # loud, and the one that would have drifted in silence the day the floor moved.
               floor: guard_floor,
               sufficient: ($observed >= guard_floor),  # missions WITH a session (D4); I13.4 revisits
               degenerate_axis: $degenerate},
       excluded: {non_comparable: ($noncomp | length), unrecognized: $unrec,
                  meta: ($meta | length), other_repo: $other_repo, no_repo: $no_repo}}
  ' < "$file"
}

# One dim line after "pipeline complete": how many missions the CURRENT kit version accumulated
# without a verdict, and where to go. Pull, not push (D6) — the human is the kanban, so it prints
# only when there is something to judge and no verdict for it yet, and it never blocks anything.
# The third reader of the ledger, and it holds no filter of its own on purpose: it reads through
# kaizen_series, so it inherits ledger_row_is_local along with every number it prints. It is called
# from cmd_run alone, and `sdd run` has no --all-repos (it dies on any unknown `-*`), so it reads
# PER REPO — which is the right unit for the question it asks: what did the run that just finished
# contribute. A repo whose rows all came from somewhere else gets missions_after_change 0 and stays
# silent, still the right silence, but ⚠️ the REASON changed with ADR 0005: it is "this repo
# contributed nothing new", no longer "the judge cannot see these rows". Since 0005 the judge sees
# every repo, and the sentence at the bottom of this function had to stop saying otherwise.
# The verdicts live in the KIT repo ($SDD_HOME/docs/handoffs/), readable from any target repo.
# Every read goes through a variable or a herestring — never `printf | grep`, the pipefail trap.
kaizen_reminder() {
  # Same one-shot warn as every other jq consumer — a silent return here would be the
  # "errors pass silently" exception in a file that already fixed this once.
  autonomy_have_jq || return 0
  local file; file="$(autonomy_log_path)"
  [ -s "$file" ] || return 0
  local series n sha
  series="$(kaizen_series)" || return 0
  n="$(jq -r '.guard.missions_after_change' <<< "$series")"
  [ "$n" != "0" ] || return 0
  sha="$(jq -r '.latest.kit_sha // empty' <<< "$series")"
  [ -n "$sha" ] || return 0
  # Same search as gate_KAIZEN: by kit_sha_judged content, never by newest file.
  local f
  for f in "$SDD_HOME"/docs/handoffs/*/05-verdict.md; do
    [ -f "$f" ] || continue
    [ "$(frontmatter "$f" kit_sha_judged)" = "$sha" ] && return 0
  done
  # WHERE this is being said from decides WHAT is true. The count above is this repo's missions,
  # and it used to be followed, in every repo, by "run 'sdd kaizen' in the kit repo" — a pointer to
  # a judge that reads a DIFFERENT set of numbers. In a target repo the human would open the kit,
  # run the command, and be told something about the kit's own missions that has nothing to do with
  # the run that just finished. Same question cmd_kaizen asks to decide where it may run at all.
  local kit_root
  kit_root="$( cd "$SDD_HOME" && git rev-parse --show-toplevel 2>/dev/null || true )"
  if [ -n "$kit_root" ] && [ "$kit_root" = "$REPO_ROOT" ]; then
    dim "  autonomy series: $n mission(s) on kit $sha without a verdict — run 'sdd kaizen' in the kit repo ($SDD_HOME) for the next kit mission plan"
    return 0
  fi
  # Outside the kit the pointer is to the kit, and the sentence is the one thing here that had to
  # change with ADR 0005: it used to say the judge would not count these rows, which was true and
  # is now false — the judge reads every repo, and ADR 0003 says these are exactly the rows a
  # verdict should rest on. A line that goes on describing the old behaviour is the label this
  # repo's first principle refuses, printed in every target repo after every run.
  #
  # The COUNT stays per repo, and that is not an oversight: this sentence is about what the run
  # that just finished contributed, `sdd run` carries no ledger option to widen it with, and a
  # reminder that answered with other projects' missions would be reporting somebody else's work
  # as this repo's.
  dim "  autonomy series: $n mission(s) of this repo on kit $sha are in the ledger. The kaizen judge counts them (ADR 0005) — run 'sdd kaizen' in the kit repo ($SDD_HOME)."
}

# KAIZEN gate — same convention as every gate (0/1, reason in GATE_WHY), but NOT in PHASES:
# KAIZEN is the meta-loop that judges the kit itself, and cmd_kaizen drives it directly.
#
# Satisfied means: a verdict exists for the kit sha the series calls latest, and — unless the
# verdict is `piorou`, which dispenses the plan (ADR 0002) — the born plan sits beside it with an
# EMPTY `aprovacao:`. The verdict is found by CONTENT (`kit_sha_judged == expected`), never by
# "newest file" — and that stays true now that latest_matching() sorts by version: file order,
# however correct, does not know which sha a verdict judged, and an old verdict must never
# satisfy a new sha.
#
# On `piorou` the gate PASSES (the judge did its job) and publishes GATE_KAIZEN_VERDICT so
# cmd_kaizen can stop the line — the gate itself never kills the process, and the global survives
# because gate_KAIZEN is CALLED, never read through $( ) (the autonomy_kit_stamp subshell lesson).
#
# The verdict LABEL is never trusted on its own (principle 1: gate = artifact, never a label):
# the value must be one of the three enum tokens, and any verdict other than `indeterminado`
# demands guard.sufficient from the SAME series the agent was told to cite — the boot prompt's
# "the guard belongs to the runner" is enforced here, not merely requested there.
#
# GATE_KAIZEN_APPROVED carries a non-empty `aprovacao:` out to cmd_kaizen, which must NOT route
# that failure through the generic fix-it retry session: the value may be a HUMAN's approval, and
# a session told to "complete what is missing" could blank it — erasing a human decision that
# `sdd run` may already be acting on.
GATE_KAIZEN_VERDICT=""
GATE_KAIZEN_VERDICT_FILE=""
GATE_KAIZEN_PLAN_DIR=""
GATE_KAIZEN_APPROVED=""
GATE_KAIZEN_UNREADABLE=""
gate_KAIZEN() {
  GATE_KAIZEN_VERDICT=""; GATE_KAIZEN_VERDICT_FILE=""; GATE_KAIZEN_PLAN_DIR=""
  GATE_KAIZEN_APPROVED=""; GATE_KAIZEN_UNREADABLE=""
  local series expected f found="" series_rc=0
  # The rc is READ, and that is the whole point. Written `series="$(kaizen_series)"` bare, this line
  # looked safe because errexit would catch it — and errexit is OFF inside here, every time: every
  # caller invokes this function as `gate_KAIZEN || gate_rc=$?`, which disables it for the entire
  # body. So a failed read left `series` empty, `expected` empty, and the gate answered "no verdict
  # for kit  yet" (that double space was the only tell) — a corrupt ledger routed into the branch
  # meaning "the judge has not run", which spends an opus session on a file that cannot be read.
  # A series that could not be read supports NO statement about the kit, so it gets its own outcome
  # rather than the most optimistic neighbouring one.
  series="$(kaizen_series)" || series_rc=$?
  if [ "$series_rc" -ne 0 ] || [ -z "$series" ]; then
    GATE_KAIZEN_UNREADABLE=1
    GATE_WHY="the ledger could not be read (the series reader exited $series_rc) — this is NOT 'not judged yet': run 'sdd autonomy' to see which row breaks it. No session can judge a series nobody can read."
    return 1
  fi
  expected="$(jq -r '.latest.kit_sha // "none"' <<< "$series")"
  for f in "$REPO_ROOT/$HANDOFF_DIR"/*/05-verdict.md; do
    [ -f "$f" ] || continue
    if [ "$(frontmatter "$f" kit_sha_judged)" = "$expected" ]; then found="$f"; break; fi
  done
  [ -n "$found" ] || { GATE_WHY="no verdict for kit ${expected} yet"; return 1; }
  GATE_KAIZEN_VERDICT_FILE="$found"
  local verdict; verdict="$(frontmatter "$found" verdict)"
  case "$verdict" in
    melhorou|piorou|indeterminado) : ;;
    *) GATE_WHY="verdict '${verdict:-<empty>}' at $found is not one of melhorou|piorou|indeterminado"
       return 1 ;;
  esac
  local sufficient; sufficient="$(jq -r '.guard.sufficient' <<< "$series")"
  if [ "$sufficient" != "true" ] && [ "$verdict" != "indeterminado" ]; then
    GATE_WHY="verdict '$verdict' at $found but guard.sufficient is false — the guard belongs to the runner and an insufficient series only supports 'indeterminado'"
    return 1
  fi
  if [ "$verdict" = "piorou" ]; then
    GATE_KAIZEN_VERDICT="piorou"
    GATE_WHY="verdict piorou at $found — the plan is dispensed, the line must stop"
    return 0
  fi
  local d; d="$(dirname "$found")"
  [ -f "$d/00-missao.md" ] \
    || { GATE_WHY="verdict at $found but 00-missao.md is missing beside it"; return 1; }
  local approval; approval="$(frontmatter "$d/00-missao.md" aprovacao)"
  if [ -n "$approval" ]; then
    GATE_KAIZEN_APPROVED="$approval"
    GATE_WHY="the born plan carries 'aprovacao: $approval' — kaizen never approves itself (pre-I13.4), and a filled value is the human's, never a session's to blank"
    return 1
  fi
  [ -f "$d/01-plano.md" ] \
    || { GATE_WHY="verdict at $found but 01-plano.md is missing beside it"; return 1; }
  [ -f "$d/checkpoint.md" ] \
    || { GATE_WHY="verdict at $found but checkpoint.md is missing beside it"; return 1; }
  GATE_KAIZEN_PLAN_DIR="$d"
  GATE_WHY="verdict ${verdict} + born plan with empty aprovacao at $d"
  return 0
}

# The two terminal outcomes of a satisfied KAIZEN gate, shared by the idempotent pre-check and
# the post-session re-evaluations. Returns 3 on `piorou` (Jidoka — same escalation convention as
# a blocked increment) and 0 when the born plan is waiting for the human.
kaizen_outcome() {
  if [ "$GATE_KAIZEN_VERDICT" = "piorou" ]; then
    info ""
    bad "the previous kit change made autonomy WORSE — the line is stopped"
    dim "  Read the verdict, decide, then re-run: $GATE_KAIZEN_VERDICT_FILE"
    return 3
  fi
  ok "gate KAIZEN: $GATE_WHY"
  dim "  Review the born plan, fill 'aprovacao:', then 'sdd run' the new mission:"
  dim "  $GATE_KAIZEN_PLAN_DIR"
  return 0
}

# Terminal handling of a born plan whose `aprovacao:` is already filled — the one gate failure
# that must NEVER be handed to a fix-it session, because the generic retry prompt ("complete
# what is missing and write the artifacts") reads, to a live agent, as an instruction to blank
# the field. Returns 3 for the loop's own forbidden self-approval, 0 when a human already
# approved (kaizen's job ended when the plan was born; the next step is sdd run).
kaizen_approved_outcome() {
  if [ "$GATE_KAIZEN_APPROVED" = "auto" ]; then
    info ""
    bad "the born plan approved ITSELF (aprovacao: auto) — pre-I13.4 the loop never does that"
    dim "  A human decides: empty the field to hand the plan back, or replace it with your own approval."
    return 3
  fi
  ok "the born plan is already approved (aprovacao: $GATE_KAIZEN_APPROVED)"
  dim "  Kaizen's work here is done — the next step is 'sdd run' on that mission, not another verdict."
  return 0
}

# The structural `indeterminado`, said out loud instead of left for the human to infer. The number
# it reads is derived by kaizen_series (ADR 0001: the runner never opines, it reports), and the
# sentence exists because `guard.sufficient: false` means two different things in two different
# repos — "a few more missions and we are there" in a target, "no number of missions here will ever
# do it" in the repo that builds the kit. Read as the first, the human waits forever.
#
# ADR 0003 is NAMED, not paraphrased: the decision is why the floor does not loosen in answer to
# this, and a sentence carrying its own evidence is the difference between a report and an opinion.
kaizen_axis_note() {
  autonomy_have_jq || return 0
  local series
  # stderr dropped ON PURPOSE, and only here: this is a second read of the same series the gate is
  # about to take, so an unreadable ledger printed jq raw diagnostic TWICE in a row — the same
  # complaint from two voices reads as two problems. Reporting corruption is the gate job, one
  # line down, and it still does it. This function only ever explains a degenerate axis, and it
  # has nothing to explain about a file it could not parse.
  series="$(kaizen_series 2>/dev/null)" || return 0
  [ "$(jq -r '.guard.degenerate_axis' <<< "$series")" = "true" ] || return 0
  # READ off the series this sentence is explaining, never written here. The comment that used to
  # sit on this line said "no count in the sentence on purpose: writing 3 here would be a third copy
  # of a number the jq program already owns, drifting the day the floor moves" — and the `dim` two
  # lines down printed "The floor of 3 missions". The promise was right; the code did the opposite,
  # and this is the only voice of the floor a human ever reads out loud.
  local floor; floor="$(jq -r '.guard.floor' <<< "$series")"
  warn "the kit_sha axis is degenerate here: the recent kit versions each carry exactly one mission, and none ever reached the floor"
  dim "  This repo BUILDS the kit, so each session commits and the next one lands on a fresh sha."
  dim "  The floor of $floor missions per kit version is unsatisfiable here, and 'indeterminado' is then"
  dim "  the CORRECT verdict, not a missing mission: evidence comes from real target repos (ADR 0003)."
}

# The composition of the axis slice, said out loud — ADR 0005, part 2. The series carries it as
# data and the judge reads it there; this is the same fact on the terminal, because the argument
# that makes reading every repo safe is that a contaminated slice is SEEN, and a JSON field nobody
# opens is not seen. It EXPLAINS and never decides: no verdict, no threshold, no opinion (ADR 0001
# — the runner reports, the agent judges).
#
# Silent when there is no latest slice at all, and silent when the slice has no composition: an
# empty series has nothing to publish, and a header printed over nothing is the kind of zero this
# file spends its lines refusing.
kaizen_composition_note() {
  autonomy_have_jq || return 0
  local series
  # stderr dropped for the same reason kaizen_axis_note drops it, and only for that reason: this
  # is a second read of the series the gate is about to take, and the same complaint arriving from
  # two voices reads as two problems. Reporting corruption is the gate's job, and it still does it.
  series="$(kaizen_series 2>/dev/null)" || return 0
  local sha; sha="$(jq -r '.latest.kit_sha // empty' <<< "$series")"
  [ -n "$sha" ] || return 0
  # `composition[]?` and not `composition[]`: a series read from a runner that predates the field
  # — or one whose latest is null — must leave this function quiet rather than make jq die inside
  # a command substitution the caller cannot see.
  local lines
  lines="$(jq -r '.latest.composition[]?
                  | "    \(.missions) mission(s), \(.missions_with_session) with a session  —  "
                    + (if .repo == "" then "<no repo>" else .repo end)' <<< "$series")"
  [ -n "$lines" ] || return 0
  dim "  the slice the judge reads for kit $sha, by repo:"
  local l; while IFS= read -r l; do dim "$l"; done <<< "$lines"
}

cmd_kaizen() {
  # ADR 0005, part 1 — the judge reads the WHOLE ledger. ADR 0003 had already said where verdict
  # evidence lives (real target repos: in the repo that BUILDS the kit every session lands on a
  # fresh sha and the axis degenerates by construction), and it stayed a dead letter for nine days
  # because nothing said how the judge READS those rows. The per-repo default kept it looking at
  # exactly the one repo 0003 declared unusable and excluded the evidence as `other_repo`: measured
  # on 20260825-frete-cif-fob, 21 comparable rows of a real target repo and 35 excluded, with three
  # missions planned on a frozen sha that would all have answered `indeterminado`.
  #
  # Set HERE, before the option loop, so it reaches every half of this command in one process:
  # `--series`, `gate_KAIZEN`, `kaizen_axis_note` and `kaizen_composition_note` all read ONE slice,
  # and the boot prompt no longer has to carry a flag to keep them in step.
  #
  # What makes it safe is part 2, not a filter: the composition of the slice is published beside
  # the numbers, so a verdict resting on a throwaway clone is a thing you SEE. `sdd autonomy` keeps
  # the per-repo default — its question genuinely is "what did THIS repo cost".
  LEDGER_ALL_REPOS=1
  local series_only=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --series)  series_only=1 ;;
      --dry-run) DRY_RUN=1 ;;
      # KEPT, and a NO-OP here since ADR 0005: the judge reads every repo by default, set at the
      # top of this function. It stays accepted because scripts, handoffs and the boot prompts of
      # finished missions already carry it, and a flag that silently changed MEANING would be worse
      # than one that stopped deciding in one of its two homes — on `sdd autonomy` it still decides
      # everything.
      # ⚠️ The comment this replaced said the flag "must NEVER default to on", and that sentence was
      # right about fixtures and wrong about the question: what it protected against was a
      # throwaway clone moving the judge's numbers, and that is now closed by the writer guard
      # (part 3) and made visible by the composition (part 2) — neither of which is a reading
      # filter. ADR 0005 records why the trade moved.
      --all-repos) LEDGER_ALL_REPOS=1 ;;
      *)         die "unknown kaizen option: $1" ;;
    esac
    shift
  done
  # The ledger FILE is global (~/.sdd), so no config and no mission are needed to read it — but the
  # reading is per repo, and kaizen_series resolves that itself. Run from outside a git repository
  # it warns and comes back empty, which is the safe direction: an empty series is insufficient by
  # construction and supports only `indeterminado`.
  if [ "$series_only" = "1" ]; then kaizen_series; return 0; fi

  load_config
  # KAIZEN plans the KIT's next mission, never a target project's. Run from anywhere else it
  # would judge the kit but give birth to the plan in the wrong repo.
  local kit_root
  kit_root="$( cd "$SDD_HOME" && git rev-parse --show-toplevel 2>/dev/null || true )"
  # Two distinct refusals, named apart: an empty kit_root means the kit itself has no git
  # history (a plain copy) — blaming the cwd would send the user hunting for the wrong problem,
  # the same misattribution autonomy_kit_stamp already warns about for ledger rows.
  [ -n "$kit_root" ] \
    || die "$SDD_HOME is not a git checkout — the kaizen loop judges kit versions and needs the kit's git history"
  [ "$kit_root" = "$REPO_ROOT" ] \
    || die "sdd kaizen plans the KIT's next mission — run it in the kit repo ($SDD_HOME)"
  # A dirty tree does not block (the judge may be invoked mid-work on purpose), but the rows born
  # now carry kit_dirty:true and stay out of the comparable series forever — worth hearing once.
  [ -z "$( git -C "$REPO_ROOT" status --porcelain 2>/dev/null )" ] \
    || warn "the kit tree is dirty — ledger rows born now carry kit_dirty:true and stay non-comparable"
  # The third door, and the one that most needed it: everything above here validates the kit repo
  # and the tree, and none of it asks WHICH BRANCH the verdict and the three born artifacts are
  # about to land on. `--series` already returned above — a pure read warns about nothing.
  warn_if_on_base_branch
  # Pseudo-mission: logs and the boot prompt need a name, but KAIZEN derives nothing from a
  # mission directory — resolve_mission is NOT called (it requires an existing mission), and this
  # directory is never created by the runner: the agent creates the real handoff directory when
  # it writes the verdict.
  MISSION="$(date +%Y%m%d)-kaizen"
  MISSION_DIR="$REPO_ROOT/$HANDOFF_DIR/$MISSION"
  PIPELINE_LOG="$(log_dir)/pipeline.log"
  AUTONOMY_RUN_ID="$(uuidgen)"
  AUTONOMY_INVOCATION="run"

  step "kaizen — judging the previous kit change and planning the next kit mission"
  [ "$DRY_RUN" = "1" ] && dim "  (dry-run: no session will be opened and nothing is written)"
  # Before the gate, so the explanation reaches the human on BOTH outcomes: a pending gate is
  # exactly where `sufficient: false` is about to be read, and an already-judged one is where the
  # next question ("why indeterminado again?") is asked. CALLED, never `$( )` — it prints.
  kaizen_axis_note
  # Beside the axis note and on the same terms: before the gate, so it reaches the human on BOTH
  # outcomes — a pending gate is where the numbers are about to be read, and an already-judged one
  # is where "why that verdict?" gets asked. CALLED, never `$( )`: it prints.
  kaizen_composition_note

  # Idempotent: already judged ⇒ no session is spent, only the outcome is repeated.
  local gate_rc=0 out_rc=0
  gate_KAIZEN || gate_rc=$?
  if [ "$gate_rc" -eq 0 ]; then
    dim "  already judged: no session to spend"
    kaizen_outcome || out_rc=$?
    return "$out_rc"
  fi
  # An unreadable ledger stops the line BEFORE any session, and ahead of every other bailout: each
  # one below reasons about numbers this series was supposed to carry, and it carries none. The
  # session is the thing being refused — a corrupt ledger is not a state an agent can fix from
  # inside a session (the file lives in $HOME and is not in the repo), so opening one only spends
  # opus to arrive at the same sentence. `die`, exactly as cmd_autonomy does over the same file:
  # this is the same refusal, reached through the gate instead of through the reader.
  if [ -n "$GATE_KAIZEN_UNREADABLE" ]; then
    die "$GATE_WHY"
  fi
  # A filled `aprovacao:` bails out BEFORE any session — see kaizen_approved_outcome.
  if [ -n "$GATE_KAIZEN_APPROVED" ]; then
    out_rc=0; kaizen_approved_outcome || out_rc=$?
    return "$out_rc"
  fi

  local before after moved="false"
  before="$(state_fingerprint)"
  run_phase KAIZEN
  # The projection stops HERE, before the fingerprint and the ledger writer — same decision, same
  # reason, as the dry-run branch in cmd_run: the writer stays out of the projection path
  # entirely instead of leaning on autonomy_append's own guard as the only defense.
  if [ "$DRY_RUN" = "1" ]; then
    dim "  (dry-run: end of the projection — no session was opened)"
    return 0
  fi
  after="$(state_fingerprint)"
  [ "$before" != "$after" ] && moved="true"
  gate_rc=0; gate_KAIZEN || gate_rc=$?
  autonomy_session_row "KAIZEN" "1" "false" "$moved" \
    "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY"
  if [ "$gate_rc" -eq 0 ]; then
    kaizen_outcome || out_rc=$?
    return "$out_rc"
  fi

  # Same bailout after the session: if the agent filled `aprovacao:` itself, a fix-it retry
  # would be told to undo it — the value's owner is a human, so the line stops instead.
  if [ -n "$GATE_KAIZEN_APPROVED" ]; then
    out_rc=0; kaizen_approved_outcome || out_rc=$?
    return "$out_rc"
  fi

  warn "gate KAIZEN failed: $GATE_WHY"
  warn "  retrying once with the gate reason in the prompt"
  run_phase KAIZEN "$LAST_PHASE_SID"
  local after2 moved2="false"
  after2="$(state_fingerprint)"
  [ "$after" != "$after2" ] && moved2="true"
  gate_rc=0; gate_KAIZEN || gate_rc=$?
  autonomy_session_row "KAIZEN" "1" "true" "$moved2" \
    "$( [ "$gate_rc" -eq 0 ] && echo pass || echo fail )" "$GATE_WHY"
  if [ "$gate_rc" -eq 0 ]; then
    kaizen_outcome || out_rc=$?
    return "$out_rc"
  fi
  # Third and last bailout: the RETRY session may be the one that filled `aprovacao:` — falling
  # through would misreport an approval as a no-progress escalation, with a spurious blocked row.
  if [ -n "$GATE_KAIZEN_APPROVED" ]; then
    out_rc=0; kaizen_approved_outcome || out_rc=$?
    return "$out_rc"
  fi

  info ""
  bad "BLOCKED in KAIZEN — two sessions without satisfying the gate: $GATE_WHY"
  dim "  The judge's session did not produce the artifacts. Read the logs in $(log_dir)/."
  autonomy_blocked_row "no-progress" "KAIZEN" "$GATE_WHY"
  return 3
}

cmd_version() { info "sdd $SDD_VERSION ($SDD_HOME)"; }

cmd_help() {
  cat <<'EOF'
sdd — runner for the autonomous development agent pipeline

USAGE
  sdd install [--force]      install the kit into the target repo (.sdd/config.sh + .claude/agents/)
  sdd preflight              environment sensor: tools, auth, config, plugins, git
  sdd health                 KIT sensor: suite, mutation, doc and config drift
  sdd status <mission>       where the mission stands, gate by gate, and what is missing
  sdd approve <mission>      show the plan and, on an explicit y, write the human approval into
                             00-missao.md and commit it (the PLAN gate — never a session)
  sdd run <mission>          run from the first unsatisfied phase through to the PR
  sdd retry <mission>        retry the current phase with a fresh session
  sdd close <mission>        post-merge: close the JIRA issue
  sdd autonomy [--all-repos] what the sessions did per kit version — advanced · churned · idle, and
                             waste = churned + idle — for this repo unless --all-repos, from the ledger
                             advanced is the gate that passed OR the EXEC session that closed an
                             increment: the pipeline's designed loop is not waste
             [--by-mission]  group by mission instead of by kit version: the same three outcomes,
                             launch(es) (distinct run_id — the intervention count D12 reads),
                             reopened phases, the `- intervention:` notes of the checkpoint when
                             it is on disk, and the mission cost. Same rows, same money, other unit.
                             `review loop US$ X (N%)` rides along on a mission that had a REVIEW
                             session: the rounds PLUS the EXEC sessions after the first one — the
                             R<n> increments a round writes — over the mission cost. Absent, and
                             never 0%, on a mission that never reviewed.
  sdd kaizen [--dry-run]     judge the previous kit change and give birth to the next kit
                             mission plan (kit repo only; exit 3 = the change made it worse)
  sdd kaizen --series        the deterministic series (JSON) the judge cites — EVERY repo in the
                             ledger, with the composition of the slice beside the numbers
  sdd help | sdd version

LEDGER OPTIONS (`autonomy` and `kaizen`)
  --all-repos                read the WHOLE ledger, not just the rows born in this repo. It
                             decides on `autonomy` and nowhere else: per repo is the right default
                             there, because that command's question is "what did THIS project
                             cost", and because a `sdd run` in a THROWAWAY FIXTURE repo once moved
                             the judge's own numbers. Ask for it when the question really is
                             cross-project maturity — which is why the ledger is one file per
                             machine to begin with.
                             ⚠️ On `kaizen` it is a NO-OP, kept because scripts and handoffs carry
                             it. Since ADR 0005 the judge always reads every repo: its question is
                             the other one — ADR 0003 says verdict evidence comes from real target
                             repos, because in the repo that BUILDS the kit every session lands on
                             a fresh sha and the axis degenerates by construction. What makes that
                             safe is not a filter — the series publishes the COMPOSITION of the
                             slice it read (missions per repo), so a verdict resting on a throwaway
                             clone is visible instead of silent, and a repo under $TMPDIR can no
                             longer write the real ledger unless SDD_STATE_DIR says where to put it.

FOR SCRIPTS
  sdd phase <mission>        print only the current phase (or DONE)
  sdd why <mission> [PHASE]  print why that phase's gate did not pass

`run` OPTIONS
  --dry-run                  print the boot prompts and exit, spending no tokens and touching
                             no mission artifact (the gates do run TEST_CMD for real)
  --phase <PHASE>            force one specific phase (PLAN|TICKET|EXEC|QA|REVIEW|DOCS|PR)
  --max-phases <N>           stop after N phases (default: no limit)

HOW THE STATE WORKS
  There is no state file. The current phase is derived from the artifacts in
  docs/handoffs/<mission>/. Session died? `sdd run` again resumes at the exact point.
  No gate is satisfied by model text — the runner runs the tests and reads the disk.
EOF
}

# ---------------------------------------------------------------------------
main() {
  local subcmd="${1:-help}"
  shift || true
  case "$subcmd" in
    install)   cmd_install "$@" ;;
    preflight) cmd_preflight "$@" ;;
    health)    cmd_health "$@" ;;
    status)    cmd_status "$@" ;;
    approve)   cmd_approve "$@" ;;
    phase)     cmd_phase "$@" ;;
    why)       cmd_why "$@" ;;
    run)       cmd_run "$@" ;;
    retry)     cmd_retry "$@" ;;
    close)     cmd_close "$@" ;;
    autonomy)  cmd_autonomy "$@" ;;
    kaizen)    cmd_kaizen "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h) cmd_help ;;
    *) die "unknown command: $subcmd (see 'sdd help')" ;;
  esac
}

# close_query <acli binary> <issue> — publishes CLOSE_REACHABLE and CLOSE_VERIFIED.
#
# CALLED, never substituted: it publishes two globals, and `$(close_query ...)` would run the body
# in a subshell where both assignments die with the substitution — the autonomy_kit_stamp scar,
# written down again because a function with TWO outputs has no honest way to be read through a
# single `$( )` anyway. cmd_close needs both: "could I ask?" and "what was the answer?" are
# different questions and the whole fix is that they stopped being one.
#
# `--fields "key,status"` and not `--fields key`: the short spelling answers `[null]`. `.key` is
# top-level in each object; `statusCategory = Done` is the project-agnostic form, because the status
# NAME is localized per project and per language, while the category is not.
#
# The capture carries `|| true` INSIDE the substitution: this file runs under `set -e`, where
# `x="$(cmd)"` dies at the assignment the moment cmd is non-zero — and non-zero is exactly what acli
# returns for expired auth. The rc is deliberately not consulted; it discriminates nothing, since
# the same tool answers rc 0 for a hit AND for a miss, and was measured answering rc 1 for
# unauthenticated on 2026-08-25. The SHAPE of the answer is the only witness there is.
CLOSE_REACHABLE=false
CLOSE_VERIFIED=false
close_query() {
  local out keys
  CLOSE_REACHABLE=false; CLOSE_VERIFIED=false
  out="$( cd "$REPO_ROOT" && "$1" jira workitem search \
      --jql "key = $2 AND statusCategory = Done" --fields "key,status" --json 2>/dev/null || true )"
  # A JSON ARRAY is the whole reachability test, and it is a shape and not a status: acli answers
  # one for a hit (`[{...}]`) and one for a miss (`[]`), and prose for expired auth or a spelling it
  # does not know. `type == "array"` and NOT `. != null`, because jq reads a bare `null` as perfectly
  # valid JSON and the empty capture would then read as reachable.
  #
  # Every shape MEASURED against this jq rather than reasoned about, because "no output" is the one
  # that would have been guessed wrong — `jq -e` exits 4 on it, not 0:
  #   `[]` 0 · `[{...}]` 0 · `null` 1 · `{...}` 1 · empty 4 · prose 5
  # Only the two zeroes reach `CLOSE_REACHABLE=true`, so a tool that dies producing nothing at all
  # is refused with the rest of them instead of letting a paid session through.
  #
  # This is also where a missing `jq` lands, and that is deliberate rather than a fourth
  # `command -v` above: jq is a hard dependency the preflight already refuses without, and an
  # unprobeable branch is the kind this repo deletes. The direction is right — no session is spent —
  # and the die message names the parse as one of the three things that produce it.
  jq -e 'type == "array"' >/dev/null 2>&1 <<< "$out" || return 0
  CLOSE_REACHABLE=true
  keys="$( jq -r '.[]?.key // empty' <<< "$out" 2>/dev/null || true )"
  # Herestring, never `printf | grep -q`: under `pipefail` that form returns 141 when grep FINDS the
  # match and closes the pipe early, so it would invert on long input and pass on short. `-x` and
  # `-F`: the JQL is what selects, but an acli that ever ignored it must not be able to satisfy this
  # with some other issue's key.
  if grep -qxF "$2" <<< "$keys"; then CLOSE_VERIFIED=true; fi
}

# Post-merge: closes the JIRA issue. Fired by the human after the merge — it is the only thing
# that happens AFTER the human gate, which is why it is not part of `sdd run`.
cmd_close() {
  load_config
  resolve_mission "${1:-}"
  PIPELINE_LOG="$(log_dir)/pipeline.log"

  [ "$JIRA_ENABLED" = "true" ] || { info "JIRA_ENABLED=false — nothing to close"; return 0; }
  local issue; issue="$(frontmatter "$MISSION_DIR/10-ticket.md" issue)"
  [ -n "$issue" ] || die "no 'issue:' found in 10-ticket.md — did the TICKET phase run?"

  local prurl; prurl="$(frontmatter "$MISSION_DIR/50-pr.md" pr_url)"
  if [ -n "$prurl" ]; then
    local merged
    merged="$( cd "$REPO_ROOT" && gh pr view "$prurl" --json state --jq .state 2>/dev/null || true )"
    if [ "$merged" != "MERGED" ]; then
      die "PR $prurl is '$merged', not MERGED — 'sdd close' is post-merge"
    fi
  fi

  local acli_bin="${SDD_ACLI_BIN:-acli}"
  command -v "$acli_bin" >/dev/null 2>&1 || die "cannot reach '$acli_bin' — 'sdd close' verifies the close against JIRA itself and will not report a close it did not see.
Install the acli CLI (or point SDD_ACLI_BIN at it), and check that its auth has not expired.
To confirm by hand:  $acli_bin jira workitem search --jql \"key = $issue AND statusCategory = Done\" --fields \"key,status\" --json"

  # THE PRE-CHECK IS THE VERIFICATION QUERY, and the earlier round of this work stopped one step
  # short of that: it asked `command -v` and called itself fail-closed. `command -v` proves the
  # binary is on PATH and nothing else — expired auth, the failure this repo actually captured a
  # fixture for (tests/.stub/acli-unauth.txt, and it is why that fixture exists), is invisible to
  # it. So the shape that argued "a verdict this command cannot reach is not a reason to spend a
  # phase budget first" spent the budget anyway on the one unreachable case that happens.
  #
  # Asking the real question here answers three at once: acli is reachable, it is authenticated,
  # and the issue may ALREADY be Done — in which case a second `sdd close` used to buy a second
  # session to learn it.
  close_query "$acli_bin" "$issue"
  [ "$CLOSE_REACHABLE" = true ] || die "'$acli_bin' did not answer JSON for $issue — expired auth, a version that spells the query differently, or a jq that cannot read it.
'sdd close' will not open a paid session it could never verify the result of.
To see what it saw:  $acli_bin jira workitem search --jql \"key = $issue AND statusCategory = Done\" --fields \"key,status\" --json"
  if [ "$CLOSE_VERIFIED" = true ]; then
    # No session, and the journal says so with `session=none`: a CLOSE row that named a session id
    # nobody spent would be the same class of lie as the rc this whole function stopped believing.
    pipeline_log_line "$(date -Iseconds)  CLOSE  issue=$issue  session=none  rc=0  verified=true  log=none"
    ok "$issue is already Done — JIRA confirms it, and no session was spent"
    return 0
  fi

  step "closing $issue"
  local sid logfile rc=0
  sid="$(uuidgen)"
  # Same grafia, same fix as run_phase above — and here $sid is the id claude is actually handed
  # via --session-id, so the name and the journal's `session=` field agree exactly. Reached once per
  # mission, so no fixture drives it; it is fixed by FORM, and that is said out loud rather than
  # left to look measured.
  logfile="$(log_dir)/CLOSE-$(date +%Y%m%d-%H%M%S)-${sid:0:8}.json"
  mkdir -p "$(dirname "$logfile")"
  # The fourth arm/check pair. `sdd close` opens a session with the same --allowedTools and the same
  # --permission-mode every phase gets, so "a target-repo session has no business editing the kit"
  # either covers it or is a claim wider than the guard. Probed by kit-guard regime 7.
  kit_guard_arm
  ( cd "$REPO_ROOT" && claude -p "/ticket close $issue" \
      --model "$MODEL_TICKET" --permission-mode "$PERMISSION_MODE" --output-format json \
      --setting-sources "user,project,local" --allowedTools "$ALLOWED_TOOLS" \
      --session-id "$sid" --max-budget-usd "$BUDGET_PER_PHASE_USD" ) > "$logfile" 2>&1 || rc=$?
  kit_guard_check "CLOSE"
  # The session's rc decides NOTHING here. It is one exit code shared by two branches — the session
  # that closed the issue exits 0, and so does the session that only ASKED whether to close it — so
  # reading it was reading a label. Measured on 2026-08-25: `ok SQ-108 closed` printed over an issue
  # sitting in "Em andamento". Principle 1 of CLAUDE.md, and the pattern gate_PR already uses: go
  # back to the live artifact and look.
  #
  # Asked a SECOND time, and the repetition is the point: acli can go unreachable between the
  # pre-check and here (auth expiring mid-session is the ordinary way), and a run that trusted the
  # earlier answer would be reading a label again — just an older one.
  close_query "$acli_bin" "$issue"
  local verified="$CLOSE_VERIFIED"
  pipeline_log_line "$(date -Iseconds)  CLOSE  issue=$issue  session=$sid  rc=$rc  verified=$verified  reachable=$CLOSE_REACHABLE  log=$logfile"
  if [ "$verified" = true ]; then
    # The artifact outranks the rc in BOTH directions, or it is not the artifact deciding — it is a
    # second label ANDed onto the first. A session that fell over after closing the issue closed it.
    if [ "$rc" -ne 0 ]; then dim "  (the close session exited $rc — see $logfile — but the issue is Done, so the artifact decides)"; fi
    ok "$issue closed — JIRA confirms it is Done"
    return 0
  fi
  # THREE outcomes, not two, and the third is why this branch exists: "I asked and JIRA said no" and
  # "I could not ask" are different facts, and telling a human the session only asked for
  # confirmation when what actually happened is that acli stopped answering sends them to read the
  # wrong log. Both fall closed — the direction never changes — but the sentence has to name which.
  if [ "$CLOSE_REACHABLE" != true ]; then
    bad "$issue is UNVERIFIED — the session ran, but '$acli_bin' stopped answering JSON afterwards (auth expiring mid-session is the ordinary way), so this command cannot say whether the close landed; see $logfile"
    return 1
  fi
  bad "$issue is still open — JIRA does not confirm the close (the session may have only asked for confirmation); see $logfile"
  return 1
}


# The braces and the `exit` are load-bearing, and tests/check-entrypoint.sh is why. bash keeps the
# file offset in sync with what it has parsed, so returning from a bare `main "$@"` sends it back
# to the read loop to ask this file for more input — and the EXEC phase edits bin/sdd DURING the
# `sdd run` executing it. Today the editor writes a new file and renames it, so the running shell
# keeps reading the old inode; an append (`>> "$0"`, `tee -a`) does not, and the shell would then
# execute whatever landed past the old end of file, with rc 0. `exit` means the read loop is never
# reached again, however much the file grew meanwhile.
{ main "$@"; exit $?; }
